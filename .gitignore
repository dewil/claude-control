# Personal runtime data — never commit.
projects.yaml
*.log
*.err
*.out

# Local working notes (drafts, plans, adversarial reports) — kept in docs/dev/
# but never versioned. Whole subtree, so nested folders never leak into the repo.
docs/dev/

# OS / editor noise
.DS_Store
*.swp

# Ephemeral git worktrees from bridge sessions
.claude/worktrees/

# Local user settings — not versioned.
.claude/settings.local.json

# Session memory — this repo is public and memory carries working context.
# Project memory lives in the private проект 1 vault instead (2026-07-25).
.claude/memory/

__pycache__
