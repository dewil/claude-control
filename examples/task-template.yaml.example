# claude-control task template (V2.7a §2).
#
# Используется `claude-rc agent new-task --name N --project P --text T`
# для рождения задачи с телефона (/new <проект> <текст>). Путь к файлу -
# CLAUDE_RC_TASK_TEMPLATE, по умолчанию ~/.claude-control/task-template.yaml.
#
# Подстановки: {{name}}, {{project}}, {{goal}}. Каждая подставляется как
# уже ЭКРАНИРОВАННЫЙ YAML-скаляр - в шаблоне плейсхолдеры стоят БЕЗ ручных
# кавычек вокруг себя (кавычка в тексте задачи иначе позволила бы дописать
# в спеку постороннее поле, включая пояс прав).
#
# Отсутствие файла или невалидный YAML после подстановки - отказ
# (fail-closed): задача без пояса прав не заводится вовсе.
#
# Пояс прав ниже (V2.10 §1) НЕ несет сборки, тестов, пакетных менеджеров и
# сети - агент умеет читать, править и коммитить, но не умеет прогнать
# проверку своей же работы. Это осознанное ограничение: набор команд
# проверки специфичен для проекта, угадывать его в общем шаблоне нельзя.
# Расширение - per-project спекой (`Bash(pytest:*)`, `Bash(npm test:*)` и
# т.п.), это единственный правильный канал.
#
# Сырого git в поясе нет и не будет (V2.10 §1.0): у git слишком много флагов,
# пишущих файл собственными руками мимо путевого ограничения Write/Edit
# (`git log --output=<файл>` и другие), плюс `git commit` исполняет хуки
# репозитория, которые агент мог сам подложить. Единственный путь к git -
# `claude-agent-commit --message "<текст>"`: фиксированный argv, хуки
# выключены, работает только в worktree своего агента.
schema: 1
name: {{name}}
type: event
role: none
project: {{project}}
goal: {{goal}}
autonomy: suggest
memory_max_mb: 200
limits: { runs_per_day: 20, run_timeout_s: 600 }
source: { kind: spool, replay_window_h: 72 }
workspace: worktree
runtime: drain
permission_mode: default
permissions:
  allow:
    - Read
    - Glob
    - Grep
    - Write
    - Edit
    - "Bash(claude-agent-commit:*)"
    - "Bash(claude-agent-done:*)"
    - "Bash(claude-agent-ask:*)"
  deny: []
  ask: []
