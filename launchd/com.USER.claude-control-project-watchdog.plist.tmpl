<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__PROJECT_WATCHDOG_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN_DIR__/claude-control-project-watchdog</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONTROL_DIR</key>
    <string>__CONTROL_DIR__</string>
    <key>CLAUDE_CONTROL_PROJECT_WATCHDOG_LOG</key>
    <string>__CONTROL_DIR__/project-watchdog.log</string>
    <key>CLAUDE_CONTROL_PROJECT_STALE_SECONDS</key>
    <string>150</string>
    <!-- Auto-restart on by default. Set to 0 for observe-only (logs "WOULD restart"
         to __CONTROL_DIR__/project-watchdog.log instead of killing+relaunching)
         when calibrating thresholds against real traffic. -->
    <key>CLAUDE_CONTROL_PROJECT_WATCHDOG_ARM</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>__CONTROL_DIR__/project-watchdog.out</string>
  <key>StandardErrorPath</key>
  <string>__CONTROL_DIR__/project-watchdog.err</string>
</dict>
</plist>
