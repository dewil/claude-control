#!/usr/bin/env bash
# claude-control-logrotate: cap every claude-control log so none grows unbounded.
# Runs independently of session health: invoked opportunistically by the watchdog
# (each tick) and by claude-rc (on session start), so logs stay bounded even with
# --no-watchdog, a broken watchdog, or manual claude-rc use.
#
# Trim is in-place (cat over the same inode) so a live appender's open fd stays
# valid - a rename would orphan its writes. This is best-effort: lines written
# between the tail read and the rewrite can be lost or interleaved. We accept that
# tradeoff; files are only touched when they exceed MAX_BYTES.
set -u

CONTROL_DIR="${CLAUDE_CONTROL_DIR:-$HOME/.claude-control}"
# Honor the same explicit overrides the units already export; otherwise derive
# everything from CONTROL_DIR (which install.sh fixes at ~/.claude-control on both
# platforms, regardless of --prefix).
SESSIONS_DIR="${CLAUDE_CONTROL_SESSIONS_DIR:-${CLAUDE_RC_LOG_DIR:-$CONTROL_DIR/sessions}}"
WLOG="${CLAUDE_CONTROL_WATCHDOG_LOG:-$CONTROL_DIR/watchdog.log}"
MAX_BYTES="${CLAUDE_CONTROL_LOG_MAX_BYTES:-5242880}"
KEEP_LINES="${CLAUDE_CONTROL_LOG_KEEP_LINES:-2000}"
# Guard the numeric tunables: a non-integer override would crash the size
# arithmetic below under set -u. Fall back to defaults on bad input.
TTL_D="${CLAUDE_CONTROL_LOG_TTL_D:-7}"   # столько дней держим логи мертвых сессий
[[ "$MAX_BYTES"  =~ ^[1-9][0-9]*$ ]] || MAX_BYTES=5242880
[[ "$KEEP_LINES" =~ ^[1-9][0-9]*$ ]] || KEEP_LINES=2000
# Мусорный TTL откатываем к дефолту, а НЕ к нулю: пустое значение в -mtime +0
# снесло бы вообще все логи, включая сегодняшние.
[[ "$TTL_D" =~ ^[0-9]+$ ]] || TTL_D=7

ts() { date '+%Y-%m-%d %H:%M:%S'; }

trim_one() {
  local f="$1" size tmp
  [[ -f "$f" ]] || return 0
  size=$(wc -c < "$f" 2>/dev/null) || return 0
  (( size > MAX_BYTES )) || return 0
  tmp="$f.trim.$$"
  if tail -n "$KEEP_LINES" "$f" > "$tmp" 2>/dev/null; then
    # Preserve the original mtime across the in-place rewrite. Both watchdogs use the
    # debug files' mtime as their heartbeat/liveness clock, so bumping it to "now" on
    # a trim could make a frozen zombie look freshly alive. Snapshot the pre-trim
    # mtime into a marker and restore it with touch -r after the rewrite.
    local stamp="$f.mtime.$$"
    touch -r "$f" "$stamp" 2>/dev/null || true
    cat "$tmp" > "$f"
    [[ -e "$stamp" ]] && touch -r "$stamp" "$f" 2>/dev/null || true
    rm -f "$stamp"
    echo "$(ts) trimmed $f (${size}B -> last ${KEEP_LINES} lines)" >> "$WLOG"
  fi
  rm -f "$tmp"
}

# Fixed control/watchdog logs (file-based on both launchd and systemd). tgbot.*
# после V3 - логи главного компонента, без них обрез покрывал уже не то.
for name in control.log control.err control.debug.log \
            watchdog.log watchdog.out watchdog.err \
            project-watchdog.log tgbot.log tgbot.err; do
  trim_one "$CONTROL_DIR/$name"
done

# Per-project session logs and their --debug-file heartbeat logs, both written by
# claude-rc via the launcher. The *.debug.log glob also matches *.log's sibling.
if [[ -d "$SESSIONS_DIR" ]]; then
  for f in "$SESSIONS_DIR"/*.log; do
    [[ -e "$f" ]] || continue   # no matches: literal glob, skip
    trim_one "$f"
  done
fi

# Обрез держит РАЗМЕР файла, но не их ЧИСЛО: каждая поднятая сессия оставляет
# пару <проект>-<sid8>.log/.debug.log навсегда. Поэтому логи давно погашенных
# сессий удаляем по возрасту - нескольких дней истории достаточно.
sweep_old_sessions() {
  [[ -d "$SESSIONS_DIR" ]] || return 0
  local live f base sid8
  # Префиксы живых сессий: юнит зовется ccsession-<uuid без дефисов>, а лог -
  # <проект>-<первые 8 hex>. Удалить лог живой сессии значит выдернуть файл
  # из-под открытого дескриптора: процесс продолжит писать в отвязанный инод,
  # и весь дальнейший вывод пропадет.
  live=" $(systemctl --user list-units --type=service --state=active \
             --no-legend 'ccsession-*' 2>/dev/null \
           | awk '{print substr($1, 11, 8)}' | tr '\n' ' ')"
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    base="$(basename "$f")"
    sid8="${base##*-}"; sid8="${sid8%%.*}"
    [[ "$live" == *" $sid8 "* ]] && continue
    rm -f "$f" && echo "$(ts) removed $f (старше ${TTL_D} дней)" >> "$WLOG"
  done < <(find "$SESSIONS_DIR" -maxdepth 1 -name '*.log' -mtime "+$TTL_D" 2>/dev/null)
}
sweep_old_sessions
