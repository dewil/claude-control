#!/usr/bin/env python3
"""claude-agent-answer: доверенный писатель ответа на вопрос (V2.3 §4,
аудит blocker 1 - закрывает самозаверение через payload.text; V2.4 §3,
исправление контракта - то же самое для permission-решения через
payload.approve; V2.5 §7.2, аудит blocker - обе фазы ниже под ОДНИМ
удержанием questions/.lock).

usage: claude-agent-answer <agent-dir> --qid <qid>
                            (--text "..." | --approve | --reject) [--by NAME]

Единственный легитимный источник текста ответа/решения. Под ОДНИМ
удержанием questions/.lock (аудит V2.5 blocker - разрыв лока между фазами
давал второму параллельному вызову окно переписать чужое решение):
1. Перечитать файл вопроса, убедиться, что status == open, что режим
   ответа соответствует виду вопроса (--approve/--reject только для
   kind=permission, --text только для kind=info - аудит V2.5 major:
   иначе --approve на info писал бы decision, а стейл-гейт V2.3 закрыл
   бы вопрос без текста, которого ждет агент), записать answer/decision
   + answered_at/answered_by, durable_write.
2. Тем же удержанием лока положить в spool АДРЕСУЮЩЕЕ событие
   {"kind": "answer", "question_id": "<qid>"} - payload несет ИСКЛЮЧИТЕЛЬНО
   question_id, runner текст/решение из него не берет НИКОГДА - и сразу
   пометить event_published_at (deadlock исключен: spool-put берет
   .inbox.lock, не questions/.lock).

Право писать в questions/ и есть доверие (в V2.5 этим писателем стал
tgbot после whitelist-проверки).
"""

import fcntl
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone

QID_RE = re.compile(r"^[0-9a-f-]{36}$")


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def durable_write(path, data):
    d = os.path.dirname(os.path.abspath(path)) or "."
    tmp = os.path.join(d, ".%s.tmp.%d" % (os.path.basename(path), os.getpid()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        mv = memoryview(data.encode() if isinstance(data, str) else data)
        while mv:
            mv = mv[os.write(fd, mv):]
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    fsync_dir(d)


def durable_json(path, doc):
    durable_write(path, json.dumps(doc, ensure_ascii=False) + "\n")


def fail(msg, code=2):
    sys.stderr.write("claude-agent-answer: %s\n" % msg)
    sys.exit(code)


def qid_safe_path(agent_dir, qid):
    """uuid4-подобный qid + containment внутри questions/ этого агента
    (аудит V2.3 major 2 - тот же протокол, что в claude-agent-run)."""
    if not qid or not QID_RE.match(qid):
        return None
    qdir = os.path.realpath(os.path.join(agent_dir, "questions"))
    path = os.path.realpath(os.path.join(qdir, qid + ".json"))
    if path != os.path.join(qdir, qid + ".json"):
        return None
    return path


def main():
    if len(sys.argv) < 2 or sys.argv[1].startswith("-"):
        fail("usage: claude-agent-answer <agent-dir> --qid Q "
             "(--text T | --approve | --reject) [--by NAME]")
    agent_dir = sys.argv[1]
    args = sys.argv[2:]
    qid, text, by, mode = None, None, "operator", None
    while args:
        a = args.pop(0)
        if a == "--qid" and args:
            qid = args.pop(0)
        elif a == "--text" and args:
            text, mode = args.pop(0), "text"
        elif a == "--approve":
            mode = "approve"
        elif a == "--reject":
            mode = "reject"
        elif a == "--by" and args:
            by = args.pop(0)
        else:
            fail("unknown/incomplete arg %r" % a)
    if not qid:
        fail("--qid is required")
    if mode is None:
        fail("нужен ровно один из --text/--approve/--reject")

    if not os.path.isdir(agent_dir):
        fail("agent dir не существует: %s" % agent_dir)
    path = qid_safe_path(agent_dir, qid)
    if not path:
        fail("некорректный qid (ожидается uuid4)")

    qdir = os.path.dirname(path)
    os.makedirs(qdir, mode=0o700, exist_ok=True)
    name = os.path.basename(agent_dir.rstrip("/"))
    bin_dir = os.path.dirname(os.path.abspath(__file__))
    lk = os.open(os.path.join(qdir, ".lock"), os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            d = json.load(open(path))
        except (OSError, ValueError):
            fail("вопрос не найден или поврежден: %s" % qid)
        if not isinstance(d, dict) or d.get("status") != "open":
            fail("вопрос уже закрыт или не существует: %s" % qid)
        qkind = d.get("kind")
        if mode in ("approve", "reject") and qkind != "permission":
            fail("--approve/--reject допустимы только для permission-вопроса "
                 "(этот - %s)" % qkind)
        if mode == "text" and qkind == "permission":
            fail("--text не допустим для permission-вопроса - только "
                 "--approve/--reject")
        if d.get("answered_at") is not None \
                and d.get("event_published_at") is not None:
            # §7.2: status может оставаться open до закрытия прогоном, но
            # ответ на этот вопрос уже дан И доведен до spool - повторный
            # тап/redelivery не должен переписать decision/answer (в т.ч.
            # reject -> approve).
            # Ответ БЕЗ опубликованного события - незавершенная запись
            # (spool-put упал/процесс убит между двумя фазами): такой
            # повтор разрешаем, иначе вопрос навсегда остался бы открытым
            # с ответом, о котором прогон никогда не узнает.
            fail("на вопрос уже отвечено: %s" % qid)
        if mode == "text":
            d["answer"] = text
        else:
            d["decision"] = mode  # "approve" | "reject"
        d["answered_at"] = now_iso()
        d["answered_by"] = by
        durable_json(path, d)

        # адресующее событие И отметка о публикации - ПОД ТЕМ ЖЕ локом
        # (аудит V2.5 blocker): разрыв лока между фазами давал второму
        # параллельному вызову окно прочитать "answered_at без
        # event_published_at" как "еще не отвечено" и переписать чужое
        # решение до того, как первый вызов успевал опубликовать событие.
        # Deadlock исключен: spool-put берет .inbox.lock, не questions/.lock.
        r = subprocess.run(
            [os.path.join(bin_dir, "claude-agent-run"), "spool-put", name,
             "--json", json.dumps({"kind": "answer", "question_id": qid}),
             "--id", "ans:%s" % qid],
            capture_output=True, text=True)
        if r.returncode != 0:
            fail("ответ записан, но адресующее событие не опубликовано: %s"
                 % (r.stderr.strip() or r.returncode))
        d["event_published_at"] = now_iso()
        durable_json(path, d)
    finally:
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)
    print(qid)


if __name__ == "__main__":
    main()
