#!/usr/bin/env python3
"""
Дайджест остатков подписочных лимитов Claude/Codex -> Telegram.

Порт прежнего PHP-сервиса (пробник + Laravel-форматтер) в один stdlib-скрипт:
одна коробка на VM - снял, отрендерил панель, отправил через claude-agent-tgbot
notify. Токены провайдеров не покидают хост и не попадают ни в снапшот, ни в
панель (только проценты и время сброса).

Отправка каждые 15 мин, но ТОЛЬКО при изменении цифр (проценты/статусы/кредиты)
относительно прошлой отправки - время сброса не считается изменением. Снапшот
снимается каждый проход (иначе изменение не поймать), кэш /limits всегда свежий.

Клэмп окон: used_percent недельных/5ч-окон OpenAI приходит с рассинхронизированных
реплик - при одном и том же reset_at значение прыгает вниз (недосчет узла) и
обратно (веб-Codex при этом стабилен). Реальный расход монотонен до сброса,
поэтому держим max usage (min remaining) с последнего reset_at в clamp.json и
показываем его; занижения гасим, max сбрасывается при смене reset_at.

Подкоманды:
  claude-agent-limits-digest once [--dry-run] [--force]
                                               снять снапшот, закэшировать,
                                               отправить если цифры изменились
                                               (dry-run: печать; force: слать
                                               даже без изменений)
  claude-agent-limits-digest render            панель из последнего кэша
                                               (для /limits в tgbot)
  claude-agent-limits-digest selftest          offline-тесты форматтера

env (~/.config/claude-control/env; все со здравыми дефолтами):
  CLAUDE_AGENT_LIMITS_TZ         display-TZ панели (деф. Europe/Moscow)
  CLAUDE_AGENT_LIMITS_ENABLED    "0"/"false" = не слать (снапшот и кэш работают)
  CLAUDE_AGENT_LIMITS_STALE_MIN  порог "данные устарели" для render (деф. 45)
  LIMITS_PROBE_PROXY             прокси провайдерских вызовов (деф.
                                 http://127.0.0.1:7890 - гео-блок RU-IP)
  LIMITS_PROBE_CLAUDE_CREDS      деф. ~/.claude/.credentials.json (на корне)
  LIMITS_PROBE_CODEX_AUTH        деф. /data/.codex/auth.json (LUKS-том)
  LIMITS_PROBE_DATA_MOUNT        точка монтирования codex-тома (деф. /data;
                                 пусто = не проверять); заперт -> status locked
  LIMITS_PROBE_CLAUDE_UA         User-Agent для Claude (деф. из `claude --version`)
  CLAUDE_CONTROL_DIR             кэш снапшота: <dir>/limits/last.json,
                                 стейт клэмпа: <dir>/limits/clamp.json

Протухший Claude-токен (401) чинится сам: дешевый прогон CLI (haiku) рефрешит
credentials, запрос повторяется один раз; stale остается только если рефреш
не помог (нужен relogin).

Graceful: проблемы токенов/тома не роняют exit (секция помечается статусом).
Ненулевой exit только при недоставке в Telegram или сломанном selftest.
"""
from __future__ import annotations

import json
import math
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

try:
    from zoneinfo import ZoneInfo
except ImportError:  # py<3.9 не поддерживаем, но не падаем на импорте
    ZoneInfo = None

BIN_DIR = os.path.dirname(os.path.realpath(__file__))
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
TIMEOUT = 20

PROXY = os.environ.get("LIMITS_PROBE_PROXY", "http://127.0.0.1:7890")
CLAUDE_CREDS = os.environ.get(
    "LIMITS_PROBE_CLAUDE_CREDS",
    os.path.expanduser("~/.claude/.credentials.json"))
CODEX_AUTH = os.environ.get("LIMITS_PROBE_CODEX_AUTH", "/data/.codex/auth.json")
DATA_MOUNT = os.environ.get("LIMITS_PROBE_DATA_MOUNT", "/data")
CONTROL_DIR = os.environ.get(
    "CLAUDE_CONTROL_DIR", os.path.expanduser("~/.claude-control"))
CACHE_FILE = os.path.join(CONTROL_DIR, "limits", "last.json")
SENT_SIG_FILE = os.path.join(CONTROL_DIR, "limits", "last-sent.sig")
CLAMP_FILE = os.path.join(CONTROL_DIR, "limits", "clamp.json")

# Здоровье хоста. Мгновенные значения - локально (/proc и локальный экспортер),
# тренды - из VictoriaMetrics на хосте метрик через ssh. Так секция работает и когда хост метрик
# недоступен: пропадают только тренды.
PROC_EXPORTER = os.environ.get("LIMITS_PROBE_PROC_EXPORTER", "127.0.0.1:9256")
METRICS_SSH = os.environ.get("LIMITS_PROBE_METRICS_SSH", "metrics-host")
METRICS_ADDR = os.environ.get("LIMITS_PROBE_METRICS_ADDR", "127.0.0.1:8428")
HOST_LOW_MB = 700        # порог тесноты по available
HOST_PSI_PCT = 1.0       # порог тесноты по PSI памяти (full avg60)
HOST_PREDICT_H = 4.0     # прогноз исчерпания показываем только ближе этого
HOST_STEAL_PCT = 5.0     # steal выше - тормозит гипервизор, а не мы
HOST_DISK_LOW_PCT = 10.0


def log(msg):
    sys.stderr.write("limits-digest: %s\n" % msg)


def iso_now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def get_in(data, *keys):
    for key in keys:
        if not isinstance(data, dict):
            return None
        data = data.get(key)
    return data


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


# ------------------------------------------------------------------ probe
# Порт прежнего python-пробника (минус POST на приемник).

def normalize_reset(value):
    # Claude отдает resets_at строкой ISO; Codex reset_at - epoch-секундами.
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%SZ")
    if isinstance(value, str) and value:
        return value
    return None


def http_get(url, headers, proxy):
    handler = urllib.request.ProxyHandler(
        {"http": proxy, "https": proxy} if proxy else {})
    opener = urllib.request.build_opener(handler)
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with opener.open(req, timeout=TIMEOUT) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except Exception as exc:  # сеть/прокси/таймаут
        log("GET %s failed: %s" % (url, type(exc).__name__))
        return 0, None


def window_entry(window):
    util = window.get("utilization") if isinstance(window, dict) else None
    if not isinstance(util, (int, float)):
        return None
    entry = {"remaining": round(100 - util)}
    reset = normalize_reset(window.get("resets_at"))
    if reset:
        entry["resets_at"] = reset
    return entry


def claude_ua():
    ua = os.environ.get("LIMITS_PROBE_CLAUDE_UA")
    if ua:
        return ua
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True,
                             text=True, timeout=10)
        match = re.search(r"(\d+\.\d+\.\d+)", out.stdout or "")
        if match:
            return "claude-code/%s" % match.group(1)
    except Exception:
        pass
    return "claude-code/2.1.0"


def refresh_claude_cli():
    """Обновить протухший OAuth-токен штатным путем: любой API-вызов CLI
    рефрешит ~/.claude/.credentials.json сам (ротация refresh_token остается
    на CLI, самодельный OAuth-рефреш не делаем). Цена - один haiku-промпт."""
    try:
        r = subprocess.run(
            ["claude", "-p", "ok", "--model", "claude-haiku-4-5-20251001"],
            capture_output=True, text=True, timeout=90)
    except Exception as exc:
        log("CLI-рефреш токена не запустился: %s" % type(exc).__name__)
        return False
    if r.returncode != 0:
        log("CLI-рефреш токена: exit %s" % r.returncode)
        return False
    return True


def build_claude():
    creds = read_json(CLAUDE_CREDS)
    token = get_in(creds, "claudeAiOauth", "accessToken")
    if not token:
        return {"status": "stale", "detail": "no credentials"}

    headers = {
        "Authorization": "Bearer %s" % token,
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": claude_ua(),
        "Content-Type": "application/json",
    }
    status, body = http_get(CLAUDE_USAGE_URL, headers, PROXY)
    if status == 401 and refresh_claude_cli():
        creds = read_json(CLAUDE_CREDS)
        token = get_in(creds, "claudeAiOauth", "accessToken") or token
        headers["Authorization"] = "Bearer %s" % token
        status, body = http_get(CLAUDE_USAGE_URL, headers, PROXY)
    if status == 401:
        return {"status": "stale", "detail": "token expired"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "error", "detail": "http %s" % status}

    section = {"status": "ok"}
    plan = get_in(creds, "claudeAiOauth", "subscriptionType")
    if isinstance(plan, str) and plan:
        section["plan"] = plan.capitalize()
    for key in ("five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet"):
        entry = window_entry(body.get(key))
        if entry:
            section[key] = entry

    # Пер-модельные недельные окна (Fable и будущие) приходят уже не
    # отдельными seven_day_* полями (те null), а в limits[]: kind
    # weekly_scoped + scope.model.display_name.
    scoped = []
    for lim in body.get("limits") or []:
        if not isinstance(lim, dict) or lim.get("kind") != "weekly_scoped":
            continue
        name = get_in(lim, "scope", "model", "display_name")
        pct = lim.get("percent")
        if not name or not isinstance(pct, (int, float)):
            continue
        entry = {"label": str(name).lower(), "remaining": round(100 - pct)}
        reset = normalize_reset(lim.get("resets_at"))
        if reset:
            entry["resets_at"] = reset
        scoped.append(entry)
    if scoped:
        section["scoped"] = scoped
    return section


def build_codex():
    if DATA_MOUNT and not os.path.ismount(DATA_MOUNT):
        return {"status": "locked", "detail": "%s not mounted" % DATA_MOUNT}

    auth = read_json(CODEX_AUTH)
    token = get_in(auth, "tokens", "access_token")
    if not token:
        return {"status": "stale", "detail": "no codex auth"}

    headers = {"Authorization": "Bearer %s" % token}
    account = get_in(auth, "tokens", "account_id")
    if account:
        headers["chatgpt-account-id"] = account

    status, body = http_get(CODEX_USAGE_URL, headers, PROXY)
    if status == 401:
        return {"status": "stale", "detail": "token expired"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "error", "detail": "http %s" % status}

    section = {"status": "ok"}
    plan = body.get("plan_type")
    if isinstance(plan, str) and plan:
        section["plan"] = plan.capitalize()

    # Окна Codex бывают разной длительности (у Plus primary - недельное,
    # 604800с). Бакетируем по limit_window_seconds: <1 сут -> five_hour,
    # иначе seven_day. Обходим оба окна, если присутствуют.
    rate_limit = body.get("rate_limit") or {}
    for wkey in ("primary_window", "secondary_window"):
        w = rate_limit.get(wkey)
        if not isinstance(w, dict) or not isinstance(
                w.get("used_percent"), (int, float)):
            continue
        entry = {"remaining": round(100 - w["used_percent"])}
        reset = normalize_reset(w.get("reset_at"))
        if reset:
            entry["resets_at"] = reset
        secs = w.get("limit_window_seconds")
        bucket = ("five_hour"
                  if isinstance(secs, (int, float)) and secs < 86400
                  else "seven_day")
        section.setdefault(bucket, entry)

    # Кредиты - только у кредитной модели (has_credits); balance бывает строкой.
    credits_obj = body.get("credits") or {}
    if isinstance(credits_obj, dict) and credits_obj.get("has_credits"):
        try:
            section["credits"] = int(float(credits_obj.get("balance")))
        except (TypeError, ValueError):
            pass
    return section


# --------------------------------------------------------------- host health
# Секция едет ПРИЦЕПОМ: добавляется к сообщению, которое и так уходит по смене
# лимитов, и НЕ участвует в digits_signature. Иначе бот слал бы дайджест каждый
# прогон (память меняется всегда) и его перестали бы читать.

def _mem_available_mb(meminfo):
    """MemAvailable в МБ из текста /proc/meminfo. free не годится: ядро отдает
    свободную память под дисковый кеш и он всегда мал."""
    m = re.search(r"^MemAvailable:\s+(\d+) kB", meminfo, re.M)
    return int(m.group(1)) // 1024 if m else None


def _psi_pct(pressure):
    """Давление по памяти: full avg60 в процентах из /proc/pressure/memory.
    full = все процессы стояли одновременно, самый честный признак нехватки."""
    m = re.search(r"^full .*avg60=([\d.]+)", pressure, re.M)
    return float(m.group(1)) if m else None


def _zram_ratio(mm_stat):
    """Во сколько раз zram ужимает: orig_data_size / mem_used_total.
    Ниже ~2.5 - жмется плохо, своп перестает спасать.

    Поля mm_stat: orig_data_size, compr_data_size, mem_used_total, mem_limit,
    mem_used_max, ... Берем ТРЕТЬЕ (текущее), а не пятое: пятое - исторический
    пик, он не убывает, и предупреждение горело бы вечно после одного всплеска."""
    parts = mm_stat.split()
    if len(parts) < 3:
        return None
    try:
        orig, used = float(parts[0]), float(parts[2])
    except ValueError:  # мусор вместо чисел - показателя просто нет
        return None
    return round(orig / used, 1) if used > 0 else None


def _read_capped(resp, limit=2 * 1024 * 1024, deadline_s=8):
    """Чтение с потолком по объему И по времени. urlopen(timeout=) ограничивает
    только отдельную socket-операцию: экспортер, шлющий по байту раз в секунду,
    держал бы read() бесконечно - и весь дайджест вместе с ним."""
    deadline = time.monotonic() + deadline_s
    chunks, total = [], 0
    while total < limit and time.monotonic() < deadline:
        chunk = resp.read(65536)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    return b"".join(chunks)


def _local_groups():
    try:
        with urllib.request.urlopen("http://%s/metrics" % PROC_EXPORTER,
                                    timeout=5) as resp:
            body = _read_capped(resp).decode("utf-8", "replace")
    except Exception:  # noqa: BLE001 - экспортер лежит, секция просто короче
        return {}
    groups = {}
    for line in body.splitlines():
        if not line.startswith("namedprocess_namegroup_"):
            continue
        if 'memtype="resident"' in line:
            kind = "rss"
        elif line.startswith("namedprocess_namegroup_num_procs"):
            kind = "n"
        elif line.startswith("namedprocess_namegroup_oldest_start_time_seconds"):
            kind = "oldest"
        else:
            continue
        m = re.search(r'groupname="([^"]+)".*?\s([\d.e+-]+)$', line)
        if not m:
            continue
        try:
            groups.setdefault(m.group(1), {})[kind] = float(m.group(2))
        except ValueError:  # обрезанное число в выдаче - пропускаем строку
            continue
    return groups


# Все выражения ЯВНО сужены на llm: в хранилище может появиться второй хост
# (например, хост метрик), и незауженный запрос молча смешал бы чужие цифры со своими.
_HOST_SEL = 'host="llm"'
_VM_EXPRS = {
    # Считаем ЖИВЫЕ цели, а не мертвые: исчезнувшая серия дает пустой ответ,
    # и "== 0" такого отказа не увидит - сторож молчал бы ровно тогда, когда нужен.
    # Окно 10 минут, а не мгновенное значение: одиночный промах скрейпа (или
    # штатный перезапуск туннеля) иначе поднимал бы ложную тревогу - проверено
    # живой остановкой туннеля, после старта цель числилась мертвой еще полминуты.
    "healthy": 'count(max_over_time(up{job=~"llm-.*"}[10m]) == 1)',
    "avail_delta_mb": '(node_memory_MemAvailable_bytes{%s} - '
                      'node_memory_MemAvailable_bytes{%s} offset 1h) '
                      '/ 1024 / 1024' % (_HOST_SEL, _HOST_SEL),
    "steal_pct": 'avg(rate(node_cpu_seconds_total{%s,mode="steal"}[15m])) * 100'
                 % _HOST_SEL,
    "growth": 'topk(1, namedprocess_namegroup_memory_bytes'
              '{%s,memtype="resident"} - namedprocess_namegroup_memory_bytes'
              '{%s,memtype="resident"} offset 1h)' % (_HOST_SEL, _HOST_SEL),
}
VM_TARGETS = 2  # llm-node и llm-process


def _vm_parse(stdout):
    """Ответы размечены префиксом ключа: пустой ответ одного запроса иначе
    сдвинул бы все остальные на одну позицию, и рост процесса приехал бы в
    steal_pct."""
    out = {}
    for line in stdout.splitlines():
        key, _, payload = line.partition("\t")
        if key not in _VM_EXPRS or not payload:
            continue
        try:
            result = json.loads(payload)["data"]["result"]
            if not result:
                continue
            value = float(result[0]["value"][1])
            if not math.isfinite(value):
                continue
            if key == "growth":
                out[key] = (str(result[0]["metric"].get("groupname", "?")), value)
            else:
                out[key] = value
        except Exception:  # noqa: BLE001 - кривой ответ по одному ключу
            continue
    return out


def _vm_query_all():
    """Один ssh на все тренды сразу: отдельные заходы стоили бы дороже самого
    дайджеста. Сеть/ключ отвалились - возвращаем None, секция обходится
    локальными цифрами."""
    url = "http://%s/api/v1/query" % METRICS_ADDR
    script = "; ".join(
        "printf %s; curl -sf --max-time 5 --get --data-urlencode %s %s; echo"
        % (shlex.quote(key + "\t"), shlex.quote("query=" + expr),
           shlex.quote(url))  # адрес тоже из окружения - экранируем
        for key, expr in _VM_EXPRS.items())
    try:
        r = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
             METRICS_SSH, script],
            capture_output=True, text=True, timeout=25)
    except Exception:  # noqa: BLE001
        return None
    if r.returncode != 0:
        return None
    return _vm_parse(r.stdout)


def build_host():
    def read(path):
        try:
            with open(path, encoding="utf-8") as fh:
                return fh.read()
        except OSError:
            return ""

    section = {"status": "ok"}
    avail = _mem_available_mb(read("/proc/meminfo"))
    if avail is None:
        return {"status": "error", "detail": "no meminfo"}
    section["available_mb"] = avail
    psi = _psi_pct(read("/proc/pressure/memory"))
    if psi is not None:
        section["psi_pct"] = psi
    ratio = _zram_ratio(read("/sys/block/zram0/mm_stat"))
    if ratio is not None:
        section["zram_ratio"] = ratio

    groups = _local_groups()
    claude = groups.get("claude") or {}
    if claude.get("n"):
        section["claude"] = {
            "n": int(claude["n"]),
            "rss_mb": int(claude.get("rss", 0) / 1048576),
        }
        oldest = claude.get("oldest")
        if oldest:
            age_h = (datetime.now(timezone.utc).timestamp() - oldest) / 3600
            if age_h > 0:
                section["claude"]["oldest_h"] = round(age_h, 1)

    disks = {}
    for path in ("/", DATA_MOUNT):
        try:
            st = os.statvfs(path)
        except OSError:
            continue
        if st.f_blocks:
            disks[path] = round(100.0 * st.f_bavail / st.f_blocks, 1)
    if disks:
        section["disk_free_pct"] = disks

    # Тренды - отдельным try: сломанный ответ хранилища не должен уносить с
    # собой локальные показатели, ради которых секция и нужна.
    try:
        _apply_trends(section, avail)
    except Exception:  # noqa: BLE001
        section["metrics"] = "unreachable"
    return section


def _apply_trends(section, avail):
    trends = _vm_query_all()
    if trends is None:
        section["metrics"] = "unreachable"
        return
    healthy = trends.get("healthy")
    # Пустой ответ = серий нет вообще (сбор мертв), а не "все живы".
    section["metrics"] = "ok" if healthy is not None and healthy >= VM_TARGETS \
        else "down"
    delta = trends.get("avail_delta_mb")
    if delta is not None:
        section["avail_delta_mb"] = int(delta)
        # Линейная экстраполяция последнего часа: сколько осталось до нуля.
        if delta < -50:
            section["predict_h"] = round(avail / -delta, 1)
    growth = trends.get("growth")
    if growth and growth[1] > 100 * 1048576:
        section["growth"] = {"group": growth[0],
                             "mb": int(growth[1] / 1048576)}
    steal = trends.get("steal_pct")
    if steal is not None:
        section["steal_pct"] = round(steal, 1)


def safe(fn):
    try:
        return fn()
    except Exception as exc:
        return {"status": "error", "detail": type(exc).__name__}


# -------------------------------------------------------------- formatter
# Порт прежнего PHP-форматтера (Laravel), рендер 1:1.

BAR_WIDTH = 10
# Разрыв "расход минус часы" в процентных пунктах, с которого зажигается 🔺.
# 20 выбраны под пятичасовое окно: работа рваная, плотный час легко дает
# +10пп к часам и сам себя выправляет, когда отходишь - меньший порог
# заставил бы метку гореть почти всегда и читаться перестала бы.
PACE_ALERT_PP = 20
PACE_MARK = "🔺"
# Длина окна по типу сброса. В данных провайдера ее нет (приходит только
# момент сброса), поэтому константы. Окна фиксированные, НЕ скользящие -
# проверено 2026-07-30 двумя снимками подряд: resets_at пятичасового окна
# за 8 минут не сдвинулся (17:20:00.410 -> 17:20:00.811, разница только в
# микросекундах, которые Anthropic считает на своей стороне).
WINDOW_SECONDS = {"time": 5 * 3600, "week": 7 * 86400}
WEEKDAYS = ["Вс", "Пн", "Вт", "Ср", "Чт", "Пт", "Сб"]  # индекс = Carbon dayOfWeek
STATUS_TEXT = {
    "stale": "токен протух, авторефреш не помог - нужен relogin",
    "locked": "том /data заперт, codex недоступен",
    "error": "ошибка снятия лимитов",
}


def php_round(x):
    # PHP round() - half away from zero; питоний round() - half to even.
    return int(math.floor(x + 0.5)) if x >= 0 else -int(math.floor(-x + 0.5))


def parse_iso(iso):
    if not isinstance(iso, str) or not iso:
        return None
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def display_tz():
    name = os.environ.get("CLAUDE_AGENT_LIMITS_TZ", "Europe/Moscow")
    if ZoneInfo is not None:
        try:
            return ZoneInfo(name)
        except Exception:
            log("неизвестная TZ %r, использую UTC" % name)
    return timezone.utc


def _bar(percent, elapsed=None):
    """Градусник расхода с меткой часов.

    percent - израсходовано квоты (заливка), elapsed - пройдено времени окна
    (положение метки). elapsed=None - метки нет, вид прежний.

    Клетка выбирается так:
      [0, min(fill, clock))  ▓  - расход в графике;
      [clock, fill)          █  - перебор, расход обогнал часы;
      clock, если clock>=fill ┃ - метка часов (есть запас);
      остальное              ░.

    Метка НЕ ставится, когда заливка ее перевалила: она занимает клетку, а
    не границу между клетками, и в случае перебора стерла бы ровно тот
    хвост, ради которого затевалась (заливка 3 клетки, часы на 2-й читались
    бы как "2 и 2, идем в ногу"). Поэтому перебор показывает █, а не метку.
    Ровно "в ногу" (fill == clock) отдельного правила не требует - метка
    сама встает вплотную к краю заливки.
    """
    fill = php_round(max(0, min(100, percent)) / (100 / BAR_WIDTH))
    if elapsed is None:
        return "▓" * fill + "░" * (BAR_WIDTH - fill)
    # int() вниз: метка показывает НАЧАЛО текущей десятины окна, поэтому
    # часы на 100% должны попасть в последнюю клетку, а не за градусник.
    clock = min(int(max(0, min(100, elapsed)) // (100 / BAR_WIDTH)),
                BAR_WIDTH - 1)
    cells = []
    for i in range(BAR_WIDTH):
        if i < min(fill, clock):
            cells.append("▓")
        elif i < fill:
            cells.append("█")
        elif i == clock:
            cells.append("┃")
        else:
            cells.append("░")
    return "".join(cells)


def _elapsed_percent(iso, kind, now):
    """Процент ПРОШЕДШЕГО времени окна: (длина - остаток) / длина.

    Именно пройденного, а не оставшегося: заливка градусника меряет
    израсходованное, и обе величины обязаны идти в одну сторону - тогда
    "идем в ногу" читается как "заливка дошла до метки". На остатке правило
    стало бы "сумма равна 100%", а это глазом не берется.

    None - когда момент сброса неизвестен или тип окна незнаком; вызывающий
    трактует это как "метки нет", а не как ноль.
    """
    total = WINDOW_SECONDS.get(kind)
    dt = parse_iso(iso)
    if total is None or dt is None:
        return None
    left = (dt - now).total_seconds()
    return max(0, min(100, (total - left) / total * 100))


def _pace_mark(used, elapsed):
    """Хвост строки: 🔺, если расход обогнал часы на PACE_ALERT_PP и больше.
    В норме молчит - метка, которая горит всегда, не читается."""
    if elapsed is None:
        return ""
    return " " + PACE_MARK if used - elapsed >= PACE_ALERT_PP else ""


def _format_reset(iso, kind, tz):
    dt = parse_iso(iso)
    if dt is None:
        return None
    dt = dt.astimezone(tz)
    if kind == "week":
        return WEEKDAYS[(dt.weekday() + 1) % 7]  # Carbon: 0=Вс..6=Сб
    return dt.strftime("%H:%M")


def _fmt_countdown(iso, now):
    """Остаток до сброса компактно: <1ч -> Nm, <1сут -> Nh, иначе Nd. Один
    десятичный знак, .0 отбрасываем (30m, 1.5h, 2.6d)."""
    dt = parse_iso(iso)
    if dt is None:
        return None
    secs = max(0, int((dt - now).total_seconds()))
    if secs < 3600:
        val, unit = secs / 60, "m"
    elif secs < 86400:
        val, unit = secs / 3600, "h"
    else:
        val, unit = secs / 86400, "d"
    return ("%.1f" % val).rstrip("0").rstrip(".") + unit


def _window_line(label, window, reset_kind, tz, now):
    if not isinstance(window, dict) or not isinstance(
            window.get("remaining"), (int, float)):
        return None
    # Показываем ИСПОЛЬЗОВАНО, а не остаток (счетчик растет по мере расхода).
    remaining = php_round(float(window["remaining"]))
    used = max(0, min(100, 100 - remaining))
    elapsed = _elapsed_percent(window.get("resets_at"), reset_kind, now)
    line = " " + label.ljust(5) + " " + _bar(used, elapsed) + "  %d%%" % used
    reset = _format_reset(window.get("resets_at"), reset_kind, tz)
    if reset:
        line += " / " + reset
        left = _fmt_countdown(window.get("resets_at"), now)
        if left:
            line += " (%s)" % left
    return line + _pace_mark(used, elapsed)


def _section(name, data, tz, now):
    if not isinstance(data, dict):
        return None
    plan = data.get("plan")
    header = name + (" · %s" % plan if isinstance(plan, str) and plan else "")
    status = data.get("status", "ok")
    body = []
    if status != "ok":
        body.append(" " + STATUS_TEXT.get(status, "нет данных секции"))
    elif name == "Claude":
        body.append(_window_line("5ч", data.get("five_hour"), "time", tz, now))
        body.append(_window_line("нед", data.get("seven_day"), "week", tz, now))
        body.append(_window_line("opus", data.get("seven_day_opus"), "week", tz, now))
        body.append(_window_line("sonnet", data.get("seven_day_sonnet"), "week", tz, now))
        for w in data.get("scoped") or []:
            label = w.get("label") if isinstance(w, dict) else None
            if not label or "seven_day_%s" % label in data:
                continue  # уже показано legacy-полем
            body.append(_window_line(label, w, "week", tz, now))
    else:
        body.append(_window_line("5ч", data.get("five_hour"), "time", tz, now))
        body.append(_window_line("нед", data.get("seven_day"), "week", tz, now))
        credits = data.get("credits")
        if isinstance(credits, (int, float)):
            body.append(" " + "кред".ljust(5) + "%s" % credits)
    body = [line for line in body if line is not None]
    if not body:
        body = [" нет данных"]
    return header + "\n" + "\n".join(body)


def _host_section(data):
    """Секция здоровья llm. В норме три строки; предупреждения появляются
    только по порогам - иначе секцию перестанут читать."""
    if not isinstance(data, dict):
        return None
    if data.get("status") != "ok":
        return "Хост llm\n не снят"

    body = []
    mem = " память %d МБ" % data["available_mb"]
    delta = data.get("avail_delta_mb")
    if isinstance(delta, int):
        mem += " (%+d/ч)" % delta
    predict = data.get("predict_h")
    if isinstance(predict, (int, float)) and predict <= HOST_PREDICT_H:
        mem += ", кончится через ~%.1f ч" % predict
    body.append(mem)

    claude = data.get("claude")
    if isinstance(claude, dict):
        line = " claude %d проц · %d МБ" % (claude["n"], claude["rss_mb"])
        if claude.get("oldest_h"):
            line += " · старейшая %.1f ч" % claude["oldest_h"]
        body.append(line)

    growth = data.get("growth")
    if isinstance(growth, dict):
        body.append(" растет %s +%d МБ/ч" % (growth["group"], growth["mb"]))

    # Тревога - когда available И PSI одновременно за порогом: по отдельности
    # каждый дает ложные срабатывания (разбор в llm-oom-runbook). Если PSI
    # снять не удалось - тревожим по одной памяти: молчать в этот момент хуже,
    # чем показать лишнее.
    psi = data.get("psi_pct")
    if data["available_mb"] < HOST_LOW_MB:
        if psi is None:
            body.append(" ⚠️ тесно: %d МБ свободно (PSI не снят)"
                        % data["available_mb"])
        elif isinstance(psi, (int, float)) and psi > HOST_PSI_PCT:
            body.append(" ⚠️ тесно: %d МБ свободно, PSI %.1f%%"
                        % (data["available_mb"], psi))
    ratio = data.get("zram_ratio")
    if isinstance(ratio, (int, float)) and ratio < 2.5:
        body.append(" ⚠️ zram жмет ×%.1f - своп почти не спасает" % ratio)
    steal = data.get("steal_pct")
    if isinstance(steal, (int, float)) and steal > HOST_STEAL_PCT:
        body.append(" ⚠️ steal %.1f%% - тормозит гипервизор, не мы" % steal)
    for path, free in sorted((data.get("disk_free_pct") or {}).items()):
        if free < HOST_DISK_LOW_PCT:
            body.append(" ⚠️ %s: свободно %.1f%%" % (path, free))
    if data.get("metrics") == "down":
        body.append(" ⚠️ метрики не собираются - проверить metrics-tunnel")
    elif data.get("metrics") == "unreachable":
        body.append(" ⚠️ хост метрик недоступен, тренды не сняты")
    return "Хост llm\n" + "\n".join(body)


def _stale_line(received_at, now=None):
    received = parse_iso(received_at)
    if received is None:
        return None
    now = now or datetime.now(timezone.utc)
    age_min = max(0, int((now - received).total_seconds())) // 60
    threshold = int(os.environ.get("CLAUDE_AGENT_LIMITS_STALE_MIN", "45"))
    return "⚠️ данные устарели: %d мин назад" % age_min \
        if age_min > threshold else None


def _cards_count_path():
    # env читается на каждый вызов (не module-level константа) - тот же
    # прием, что _sent_map_path/_cards_count_path в claude-agent-tgbot,
    # писателе этого файла; заодно дает тестам изолироваться без реального
    # ~/.claude-control на машине.
    return os.environ.get(
        "CLAUDE_AGENT_TG_CARDS_COUNT",
        os.path.expanduser("~/.claude-control/tgbot.cards.json"))


def _cards_today_line(now=None):
    """Р11 (план §12): сколько карточек-решений реально ушло dwl сегодня -
    ориентир 5-10/день. Файла нет (tgbot ни разу не слал карточку, свежая
    установка) - строки нет вовсе, тот же принцип, что у секции хоста при
    отсутствии данных. Файл есть, но день не совпал (счетчик еще не
    перевалил на сегодня, или лежит вчерашний хвост) - показываем 0."""
    now = now if now is not None else time.time()
    day = time.strftime("%Y-%m-%d", time.gmtime(now))
    try:
        with open(_cards_count_path()) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict):
        return None
    count = d.get("count", 0) if d.get("day") == day else 0
    return "Карточек сегодня: %d" % count


_SIG_WINDOWS = ("five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet")


def digits_signature(snapshot):
    """Сигнатура ЦИФР для дедупа отправки: статусы + отображаемые проценты
    (used, то же php_round что в панели) + кредиты. НЕ включает время сброса
    (resets_at) и captured_at - меняются каждую минуту, но это не "новые цифры".
    Одинаковая сигнатура двух проходов -> не шлем (dwl: слать при изменении
    процентов, не времени)."""
    if not isinstance(snapshot, dict):
        return ""
    parts = []
    for name in ("claude", "codex"):
        d = snapshot.get(name)
        if not isinstance(d, dict):
            parts.append(name + ":none")
            continue
        status = d.get("status", "ok")
        seg = [name, status, str(d.get("plan") or "")]
        if status == "ok":
            for key in _SIG_WINDOWS:
                w = d.get(key)
                if isinstance(w, dict) and isinstance(w.get("remaining"), (int, float)):
                    used = max(0, min(100, 100 - php_round(float(w["remaining"]))))
                    seg.append("%s=%d" % (key, used))
            for w in d.get("scoped") or []:
                if isinstance(w, dict) and isinstance(
                        w.get("remaining"), (int, float)):
                    used = max(0, min(100, 100 - php_round(float(w["remaining"]))))
                    seg.append("%s=%d" % (w.get("label") or "?", used))
            cr = d.get("credits")
            if isinstance(cr, (int, float)):
                seg.append("credits=%d" % int(cr))
        parts.append("|".join(seg))
    return ";".join(parts)


def render(envelope, now=None):
    tz = display_tz()
    if not isinstance(envelope, dict) or not isinstance(
            envelope.get("snapshot"), dict):
        return "🤖 Лимиты LLM\n\nНет данных - пробник еще не присылал снапшот."

    now_eff = now or datetime.now(timezone.utc)
    snapshot = envelope["snapshot"]
    header_dt = parse_iso(snapshot.get("captured_at")
                          or envelope.get("received_at"))
    header_time = (header_dt or now_eff).astimezone(tz).strftime("%H:%M")

    lines = ["🤖 Лимиты LLM · %s" % header_time]
    stale = _stale_line(envelope.get("received_at"), now=now_eff)
    if stale:
        lines.append(stale)
    for name in ("Claude", "Codex"):
        section = _section(name, snapshot.get(name.lower()), tz, now_eff)
        if section:
            lines.append("")
            lines.append(section)
    host = _host_section(snapshot.get("host"))
    if host:
        lines.append("")
        lines.append(host)
    cards = _cards_today_line(now_eff.timestamp())
    if cards:
        lines.append("")
        lines.append(cards)
    return "\n".join(lines)


# ------------------------------------------------------------------ cache

def cache_write(envelope):
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(envelope, fh, ensure_ascii=False)
        os.replace(tmp, CACHE_FILE)
    except OSError as exc:
        log("кэш не записан: %s" % exc)  # не фатально - панель уже собрана


# ------------------------------------------------------------------ clamp
# used_percent окон OpenAI приходит с рассинхронизированных реплик и прыгает
# вниз при неизменном reset_at. Реальный расход монотонен до сброса - держим
# min remaining (= max usage) с последнего reset_at, занижения игнорируем.

def _clamp_windows(snapshot):
    """(key, window) для каждого клэмпуемого окна снапшота (только status ok)."""
    for prov in ("claude", "codex"):
        sec = snapshot.get(prov)
        if not isinstance(sec, dict) or sec.get("status", "ok") != "ok":
            continue
        for wkey in ("five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet"):
            w = sec.get(wkey)
            if isinstance(w, dict) and isinstance(w.get("remaining"), (int, float)):
                yield "%s:%s" % (prov, wkey), w
        for w in sec.get("scoped") or []:
            if isinstance(w, dict) and isinstance(w.get("remaining"), (int, float)):
                yield "%s:scoped:%s" % (prov, w.get("label") or "?"), w


def clamp_snapshot(snapshot, state):
    """Держим max usage (min remaining) каждого окна с последнего reset_at.
    Мутирует snapshot (гасит спурьезные занижения) и state (бегущий минимум) на
    месте. Окно без resets_at не клэмпим - сброс не детектируется."""
    if not isinstance(snapshot, dict) or not isinstance(state, dict):
        return
    for key, w in _clamp_windows(snapshot):
        reset = w.get("resets_at")
        if not reset:
            continue
        cur = w["remaining"]
        prev = state.get(key)
        if (isinstance(prev, dict) and prev.get("resets_at") == reset
                and isinstance(prev.get("remaining"), (int, float))):
            cur = min(prev["remaining"], cur)  # min remaining = max usage
            w["remaining"] = cur
        state[key] = {"resets_at": reset, "remaining": cur}


def apply_clamp(snapshot):
    """IO-обертка над clamp_snapshot: загрузить стейт, применить, сохранить.
    Проблемы стейта не роняют проход - в худшем случае показываем сырое."""
    state = read_json(CLAMP_FILE)
    if not isinstance(state, dict):
        state = {}
    try:
        clamp_snapshot(snapshot, state)
    except Exception as exc:  # noqa: BLE001
        log("клэмп пропущен: %s" % type(exc).__name__)
        return
    try:
        os.makedirs(os.path.dirname(CLAMP_FILE), exist_ok=True)
        tmp = CLAMP_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, ensure_ascii=False)
        os.replace(tmp, CLAMP_FILE)
    except OSError as exc:
        log("стейт клэмпа не записан: %s" % exc)


# ------------------------------------------------------------------ modes

def _read_sent_sig():
    try:
        with open(SENT_SIG_FILE, "r", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return None


def _write_sent_sig(sig):
    try:
        os.makedirs(os.path.dirname(SENT_SIG_FILE), exist_ok=True)
        tmp = SENT_SIG_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(sig)
        os.replace(tmp, SENT_SIG_FILE)
    except OSError as exc:
        log("сигнатура отправки не записана: %s" % exc)


def mode_once(argv):
    dry_run = "--dry-run" in argv
    force = "--force" in argv  # слать даже без изменений (ручной прогон)
    snapshot = {
        "captured_at": iso_now(),
        "claude": safe(build_claude),
        "codex": safe(build_codex),
        "host": safe(build_host),  # прицепом, вне digits_signature
    }
    apply_clamp(snapshot)  # гасим спурьезные занижения реплик OpenAI (min remaining)
    envelope = {"received_at": iso_now(), "snapshot": snapshot}
    cache_write(envelope)  # всегда - /limits показывает текущее
    panel = render(envelope)
    if dry_run:
        print(panel)
        return 0
    if os.environ.get("CLAUDE_AGENT_LIMITS_ENABLED", "1").lower() \
            in ("0", "false", "no"):
        log("отправка выключена (CLAUDE_AGENT_LIMITS_ENABLED)")
        return 0
    # дедуп: слать только при изменении ЦИФР относительно прошлой ОТПРАВКИ
    sig = digits_signature(envelope["snapshot"])
    if not force and sig == _read_sent_sig():
        log("цифры не изменились - не шлем")
        return 0
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-tgbot"), "notify", "--pre", "-"],
            input=panel, text=True, capture_output=True, timeout=120)
    except Exception as exc:  # noqa: BLE001
        log("notify не запустился: %s" % type(exc).__name__)
        return 1
    if r.returncode != 0:
        log("notify exit %s: %s" % (r.returncode, (r.stderr or "").strip()[:200]))
        return 1
    # фиксируем сигнатуру ТОЛЬКО после успешной отправки (сбой -> повтор)
    _write_sent_sig(sig)
    return 0


def mode_render():
    print(render(read_json(CACHE_FILE)))
    return 0


def mode_selftest():
    os.environ["CLAUDE_AGENT_LIMITS_TZ"] = "Europe/Moscow"
    os.environ.pop("CLAUDE_AGENT_LIMITS_STALE_MIN", None)
    failed = []

    def t(name, cond):
        print("  %s: %s" % ("ok" if cond else "FAIL", name))
        if not cond:
            failed.append(name)

    # Золотая панель из handoff §1.2 (2026-07-19 - Вс; +3ч MSK -> Пн 00:00).
    snapshot = {
        "captured_at": "2026-07-17T06:00:00Z",
        "claude": {
            "status": "ok", "plan": "Max",
            "five_hour": {"remaining": 82, "resets_at": "2026-07-17T07:30:00Z"},
            "seven_day": {"remaining": 60, "resets_at": "2026-07-19T21:00:00Z"},
            "seven_day_opus": {"remaining": 55,
                               "resets_at": "2026-07-19T21:00:00Z"},
            "seven_day_sonnet": {"remaining": 70,
                                 "resets_at": "2026-07-19T21:00:00Z"},
            "scoped": [{"label": "fable", "remaining": 65,
                        "resets_at": "2026-07-19T21:00:00Z"}],
        },
        "codex": {
            "status": "ok", "plan": "Plus",
            "five_hour": {"remaining": 100, "resets_at": "2026-07-17T09:30:00Z"},
            "seven_day": {"remaining": 58, "resets_at": "2026-07-22T21:00:00Z"},
            "credits": 12,
        },
    }
    golden = "\n".join([
        "🤖 Лимиты LLM · 09:00",
        "",
        "Claude · Max",
        " 5ч    ▓▓░░░░░┃░░  18% / 10:30 (1.5h)",
        " нед   ▓▓▓▓░░┃░░░  40% / Пн (2.6d)",
        " opus  ▓▓▓▓▓░┃░░░  45% / Пн (2.6d)",
        " sonnet ▓▓▓░░░┃░░░  30% / Пн (2.6d)",
        " fable ▓▓▓▓░░┃░░░  35% / Пн (2.6d)",
        "",
        "Codex · Plus",
        " 5ч    ░░░┃░░░░░░  0% / 12:30 (3.5h)",
        # Единственное окно фикстуры, где расход обогнал часы (42% квоты при
        # ~20% недели) - держит 🔺 под сквозной проверкой, а не только юнитом.
        " нед   ▓███░░░░░░  42% / Чт (5.6d) 🔺",
        " кред 12",
    ])
    os.environ["CLAUDE_AGENT_TG_CARDS_COUNT"] = "/nonexistent/tgbot.cards.json"
    fresh = parse_iso("2026-07-17T06:00:00Z")
    got = render({"received_at": "2026-07-17T06:00:00Z", "snapshot": snapshot},
                 now=fresh)
    t("golden panel", got == golden)
    if got != golden:
        for a, b in zip(got.split("\n"), golden.split("\n")):
            if a != b:
                print("    got:    %r\n    golden: %r" % (a, b))

    # PHP-округление: used=45 -> 5 клеток (питоний round дал бы 4).
    t("bar half-up", _bar(45) == "▓▓▓▓▓░░░░░")
    t("bar 0/100", _bar(0) == "░" * 10 and _bar(100) == "▓" * 10)

    # Метка часов в градуснике. Без elapsed поведение прежнее (окно без
    # известного момента сброса) - это же страхует старые вызовы.
    t("bar no clock", _bar(45, None) == "▓▓▓▓▓░░░░░")
    # Запас: заливка не дошла до метки - метка стоит отдельной клеткой.
    t("bar clock ahead", _bar(21, 83) == "▓▓░░░░░░┃░")
    # В ногу: метка ровно на границе заливки, отдельного правила не нужно.
    t("bar clock level", _bar(42, 44) == "▓▓▓▓┃░░░░░")
    # Перебор: хвост за меткой красится █, метки при этом НЕТ - иначе она
    # съела бы клетку перебора и градусник соврал бы именно там, где важно.
    t("bar clock behind", _bar(30, 21) == "▓▓█░░░░░░░")
    t("bar clock behind full", _bar(100, 50) == "▓▓▓▓▓█████")
    # Края: часы в нуле - метка в первой клетке; часы в 100% - в последней
    # (индекс 10 не существует, зажимаем в 9).
    t("bar clock at zero", _bar(0, 0) == "┃░░░░░░░░░")
    t("bar clock at end", _bar(0, 100) == "░░░░░░░░░┃")

    # Процент ПРОШЕДШЕГО времени окна. Длины окон - константы (в данных
    # провайдера их нет), тип берется из reset_kind.
    n5 = parse_iso("2026-07-17T06:00:00Z")
    t("elapsed 5h", _elapsed_percent("2026-07-17T10:30:00Z", "time", n5) == 10.0)
    t("elapsed week", _elapsed_percent("2026-07-19T21:00:00Z", "week", n5) == 62.5)
    # Сброс уже прошел / срок абсурдно далеко - зажимаем в 100 и 0, а не
    # выпускаем метку за пределы градусника.
    t("elapsed past clamps", _elapsed_percent("2026-07-17T05:00:00Z", "time", n5) == 100)
    t("elapsed future clamps", _elapsed_percent("2026-07-18T06:00:00Z", "time", n5) == 0)
    t("elapsed no reset", _elapsed_percent(None, "time", n5) is None)

    # Порог 🔺: зажигается от PACE_ALERT_PP пунктов разрыва, ниже молчит.
    t("pace threshold", PACE_ALERT_PP == 20)
    t("pace mark on", _pace_mark(50, 25) == " 🔺")
    t("pace mark off at threshold-1", _pace_mark(44, 25) == "")
    t("pace mark on at threshold", _pace_mark(45, 25) == " 🔺")
    t("pace mark none without clock", _pace_mark(90, None) == "")

    # Статусы секций.
    tz = display_tz()
    t("stale text", _section("Claude", {"status": "stale"}, tz, fresh)
      == "Claude\n токен протух, авторефреш не помог - нужен relogin")
    t("locked text", _section("Codex", {"status": "locked", "plan": "Plus"}, tz, fresh)
      == "Codex · Plus\n том /data заперт, codex недоступен")
    t("error text", _section("Codex", {"status": "error"}, tz, fresh)
      == "Codex\n ошибка снятия лимитов")
    t("ok no windows", _section("Claude", {"status": "ok"}, tz, fresh)
      == "Claude\n нет данных")

    # Countdown: единицы m/h/d, .0 отбрасывается, past -> 0m; нет resets_at -> нет скобок.
    n = parse_iso("2026-07-17T00:00:00Z")
    t("countdown minutes", _fmt_countdown("2026-07-17T00:30:00Z", n) == "30m")
    t("countdown hours", _fmt_countdown("2026-07-17T02:30:00Z", n) == "2.5h")
    t("countdown days", _fmt_countdown("2026-07-20T12:00:00Z", n) == "3.5d")
    t("countdown past clamps", _fmt_countdown("2026-07-16T23:00:00Z", n) == "0m")
    t("no resets no parens",
      _window_line("5ч", {"remaining": 50}, "time", tz, fresh) == " 5ч    ▓▓▓▓▓░░░░░  50%")

    # Кредиты: скрыты без поля, видны с полем.
    codex_no_credits = _section(
        "Codex", {"status": "ok",
                  "five_hour": {"remaining": 90}}, tz, fresh)
    t("credits hidden", "кред" not in codex_no_credits)

    # Пустой конверт.
    t("empty envelope", render(None)
      == "🤖 Лимиты LLM\n\nНет данных - пробник еще не присылал снапшот.")

    # Дедуп-сигнатура: время сброса НЕ меняет сигнатуру, проценты/кредиты/статус - меняют.
    base_sig = digits_signature(snapshot)
    reset_moved = json.loads(json.dumps(snapshot))
    reset_moved["claude"]["five_hour"]["resets_at"] = "2099-01-01T00:00:00Z"
    reset_moved["captured_at"] = "2099-01-01T00:00:00Z"
    t("sig ignores reset/time", digits_signature(reset_moved) == base_sig)
    pct_moved = json.loads(json.dumps(snapshot))
    pct_moved["claude"]["five_hour"]["remaining"] = 40  # было 82
    t("sig changes on percent", digits_signature(pct_moved) != base_sig)
    cred_moved = json.loads(json.dumps(snapshot))
    cred_moved["codex"]["credits"] = 5  # было 12
    t("sig changes on credits", digits_signature(cred_moved) != base_sig)
    stale_moved = json.loads(json.dumps(snapshot))
    stale_moved["claude"] = {"status": "stale"}
    t("sig changes on status", digits_signature(stale_moved) != base_sig)
    scoped_moved = json.loads(json.dumps(snapshot))
    scoped_moved["claude"]["scoped"][0]["remaining"] = 20  # было 65
    t("sig changes on scoped percent", digits_signature(scoped_moved) != base_sig)

    # --- здоровье хоста ---
    # Разбор локальных источников.
    t("meminfo parse", _mem_available_mb(
        "MemTotal:        8131624 kB\nMemAvailable:    3532112 kB\n") == 3449)
    t("meminfo missing", _mem_available_mb("MemTotal: 1 kB") is None)
    t("psi parse", _psi_pct(
        "some avg10=0.00 avg60=1.50 avg300=0.00 total=1\n"
        "full avg10=0.00 avg60=3.12 avg300=0.00 total=2\n") == 3.12)
    # Третье поле mm_stat (mem_used_total), не пятое (mem_used_max): пик не
    # убывает и предупреждение горело бы вечно после одного всплеска.
    t("zram ratio current not peak", _zram_ratio(
        "1488269312 374069378 532680704 0 828588032 6185 6282 742 3351") == 2.8)
    t("zram empty", _zram_ratio("") is None)
    t("zram garbage", _zram_ratio("x y z") is None)

    # Разметка ответов VM по ключу: пустой ответ одного запроса не должен
    # сдвигать остальные.
    ok_json = '{"data":{"result":[{"metric":{},"value":[1,"42"]}]}}'
    grow_json = ('{"data":{"result":[{"metric":{"groupname":"chrome-mcp"},'
                 '"value":[1,"1073741824"]}]}}')
    parsed = _vm_parse("healthy\t\nsteal_pct\t%s\ngrowth\t%s\n"
                       % (ok_json, grow_json))
    t("vm parse skips empty", "healthy" not in parsed)
    t("vm parse keeps aligned", parsed.get("steal_pct") == 42.0)
    t("vm parse growth label", parsed.get("growth") == ("chrome-mcp", 1073741824.0))
    t("vm parse drops nan", _vm_parse(
        'steal_pct\t{"data":{"result":[{"metric":{},"value":[1,"NaN"]}]}}') == {})
    t("vm parse survives junk", _vm_parse("steal_pct\tnot-json\n") == {})

    # Запросы обязаны быть сужены на llm - иначе подмешаются чужие хосты.
    t("vm exprs scoped", all('host="llm"' in e for k, e in _VM_EXPRS.items()
                             if k != "healthy"))
    # Сторож смотрит окно, иначе одиночный промах скрейпа = ложная тревога.
    t("watchdog uses window", "max_over_time" in _VM_EXPRS["healthy"]
      and "== 1" in _VM_EXPRS["healthy"])

    # Секция едет прицепом: наличие host НЕ меняет сигнатуру дедупа.
    with_host = json.loads(json.dumps(snapshot))
    with_host["host"] = {"status": "ok", "available_mb": 640, "psi_pct": 9.9}
    t("sig ignores host", digits_signature(with_host) == base_sig)

    # Рендер: в норме без предупреждений.
    calm = {"status": "ok", "available_mb": 3400, "psi_pct": 0.0,
            "zram_ratio": 3.4, "avail_delta_mb": -120, "metrics": "ok",
            "claude": {"n": 4, "rss_mb": 1360, "oldest_h": 9.2},
            "disk_free_pct": {"/": 42.0, "/data": 55.0}}
    t("host calm", _host_section(calm) == "\n".join([
        "Хост llm",
        " память 3400 МБ (-120/ч)",
        " claude 4 проц · 1360 МБ · старейшая 9.2 ч",
    ]))

    # Прогноз показывается только когда до нуля ближе порога.
    far = dict(calm, predict_h=12.0)
    t("host predict far hidden", "кончится" not in _host_section(far))
    near = dict(calm, predict_h=1.9)
    t("host predict near shown", "кончится через ~1.9 ч" in _host_section(near))

    # Тревога "тесно" - только когда available И PSI одновременно за порогом.
    low_only = dict(calm, available_mb=500, psi_pct=0.2)
    t("host low mem alone quiet", "тесно" not in _host_section(low_only))
    psi_only = dict(calm, psi_pct=5.0)
    t("host psi alone quiet", "тесно" not in _host_section(psi_only))
    tight = dict(calm, available_mb=500, psi_pct=5.0)
    t("host tight warns", "⚠️ тесно: 500 МБ свободно, PSI 5.0%"
      in _host_section(tight))

    # Пороговые предупреждения.
    t("host steal warns", "steal 7.2%" in _host_section(dict(calm, steal_pct=7.2)))
    t("host steal quiet", "steal" not in _host_section(dict(calm, steal_pct=1.0)))
    t("host disk warns", "/data: свободно 4.0%"
      in _host_section(dict(calm, disk_free_pct={"/": 42.0, "/data": 4.0})))
    t("host zram warns", "zram жмет ×1.8"
      in _host_section(dict(calm, zram_ratio=1.8)))
    t("host growth", "растет chrome-mcp +1400 МБ/ч"
      in _host_section(dict(calm, growth={"group": "chrome-mcp", "mb": 1400})))

    t("host metrics ok quiet", "метрики" not in _host_section(
        {"status": "ok", "available_mb": 3400, "metrics": "ok"}))

    # Сторож мониторинга и мягкая деградация без хоста метрик.
    t("host metrics down", "метрики не собираются"
      in _host_section(dict(calm, metrics="down")))
    t("host metrics unreachable", "хост метрик недоступен"
      in _host_section(dict(calm, metrics="unreachable")))
    t("host absent", _host_section(None) is None)
    t("host error", _host_section({"status": "error"}) == "Хост llm\n не снят")

    # Панель без host остается прежней (golden выше это и проверяет).
    t("panel keeps host", "Хост llm" in render(
        {"received_at": "2026-07-17T06:00:00Z",
         "snapshot": dict(snapshot, host=calm)}, now=fresh))
    # Scoped-окно с тем же именем, что legacy seven_day_* - не дублируется.
    t("scoped dup hidden", _section("Claude", {
        "status": "ok",
        "seven_day_opus": {"remaining": 50},
        "scoped": [{"label": "opus", "remaining": 10}]}, tz, fresh).count("opus") == 1)
    t("sig stable across dup", digits_signature(json.loads(json.dumps(snapshot))) == base_sig)

    # Устаревание: 60 мин > порога 45 -> строка присутствует; 10 мин -> нет.
    old_env = {"received_at": "2026-07-17T05:00:00Z", "snapshot": snapshot}
    got_stale = render(old_env, now=parse_iso("2026-07-17T06:00:00Z"))
    t("stale line shown", "⚠️ данные устарели: 60 мин назад" in got_stale)
    t("stale line hidden", "устарели" not in got)

    # Счетчик карточек (Р11, план §12) - писатель bin/claude-agent-tgbot
    # (cards_count_bump), здесь только чтение. Изолированный временный файл -
    # тест не зависит от реального ~/.claude-control на машине.
    import tempfile
    cards_tmp = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
    cards_tmp.close()
    os.environ["CLAUDE_AGENT_TG_CARDS_COUNT"] = cards_tmp.name
    os.unlink(cards_tmp.name)  # старт с отсутствующего файла (свежая установка)
    t("cards line absent when file missing",
      _cards_today_line(now=1753000000) is None)
    with open(cards_tmp.name, "w") as f:
        json.dump({"day": "2026-07-20", "count": 4}, f)
    today_ts = parse_iso("2026-07-20T12:00:00Z").timestamp()
    tomorrow_ts = parse_iso("2026-07-21T12:00:00Z").timestamp()
    t("cards line shown for today",
      _cards_today_line(now=today_ts) == "Карточек сегодня: 4")
    t("cards line resets on stale day",
      _cards_today_line(now=tomorrow_ts) == "Карточек сегодня: 0")
    t("panel shows cards line", "Карточек сегодня: 4" in render(
        {"received_at": "2026-07-20T12:00:00Z", "snapshot": snapshot},
        now=parse_iso("2026-07-20T12:00:00Z")))
    os.unlink(cards_tmp.name)
    os.environ.pop("CLAUDE_AGENT_TG_CARDS_COUNT", None)
    t("golden panel unaffected by absent cards file",
      "Карточек" not in got)

    # Недельный reset без TZ-сдвига дня: 2026-07-22T10:00Z = Ср и в MSK.
    t("weekday wed", _format_reset("2026-07-22T10:00:00Z", "week", tz) == "Ср")
    t("time in msk", _format_reset("2026-07-17T06:00:00Z", "time", tz) == "09:00")

    # Graceful-пробник без сети: нет creds -> stale, нет маунта -> locked.
    global CLAUDE_CREDS, DATA_MOUNT, http_get, refresh_claude_cli
    CLAUDE_CREDS, saved_creds = "/nonexistent/creds.json", CLAUDE_CREDS
    t("probe claude no creds",
      safe(build_claude) == {"status": "stale", "detail": "no credentials"})
    CLAUDE_CREDS = saved_creds
    DATA_MOUNT, saved_mount = "/nonexistent-mount-point", DATA_MOUNT
    t("probe codex locked", safe(build_codex)["status"] == "locked")
    DATA_MOUNT = saved_mount

    # Авторефреш: 401 -> CLI-рефреш -> один повтор; на 200 рефреш не зовется.
    import tempfile
    os.environ["LIMITS_PROBE_CLAUDE_UA"] = "claude-code/test"
    tmp_creds = tempfile.NamedTemporaryFile(
        "w", suffix=".json", delete=False)
    json.dump({"claudeAiOauth": {"accessToken": "tok"}}, tmp_creds)
    tmp_creds.close()
    CLAUDE_CREDS, saved_creds = tmp_creds.name, CLAUDE_CREDS
    saved_get, saved_refresh = http_get, refresh_claude_cli
    calls = {"get": 0, "refresh": 0}
    ok_body = {"five_hour": {"utilization": 20}}

    def fake_refresh(result):
        def inner():
            calls["refresh"] += 1
            return result
        return inner

    def fake_get_401_then_200(url, headers, proxy):
        calls["get"] += 1
        return (401, None) if calls["get"] == 1 else (200, ok_body)

    http_get, refresh_claude_cli = fake_get_401_then_200, fake_refresh(True)
    t("401 refresh retry ok",
      safe(build_claude).get("status") == "ok"
      and calls == {"get": 2, "refresh": 1})

    calls.update(get=0, refresh=0)
    http_get = lambda url, headers, proxy: (
        calls.__setitem__("get", calls["get"] + 1) or (401, None))
    refresh_claude_cli = fake_refresh(False)
    t("401 refresh fail stale",
      safe(build_claude) == {"status": "stale", "detail": "token expired"}
      and calls == {"get": 1, "refresh": 1})

    calls.update(get=0, refresh=0)
    http_get = lambda url, headers, proxy: (200, dict(ok_body))
    refresh_claude_cli = fake_refresh(True)
    t("200 no refresh",
      safe(build_claude).get("status") == "ok" and calls["refresh"] == 0)

    # Пер-модельные окна из limits[] (weekly_scoped + scope.model).
    scoped_body = {
        "five_hour": {"utilization": 20},
        "seven_day_opus": None,
        "limits": [
            {"kind": "session", "percent": 20},
            {"kind": "weekly_scoped", "percent": 35,
             "resets_at": "2026-07-19T21:00:00Z",
             "scope": {"model": {"display_name": "Fable"}}},
            {"kind": "weekly_scoped", "percent": 10,
             "scope": {"surface": "cowork"}},  # без model - пропускаем
        ],
    }
    http_get = lambda url, headers, proxy: (200, scoped_body)
    t("probe scoped fable",
      safe(build_claude).get("scoped")
      == [{"label": "fable", "remaining": 65,
           "resets_at": "2026-07-19T21:00:00Z"}])

    http_get, refresh_claude_cli = saved_get, saved_refresh
    CLAUDE_CREDS = saved_creds
    os.unlink(tmp_creds.name)

    # --- Клэмп окон: держим min remaining (max usage) с последнего reset_at ---
    def _cx(rem, reset="2026-07-28T21:00:00Z"):
        return {"codex": {"status": "ok",
                          "seven_day": {"remaining": rem, "resets_at": reset}}}
    st = {}
    s = _cx(84); clamp_snapshot(s, st)
    t("clamp first passthrough", s["codex"]["seven_day"]["remaining"] == 84)
    s = _cx(94); clamp_snapshot(s, st)  # недосчет реплики (used 6 вместо 16) - гасим
    t("clamp holds min on spurious rise", s["codex"]["seven_day"]["remaining"] == 84)
    s = _cx(80); clamp_snapshot(s, st)  # реальный рост расхода - обновляем минимум
    t("clamp tracks real usage", s["codex"]["seven_day"]["remaining"] == 80)
    s = _cx(94); clamp_snapshot(s, st)
    t("clamp holds new min", s["codex"]["seven_day"]["remaining"] == 80)
    s = _cx(98, "2026-08-04T21:00:00Z"); clamp_snapshot(s, st)  # новое окно - сброс
    t("clamp resets on new window", s["codex"]["seven_day"]["remaining"] == 98)

    st2 = {}
    n = {"claude": {"status": "ok", "five_hour": {"remaining": 50}}}
    clamp_snapshot(n, st2)
    n = {"claude": {"status": "ok", "five_hour": {"remaining": 90}}}
    clamp_snapshot(n, st2)
    t("clamp skips window without reset", n["claude"]["five_hour"]["remaining"] == 90)

    st3 = {"codex:seven_day": {"resets_at": "2026-07-28T21:00:00Z", "remaining": 70}}
    clamp_snapshot({"codex": {"status": "error"}}, st3)  # error не трогает стейт
    t("clamp ignores error section", st3["codex:seven_day"]["remaining"] == 70)
    s = _cx(88); clamp_snapshot(s, st3)  # после восстановления держим накопленный min
    t("clamp survives error", s["codex"]["seven_day"]["remaining"] == 70)

    st4 = {}
    sc = {"claude": {"status": "ok", "scoped": [
        {"label": "fable", "remaining": 57, "resets_at": "2026-07-28T21:00:00Z"}]}}
    clamp_snapshot(sc, st4)
    sc = {"claude": {"status": "ok", "scoped": [
        {"label": "fable", "remaining": 70, "resets_at": "2026-07-28T21:00:00Z"}]}}
    clamp_snapshot(sc, st4)
    t("clamp scoped by label", sc["claude"]["scoped"][0]["remaining"] == 57)

    print("%d failed" % len(failed) if failed else "all ok")
    return 1 if failed else 0


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "once":
        return mode_once(sys.argv[2:])
    if mode == "render":
        return mode_render()
    if mode == "selftest":
        return mode_selftest()
    sys.stderr.write(__doc__.strip() + "\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
