#!/usr/bin/env python3
"""claude-agent-canon-maintainer: детерминированный fleet-reconciler canon-sync (этап 8, часть c).

Контракт: docs/design-2026-07-14-stage8-canon-sync.md §5 (транзакционный слой §10 - в
toolkit canon-delta). План: docs/dev/plan-2026-07-14-stage8-part-c.md, бэклог рядом.

Раскатывает ревизии канона (claude-toolkit, тег canon-vN) по парку проектов. НЕ
LLM-mission: детерминированный проход; канон-механика (classify/WAL-apply/resolution)
исполняется toolkit canon-delta.py как непрозрачным CLI (exit 0/10/1/2/3), maintainer
делает schedule/inventory/budgets/PR-lifecycle/уведомления. canon.state.json проектов
пишет ТОЛЬКО delta - maintainer его читает.

Подкоманды:
  once            один проход по fleet (observe до arm)
  status          сводка armed/cursor/latch/budget (JSON в stdout)
  arm | disarm    включить/выключить мутирующий режим (durable-флаг)
  ack <release> <ring>    снять breaker-latch (только вручную, §5)
  recover         терминализовать хвосты незавершенных транзакций
  rollback <project>      аварийный откат на предыдущую примененную ревизию
                          (rollout_record[-2]; ставит latch до ack, §17)

Env (дефолты):
  CLAUDE_CANON_DIR     ~/.claude-control/canon   durable-состояние maintainer
  CLAUDE_CANON_FLEET   $CLAUDE_CANON_DIR/fleet.yaml   инвентарь fleet
  CLAUDE_CANON_MIRROR  $CLAUDE_CANON_DIR/mirror       полное git-зеркало канона
  CLAUDE_CANON_LOCK    override singleton-flock; дефолт - ФИКС-путь вне
                       CLAUDE_CANON_DIR: $XDG_RUNTIME_DIR/claude-stage8-canon.lock,
                       без него /tmp/claude-stage8-canon-<uid>.lock (§5.1)

Все записи durable (tmp+fsync+rename+fsync dir). Exit-коды: 0 ok, 2 validation,
5 lock-busy, 7 disk/unsafe.
"""

import fcntl
import json
import os
import sys
import time
import uuid

# --- exit-коды (конвенция агентного слоя) ---
EXIT_OK = 0
EXIT_VALIDATION = 2
EXIT_TRANSIENT = 3   # сеть/источник недоступен: retry следующим проходом
EXIT_LOCK_BUSY = 5
EXIT_DISK = 7


# =========================================================================
# Конфиг из env
# =========================================================================

def canon_dir() -> str:
    return os.environ.get(
        "CLAUDE_CANON_DIR",
        os.path.join(os.path.expanduser("~"), ".claude-control", "canon"),
    )


def cfg_path(env_key: str, default_rel: str) -> str:
    return os.environ.get(env_key, os.path.join(canon_dir(), default_rel))


# =========================================================================
# Durable-примитивы (прием io/run/части (a): tmp -> write-all -> fchmod -> fsync
# -> rename -> fsync dir)
# =========================================================================

def fsync_dir(path: str) -> None:
    try:
        fd = os.open(path, os.O_RDONLY)
    except (FileNotFoundError, NotADirectoryError):
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _write_all(fd: int, data: bytes) -> None:
    mv = memoryview(data)
    off = 0
    while off < len(data):
        n = os.write(fd, mv[off:])
        if n <= 0:
            raise OSError(f"нулевая запись в fd на off={off}/{len(data)}")
        off += n


def durable_write(path: str, data: bytes, mode: int = 0o600) -> None:
    """Атомарная durable-запись; ENOSPC/EIO -> exit 7 у вызывающего."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f".{os.path.basename(path)}.tmp.{uuid.uuid4().hex}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        _write_all(fd, data)
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    fsync_dir(d)


def durable_write_json(path: str, obj: object) -> None:
    durable_write(path, (json.dumps(obj, ensure_ascii=True, sort_keys=True, indent=2) + "\n").encode("utf-8"))


def read_json(path: str, default: object) -> object:
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as e:
        die(f"битый JSON {path}: {e}", EXIT_DISK)


def lock_path() -> str:
    """Фикс-путь singleton-замка (§5.1, T16): НЕ зависит от CLAUDE_CANON_DIR -
    оба триггера (systemd timer и harvester-marker) обязаны взять один путь
    даже при разъехавшемся окружении. Приоритет: явный CLAUDE_CANON_LOCK
    (тесты/особые случаи) -> $XDG_RUNTIME_DIR (tmpfs systemd-user) ->
    /tmp с uid (без гонки между юзерами)."""
    env = os.environ.get("CLAUDE_CANON_LOCK")
    if env:
        if not os.path.isabs(env):
            # process-relative замок развалил бы singleton между systemd и
            # ручным запуском из другого cwd (r2-#11)
            die("CLAUDE_CANON_LOCK должен быть абсолютным путем", EXIT_VALIDATION)
        return env
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isdir(run):
        return os.path.join(run, "claude-stage8-canon.lock")
    import tempfile
    return os.path.join(tempfile.gettempdir(),
                        f"claude-stage8-canon-{os.getuid()}.lock")


class SingletonLock:
    """Exclusive flock фикс-пути. Дефолт non-blocking: занято -> exit 5 (оба
    триггера - timer и harvester-marker - берут ЭТОТ ЖЕ путь, §5, находка 10).
    wait=True - блокирующий захват для коротких админ-команд (arm/disarm/ack):
    kill-switch и защелки сериализуются с бегущим проходом, а не теряются в
    read-modify-write гонке с ним (r4-#5)."""

    def __init__(self, path: str, wait: bool = False) -> None:
        self.path = path
        self.wait = wait
        self.fd = None

    def __enter__(self):
        d = os.path.dirname(self.path)
        if d:  # относительный bare-путь: dirname пуст, makedirs("") падает
            os.makedirs(d, exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            flags = fcntl.LOCK_EX if self.wait else fcntl.LOCK_EX | fcntl.LOCK_NB
            fcntl.flock(self.fd, flags)
        except BlockingIOError:
            os.close(self.fd)
            self.fd = None
            die("другой проход держит lock", EXIT_LOCK_BUSY)
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)


# =========================================================================
# Лог (машиночитаемый: JSON-строки в stdout) + pass-id
# =========================================================================

_PASS_ID: str | None = None


def new_pass_id() -> str:
    global _PASS_ID
    _PASS_ID = f"{int(time.time())}-{uuid.uuid4().hex[:12]}"
    return _PASS_ID


def log(event: str, **fields) -> None:
    rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event}
    if _PASS_ID:
        rec["pass_id"] = _PASS_ID
    rec.update(fields)
    print(json.dumps(rec, ensure_ascii=True, sort_keys=True))
    sys.stdout.flush()


def die(msg: str, code: int) -> None:
    sys.stderr.write(f"canon-maintainer: {msg}\n")
    sys.exit(code)


def _fault(point: str) -> None:
    """T30 (fault-матрица §4.5в): управляемый crash в транзакционной точке.
    CLAUDE_CANON_FAULT=<точка> -> os._exit(86): эмуляция SIGKILL - никаких
    finally/atexit/flush, как настоящий обрыв. Вне тестов env не задан."""
    if os.environ.get("CLAUDE_CANON_FAULT") == point:
        os._exit(86)


# =========================================================================
# Инвентарь fleet.yaml (T02): мини-YAML 2 уровней, stdlib-only (как intent
# в canon-delta части (a); yq на VM не требуем)
# =========================================================================

POLICIES = ("observe", "branch", "auto-merge")
RINGS = ("canary", "snapshot", "rest")
TRACKS = ("stable",)


def _strip_comment(s: str) -> str:
    if " #" in s:
        s = s.split(" #", 1)[0]
    return s.strip()


def parse_fleet_yaml(text: str) -> dict:
    """{name: {key: value}}. Поддержка: 'name:' без отступа, '  key: value' с
    отступом. Значения - скаляры (строки); кавычки снимаются. Комментарии/пустые
    игнорируются. Прочее -> ValueError."""
    fleet: dict = {}
    current: str | None = None
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indented = line[0] in " \t"
        if not indented:
            if not stripped.endswith(":") or " " in stripped[:-1]:
                raise ValueError(f"строка {lineno}: ожидался 'имя-проекта:'")
            current = stripped[:-1]
            if current in fleet:
                raise ValueError(f"строка {lineno}: дубль проекта {current}")
            fleet[current] = {}
        else:
            if current is None:
                raise ValueError(f"строка {lineno}: поле вне проекта")
            if ":" not in stripped:
                raise ValueError(f"строка {lineno}: ожидалось 'key: value'")
            key, _, rest = stripped.partition(":")
            val = _strip_comment(rest)
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            fleet[current][key.strip()] = val
    return fleet


def _is_git_checkout(path: str) -> bool:
    return os.path.exists(os.path.join(path, ".git"))


def validate_fleet(fleet: dict) -> dict:
    """Нормализует и валидирует инвентарь. Ошибка -> ValueError (exit 2).
    R2: локальный не-git путь допускает ТОЛЬКО policy=observe."""
    import re
    norm: dict = {}
    for name, spec in fleet.items():
        # имя проекта - компонент путей (repos/, worktrees/, state/<name>.json):
        # не-path-safe имя ("../evil", слэши) писало бы вне canon-dir
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name):
            raise ValueError(f"{name}: имя проекта не path-safe "
                             "(допустимо [A-Za-z0-9._-], не с точки)")
        path = spec.get("path") or None
        repo_url = spec.get("repo_url") or None
        if not path and not repo_url:
            raise ValueError(f"{name}: нужен path или repo_url")
        if path and repo_url:
            # двусмысленный routing: path-проекты observe-only (F2), repo_url -
            # PR-поток; оба сразу дали бы armed-мутации "Mac"-проекта
            raise ValueError(f"{name}: path и repo_url взаимоисключающие")
        policy = spec.get("policy", "observe")
        if policy not in POLICIES:
            raise ValueError(f"{name}: policy={policy} вне {POLICIES}")
        ring = spec.get("ring", "rest")
        if ring not in RINGS:
            raise ValueError(f"{name}: ring={ring} вне {RINGS}")
        track = spec.get("track", "stable")
        if track not in TRACKS:
            raise ValueError(f"{name}: track={track} вне {TRACKS}")
        managed = spec.get("fleet_managed", "true").lower() != "false"
        if path and not repo_url and not _is_git_checkout(path) and policy != "observe":
            raise ValueError(f"{name}: не-git путь допускает только policy=observe (R2)")
        norm[name] = {
            "path": path, "repo_url": repo_url, "policy": policy,
            "ring": ring, "track": track, "fleet_managed": managed,
            "smoke_cmd": spec.get("smoke_cmd") or None,
            "target_cmd": spec.get("target_cmd") or None,
        }
    return norm


def load_fleet() -> dict:
    """Инвентарь с диска; отсутствие файла = пустой fleet (0 проектов)."""
    fleet_path = cfg_path("CLAUDE_CANON_FLEET", "fleet.yaml")
    if not os.path.exists(fleet_path):
        return {}
    try:
        with open(fleet_path, encoding="utf-8") as f:
            raw = parse_fleet_yaml(f.read())
        return validate_fleet(raw)
    except ValueError as e:
        die(f"fleet.yaml: {e}", EXIT_VALIDATION)


# =========================================================================
# Host-side зеркало канона (T03, §2/§5): полный клон, fetch раз на проход,
# tag -> commit_sha (ambient identity), lock из git-объектов (не рабочего дерева)
# =========================================================================

def _git(mirror: str, *args: str, check: bool = True):
    import subprocess
    r = subprocess.run(["git", "-C", mirror, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise MirrorError(f"git {' '.join(args[:2])}: {r.stderr.strip()[:300]}")
    return r


class MirrorError(Exception):
    """Transient-сбой зеркала/источника: exit 3, retry следующим проходом."""


def mirror_update() -> str:
    """Клонирует (--mirror) при отсутствии, иначе fetch --prune. Возвращает путь.
    Полный клон обязателен (§2): прошлые lock для отката тянутся git-объектами."""
    import subprocess
    mirror = cfg_path("CLAUDE_CANON_MIRROR", "mirror")
    repo_url = os.environ.get("CLAUDE_CANON_REPO_URL", "git@github.com:dewil/claude-toolkit.git")
    if not os.path.exists(os.path.join(mirror, "HEAD")):
        os.makedirs(os.path.dirname(mirror), exist_ok=True)
        r = subprocess.run(["git", "clone", "--mirror", repo_url, mirror],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise MirrorError(f"clone --mirror: {r.stderr.strip()[:300]}")
    else:
        _git(mirror, "fetch", "--prune", repo_url, "+refs/*:refs/*")
    return mirror


def mirror_resolve(mirror: str, ref: str) -> str:
    """Тег canon-vN -> полный commit_sha (ambient release-identity, §2)."""
    r = _git(mirror, "rev-parse", f"{ref}^{{commit}}", check=False)
    if r.returncode != 0:
        raise MirrorError(f"ref {ref} не найден в зеркале")
    return r.stdout.strip()


def mirror_lock(mirror: str, commit_sha: str) -> str | None:
    """canon.lock.json из git-объектов ревизии (git show <sha>:path)."""
    r = _git(mirror, "show", f"{commit_sha}:canon.lock.json", check=False)
    return r.stdout if r.returncode == 0 else None


def mirror_latest_release(mirror: str) -> tuple[str, str] | None:
    """Последний тег canon-vN (version-sort) -> (ref, commit_sha); None если тегов нет."""
    r = _git(mirror, "tag", "-l", "canon-v*", "--sort=-v:refname", check=False)
    tags = [t for t in r.stdout.splitlines() if t.strip()]
    if not tags:
        return None
    ref = tags[0]
    return ref, mirror_resolve(mirror, ref)


# =========================================================================
# Клоны fleet-репо (T09, §15.1): ~/.claude-control/canon/repos/<name>,
# fetch раз на проход; dirty/detached -> held (не чиним молча)
# =========================================================================

class CloneHeld(Exception):
    """Клон в аномальном состоянии -> вердикт held-<reason>, проход жив."""

    def __init__(self, reason: str) -> None:
        self.reason = reason
        super().__init__(reason)


def clone_update(name: str, repo_url: str) -> str:
    """Клонирует fleet-репо при отсутствии, иначе fetch --prune. Возвращает путь.
    Клон - зона maintainer (не проект пользователя): создание/фетч допустимы и в
    observe. Dirty рабочее дерево -> CloneHeld (кто-то лез руками, не трогаем)."""
    import subprocess
    root = os.path.join(canon_dir(), "repos", name)
    if not os.path.isdir(os.path.join(root, ".git")):
        os.makedirs(os.path.dirname(root), exist_ok=True)
        r = subprocess.run(["git", "clone", repo_url, root], capture_output=True, text=True)
        if r.returncode != 0:
            raise MirrorError(f"clone {name}: {r.stderr.strip()[:300]}")
        return root
    r = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise CloneHeld("broken-clone")
    if r.stdout.strip():
        raise CloneHeld("dirty-clone")
    r = subprocess.run(["git", "-C", root, "fetch", "--prune", "origin"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise MirrorError(f"fetch {name}: {r.stderr.strip()[:300]}")
    return root


# =========================================================================
# Toolkit canon-delta как непрозрачный CLI (T04, граница B §4): потребляем
# ТОЛЬКО exit-код + stdout-как-данные; git-объекты сами не трогаем
# =========================================================================

DELTA_CODE_MAP = {
    0: "ok",          # applied / up-to-date -> продвигать FSM
    10: "conflicts",  # escalate-классы -> держать applied, в digest
    1: "transient",   # transport -> retry следующим проходом
    2: "incompat",    # schema/min_cli fail-closed -> held(incompat) + алерт
    3: "recovery",    # recovery-required -> delta recover, потом повтор
}


def migrate_bin() -> list[str]:
    """toolkit canon-migrate.py (§11): env CLAUDE_CANON_MIGRATE либо sibling
    canon-delta в том же каталоге toolkit/scripts."""
    env = os.environ.get("CLAUDE_CANON_MIGRATE")
    if env:
        return [sys.executable or "python3", env]
    delta = delta_bin()
    return delta[:-1] + [os.path.join(os.path.dirname(delta[-1]),
                                      "canon-migrate.py")]


def delta_bin() -> list[str]:
    """Команда запуска canon-delta: env CLAUDE_CANON_DELTA (путь к скрипту/моку)."""
    path = os.environ.get("CLAUDE_CANON_DELTA")
    if not path:
        die("CLAUDE_CANON_DELTA не задан (путь к canon-delta.py toolkit)", EXIT_VALIDATION)
    return [sys.executable, path] if path.endswith(".py") else [path]


def delta_call(args: list[str], cwd: str | None = None, timeout: int = 600) -> dict:
    """Запуск delta; возвращает {code, klass, verdict}. stdout - недоверенные
    данные: битый JSON -> verdict=None, не ошибка. Неизвестный код -> 'unknown'
    (fail-closed: держим проект, не продвигаем)."""
    import subprocess
    try:
        r = subprocess.run(delta_bin() + args, capture_output=True, text=True,
                           cwd=cwd, timeout=timeout)
        code = r.returncode
        out = r.stdout
    except subprocess.TimeoutExpired:
        return {"code": None, "klass": "transient", "verdict": None, "stderr": "timeout"}
    verdict = None
    try:
        verdict = json.loads(out)
    except (json.JSONDecodeError, TypeError):
        pass
    return {
        "code": code,
        "klass": DELTA_CODE_MAP.get(code, "unknown"),
        "verdict": verdict,
        "stderr": (r.stderr or "")[-500:],
    }


# =========================================================================
# Armed-флаг (T08 минимум: durable вкл/выкл; observe-first счетчик - позже)
# =========================================================================

def armed_path() -> str:
    return os.path.join(canon_dir(), "armed.json")


def armed_state() -> dict:
    return read_json(armed_path(), {"armed": False, "observe_passes_left": 0})


def is_armed() -> bool:
    return bool(armed_state().get("armed"))


def set_armed(value: bool) -> None:
    """arm взводит observe-first счетчик (§16.3): первые N armed-проходов все
    равно observe - страховка от немедленных мутаций. disarm = kill switch."""
    passes = int(os.environ.get("CLAUDE_CANON_OBSERVE_PASSES", "3")) if value else 0
    durable_write_json(armed_path(), {"armed": value, "observe_passes_left": passes})


def effective_mode() -> str:
    """observe (не armed) | observe-first (armed, счетчик > 0) | armed.
    Мутации (M1+) разрешены ТОЛЬКО при 'armed'."""
    st = armed_state()
    if not st.get("armed"):
        return "observe"
    if int(st.get("observe_passes_left") or 0) > 0:
        return "observe-first"
    return "armed"


def consume_observe_pass() -> None:
    """Декремент observe-first счетчика (по одному на armed-проход, durable)."""
    st = armed_state()
    left = int(st.get("observe_passes_left") or 0)
    if st.get("armed") and left > 0:
        st["observe_passes_left"] = left - 1
        durable_write_json(armed_path(), st)


# =========================================================================
# Субкоманды
# =========================================================================

def observe_project(name: str, spec: dict, lock_file: str) -> dict:
    """Read-only вердикт по проекту (delta `plan`, никаких мутаций). Возвращает
    {project, klass, detail?}. Не бросает - ошибки проекта не роняют проход.
    Для repo_url-проектов plan гоняется по detached-worktree от
    origin/<default>: рабочее дерево клона fetch НЕ двигает, наблюдение по
    нему отчитывалось бы о состоянии на момент clone."""
    import tempfile
    root = spec.get("path")
    cleanup = None
    if not root:
        repo_url = spec.get("repo_url")
        if not repo_url:
            return {"project": name, "klass": "skipped-no-clone"}
        try:
            clone = clone_update(name, repo_url)
            base = f"origin/{_default_branch(clone)}"
        except CloneHeld as e:
            return {"project": name, "klass": f"held-{e.reason}"}
        except MirrorError as e:
            return {"project": name, "klass": "transient", "detail": str(e)[:200]}
        tmp = tempfile.mkdtemp(prefix=".observe-", dir=os.path.dirname(clone))
        root = os.path.join(tmp, "head")
        r = _run_git(clone, "worktree", "add", "--detach", root, base)
        if r.returncode != 0:
            _drop_temp_worktree(clone, root, tmp)  # + prune частичной регистрации
            return {"project": name, "klass": "transient",
                    "detail": f"observe worktree: {r.stderr.strip()[:150]}"}

        def cleanup():
            _drop_temp_worktree(clone, root, tmp)
    try:
        if not os.path.isdir(root):
            return {"project": name, "klass": "missing-path"}
        intent = os.path.join(root, ".claude", "canon.intent.yaml")
        if not os.path.exists(intent):
            return {"project": name, "klass": "needs-bootstrap"}
        # --root у canon-delta - глобальный флаг (ДО субкоманды)
        res = delta_call(["--root", root, "plan", "--lock", lock_file])
        out = {"project": name, "klass": res["klass"]}
        v = res.get("verdict")
        if isinstance(v, dict):
            if "counts" in v:
                out["counts"] = v["counts"]
            if "release_ready" in v:
                out["release_ready"] = v["release_ready"]
        if res["klass"] in ("incompat", "unknown"):
            out["detail"] = res.get("stderr", "")[:200]
        return out
    finally:
        if cleanup:
            cleanup()


def _run_git(root: str, *args: str):
    import subprocess
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)


def gh_call(args: list[str], cwd: str, timeout: int = 120):
    """gh CLI (env CLAUDE_CANON_GH для мока). Возвращает CompletedProcess;
    таймаут не пробрасывается исключением - возвращается rc=124 (transient
    для вызывающих, проход не роняет)."""
    import subprocess
    gh = os.environ.get("CLAUDE_CANON_GH", "gh")
    try:
        return subprocess.run([gh, *args], capture_output=True, text=True,
                              cwd=cwd, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess([gh, *args], 124, "", "gh timeout")


def project_cursor_path(name: str) -> str:
    return os.path.join(canon_dir(), "state", f"{name}.json")


def save_project_cursor(name: str, cur: dict) -> None:
    durable_write_json(project_cursor_path(name), cur)


def load_project_cursor(name: str) -> dict:
    """Битый cursor - беда ОДНОГО проекта, не машины: не die (SystemExit
    пролетел бы мимо per-project изоляции), а CloneHeld -> held-corrupt-cursor.
    Разруливается вручную (удалить/починить canon/state/<name>.json)."""
    try:
        with open(project_cursor_path(name), encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError):
        raise CloneHeld("corrupt-cursor")
    if not isinstance(data, dict):
        raise CloneHeld("corrupt-cursor")
    return data


def _cursor_phase(cur: dict) -> str:
    """Фаза FSM (§4): явная из cursor v2, для legacy-формата выводится из
    полей (applied-bool -> applied, pr_number -> candidate, пусто -> idle)."""
    if not cur:
        return "idle"
    if cur.get("phase"):
        return cur["phase"]
    if cur.get("applied"):
        return "applied"
    if cur.get("pr_number") is not None:
        return "candidate"
    return "idle"


def cursor_transition(name: str, to_phase: str, expect: dict | None = None,
                      drop: tuple = (), **fields) -> bool:
    """Durable CAS-переход cursor (§4.5б): перечитать файл, сверить expected-поля
    по текущему содержимому, записать атомарно. CAS-fail -> False, файл не
    тронут (вызывающий трактует как transient: мир сдвинулся под ногами)."""
    cur = load_project_cursor(name)
    if expect:
        for k, v in expect.items():
            if cur.get(k) != v:
                log("cursor-cas-fail", project=name, field=k,
                    expected=str(v)[:40], actual=str(cur.get(k))[:40])
                return False
    cur["phase"] = to_phase
    cur.update(fields)
    for k in drop:
        cur.pop(k, None)
    save_project_cursor(name, cur)
    return True


def _default_branch(clone: str) -> str:
    r = _run_git(clone, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if r.returncode == 0:
        return r.stdout.strip().split("/", 1)[1]
    for cand in ("main", "master"):
        if _run_git(clone, "rev-parse", "--verify", "-q", f"origin/{cand}").returncode == 0:
            return cand
    raise CloneHeld("no-default-branch")


def _pr_state(clone: str, pr_number) -> str | None:
    """Судьба PR через gh (§15.5): MERGED / CLOSED / OPEN. None = не удалось
    узнать (gh недоступен, мусорный ответ) - трактуется транзиентно, held по
    неподтвержденному состоянию НЕ защелкивается."""
    r = gh_call(["pr", "view", str(pr_number), "--json", "state"], cwd=clone)
    if r.returncode != 0:
        return None
    try:
        parsed = json.loads(r.stdout or "{}")
        st = parsed.get("state") if isinstance(parsed, dict) else None
    except json.JSONDecodeError:
        return None
    return st if st in ("MERGED", "CLOSED", "OPEN") else None


def _branch_conflicts_base(clone: str, base: str, branch_ref: str) -> bool:
    """Детект 'main ушел вперед С КОНФЛИКТОМ против PR-ветки' (§15.5) локальным
    merge-tree (git >= 2.38): exit 1 = конфликт. Прочие коды (старый git,
    ошибка) = считаем чистым: детект вспомогательный, без него PR просто
    останется conflicting на GitHub - не повод мутировать."""
    r = _run_git(clone, "merge-tree", "--write-tree", "--no-messages",
                 base, branch_ref)
    return r.returncode == 1


# классы delta, совместимые с applied: точное совпадение байт либо путь
# осознанно/структурно вне применимого scope. local-edit сюда НЕ входит:
# post-merge правка человека = расхождение дерева с релизом -> held (§5, T3)
_T3_OK_CLASSES = {"up-to-date", "managed-but-excluded", "retired-from-scope"}


def _drop_temp_worktree(clone: str, wt: str, tmp: str) -> None:
    """Убрать ВРЕМЕННЫЙ worktree со сходимостью: сбойный remove (например,
    каталог уже исчез) не оставляет stale-регистрацию - каталог сносится, а
    сирота вычищается prune. Иначе каждый проход копил бы записи в
    .git/worktrees/ (r3-находка). Только для наших one-shot worktree
    (t3/observe) - durable candidate-worktree убирается отдельно, под гардом."""
    import shutil
    r = _run_git(clone, "worktree", "remove", "--force", wt)
    shutil.rmtree(tmp, ignore_errors=True)
    if r.returncode != 0:
        _run_git(clone, "worktree", "prune")


def _t3_verdict_applied(res: dict) -> bool:
    """Строгая интерпретация недоверенного classify-вердикта: applied только
    при непустом списке items, каждый item - dict с klass из _T3_OK_CLASSES.
    Пустой items (пустой канон / усеченный вывод) НЕ проходит: vacuous truth
    здесь означала бы терминальный applied без единого проверенного пути."""
    # только чистый exit 0: код 10 (conflicts) с allowlist-items - противоречие
    # недоверенного вывода, а не applied (r1-#3)
    if res.get("code") != 0:
        return False
    items = (res.get("verdict") or {}).get("items")
    if not isinstance(items, list) or not items:
        return False
    return all(isinstance(it, dict) and it.get("klass") in _T3_OK_CLASSES
               for it in items)


def t3_applied_check(clone: str, lock_file: str, commit: str) -> tuple[bool, str | None]:
    """T3-предикат (§15.4, T3): канон ПРИСУТСТВУЕТ БАЙТАМИ в post-merge main-tree.
    НЕ событие merge: delta `classify` на detached-worktree от origin/<default>;
    applied только если КАЖДЫЙ путь в {up-to-date, managed-but-excluded,
    retired-from-scope}. Строже plan-гейта: local-edit/outdated/new/conflict -
    любое расхождение байт -> False. Единая функция для FSM-applied и
    harvester mark-applied (T25). Возвращает (applied, sha ПРОВЕРЕННОГО снимка
    default-ветки) - в cursor фиксируется именно проверенный sha, а не более
    поздний rev-parse (иначе гонка с параллельным мерджем пишет непроверенное)."""
    import tempfile
    base_ref = f"origin/{_default_branch(clone)}"
    base_sha = _run_git(clone, "rev-parse", base_ref).stdout.strip() or None
    tmp = tempfile.mkdtemp(prefix=".t3-check-", dir=os.path.dirname(clone))
    wt = os.path.join(tmp, "main")
    try:
        r = _run_git(clone, "worktree", "add", "--detach", wt, base_sha or base_ref)
        if r.returncode != 0:
            return False, base_sha
        res = delta_call(["--root", wt, "classify", "--lock", lock_file])
        if os.environ.get("CANON_T3_DEBUG"):
            v = res.get("verdict") or {}
            sys.stderr.write(f"T3DBG code={res['code']} summary={v.get('summary')} "
                             f"lock={lock_file} stderr={res.get('stderr','')[:150]}\n")
        applied = _t3_verdict_applied(res)
        if applied:
            # страховка от усеченного недоверенного items: classify строит
            # union ⊇ пути state.file_hashes, поэтому все пути state ПРОВЕРЯЕМОГО
            # дерева обязаны присутствовать в вердикте. Отсутствующий/битый
            # state -> False: наш PR всегда везет state, канон без него в
            # main-tree оказался не нашим путем - пусть цикл доедет штатно
            st = None
            try:
                with open(os.path.join(wt, ".claude", "canon.state.json"),
                          encoding="utf-8") as f:
                    st = json.load(f)
                fh = st.get("file_hashes") if isinstance(st, dict) else None
                state_paths = set(fh.keys()) if isinstance(fh, dict) else None
            except (OSError, json.JSONDecodeError):
                state_paths = None
            got = {it.get("path") for it in res["verdict"]["items"]}
            if state_paths is None or not state_paths <= got:
                applied = False
            # r1-#4/r2-#4: state ПРОВЕРЯЕМОГО дерева обязан фиксировать ИМЕННО
            # этот релиз (applied_release.commit_sha == target). Сверять items
            # с путями lock нельзя - membership-scoped файлы (project_type вне
            # секции) законно отсутствуют в вердикте (r2). А applied_release
            # пишет только ПОЛНЫЙ успешный sync этого релиза (release-wide
            # gate части (a)) - усеченный stdout classify это поле не подделает,
            # и актуальный state сам тянет НОВЫЕ пути релиза в state_paths
            rel = st.get("applied_release") if isinstance(st, dict) else None
            if not isinstance(rel, dict) or rel.get("commit_sha") != commit:
                applied = False
        return applied, base_sha
    finally:
        _drop_temp_worktree(clone, wt, tmp)


def _wt_holds_foreign(wt: str, upstream: str) -> str | None:
    """Чужая работа в НАШЕМ durable worktree: незакоммиченные изменения (кроме
    рантайм-путей delta) либо коммиты постороннего committer поверх upstream.
    Возвращает описание или None. Гард перед любым worktree remove --force:
    снос уничтожил бы единственную ссылку на непушенную человеческую работу (И1)."""
    st = _run_git(wt, "status", "--porcelain")
    if st.returncode == 0:
        dirt = [ln for ln in st.stdout.splitlines()
                if ln[3:] and not ln[3:].startswith(".claude/.canon-")]
        if dirt:
            return f"dirty: {dirt[0][:80]}"
    lg = _run_git(wt, "log", "--format=%ce", f"{upstream}..HEAD")
    if lg.returncode == 0:
        alien = [ce for ce in lg.stdout.split() if ce != "canon-maintainer@local"]
        if alien:
            return f"чужой коммит ({alien[0]})"
    return None


def _terminalize_live_wal(name: str, wt: str, mirror: str) -> dict | None:
    """§4.5(а): живой WAL delta (journal в worktree) блокирует новое намерение
    и снос дерева - сперва recover (терминализация roll-forward/back), потом
    продолжение. Возвращает held-вердикт или None (путь чист)."""
    if not os.path.exists(os.path.join(wt, ".claude", ".canon-journal.json")):
        return None
    res = delta_call(["--root", wt, "recover", "--mirror", mirror])
    if res["klass"] != "ok":
        return {"project": name, "klass": "held-recovery",
                "detail": f"live-WAL не терминализирован: {res['klass']}"}
    return None


def _close_applied(name: str, clone: str, ref: str, branch: str,
                   commit: str, main_sha: str | None) -> dict:
    """Замкнуть цикл релиза: cursor.applied (с sha ПРОВЕРЕННОГО T3-снимка) +
    уборка worktree/веток. Remote-ветка удаляется ТОЛЬКО под CAS (lease на наш
    последний push): чужой хвост или незнакомая ветка остаются человеку.
    Ошибки уборки не блокируют applied (следующий проход доубирает не сможет -
    fast-path; поэтому остатки фиксируются в detail для digest)."""
    notes: list[str] = []
    cur = load_project_cursor(name)
    wt = os.path.join(canon_dir(), "worktrees", name, ref)
    keep_local = False
    if os.path.isdir(wt):
        remote_alive = _run_git(clone, "rev-parse", "--verify", "-q",
                                f"origin/{branch}").returncode == 0
        upstream = f"origin/{branch}" if remote_alive \
            else f"origin/{_default_branch(clone)}"
        foreign = _wt_holds_foreign(wt, upstream)
        if foreign:
            keep_local = True
            notes.append(f"worktree оставлен: {foreign}")
        else:
            r = _run_git(clone, "worktree", "remove", "--force", wt)
            if r.returncode != 0:
                notes.append(f"worktree remove: {r.stderr.strip()[:80]}")
    if not keep_local:
        _run_git(clone, "worktree", "prune")
        _run_git(clone, "branch", "-D", branch)  # отсутствие - норма
    lease = cur.get("pr_head_sha")
    if lease:
        remote_sha = _run_git(clone, "rev-parse", "--verify", "-q",
                              f"origin/{branch}").stdout.strip()
        if remote_sha and remote_sha == lease:
            r = _run_git(clone, "push",
                         f"--force-with-lease={branch}:{lease}",
                         "origin", f":{branch}")
            if r.returncode != 0:
                notes.append(f"remote delete: {r.stderr.strip()[:80]}")
        elif remote_sha:
            notes.append(f"remote-ветка оставлена: sha != наш последний push")
    _fault("pre-applied-cursor")
    # gate B (§4.2): applied-подтверждение durable ПОСЛЕ T3; безусловный
    # переход - post-merge-truth главнее любого ожидания в cursor
    cursor_transition(name, "applied", release=ref, applied=True,
                      applied_commit=commit, applied_main_sha=main_sha,
                      drop=("pr_head_sha",))
    v = {"project": name, "klass": "applied", "release": ref}
    if notes:
        v["detail"] = "; ".join(notes)[:200]
    return v


def _read_recovery_conflicts(wt: str) -> list:
    """§9.3: recovery_conflicts из delta-state worktree (часть (a) пишет их
    durable) - в digest. Битый/отсутствующий state = пусто, не ошибка."""
    try:
        with open(os.path.join(wt, ".claude", "canon.state.json"),
                  encoding="utf-8") as f:
            st = json.load(f)
        rc = st.get("recovery_conflicts") if isinstance(st, dict) else None
        return rc if isinstance(rc, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def _smoke_timeout() -> int:
    try:
        return max(1, int(os.environ.get("CLAUDE_CANON_SMOKE_TIMEOUT", "300")))
    except ValueError:
        return 300


def _smoke_check(name: str, wt: str, spec: dict, branch: str) -> dict | None:
    """§7: semantic smoke в candidate worktree ДО push/PR. Команды: smoke_cmd
    проекта (fleet.yaml) либо глобальная CLAUDE_CANON_SMOKE_CMD (на VM -
    'claude грузит .claude'), затем target_cmd проекта; ни одной не задано -
    smoke пропускается. Результат durable в canon/smoke/<name>.json с fencing
    по head-sha кандидата: чужой/устаревший SHA не принимается, неизменный
    кандидат не перегоняется (кэш и pass, и fail; форс - удалить файл).
    Возвращает held-вердикт или None (пройдено/нечего гонять).
    held-smoke - breaker-предикат (§6.2); timeout НЕ защелкивает (транзиентен),
    но кольцо мягко держится. Зависший smoke ограничен per-project timeout -
    проход остальных не падает (bulkhead §7.4)."""
    import subprocess
    cmds = []
    if spec.get("smoke_cmd"):
        cmds.append(("smoke_cmd", spec["smoke_cmd"]))
    elif os.environ.get("CLAUDE_CANON_SMOKE_CMD"):
        cmds.append(("smoke_cmd", os.environ["CLAUDE_CANON_SMOKE_CMD"]))
    if spec.get("target_cmd"):
        cmds.append(("target_cmd", spec["target_cmd"]))
    if not cmds:
        return None
    import hashlib
    # r1-#8: кэш валиден только для ТОЙ ЖЕ пары (кандидат, команды) - смена
    # smoke_cmd/target_cmd при неизменном head обязана перегнать проверку
    cmds_sig = hashlib.sha256(
        "\x00".join(c for _, c in cmds).encode("utf-8")).hexdigest()[:16]
    head = _run_git(wt, "rev-parse", "HEAD").stdout.strip()
    res_path = os.path.join(canon_dir(), "smoke", f"{name}.json")
    try:  # битый кэш = перегон, не die (r2-Д4-класс: не ронять проход)
        with open(res_path, encoding="utf-8") as f:
            prev = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        prev = {}
    if isinstance(prev, dict) and prev.get("head_sha") == head \
            and prev.get("cmds_sig") == cmds_sig:
        exits = prev.get("exits")
        # fail-кэш валиден любой длины (break после первого fail); pass-кэш
        # обязан покрыть ВСЕ команды - пустой/усеченный all-zero = перегон
        # (r2-#8, r3-#8)
        if isinstance(exits, list) and exits:
            if any(e != 0 for e in exits):
                return {"project": name, "klass": "held-smoke",
                        "detail": f"smoke fail (кэш {head[:12]}): exits={exits}"}
            if len(exits) == len(cmds):
                return None
    exits = []
    for kind, cmd in cmds:
        try:
            r = subprocess.run(["sh", "-c", cmd], cwd=wt, capture_output=True,
                               text=True, timeout=_smoke_timeout())
        except subprocess.TimeoutExpired:
            return {"project": name, "klass": "held-smoke-timeout",
                    "detail": f"{kind} превысил {_smoke_timeout()}s"}
        exits.append(r.returncode)
        if r.returncode != 0:
            break
    durable_write_json(res_path, {
        "head_sha": head, "branch": branch, "exits": exits,
        "cmds_sig": cmds_sig, "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    })
    if any(e != 0 for e in exits):
        return {"project": name, "klass": "held-smoke",
                "detail": f"smoke fail: exits={exits}"}
    return None


def candidate_flow(name: str, spec: dict, clone: str, ref: str, commit: str,
                   lock_file: str, mirror: str, pass_id: str = "") -> dict:
    """armed-поток модели B (§15.2): worktree от origin/<default> + ветка
    canon/<vN> (детерминированное имя = идемпотентность), внутри - delta sync
    (WAL-apply делает toolkit), успех коммитится в ветку. Push+PR - T11.
    Конфликт (exit 10) -> held-conflicts, свежая ветка убирается."""
    branch = "canon/" + (ref[len("canon-"):] if ref.startswith("canon-") else ref)

    # 0) post-merge scan (T12, §15.4): канон уже байтами в main-tree -> applied,
    # замкнуть и убрать candidate-артефакты. Проверяется ДО веткостроения.
    cur = load_project_cursor(name)
    if _cursor_phase(cur) == "applied" and cur.get("release") == ref:
        return {"project": name, "klass": "applied", "release": ref}
    t3_ok, t3_sha = t3_applied_check(clone, lock_file, commit)
    if t3_ok:
        return _close_applied(name, clone, ref, branch, commit, t3_sha)
    if cur.get("release") == ref and cur.get("pr_number") is not None:
        # наш PR по этому релизу был запушен, а T3 не сошелся и remote-ветки
        # нет. Реакцию решает судьба PR (§15.5): MERGED - дерево подменили при
        # мердже -> mismatch; CLOSED - человек отклонил канон -> held до ack,
        # PR НЕ пересоздаем; OPEN - ветку снесли руками, PR жив -> пересоздание
        # штатным потоком ниже; неизвестно -> транзиентный пропуск
        remote_alive = _run_git(clone, "rev-parse", "--verify", "-q",
                                f"origin/{branch}").returncode == 0
        if not remote_alive:
            state = _pr_state(clone, cur["pr_number"])
            if state == "MERGED":
                return {"project": name, "klass": "held-post-merge-mismatch",
                        "detail": "PR смерджен, но main-tree != канону"}
            if state == "CLOSED":
                return {"project": name, "klass": "held-pr-closed",
                        "detail": f"PR #{cur['pr_number']} закрыт без мерджа"}
            if state is None:
                return {"project": name, "klass": "transient",
                        "detail": "судьба PR неизвестна (gh pr view не ответил)"}

    default_branch = _default_branch(clone)
    base = f"origin/{default_branch}"
    wt = os.path.join(canon_dir(), "worktrees", name, ref)
    branch_existed = _run_git(clone, "rev-parse", "--verify", "-q", branch).returncode == 0
    remote_branch = _run_git(clone, "rev-parse", "--verify", "-q", f"origin/{branch}").returncode == 0

    # §15.5: default-ветка ушла вперед и КОНФЛИКТУЕТ с PR-веткой. Контент ветки
    # детерминирован парой (main, lock), поэтому вместо rebase - recreate от
    # свежего main; push дальше только с force-with-lease на наш прежний sha.
    force_lease = None
    if remote_branch and _branch_conflicts_base(clone, base, f"origin/{branch}"):
        remote_sha = _run_git(clone, "rev-parse", f"origin/{branch}").stdout.strip()
        if cur.get("pr_head_sha") != remote_sha:
            return {"project": name, "klass": "held-foreign-commits",
                    "detail": f"конфликт с {base} + чужие коммиты в origin/{branch}"}
        if os.path.isdir(wt):
            foreign = _wt_holds_foreign(wt, f"origin/{branch}")
            if foreign:
                return {"project": name, "klass": "held-foreign-commits",
                        "detail": f"в worktree: {foreign}"}
            held = _terminalize_live_wal(name, wt, mirror)
            if held:
                return held
            _run_git(clone, "worktree", "remove", "--force", wt)
        _run_git(clone, "worktree", "prune")
        _run_git(clone, "branch", "-D", branch)
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        r = _run_git(clone, "worktree", "add", wt, "-B", branch, base)
        if r.returncode != 0:
            return {"project": name, "klass": "held-worktree", "detail": r.stderr.strip()[:200]}
        branch_existed = True
        force_lease = remote_sha

    if not os.path.isdir(wt):
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        _run_git(clone, "worktree", "prune")  # сироты от снесенных каталогов
        if branch_existed:
            r = _run_git(clone, "worktree", "add", wt, branch)
        elif remote_branch:
            # локальная ветка потеряна, remote жива. CAS по cursor (§15.5):
            # продолжаем ТОЛЬКО если origin/<branch> == наш последний push;
            # иначе в ветке чужие коммиты -> held, не строим поверх молча.
            remote_sha = _run_git(clone, "rev-parse", f"origin/{branch}").stdout.strip()
            cur = load_project_cursor(name)
            if cur.get("pr_head_sha") != remote_sha:
                return {"project": name, "klass": "held-foreign-commits",
                        "detail": f"origin/{branch}={remote_sha[:12]} != cursor"}
            r = _run_git(clone, "worktree", "add", wt, "-b", branch, f"origin/{branch}")
            branch_existed = True  # наша remote-история = ветка существовала
        else:
            base = f"origin/{_default_branch(clone)}"
            r = _run_git(clone, "worktree", "add", wt, "-b", branch, base)
        if r.returncode != 0:
            return {"project": name, "klass": "held-worktree", "detail": r.stderr.strip()[:200]}

    # T26 (§11): bootstrap - проект без intent/state. Старый canon.yaml ->
    # canon-migrate в worktree (расщепление уедет в PR вместе с каноном);
    # нет и его -> проект не подключен, не мутируем (needs-bootstrap).
    # r1-#7: migrate пишет intent/state/ledger НЕ транзакционно - при живом
    # canon.yaml неполная тройка означает оборванную миграцию, перегоняем
    # --force (worktree одноразовый, человеческих правок в нем еще нет)
    _wtp = lambda *p: os.path.join(wt, ".claude", *p)
    migrated = all(os.path.exists(_wtp(f)) for f in
                   ("canon.intent.yaml", "canon.state.json", "canon.ledger.json"))
    if not os.path.exists(_wtp("canon.intent.yaml")) or \
            (os.path.exists(_wtp("canon.yaml")) and not migrated):
        import subprocess
        if not os.path.exists(_wtp("canon.yaml")):
            _run_git(clone, "worktree", "remove", "--force", wt)
            if not branch_existed:
                _run_git(clone, "branch", "-D", branch)
            return {"project": name, "klass": "needs-bootstrap",
                    "detail": "нет ни canon.intent.yaml, ни canon.yaml"}
        # r2-#7: --force не перегоняется поверх человеческой работы в living
        # worktree. Артефакты самой оборванной миграции (intent/state/ledger)
        # человеческими НЕ считаются - иначе partial-crash не самолечился бы
        own = {".claude/canon.intent.yaml", ".claude/canon.state.json",
               ".claude/canon.ledger.json"}
        st_r = _run_git(wt, "status", "--porcelain")
        dirt = [ln[3:] for ln in st_r.stdout.splitlines()
                if ln[3:] and not ln[3:].startswith(".claude/.canon-")
                and ln[3:] not in own] if st_r.returncode == 0 else []
        lg = _run_git(wt, "log", "--format=%ce", f"{base}..HEAD")
        alien = [ce for ce in lg.stdout.split()
                 if ce != "canon-maintainer@local"] if lg.returncode == 0 else []
        if dirt or alien:
            what = f"dirty: {dirt[0][:80]}" if dirt \
                else f"чужой коммит ({alien[0]})"
            return {"project": name, "klass": "held-migrate",
                    "detail": f"worktree держит работу: {what}"[:200]}
        try:
            mr = subprocess.run([*migrate_bin(), "--root", wt, "--force"],
                                capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            return {"project": name, "klass": "held-migrate",
                    "detail": f"canon-migrate: {e}"[:200]}
        if mr.returncode != 0:
            return {"project": name, "klass": "held-migrate",
                    "detail": f"canon-migrate rc={mr.returncode}: "
                              f"{mr.stderr.strip()[:150]}"}
        log("bootstrap-migrated", project=name)

    # §4.5(а): живой WAL терминализируется ДО нового намерения
    held = _terminalize_live_wal(name, wt, mirror)
    if held:
        return held
    # gate A (§4.2): намерение durable ДО вызова delta; CAS по applied_commit -
    # если applied сдвинулся под ногами, снимок потока устарел. Поля
    # applied/applied_main_sha описывают ПРОШЛЫЙ релиз - при новом намерении
    # вычищаются (иначе legacy-бул applied лжет рядом с phase=candidate)
    if not cursor_transition(name, "candidate",
                             expect={"applied_commit": cur.get("applied_commit")},
                             drop=("applied", "applied_main_sha"),
                             desired_commit=commit, release=ref,
                             ring=spec.get("ring", "rest"), pass_id=pass_id):
        return {"project": name, "klass": "transient",
                "detail": "cursor CAS не сошелся (intent)"}
    _fault("intent-recorded")

    res = delta_call(["--root", wt, "sync", "--lock", lock_file,
                      "--mirror", mirror, "--target", commit])
    if res["klass"] != "ok":
        if res["klass"] == "conflicts":
            # T23 (§9): worktree и ветка ЖИВУТ - digest дает resolve-команды
            # на это дерево; человек резолвит, следующий проход подхватывает
            # resolution в кандидата. Remote не мутирован (push не было).
            klass = "held-rebase-conflict" if force_lease else "held-conflicts"
            v = {"project": name, "klass": klass,
                 "detail": res.get("stderr", "")[:200]}
            items = (res.get("verdict") or {}).get("items")
            if isinstance(items, list):
                esc = [{"path": it.get("path"), "klass": it.get("klass")}
                       for it in items if isinstance(it, dict) and
                       it.get("klass") in ("conflict", "untracked-collision",
                                           "removed-upstream")]
                if esc:
                    v["escalations"] = esc
                    v["resolve_root"] = wt
                    v["lock_file"] = lock_file
            recov = _read_recovery_conflicts(wt)
            if recov:
                v["recovery_conflicts"] = recov
            return v
        # transient/incompat/recovery: одноразовый ЧИСТЫЙ worktree убрать;
        # свежесозданную ветку не оставлять; пересозданную recreate-ветку тоже
        # (ее база - main без канона, промежуточный артефакт вводит в
        # заблуждение). Но (r1-#1/#2): живой WAL терминализируется ДО сноса,
        # а dirty-дерево (человеческий resolve в living worktree после
        # conflicts) сносить нельзя - это единственная копия работы
        held = _terminalize_live_wal(name, wt, mirror)
        if held:
            return held
        upstream = f"origin/{branch}" if remote_branch else base
        foreign = _wt_holds_foreign(wt, upstream)
        if foreign:
            return {"project": name, "klass": res["klass"],
                    "detail": (f"worktree сохранен ({foreign}); "
                               + res.get("stderr", ""))[:200]}
        _run_git(clone, "worktree", "remove", "--force", wt)
        if not branch_existed or force_lease:
            _run_git(clone, "branch", "-D", branch)
        return {"project": name, "klass": res["klass"],
                "detail": res.get("stderr", "")[:200]}
    _fault("delta-ok")

    # закоммитить материализованный канон (включая .claude/canon.state.json);
    # рантайм-артефакты delta (замок/журнал/стейдж/бэкап) в PR НЕ едут;
    # reset: add с исключающим pathspec не снимает УЖЕ застейдженную запись
    # вне pathspec - чистим индекс перед пересборкой;
    # нет изменений (повторный проход) - no-op, коммиты не плодятся
    _run_git(wt, "reset", "-q")
    _run_git(wt, "add", "-A", "--",
             ":!.claude/.canon-lock", ":!.claude/.canon-journal.json",
             ":!.claude/.canon-stage", ":!.claude/.canon-bak")
    if _run_git(wt, "diff", "--cached", "--quiet").returncode != 0:
        r = _run_git(wt, "-c", "user.name=canon-maintainer",
                     "-c", "user.email=canon-maintainer@local",
                     "commit", "-q", "-m", f"canon: sync {ref}")
        if r.returncode != 0:
            return {"project": name, "klass": "held-commit", "detail": r.stderr.strip()[:200]}
    _fault("committed")
    # нечего предлагать: ветка не отличается от базы (канон уже в main) -> без PR
    ahead = _run_git(wt, "rev-list", "--count", f"{base}..{branch}")
    if ahead.returncode == 0 and ahead.stdout.strip() == "0":
        _run_git(clone, "worktree", "remove", "--force", wt)
        if not branch_existed:
            _run_git(clone, "branch", "-D", branch)
        return {"project": name, "klass": "up-to-date-no-pr"}

    held = _smoke_check(name, wt, spec, branch)
    if held:
        return held
    return _push_and_pr(name, spec, wt, clone, branch, ref, commit, force_lease)


def _push_and_pr(name: str, spec: dict, wt: str, clone: str, branch: str, ref: str,
                 commit: str, force_lease: str | None = None) -> dict:
    """T11 (§15.3): судьба PR ветки -> push -> pr create. Порядок жесткий:
    СНАЧАЛА gh pr list --state all (история ветки не зависит от cursor -
    переживает потерю state после crash между create и записью cursor);
    гейты CLOSED/MERGED и недоступный gh срабатывают ДО каких-либо мутаций
    remote. Push: fast-forward = встроенный CAS (дивергенция с чужими
    коммитами -> отказ, held-foreign-commits, НЕ затираем); force_lease
    (recreate-путь §15.5) переписывает ТОЛЬКО поверх нашего прежнего sha.
    pr create fail -> transient (недоступный gh не защелкивает held, И4)."""
    lr = gh_call(["pr", "list", "--head", branch, "--state", "all",
                  "--json", "number,state,headRefOid"], cwd=wt)
    if lr.returncode != 0:
        return {"project": name, "klass": "transient",
                "detail": f"gh pr list не ответил: {lr.stderr.strip()[:150]}"}
    try:
        prs = json.loads(lr.stdout or "[]")
        # схема строгая: недоверенный ответ; "истории нет" разрешает push и
        # create, поэтому мусор обязан давать transient, а не пустую историю
        if not isinstance(prs, list):
            raise ValueError("не list")
        states = {}
        for p in prs:
            n = p.get("number") if isinstance(p, dict) else None
            # type is int: bool - подкласс int, JSON true прошел бы isinstance
            if (type(n) is not int or n <= 0
                    or p.get("state") not in ("OPEN", "CLOSED", "MERGED")):
                raise ValueError("элемент вне схемы")
            states[n] = p["state"]
    except (json.JSONDecodeError, ValueError):
        return {"project": name, "klass": "transient",
                "detail": "gh pr list вернул мусор"}
    # gh --head матчит только same-repo head-ветку (форк был бы user:branch),
    # поэтому вся история списка - PR-ы именно нашей candidate-ветки
    pr_number = next((n for n, s in states.items() if s == "OPEN"), None)
    if pr_number is None and states:
        if "MERGED" in states.values():
            # merged PR этой ветки при T3-false (мы здесь только после
            # несошедшегося шага 0) = дерево разошлось с релизом
            return {"project": name, "klass": "held-post-merge-mismatch",
                    "detail": "PR ветки смерджен, но main-tree != канону"}
        return {"project": name, "klass": "held-pr-closed",
                "detail": f"PR ветки {branch} закрыт без мерджа"}

    push_args = ["push"]
    if force_lease:
        push_args.append(f"--force-with-lease={branch}:{force_lease}")
    r = _run_git(wt, *push_args, "origin", branch)
    if r.returncode != 0:
        err = r.stderr.lower()
        if ("non-fast-forward" in err or "fetch first" in err
                or "stale info" in err or "rejected" in err):
            return {"project": name, "klass": "held-foreign-commits",
                    "detail": r.stderr.strip()[:200]}
        return {"project": name, "klass": "transient", "detail": r.stderr.strip()[:200]}
    _fault("pushed")
    head_sha = _run_git(wt, "rev-parse", "HEAD").stdout.strip()

    if pr_number is None:
        cr = gh_call(["pr", "create", "--head", branch,
                      "--title", f"canon: sync {ref}",
                      "--body", f"Автоматический PR canon-sync (release {ref}). "
                                f"Applied фиксируется по post-merge main-tree (T3)."],
                     cwd=wt)
        if cr.returncode != 0:
            return {"project": name, "klass": "transient",
                    "detail": f"gh pr create не прошел: {cr.stderr.strip()[:150]}"}
        tail = cr.stdout.strip().rsplit("/", 1)
        pr_number = int(tail[1]) if len(tail) == 2 and tail[1].isdigit() else None
    _fault("pr-created")

    # pr-recorded: CAS по desired_commit - намерение (gate A) писал ЭТОТ проход;
    # расхождение = cursor сдвинут извне, снимок устарел -> не пишем
    if not cursor_transition(name, "candidate",
                             expect={"desired_commit": commit},
                             release=ref, branch=branch,
                             pr_number=pr_number, pr_head_sha=head_sha):
        return {"project": name, "klass": "transient",
                "detail": "cursor CAS не сошелся (pr-recorded)"}
    return {"project": name, "klass": "candidate-pr-open",
            "branch": branch, "pr_number": pr_number}


_NEUTRAL_KLASSES = {"applied", "up-to-date-no-pr", "ok", "waiting-ring",
                    "unmanaged"}


def write_digest(pass_id: str, target_ref: str, verdicts: list[dict]) -> str:
    """§9.1: durable digest прохода = источник истины. Шапка-счетчики
    (projects/ok/held/escalations), per-project вердикты; для конфликтов -
    пути с классами и copy-paste resolve-команды на living worktree (§9.3);
    recovery_conflicts из delta-state. НЕ диффы."""
    n_total = len(verdicts)
    n_ok = sum(1 for v in verdicts if v["klass"] in _NEUTRAL_KLASSES
               or v["klass"] == "candidate-pr-open")
    n_held = n_total - n_ok
    n_esc = sum(len(v.get("escalations") or []) for v in verdicts)
    lines = [f"# canon-pass {pass_id}", "", f"target: {target_ref}",
             f"summary: projects={n_total} ok={n_ok} held={n_held} escalations={n_esc}",
             ""]
    try:
        delta = " ".join(delta_bin())
    except SystemExit:  # digest не требует delta; плейсхолдер для команды
        delta = "canon-delta.py"
    for v in verdicts:
        extra = ""
        if "counts" in v:
            extra = " " + json.dumps(v["counts"], ensure_ascii=True, sort_keys=True)
        if v.get("detail"):
            extra += f" - {v['detail']}"
        lines.append(f"- {v['project']}: {v['klass']}{extra}")
        root = v.get("resolve_root")
        for e in v.get("escalations") or []:
            lines.append(f"  - escalation: {e.get('path')} [{e.get('klass')}]")
            if root:
                # r4-#7: пути из недоверенного delta-stdout квотируются -
                # copy-paste команда не должна нести shell-инъекцию
                import shlex
                lines.append(f"    resolve: {delta} --root {shlex.quote(root)} "
                             f"resolve --path {shlex.quote(str(e.get('path')))} "
                             f"--outcome accept "
                             f"--lock {shlex.quote(str(v.get('lock_file')))}  "
                             f"# outcome: accept|keep-local|skip")
        for rc in v.get("recovery_conflicts") or []:
            lines.append(f"  - recovery-conflict: {json.dumps(rc, ensure_ascii=True)[:160]}")
    path = os.path.join(canon_dir(), "digest", f"{pass_id}.md")
    durable_write(path, ("\n".join(lines) + "\n").encode("utf-8"), 0o644)
    return path


def _maybe_alert(target_ref: str, verdicts: list[dict], digest_path: str) -> None:
    """§9.2: пуш шапки через CLAUDE_AGENT_ALERT_CMD (3-арг конвенция агентного
    слоя: name, reason, detail). Шлется только когда есть не-нейтральные
    вердикты И сигнатура эпизода изменилась с прошлого пуша - повторные
    проходы с тем же состоянием не флудят."""
    import hashlib
    import subprocess
    cmd = os.environ.get("CLAUDE_AGENT_ALERT_CMD", "")
    interesting = [v for v in verdicts if v["klass"] not in _NEUTRAL_KLASSES]
    if not cmd or not interesting:
        return
    # r1-#9/r2-#9/r4-#9: в сигнатуре - escalation путь И класс, плюс пути
    # recovery_conflicts: новый файл, смена класса или новый recovery-конфликт
    # того же проекта/klass = НОВЫЙ эпизод, а не повтор
    def _epaths(v: dict) -> str:
        esc = ",".join(sorted(f"{e.get('path')}={e.get('klass')}" for e in
                              (v.get("escalations") or [])
                              if isinstance(e, dict)))
        rc = ",".join(sorted(str(x.get("path")) for x in
                             (v.get("recovery_conflicts") or [])
                             if isinstance(x, dict)))
        return f"{esc};{rc}"
    sig_src = target_ref + "|" + "|".join(
        sorted(f"{v['project']}:{v['klass']}:{_epaths(v)}" for v in interesting))
    sig = hashlib.sha256(sig_src.encode("utf-8")).hexdigest()
    state_path = os.path.join(canon_dir(), "alert.json")
    try:
        with open(state_path, encoding="utf-8") as f:
            prev = json.load(f)
    except (OSError, json.JSONDecodeError):
        prev = {}
    if isinstance(prev, dict) and prev.get("sig") == sig:
        return
    n_held = len(interesting)
    header = (f"canon {target_ref}: {n_held} require attention "
              f"({', '.join(sorted({v['klass'] for v in interesting}))})")
    try:
        # r2-B: команда может нести встроенные аргументы ("claude-agent-tgbot
        # send") - shlex, а не exec одной строки как имени файла
        import shlex
        r = subprocess.run(shlex.split(cmd) +
                           ["canon-maintainer", header, digest_path],
                           capture_output=True, timeout=30)
    except Exception:
        return  # недоставленный алерт не двигает сигнатуру - повторим
    if r.returncode != 0:
        return  # хук сам сообщил о недоставке (r1-#9) - повторим
    durable_write_json(state_path, {"sig": sig})


# T19 (§6.2): circuit breaker. Предикат ЗАЩЕЛКИВАНИЯ - системные ошибки
# раскатки, которые повторятся на следующем кольце: schema/min_cli (incompat),
# неожиданные исключения (error) и красный smoke кандидата (held-smoke, T22).
# Человеческие ситуации (conflicts, foreign, pr-closed) кольцо мягко держит
# гейт T18 без защелки; smoke-timeout транзиентен - тоже без защелки.
_LATCH_KLASSES = ("incompat", "error", "held-smoke")


def latches_path() -> str:
    return os.path.join(canon_dir(), "latches.json")


def load_latches() -> dict:
    d = read_json(latches_path(), {})
    return d if isinstance(d, dict) else {}


def latch_key(ref: str, ring: str) -> str:
    return f"{ref}|{ring}"


def set_latch(ref: str, ring: str, project: str, reason: str) -> None:
    d = load_latches()
    d[latch_key(ref, ring)] = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "project": project, "reason": reason,
    }
    durable_write_json(latches_path(), d)
    log("latch-set", release=ref, ring=ring, project=project, reason=reason)


def clear_latch(ref: str, ring: str) -> bool:
    d = load_latches()
    if latch_key(ref, ring) not in d:
        return False
    d.pop(latch_key(ref, ring))
    durable_write_json(latches_path(), d)
    return True


# T20 (§6.3, F4): бюджет = мутирующих ВХОДОВ на проход (bump-before-action:
# учет durable ДО действия, crash не обходит cap). Reset - атомарной сменой
# pass_id в budget.json (прием usage.json из agent-run).
def budget_cap() -> int:
    try:
        return max(0, int(os.environ.get("CLAUDE_CANON_BUDGET", "10")))
    except ValueError:
        return 10


def budget_bump(pass_id: str) -> bool:
    """True = действие разрешено и учтено. False = cap исчерпан (без записи)."""
    p = os.path.join(canon_dir(), "budget.json")
    d = read_json(p, {})
    if not isinstance(d, dict) or d.get("pass_id") != pass_id:
        d = {"pass_id": pass_id, "used": 0}
    used = int(d.get("used") or 0)
    if used >= budget_cap():
        return False
    d["used"] = used + 1
    durable_write_json(p, d)
    return True


def trigger_marker_path() -> str:
    return cfg_path("CLAUDE_CANON_TRIGGER", "harvest-trigger.json")


def consume_trigger_marker() -> bool:
    """T17 (§5.3): поглотить durable-маркер harvester approve. Читается и
    удаляется ПОД singleton-локом; битое содержимое не мешает (маркер -
    сигнал, не данные)."""
    p = trigger_marker_path()
    if not os.path.exists(p):
        return False
    try:
        os.remove(p)
        fsync_dir(os.path.dirname(p))
    except OSError:
        return False
    return True


def cmd_once(argv: list[str]) -> int:
    """Проход(ы) под одним локом. Цикл - коалесценция триггера (§5.3): маркер,
    записанный harvester'ом ВО ВРЕМЯ прохода, подхватывается повторным циклом
    (иначе ждал бы 12ч таймера: пинок systemctl упирается в lock-busy).
    Cap - защита от шторма approve; остаток подберет следующий проход."""
    with SingletonLock(lock_path()):
        rc = EXIT_OK
        for _round in range(3):
            triggered = consume_trigger_marker()
            rc = _single_pass(triggered)
            if not os.path.exists(trigger_marker_path()):
                break
    return rc


def _single_pass(triggered: bool = False) -> int:
    pass_id = new_pass_id()
    mode = effective_mode()
    extra = {"trigger": "harvester"} if triggered else {}
    log("pass-start", armed=is_armed(), mode=mode, **extra)
    if mode == "observe-first":
        consume_observe_pass()
    projects = load_fleet()
    if not projects:
        try:  # r4-#8: trigger-marker уже поглощен - pending замыкаем и тут
            _scan_pending(mirror_update())
        except Exception as e:
            log("mark-applied-scan", error=f"{type(e).__name__}: {e}"[:200])
        log("pass-end", projects=0)
        return EXIT_OK

    # зеркало + target-ревизия (раз на проход, §5)
    try:
        mirror = mirror_update()
        release = mirror_latest_release(mirror)
        if release is None:
            try:  # r3-A: pending замыкается и проходом без canon-релиза
                _scan_pending(mirror)
            except Exception as e:
                log("mark-applied-scan", error=f"{type(e).__name__}: {e}"[:200])
            log("pass-end", projects=len(projects), note="no-canon-release")
            return EXIT_OK
        ref, commit = release
        lock_text = mirror_lock(mirror, commit)
        if lock_text is None:
            raise MirrorError(f"ревизия {ref} без canon.lock.json (издание сломано?)")
    except MirrorError as e:
        die(str(e), EXIT_TRANSIENT)
    lock_file = os.path.join(canon_dir(), "cache", f"lock-{commit}.json")
    durable_write(lock_file, lock_text.encode("utf-8"), 0o644)
    log("release", ref=ref, commit_sha=commit)

    # per-project: observe -> read-only plan; armed + repo_url + мутирующая
    # policy -> candidate-поток (PR-механика §15). path-проекты (Mac-чекауты)
    # НЕ мутируются никогда (F2) - только observe-вердикт.
    # T18 (§6.1): кольца по порядку canary -> snapshot -> rest; мутирующий
    # поток кольца открыт, только когда ВСЕ мутирующие проекты предыдущих
    # колец пришли к applied/up-to-date на target-релизе (blast-radius);
    # observe-проекты кольца гейт не держат (они не применяют)
    verdicts = []
    by_ring: dict[str, list[str]] = {r: [] for r in RINGS}
    for name in sorted(projects):
        by_ring[projects[name].get("ring", "rest")].append(name)
    ring_blocked = False
    for ring in RINGS:
        # T19: durable latch(release,ring) - жесткий стоп кольца до ручного ack;
        # новый проход НЕ сбрасывает
        ring_latched = latch_key(ref, ring) in load_latches()
        ring_landed = not ring_latched
        for name in by_ring[ring]:
            spec = projects[name]
            mutating = (mode == "armed" and spec.get("repo_url")
                        and spec["policy"] in ("branch", "auto-merge"))
            # r4-#1: заявленный opt-out - проект не трогается вовсе
            if not spec.get("fleet_managed", True):
                v = {"project": name, "klass": "unmanaged",
                     "detail": "fleet_managed: false"}
                log("project-verdict", **v)
                verdicts.append(v)
                continue
            # r4-#2: терминально-applied на target-релизе - гарантированный
            # no-op (шаг 0 candidate_flow), бюджет и clone не тратятся:
            # иначе applied-проекты вечно морили бы pending при низком cap.
            # Битый cursor не решается здесь - уйдет штатным потоком в
            # held-corrupt-cursor
            try:
                cur0 = load_project_cursor(name)
            except CloneHeld:
                cur0 = {}
            if (mutating and _cursor_phase(cur0) == "applied"
                    and cur0.get("release") == ref):
                v = {"project": name, "klass": "applied", "release": ref}
                log("project-verdict", **v)
                verdicts.append(v)
                continue
            if mutating and ring_latched:
                v = {"project": name, "klass": "latched",
                     "detail": f"breaker latch({ref},{ring}) - снять: ack"}
            elif mutating and ring_blocked:
                v = {"project": name, "klass": "waiting-ring",
                     "detail": f"кольцо {ring} ждет applied предыдущих"}
            elif mutating and not budget_bump(pass_id):
                v = {"project": name, "klass": "budget-exhausted",
                     "detail": f"cap {budget_cap()} применений/проход"}
                ring_landed = False
            elif mutating:
                _fault("budget-bumped")
                try:
                    clone = clone_update(name, spec["repo_url"])
                    v = candidate_flow(name, spec, clone, ref, commit,
                                       lock_file, mirror, pass_id)
                except CloneHeld as e:
                    v = {"project": name, "klass": f"held-{e.reason}"}
                except MirrorError as e:
                    v = {"project": name, "klass": "transient", "detail": str(e)[:200]}
                except Exception as e:  # изоляция: один проект не валит проход
                    v = {"project": name, "klass": "error",
                         "detail": f"{type(e).__name__}: {e}"[:200]}
                if v["klass"] not in ("applied", "up-to-date-no-pr"):
                    ring_landed = False
                if v["klass"] in _LATCH_KLASSES:
                    # fail-fast (§6.2): защелка после ПЕРВОГО fail - остаток
                    # кольца в этом же проходе уже не мутируется
                    set_latch(ref, ring, name, v["klass"])
                    _fault("latch-set")
                    ring_latched = True
            else:
                try:
                    v = observe_project(name, spec, lock_file)
                except CloneHeld as e:
                    v = {"project": name, "klass": f"held-{e.reason}"}
                except Exception as e:
                    v = {"project": name, "klass": "error",
                         "detail": f"{type(e).__name__}: {e}"[:200]}
            log("project-verdict", **v)
            verdicts.append(v)
        if not ring_blocked and not ring_landed:
            ring_blocked = True
    digest = write_digest(pass_id, ref, verdicts)
    _maybe_alert(ref, verdicts, digest)
    try:
        # r2-A: harvester-pending замыкается КАЖДЫМ проходом (иначе scan жил
        # только отдельной субкомандой и после мерджа правила pending висел);
        # best-effort - сбой скана не валит вердикты прохода
        _scan_pending(mirror)
    except Exception as e:
        log("mark-applied-scan", error=f"{type(e).__name__}: {e}"[:200])
    log("pass-end", projects=len(projects), digest=digest)
    return EXIT_OK


def cmd_status(argv: list[str]) -> int:
    projects = {}
    for name, spec in load_fleet().items():
        cur = {}
        try:
            cur = load_project_cursor(name)
        except CloneHeld:
            cur = {"phase": "corrupt-cursor"}
        projects[name] = {
            "policy": spec["policy"], "ring": spec["ring"],
            "phase": _cursor_phase(cur),
            "release": cur.get("release"),
        }
    st = armed_state()
    out = {
        "armed": bool(st.get("armed")),
        "mode": effective_mode(),
        "observe_passes_left": int(st.get("observe_passes_left") or 0),
        "latches": load_latches(),
        "projects": projects,
    }
    print(json.dumps(out, ensure_ascii=True, sort_keys=True, indent=2))
    return EXIT_OK


def cmd_arm(argv: list[str]) -> int:
    with SingletonLock(lock_path(), wait=True):
        set_armed(True)
    log("armed", value=True)
    return EXIT_OK


def cmd_disarm(argv: list[str]) -> int:
    # kill-switch ждет конца текущего прохода (секунды): иначе RMW
    # consume_observe_pass бегущего once воскресил бы armed=true (r4-#5)
    with SingletonLock(lock_path(), wait=True):
        set_armed(False)
    log("armed", value=False)
    return EXIT_OK


def cmd_ack(argv: list[str]) -> int:
    """§6.4: снять breaker-latch(release,ring) - ЕДИНСТВЕННЫЙ способ (ручной);
    отсутствие латча - no-op (идемпотентно)."""
    if len(argv) != 2:
        die("usage: ack <release> <ring>", EXIT_VALIDATION)
    release, ring = argv
    with SingletonLock(lock_path(), wait=True):  # r4-#5: не затирать чужой latch
        cleared = clear_latch(release, ring)
    log("ack", release=release, ring=ring,
        result="cleared" if cleared else "no-latch")
    return EXIT_OK


def cmd_mirror(argv: list[str]) -> int:
    """mirror <tag>: обновить зеркало, отрезолвить тег, проверить lock. JSON в stdout."""
    if len(argv) != 1:
        die("usage: mirror <canon-vN>", EXIT_VALIDATION)
    try:
        mirror = mirror_update()
        commit = mirror_resolve(mirror, argv[0])
        lock_text = mirror_lock(mirror, commit)
    except MirrorError as e:
        die(str(e), EXIT_TRANSIENT)
    print(json.dumps({
        "mirror": mirror, "ref": argv[0], "commit_sha": commit,
        "lock_found": lock_text is not None,
    }, ensure_ascii=True, sort_keys=True, indent=2))
    return EXIT_OK


def cmd_recover(argv: list[str]) -> int:
    """r4-#10: обойти durable worktrees и терминализировать живые WAL
    (delta recover per-worktree). Break-glass дополнение к автоматическому
    WAL-гейту candidate-потока."""
    with SingletonLock(lock_path()):
        new_pass_id()
        n = 0
        base = os.path.join(canon_dir(), "worktrees")
        try:
            mirror = mirror_update()
        except MirrorError as e:
            die(str(e), EXIT_TRANSIENT)
        if os.path.isdir(base):
            for name in sorted(os.listdir(base)):
                pdir = os.path.join(base, name)
                if not os.path.isdir(pdir):
                    continue
                for ref in sorted(os.listdir(pdir)):
                    wt = os.path.join(pdir, ref)
                    if not os.path.isdir(wt):
                        continue
                    n += 1
                    held = _terminalize_live_wal(name, wt, mirror)
                    log("recover-worktree", project=name, ref=ref,
                        result=held["klass"] if held else "ok")
        log("recover", worktrees=n)
    return EXIT_OK


def cid_map_path() -> str:
    return os.path.join(canon_dir(), "cid-map.json")


def load_cid_map() -> dict:
    """§10.2: durable cid -> {"path": rule-path, "blob": эталонный blob-sha,
    "reg_head": форензик-метка}. Единственный писатель - maintainer
    (cmd_cid_map). Битый файл = пусто. Легаси-строка (голый path)
    нормализуется без blob - для нее автозамыкание недоказуемо (руками)."""
    try:
        with open(cid_map_path(), encoding="utf-8") as f:
            d = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    if not isinstance(d, dict):
        return {}
    return {k: (v if isinstance(v, dict) else {"path": v})
            for k, v in d.items()}


def cmd_cid_map(argv: list[str]) -> int:
    """cid-map <cid> <rule-path> <blob-sha40>: регистрация при упаковке
    правила в PR к канон-репо. blob - ЭТАЛОННЫЕ байты правила (git
    hash-object <файл> в чекауте упаковщика): терминальный mark-applied
    доказывается контентом в HEAD-дереве, а не появлением пути (r3-#6 -
    чужой файл тем же путем давал false-applied). reg_head пишется как
    форензик-метка. Идемпотентна (та же тройка - no-op); конфликтная
    перезапись отвергается (переезд/обновление правила - руками).
    Под singleton-локом: гонка двух регистраций не теряет запись (r3)."""
    if len(argv) != 3:
        die("usage: cid-map <cid16> <rule-path> <blob-sha40>", EXIT_VALIDATION)
    cid, rule_path, blob = argv
    import re
    if not re.fullmatch(r"[0-9a-f]{16}", cid):
        die(f"cid должен быть 16 hex-символов: {cid}", EXIT_VALIDATION)
    if not re.fullmatch(r"[0-9a-f]{40}", blob):
        die(f"blob должен быть 40 hex-символов (git hash-object): {blob}",
            EXIT_VALIDATION)
    # путь - относительный файл внутри дерева канона (r4-#6): абсолютный,
    # с ".."-компонентами или пустой давал бы гейт вне канон-скоупа
    if (not rule_path or rule_path.startswith("/") or rule_path.endswith("/")
            or ".." in rule_path.split("/")):
        die(f"rule-path должен быть относительным файлом в дереве: {rule_path}",
            EXIT_VALIDATION)
    with SingletonLock(lock_path()):
        d = load_cid_map()
        if cid in d:
            if d[cid]["path"] == rule_path and d[cid].get("blob") == blob:
                log("cid-map", cid=cid, rule_path=rule_path, result="unchanged")
                return EXIT_OK
            die(f"cid {cid} уже зарегистрирован ({d[cid]['path']}) - "
                "переезд/обновление руками", EXIT_VALIDATION)
        try:
            mirror = mirror_update()
        except MirrorError:
            mirror = cfg_path("CLAUDE_CANON_MIRROR", "mirror")  # оффлайн
        reg_head = _git(mirror, "rev-parse", "HEAD", check=False).stdout.strip() \
            if os.path.exists(os.path.join(mirror, "HEAD")) else ""
        d[cid] = {"path": rule_path, "blob": blob, "reg_head": reg_head or None}
        durable_write_json(cid_map_path(), d)
    log("cid-map", cid=cid, rule_path=rule_path, blob=blob, result="added")
    return EXIT_OK


def _scan_pending(mirror: str) -> None:
    """T25 (§10.3): замкнуть harvester-цикл по post-merge-truth КАНОН-репо.
    Для каждого pending-upstream кандидата (harvester `pending`): rule-path
    из cid-map; правило ДОЕХАЛО в HEAD-дерево канон-зеркала (мердж в
    default-ветку канона = принятие; НЕ событие merge и не издание релиза) ->
    `claude-agent-harvest mark-applied` (терминален - гейт стоит ДО вызова).
    Незамапленный cid (правило еще не упаковано) / правило вне дерева /
    существовавший при регистрации путь - пропуск с логом. Идемпотентен:
    applied-кандидаты в pending не приходят. Вызывается под singleton-локом
    (из cmd_once в конце каждого прохода, r2-A, и из cmd_mark_applied_scan);
    транзиентные сбои поднимает MirrorError - лока и exit-политики не решает."""
    import subprocess
    harv = os.environ.get("CLAUDE_HARVEST_BIN", os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "claude-agent-harvest"))
    head = _git(mirror, "rev-parse", "HEAD", check=False).stdout.strip()
    if not head:
        raise MirrorError("зеркало без HEAD")
    try:
        r = subprocess.run([harv, "pending"], capture_output=True,
                           text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise MirrorError(f"harvester pending: {e}")
    if r.returncode != 0:
        raise MirrorError(
            f"harvester pending: rc={r.returncode} {r.stderr.strip()[:150]}")
    cidmap = load_cid_map()
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
            pkey, role, cid = rec["pkey"], rec["role"], rec["cid"]
        except (json.JSONDecodeError, TypeError, KeyError):
            log("mark-applied-scan", skip="bad-record", raw=line[:120])
            continue
        ent = cidmap.get(cid)
        if not ent:
            log("mark-applied-scan", cid=cid, result="not-mapped")
            continue
        rule_path, blob = ent["path"], ent.get("blob")
        if not blob:
            # легаси-запись без эталона байт: терминальный mark-applied
            # недоказуем - только руками (r3-#6)
            log("mark-applied-scan", cid=cid, rule_path=rule_path,
                result="no-blob-unverified")
            continue
        # r1/r2/r3/r4-#6: applied = РЕГУЛЯРНЫЙ ФАЙЛ правила в HEAD-дереве с
        # байтами эталона: ls-tree дает mode+type+sha - symlink (120000, blob
        # от target-строки) и директория (tree) не проходят
        lt = _git(mirror, "ls-tree", head, "--", rule_path, check=False)
        parts = lt.stdout.strip().split(None, 3) if lt.returncode == 0 else []
        if len(parts) < 3:
            log("mark-applied-scan", cid=cid, rule_path=rule_path,
                result="not-in-tree")
            continue
        if parts[1] != "blob" or parts[0] not in ("100644", "100755"):
            log("mark-applied-scan", cid=cid, rule_path=rule_path,
                result="not-a-regular-file")
            continue
        if parts[2] != blob:
            log("mark-applied-scan", cid=cid, rule_path=rule_path,
                result="blob-mismatch")
            continue
        mr = subprocess.run([harv, "mark-applied", pkey, role, cid],
                            capture_output=True, text=True, timeout=60)
        log("mark-applied-scan", cid=cid, rule_path=rule_path,
            result="applied" if mr.returncode == 0
            else f"mark-applied rc={mr.returncode}")


def cmd_mark_applied_scan(argv: list[str]) -> int:
    """CLI-обертка _scan_pending: singleton-лок + свежее зеркало."""
    with SingletonLock(lock_path()):
        new_pass_id()
        try:
            mirror = mirror_update()
            _scan_pending(mirror)
        except MirrorError as e:
            die(str(e), EXIT_TRANSIENT)
    return EXIT_OK


def cmd_rollback(argv: list[str]) -> int:
    """T21 (§17): аварийный откат проекта на ПРЕДЫДУЩУЮ примененную ревизию.
    prev = rollout_record[-2] из canon.state.json origin/<default>-дерева
    (state пишет только delta - здесь читаем); лок прошлой ревизии
    материализуется из зеркала (git show <sha>:canon.lock.json); откат =
    штатный delta sync --target prev (WAL) в rollback-ветку + PR (main
    принадлежит человеку). Latch(latest-release, ring) ставится ДО мутаций:
    таймерные проходы не пере-раскатывают плохой релиз; снятие - только ack.
    Идемпотентна: прерванный откат доигрывается повторным вызовом.
    Автотриггер по smoke-fail подключит T22; команда остается break-glass."""
    if len(argv) != 1:
        die("usage: rollback <project>", EXIT_VALIDATION)
    name = argv[0]
    with SingletonLock(lock_path()):
        new_pass_id()
        projects = load_fleet()
        if name not in projects:
            die(f"{name}: не в fleet.yaml", EXIT_VALIDATION)
        spec = projects[name]
        if not spec.get("repo_url") or spec["policy"] == "observe":
            die(f"{name}: rollback только для repo_url-проектов с мутирующей policy",
                EXIT_VALIDATION)
        try:
            mirror = mirror_update()
            release = mirror_latest_release(mirror)
        except MirrorError as e:
            die(str(e), EXIT_TRANSIENT)
        if release is None:
            die("в зеркале нет релизов canon-vN", EXIT_VALIDATION)
        ref, commit = release
        try:
            clone = clone_update(name, spec["repo_url"])
        except CloneHeld as e:
            die(f"{name}: {e.reason}", EXIT_VALIDATION)
        except MirrorError as e:
            die(str(e), EXIT_TRANSIENT)
        default = _default_branch(clone)
        st_raw = _run_git(clone, "show", f"origin/{default}:.claude/canon.state.json")
        if st_raw.returncode != 0:
            die(f"{name}: canon.state.json отсутствует в origin/{default} - "
                "канон не применялся, откатывать нечего", EXIT_VALIDATION)
        try:
            rr = (json.loads(st_raw.stdout) or {}).get("rollout_record") or []
        except json.JSONDecodeError:
            die(f"{name}: canon.state.json в origin/{default} не парсится", EXIT_VALIDATION)
        if not isinstance(rr, list) or len(rr) < 2:
            die(f"{name}: rollout_record без предыдущей ревизии (записей: "
                f"{len(rr) if isinstance(rr, list) else '?'})", EXIT_VALIDATION)
        prev = rr[-2]
        lock_text = mirror_lock(mirror, prev)
        if lock_text is None:
            die(f"lock ревизии {prev[:12]} не достается из зеркала", EXIT_TRANSIENT)
        lock_file = os.path.join(canon_dir(), "cache", f"lock-{prev}.json")
        durable_write(lock_file, lock_text.encode("utf-8"), 0o644)

        # защелка ДО мутаций (§17.3): будущие проходы не трогают проект/кольцо
        ring = spec.get("ring", "rest")
        if latch_key(ref, ring) not in load_latches():
            set_latch(ref, ring, name, "rollback")
        _fault("rollback-latched")

        branch = f"canon-rollback/{prev[:12]}"
        wt = os.path.join(canon_dir(), "worktrees", name, f"rollback-{prev[:12]}")
        # r2-#5: rollback-worktree ВСЕГДА пересоздается от СВЕЖЕГО
        # origin/<default> - stale wt прошлого отката дал бы ложный
        # rolled-back поверх уехавшего main. Живой WAL и человеческая работа -
        # под теми же гардами, что и candidate-поток
        if os.path.isdir(wt):
            held = _terminalize_live_wal(name, wt, mirror)
            if held:
                log("rollback-verdict", **held)
                return EXIT_OK
            # r3-#5/r4-#3: dirty в rollback-worktree = наш post-image по
            # определению протокола (обрыв между sync и commit; работа руками
            # в worktrees/ запрещена runbook'ом) - сносим без эвристик по
            # формам porcelain (delta детерминирована, wt пересоздается).
            # Чужие КОММИТЫ - закоммиченный труд - держат откат
            lg = _run_git(wt, "log", "--format=%ce", f"origin/{default}..HEAD")
            alien = [ce for ce in lg.stdout.split()
                     if ce != "canon-maintainer@local"] if lg.returncode == 0 else []
            if alien:
                log("rollback-verdict", project=name,
                    klass="held-foreign-commits",
                    detail=f"rollback-worktree: чужой коммит ({alien[0]})")
                return EXIT_OK
            _run_git(clone, "worktree", "remove", "--force", wt)
        # чужие коммиты в remote-ветке отката (человек дополнял rollback-PR)
        # не перезаписываются; свою прежнюю ветку двигаем только под lease
        rb_lease = None
        if _run_git(clone, "rev-parse", "--verify", "-q",
                    f"origin/{branch}").returncode == 0:
            lg = _run_git(clone, "log", "--format=%ce",
                          f"origin/{default}..origin/{branch}")
            alien = [ce for ce in lg.stdout.split()
                     if ce != "canon-maintainer@local"] if lg.returncode == 0 else []
            if alien:
                log("rollback-verdict", project=name,
                    klass="held-foreign-commits",
                    detail=f"origin/{branch}: чужой коммит ({alien[0]})")
                return EXIT_OK
            rb_lease = _run_git(clone, "rev-parse",
                                f"origin/{branch}").stdout.strip()
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        _run_git(clone, "worktree", "prune")
        r = _run_git(clone, "worktree", "add", wt, "-B", branch, f"origin/{default}")
        if r.returncode != 0:
            die(f"worktree: {r.stderr.strip()[:200]}", EXIT_TRANSIENT)
        held = _terminalize_live_wal(name, wt, mirror)
        if held:
            log("rollback-verdict", **held)
            return EXIT_OK
        res = delta_call(["--root", wt, "sync", "--lock", lock_file,
                          "--mirror", mirror, "--target", prev])
        if res["klass"] != "ok":
            log("rollback-verdict", project=name, klass=f"held-{res['klass']}",
                detail=res.get("stderr", "")[:200])
            return EXIT_OK
        _fault("rollback-synced")
        _run_git(wt, "reset", "-q")
        _run_git(wt, "add", "-A", "--",
                 ":!.claude/.canon-lock", ":!.claude/.canon-journal.json",
                 ":!.claude/.canon-stage", ":!.claude/.canon-bak")
        if _run_git(wt, "diff", "--cached", "--quiet").returncode != 0:
            r = _run_git(wt, "-c", "user.name=canon-maintainer",
                         "-c", "user.email=canon-maintainer@local",
                         "commit", "-q", "-m", f"canon: rollback to {prev[:12]}")
            if r.returncode != 0:
                die(f"commit: {r.stderr.strip()[:200]}", EXIT_TRANSIENT)

        # откат уже байтами в origin/<default> (прошлый rollback-PR влит) -
        # ветка не отличается от базы, PR не нужен: честный rolled-back по
        # ДЕРЕВУ, а не по PR-истории (r2-#5)
        ahead = _run_git(wt, "rev-list", "--count", f"origin/{default}..{branch}")
        if ahead.returncode == 0 and ahead.stdout.strip() == "0":
            cursor_transition(name, "rolled-back",
                              rolled_back_from=commit, rolled_back_to=prev,
                              release=ref, pr_number=None,
                              drop=("applied", "applied_main_sha", "pr_head_sha"))
            log("rollback-verdict", project=name, klass="rolled-back",
                to=prev, note="already-in-main")
            return EXIT_OK

        # push + PR (без релизного cursor-CAS: rollback - отдельный поток).
        # Схема списка строгая, как в _push_and_pr: мусор -> transient ДО
        # мутаций, а не тихая пустая история (r1-#5)
        lr = gh_call(["pr", "list", "--head", branch, "--state", "all",
                      "--json", "number,state,headRefOid"], cwd=wt)
        if lr.returncode != 0:
            log("rollback-verdict", project=name, klass="transient",
                detail="gh pr list не ответил - откат не завершен, повторить")
            return EXIT_TRANSIENT
        try:
            prs = json.loads(lr.stdout or "[]")
            if not isinstance(prs, list):
                raise ValueError("не list")
            states = {}
            merged_heads = set()
            for p in prs:
                n = p.get("number") if isinstance(p, dict) else None
                if (type(n) is not int or n <= 0
                        or p.get("state") not in ("OPEN", "CLOSED", "MERGED")):
                    raise ValueError("элемент вне схемы")
                states[n] = p["state"]
                if p["state"] == "MERGED":
                    h = p.get("headRefOid")
                    if not isinstance(h, str) or not h:
                        raise ValueError("MERGED без headRefOid")
                    merged_heads.add(h)
        except (json.JSONDecodeError, ValueError):
            log("rollback-verdict", project=name, klass="transient",
                detail="gh pr list вернул мусор")
            return EXIT_TRANSIENT
        pr_number = next((n for n, s in states.items() if s == "OPEN"), None)
        if pr_number is None and "CLOSED" in states.values():
            log("rollback-verdict", project=name, klass="held-pr-closed",
                detail="rollback-PR закрыт человеком без мерджа")
            return EXIT_OK
        push_args = ["push"]
        if rb_lease:
            push_args.append(f"--force-with-lease={branch}:{rb_lease}")
        r = _run_git(wt, *push_args, "origin", branch)
        if r.returncode != 0:
            log("rollback-verdict", project=name, klass="transient",
                detail=f"push: {r.stderr.strip()[:150]}")
            return EXIT_TRANSIENT
        _fault("rollback-pushed")
        # create гасится только MERGED-историей НАШЕГО текущего head (откат
        # уже влит); historical MERGED другого head (прошлый rollback к тому
        # же prev) НЕ считается - иначе новый откат не был бы предложен (r1-#5)
        rb_head = _run_git(wt, "rev-parse", "HEAD").stdout.strip()
        if pr_number is None and rb_head not in merged_heads:
            cr = gh_call(["pr", "create", "--head", branch,
                          "--title", f"canon: rollback to {prev[:12]}",
                          "--body", f"Аварийный откат канона на ревизию {prev} "
                                    f"(предыдущая примененная, rollout_record[-2])."],
                         cwd=wt)
            if cr.returncode != 0:
                log("rollback-verdict", project=name, klass="transient",
                    detail=f"gh pr create: {cr.stderr.strip()[:150]}")
                return EXIT_TRANSIENT
            tail = cr.stdout.strip().rsplit("/", 1)
            pr_number = int(tail[1]) if len(tail) == 2 and tail[1].isdigit() else None
        _fault("rollback-pr-created")

        # r4-#4: PR отката живет в СВОЕМ поле - pr_number/branch описывают
        # candidate-поток релиза; их наследование заклинивало rollout
        # (candidate_flow принимал merged rollback-PR за судьбу canon/<vN>)
        cursor_transition(name, "rolled-back",
                          rolled_back_from=commit, rolled_back_to=prev,
                          release=ref, rollback_pr_number=pr_number,
                          drop=("applied", "applied_main_sha", "pr_head_sha",
                                "pr_number", "branch"))
        v = {"project": name, "klass": "rolled-back",
             "to": prev, "pr_number": pr_number}
        log("rollback-verdict", **v)
    return EXIT_OK


COMMANDS = {
    "once": cmd_once,
    "status": cmd_status,
    "arm": cmd_arm,
    "disarm": cmd_disarm,
    "ack": cmd_ack,
    "mirror": cmd_mirror,
    "recover": cmd_recover,
    "rollback": cmd_rollback,
    "cid-map": cmd_cid_map,
    "mark-applied-scan": cmd_mark_applied_scan,
}


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        sys.stderr.write(__doc__ or "")
        return EXIT_OK if args else EXIT_VALIDATION
    cmd = args[0].lstrip("-")  # допускаем и `once`, и `--once` (systemd ExecStart)
    fn = COMMANDS.get(cmd)
    if fn is None:
        die(f"неизвестная субкоманда: {args[0]}", EXIT_VALIDATION)
    try:
        return fn(args[1:])
    except OSError as e:
        die(f"disk/IO: {e}", EXIT_DISK)


if __name__ == "__main__":
    sys.exit(main())
