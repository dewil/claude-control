#!/usr/bin/env python3
"""claude-agent-canon-maintainer: детерминированный fleet-reconciler canon-sync (этап 8, часть c).

Контракт: docs/design-2026-07-14-stage8-canon-sync.md §5 (транзакционный слой §10 - в
toolkit canon-delta). План: docs/dev/plan-2026-07-14-stage8-part-c.md, бэклог рядом.

Раскатывает ревизии канона (claude-toolkit, тег canon-vN) по парку проектов. НЕ
LLM-mission: детерминированный проход; канон-механика (classify/WAL-apply/resolution)
исполняется toolkit canon-delta.py как непрозрачным CLI (exit 0/10/1/2/3), maintainer
делает schedule/inventory/budgets/PR-lifecycle/уведомления. canon.state.json проектов
пишет ТОЛЬКО delta - maintainer его читает.

Подкоманды:
  once            один проход по fleet (observe до arm)
  status          сводка armed/cursor/latch/budget (JSON в stdout)
  arm | disarm    включить/выключить мутирующий режим (durable-флаг)
  ack <release> <ring>    снять breaker-latch (только вручную, §5)
  recover         терминализовать хвосты незавершенных транзакций

Env (дефолты):
  CLAUDE_CANON_DIR     ~/.claude-control/canon   durable-состояние maintainer
  CLAUDE_CANON_FLEET   $CLAUDE_CANON_DIR/fleet.yaml   инвентарь fleet
  CLAUDE_CANON_MIRROR  $CLAUDE_CANON_DIR/mirror       полное git-зеркало канона
  CLAUDE_CANON_LOCK    $CLAUDE_CANON_DIR/.lock        singleton-flock (оба триггера)

Все записи durable (tmp+fsync+rename+fsync dir). Exit-коды: 0 ok, 2 validation,
5 lock-busy, 7 disk/unsafe.
"""

import fcntl
import json
import os
import sys
import time
import uuid

# --- exit-коды (конвенция агентного слоя) ---
EXIT_OK = 0
EXIT_VALIDATION = 2
EXIT_TRANSIENT = 3   # сеть/источник недоступен: retry следующим проходом
EXIT_LOCK_BUSY = 5
EXIT_DISK = 7


# =========================================================================
# Конфиг из env
# =========================================================================

def canon_dir() -> str:
    return os.environ.get(
        "CLAUDE_CANON_DIR",
        os.path.join(os.path.expanduser("~"), ".claude-control", "canon"),
    )


def cfg_path(env_key: str, default_rel: str) -> str:
    return os.environ.get(env_key, os.path.join(canon_dir(), default_rel))


# =========================================================================
# Durable-примитивы (прием io/run/части (a): tmp -> write-all -> fchmod -> fsync
# -> rename -> fsync dir)
# =========================================================================

def fsync_dir(path: str) -> None:
    try:
        fd = os.open(path, os.O_RDONLY)
    except (FileNotFoundError, NotADirectoryError):
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _write_all(fd: int, data: bytes) -> None:
    mv = memoryview(data)
    off = 0
    while off < len(data):
        n = os.write(fd, mv[off:])
        if n <= 0:
            raise OSError(f"нулевая запись в fd на off={off}/{len(data)}")
        off += n


def durable_write(path: str, data: bytes, mode: int = 0o600) -> None:
    """Атомарная durable-запись; ENOSPC/EIO -> exit 7 у вызывающего."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f".{os.path.basename(path)}.tmp.{uuid.uuid4().hex}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        _write_all(fd, data)
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    fsync_dir(d)


def durable_write_json(path: str, obj: object) -> None:
    durable_write(path, (json.dumps(obj, ensure_ascii=True, sort_keys=True, indent=2) + "\n").encode("utf-8"))


def read_json(path: str, default: object) -> object:
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as e:
        die(f"битый JSON {path}: {e}", EXIT_DISK)


class SingletonLock:
    """Non-blocking exclusive flock фикс-пути; занято -> exit 5. Оба триггера
    (timer и harvester-marker) берут ЭТОТ ЖЕ путь (§5, находка 10)."""

    def __init__(self, path: str) -> None:
        self.path = path
        self.fd = None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(self.fd)
            self.fd = None
            die("другой проход держит lock", EXIT_LOCK_BUSY)
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)


# =========================================================================
# Лог (машиночитаемый: JSON-строки в stdout) + pass-id
# =========================================================================

_PASS_ID: str | None = None


def new_pass_id() -> str:
    global _PASS_ID
    _PASS_ID = f"{int(time.time())}-{uuid.uuid4().hex[:12]}"
    return _PASS_ID


def log(event: str, **fields) -> None:
    rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event}
    if _PASS_ID:
        rec["pass_id"] = _PASS_ID
    rec.update(fields)
    print(json.dumps(rec, ensure_ascii=True, sort_keys=True))
    sys.stdout.flush()


def die(msg: str, code: int) -> None:
    sys.stderr.write(f"canon-maintainer: {msg}\n")
    sys.exit(code)


# =========================================================================
# Инвентарь fleet.yaml (T02): мини-YAML 2 уровней, stdlib-only (как intent
# в canon-delta части (a); yq на VM не требуем)
# =========================================================================

POLICIES = ("observe", "branch", "auto-merge")
RINGS = ("canary", "snapshot", "rest")
TRACKS = ("stable",)


def _strip_comment(s: str) -> str:
    if " #" in s:
        s = s.split(" #", 1)[0]
    return s.strip()


def parse_fleet_yaml(text: str) -> dict:
    """{name: {key: value}}. Поддержка: 'name:' без отступа, '  key: value' с
    отступом. Значения - скаляры (строки); кавычки снимаются. Комментарии/пустые
    игнорируются. Прочее -> ValueError."""
    fleet: dict = {}
    current: str | None = None
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indented = line[0] in " \t"
        if not indented:
            if not stripped.endswith(":") or " " in stripped[:-1]:
                raise ValueError(f"строка {lineno}: ожидался 'имя-проекта:'")
            current = stripped[:-1]
            if current in fleet:
                raise ValueError(f"строка {lineno}: дубль проекта {current}")
            fleet[current] = {}
        else:
            if current is None:
                raise ValueError(f"строка {lineno}: поле вне проекта")
            if ":" not in stripped:
                raise ValueError(f"строка {lineno}: ожидалось 'key: value'")
            key, _, rest = stripped.partition(":")
            val = _strip_comment(rest)
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            fleet[current][key.strip()] = val
    return fleet


def _is_git_checkout(path: str) -> bool:
    return os.path.exists(os.path.join(path, ".git"))


def validate_fleet(fleet: dict) -> dict:
    """Нормализует и валидирует инвентарь. Ошибка -> ValueError (exit 2).
    R2: локальный не-git путь допускает ТОЛЬКО policy=observe."""
    norm: dict = {}
    for name, spec in fleet.items():
        path = spec.get("path") or None
        repo_url = spec.get("repo_url") or None
        if not path and not repo_url:
            raise ValueError(f"{name}: нужен path или repo_url")
        policy = spec.get("policy", "observe")
        if policy not in POLICIES:
            raise ValueError(f"{name}: policy={policy} вне {POLICIES}")
        ring = spec.get("ring", "rest")
        if ring not in RINGS:
            raise ValueError(f"{name}: ring={ring} вне {RINGS}")
        track = spec.get("track", "stable")
        if track not in TRACKS:
            raise ValueError(f"{name}: track={track} вне {TRACKS}")
        managed = spec.get("fleet_managed", "true").lower() != "false"
        if path and not repo_url and not _is_git_checkout(path) and policy != "observe":
            raise ValueError(f"{name}: не-git путь допускает только policy=observe (R2)")
        norm[name] = {
            "path": path, "repo_url": repo_url, "policy": policy,
            "ring": ring, "track": track, "fleet_managed": managed,
            "smoke_cmd": spec.get("smoke_cmd") or None,
            "target_cmd": spec.get("target_cmd") or None,
        }
    return norm


def load_fleet() -> dict:
    """Инвентарь с диска; отсутствие файла = пустой fleet (0 проектов)."""
    fleet_path = cfg_path("CLAUDE_CANON_FLEET", "fleet.yaml")
    if not os.path.exists(fleet_path):
        return {}
    try:
        with open(fleet_path, encoding="utf-8") as f:
            raw = parse_fleet_yaml(f.read())
        return validate_fleet(raw)
    except ValueError as e:
        die(f"fleet.yaml: {e}", EXIT_VALIDATION)


# =========================================================================
# Host-side зеркало канона (T03, §2/§5): полный клон, fetch раз на проход,
# tag -> commit_sha (ambient identity), lock из git-объектов (не рабочего дерева)
# =========================================================================

def _git(mirror: str, *args: str, check: bool = True):
    import subprocess
    r = subprocess.run(["git", "-C", mirror, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise MirrorError(f"git {' '.join(args[:2])}: {r.stderr.strip()[:300]}")
    return r


class MirrorError(Exception):
    """Transient-сбой зеркала/источника: exit 3, retry следующим проходом."""


def mirror_update() -> str:
    """Клонирует (--mirror) при отсутствии, иначе fetch --prune. Возвращает путь.
    Полный клон обязателен (§2): прошлые lock для отката тянутся git-объектами."""
    import subprocess
    mirror = cfg_path("CLAUDE_CANON_MIRROR", "mirror")
    repo_url = os.environ.get("CLAUDE_CANON_REPO_URL", "git@github.com:dewil/claude-toolkit.git")
    if not os.path.exists(os.path.join(mirror, "HEAD")):
        os.makedirs(os.path.dirname(mirror), exist_ok=True)
        r = subprocess.run(["git", "clone", "--mirror", repo_url, mirror],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise MirrorError(f"clone --mirror: {r.stderr.strip()[:300]}")
    else:
        _git(mirror, "fetch", "--prune", repo_url, "+refs/*:refs/*")
    return mirror


def mirror_resolve(mirror: str, ref: str) -> str:
    """Тег canon-vN -> полный commit_sha (ambient release-identity, §2)."""
    r = _git(mirror, "rev-parse", f"{ref}^{{commit}}", check=False)
    if r.returncode != 0:
        raise MirrorError(f"ref {ref} не найден в зеркале")
    return r.stdout.strip()


def mirror_lock(mirror: str, commit_sha: str) -> str | None:
    """canon.lock.json из git-объектов ревизии (git show <sha>:path)."""
    r = _git(mirror, "show", f"{commit_sha}:canon.lock.json", check=False)
    return r.stdout if r.returncode == 0 else None


def mirror_latest_release(mirror: str) -> tuple[str, str] | None:
    """Последний тег canon-vN (version-sort) -> (ref, commit_sha); None если тегов нет."""
    r = _git(mirror, "tag", "-l", "canon-v*", "--sort=-v:refname", check=False)
    tags = [t for t in r.stdout.splitlines() if t.strip()]
    if not tags:
        return None
    ref = tags[0]
    return ref, mirror_resolve(mirror, ref)


# =========================================================================
# Клоны fleet-репо (T09, §15.1): ~/.claude-control/canon/repos/<name>,
# fetch раз на проход; dirty/detached -> held (не чиним молча)
# =========================================================================

class CloneHeld(Exception):
    """Клон в аномальном состоянии -> вердикт held-<reason>, проход жив."""

    def __init__(self, reason: str) -> None:
        self.reason = reason
        super().__init__(reason)


def clone_update(name: str, repo_url: str) -> str:
    """Клонирует fleet-репо при отсутствии, иначе fetch --prune. Возвращает путь.
    Клон - зона maintainer (не проект пользователя): создание/фетч допустимы и в
    observe. Dirty рабочее дерево -> CloneHeld (кто-то лез руками, не трогаем)."""
    import subprocess
    root = os.path.join(canon_dir(), "repos", name)
    if not os.path.isdir(os.path.join(root, ".git")):
        os.makedirs(os.path.dirname(root), exist_ok=True)
        r = subprocess.run(["git", "clone", repo_url, root], capture_output=True, text=True)
        if r.returncode != 0:
            raise MirrorError(f"clone {name}: {r.stderr.strip()[:300]}")
        return root
    r = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise CloneHeld("broken-clone")
    if r.stdout.strip():
        raise CloneHeld("dirty-clone")
    r = subprocess.run(["git", "-C", root, "fetch", "--prune", "origin"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise MirrorError(f"fetch {name}: {r.stderr.strip()[:300]}")
    return root


# =========================================================================
# Toolkit canon-delta как непрозрачный CLI (T04, граница B §4): потребляем
# ТОЛЬКО exit-код + stdout-как-данные; git-объекты сами не трогаем
# =========================================================================

DELTA_CODE_MAP = {
    0: "ok",          # applied / up-to-date -> продвигать FSM
    10: "conflicts",  # escalate-классы -> держать applied, в digest
    1: "transient",   # transport -> retry следующим проходом
    2: "incompat",    # schema/min_cli fail-closed -> held(incompat) + алерт
    3: "recovery",    # recovery-required -> delta recover, потом повтор
}


def delta_bin() -> list[str]:
    """Команда запуска canon-delta: env CLAUDE_CANON_DELTA (путь к скрипту/моку)."""
    path = os.environ.get("CLAUDE_CANON_DELTA")
    if not path:
        die("CLAUDE_CANON_DELTA не задан (путь к canon-delta.py toolkit)", EXIT_VALIDATION)
    return [sys.executable, path] if path.endswith(".py") else [path]


def delta_call(args: list[str], cwd: str | None = None, timeout: int = 600) -> dict:
    """Запуск delta; возвращает {code, klass, verdict}. stdout - недоверенные
    данные: битый JSON -> verdict=None, не ошибка. Неизвестный код -> 'unknown'
    (fail-closed: держим проект, не продвигаем)."""
    import subprocess
    try:
        r = subprocess.run(delta_bin() + args, capture_output=True, text=True,
                           cwd=cwd, timeout=timeout)
        code = r.returncode
        out = r.stdout
    except subprocess.TimeoutExpired:
        return {"code": None, "klass": "transient", "verdict": None, "stderr": "timeout"}
    verdict = None
    try:
        verdict = json.loads(out)
    except (json.JSONDecodeError, TypeError):
        pass
    return {
        "code": code,
        "klass": DELTA_CODE_MAP.get(code, "unknown"),
        "verdict": verdict,
        "stderr": (r.stderr or "")[-500:],
    }


# =========================================================================
# Armed-флаг (T08 минимум: durable вкл/выкл; observe-first счетчик - позже)
# =========================================================================

def armed_path() -> str:
    return os.path.join(canon_dir(), "armed.json")


def armed_state() -> dict:
    return read_json(armed_path(), {"armed": False, "observe_passes_left": 0})


def is_armed() -> bool:
    return bool(armed_state().get("armed"))


def set_armed(value: bool) -> None:
    """arm взводит observe-first счетчик (§16.3): первые N armed-проходов все
    равно observe - страховка от немедленных мутаций. disarm = kill switch."""
    passes = int(os.environ.get("CLAUDE_CANON_OBSERVE_PASSES", "3")) if value else 0
    durable_write_json(armed_path(), {"armed": value, "observe_passes_left": passes})


def effective_mode() -> str:
    """observe (не armed) | observe-first (armed, счетчик > 0) | armed.
    Мутации (M1+) разрешены ТОЛЬКО при 'armed'."""
    st = armed_state()
    if not st.get("armed"):
        return "observe"
    if int(st.get("observe_passes_left") or 0) > 0:
        return "observe-first"
    return "armed"


def consume_observe_pass() -> None:
    """Декремент observe-first счетчика (по одному на armed-проход, durable)."""
    st = armed_state()
    left = int(st.get("observe_passes_left") or 0)
    if st.get("armed") and left > 0:
        st["observe_passes_left"] = left - 1
        durable_write_json(armed_path(), st)


# =========================================================================
# Субкоманды
# =========================================================================

def observe_project(name: str, spec: dict, lock_file: str) -> dict:
    """Read-only вердикт по проекту (delta `plan`, никаких мутаций). Возвращает
    {project, klass, detail?}. Не бросает - ошибки проекта не роняют проход."""
    root = spec.get("path")
    if not root:
        repo_url = spec.get("repo_url")
        if not repo_url:
            return {"project": name, "klass": "skipped-no-clone"}
        try:
            root = clone_update(name, repo_url)
        except CloneHeld as e:
            return {"project": name, "klass": f"held-{e.reason}"}
        except MirrorError as e:
            return {"project": name, "klass": "transient", "detail": str(e)[:200]}
    if not os.path.isdir(root):
        return {"project": name, "klass": "missing-path"}
    intent = os.path.join(root, ".claude", "canon.intent.yaml")
    if not os.path.exists(intent):
        return {"project": name, "klass": "needs-bootstrap"}
    # --root у canon-delta - глобальный флаг (ДО субкоманды)
    res = delta_call(["--root", root, "plan", "--lock", lock_file])
    out = {"project": name, "klass": res["klass"]}
    v = res.get("verdict")
    if isinstance(v, dict):
        if "counts" in v:
            out["counts"] = v["counts"]
        if "release_ready" in v:
            out["release_ready"] = v["release_ready"]
    if res["klass"] in ("incompat", "unknown"):
        out["detail"] = res.get("stderr", "")[:200]
    return out


def _run_git(root: str, *args: str):
    import subprocess
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)


def gh_call(args: list[str], cwd: str, timeout: int = 120):
    """gh CLI (env CLAUDE_CANON_GH для мока). Возвращает CompletedProcess."""
    import subprocess
    gh = os.environ.get("CLAUDE_CANON_GH", "gh")
    return subprocess.run([gh, *args], capture_output=True, text=True,
                          cwd=cwd, timeout=timeout)


def project_cursor_path(name: str) -> str:
    return os.path.join(canon_dir(), "state", f"{name}.json")


def save_project_cursor(name: str, cur: dict) -> None:
    durable_write_json(project_cursor_path(name), cur)


def load_project_cursor(name: str) -> dict:
    return read_json(project_cursor_path(name), {})


def _default_branch(clone: str) -> str:
    r = _run_git(clone, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if r.returncode == 0:
        return r.stdout.strip().split("/", 1)[1]
    for cand in ("main", "master"):
        if _run_git(clone, "rev-parse", "--verify", "-q", f"origin/{cand}").returncode == 0:
            return cand
    raise CloneHeld("no-default-branch")


def _pr_state(clone: str, pr_number) -> str | None:
    """Судьба PR через gh (§15.5): MERGED / CLOSED / OPEN. None = не удалось
    узнать (gh недоступен, мусорный ответ) - трактуется транзиентно, held по
    неподтвержденному состоянию НЕ защелкивается."""
    r = gh_call(["pr", "view", str(pr_number), "--json", "state"], cwd=clone)
    if r.returncode != 0:
        return None
    try:
        st = (json.loads(r.stdout or "{}") or {}).get("state")
    except json.JSONDecodeError:
        return None
    return st if st in ("MERGED", "CLOSED", "OPEN") else None


def _branch_conflicts_base(clone: str, base: str, branch_ref: str) -> bool:
    """Детект 'main ушел вперед С КОНФЛИКТОМ против PR-ветки' (§15.5) локальным
    merge-tree (git >= 2.38): exit 1 = конфликт. Прочие коды (старый git,
    ошибка) = считаем чистым: детект вспомогательный, без него PR просто
    останется conflicting на GitHub - не повод мутировать."""
    r = _run_git(clone, "merge-tree", "--write-tree", "--no-messages",
                 base, branch_ref)
    return r.returncode == 1


# классы delta, совместимые с applied: точное совпадение байт либо путь
# осознанно/структурно вне применимого scope. local-edit сюда НЕ входит:
# post-merge правка человека = расхождение дерева с релизом -> held (§5, T3)
_T3_OK_CLASSES = {"up-to-date", "managed-but-excluded", "retired-from-scope"}


def t3_applied_check(clone: str, lock_file: str) -> bool:
    """T3-предикат (§15.4, T3): канон ПРИСУТСТВУЕТ БАЙТАМИ в post-merge main-tree.
    НЕ событие merge: delta `classify` на detached-worktree от origin/<default>;
    applied только если КАЖДЫЙ путь в {up-to-date, managed-but-excluded,
    retired-from-scope}. Строже plan-гейта: local-edit/outdated/new/conflict -
    любое расхождение байт -> False. Единая функция для FSM-applied и
    harvester mark-applied (T25)."""
    import shutil
    import tempfile
    base = f"origin/{_default_branch(clone)}"
    tmp = tempfile.mkdtemp(prefix=".t3-check-", dir=os.path.dirname(clone))
    wt = os.path.join(tmp, "main")
    try:
        r = _run_git(clone, "worktree", "add", "--detach", wt, base)
        if r.returncode != 0:
            return False
        res = delta_call(["--root", wt, "classify", "--lock", lock_file])
        v = res.get("verdict") or {}
        items = v.get("items")
        if os.environ.get("CANON_T3_DEBUG"):
            sys.stderr.write(f"T3DBG code={res['code']} summary={v.get('summary')} "
                             f"lock={lock_file} stderr={res.get('stderr','')[:150]}\n")
        if res["code"] not in (0, 10) or not isinstance(items, list):
            return False
        return all(it.get("klass") in _T3_OK_CLASSES for it in items)
    finally:
        _run_git(clone, "worktree", "remove", "--force", wt)
        shutil.rmtree(tmp, ignore_errors=True)


def _close_applied(name: str, clone: str, ref: str, branch: str) -> dict:
    """Замкнуть цикл релиза: cursor.applied + уборка worktree/веток (локальной
    и remote; отсутствие remote-ветки - не ошибка, человек мог удалить кнопкой)."""
    wt = os.path.join(canon_dir(), "worktrees", name, ref)
    if os.path.isdir(wt):
        _run_git(clone, "worktree", "remove", "--force", wt)
    _run_git(clone, "worktree", "prune")
    _run_git(clone, "branch", "-D", branch)
    _run_git(clone, "push", "origin", "--delete", branch)  # best-effort
    main_sha = _run_git(clone, "rev-parse", f"origin/{_default_branch(clone)}").stdout.strip()
    cur = load_project_cursor(name)
    cur.update({"release": ref, "applied": True, "applied_main_sha": main_sha})
    cur.pop("pr_head_sha", None)
    save_project_cursor(name, cur)
    return {"project": name, "klass": "applied", "release": ref}


def candidate_flow(name: str, spec: dict, clone: str, ref: str, commit: str,
                   lock_file: str, mirror: str) -> dict:
    """armed-поток модели B (§15.2): worktree от origin/<default> + ветка
    canon/<vN> (детерминированное имя = идемпотентность), внутри - delta sync
    (WAL-apply делает toolkit), успех коммитится в ветку. Push+PR - T11.
    Конфликт (exit 10) -> held-conflicts, свежая ветка убирается."""
    branch = "canon/" + (ref[len("canon-"):] if ref.startswith("canon-") else ref)

    # 0) post-merge scan (T12, §15.4): канон уже байтами в main-tree -> applied,
    # замкнуть и убрать candidate-артефакты. Проверяется ДО веткостроения.
    cur = load_project_cursor(name)
    if cur.get("applied") and cur.get("release") == ref:
        return {"project": name, "klass": "applied", "release": ref}
    if t3_applied_check(clone, lock_file):
        return _close_applied(name, clone, ref, branch)
    if cur.get("release") == ref and cur.get("pr_number") is not None:
        # наш PR по этому релизу был запушен, а T3 не сошелся и remote-ветки
        # нет. Реакцию решает судьба PR (§15.5): MERGED - дерево подменили при
        # мердже -> mismatch; CLOSED - человек отклонил канон -> held до ack,
        # PR НЕ пересоздаем; OPEN - ветку снесли руками, PR жив -> пересоздание
        # штатным потоком ниже; неизвестно -> транзиентный пропуск
        remote_alive = _run_git(clone, "rev-parse", "--verify", "-q",
                                f"origin/{branch}").returncode == 0
        if not remote_alive:
            state = _pr_state(clone, cur["pr_number"])
            if state == "MERGED":
                return {"project": name, "klass": "held-post-merge-mismatch",
                        "detail": "PR смерджен, но main-tree != канону"}
            if state == "CLOSED":
                return {"project": name, "klass": "held-pr-closed",
                        "detail": f"PR #{cur['pr_number']} закрыт без мерджа"}
            if state is None:
                return {"project": name, "klass": "transient",
                        "detail": "судьба PR неизвестна (gh pr view не ответил)"}

    default_branch = _default_branch(clone)
    base = f"origin/{default_branch}"
    wt = os.path.join(canon_dir(), "worktrees", name, ref)
    branch_existed = _run_git(clone, "rev-parse", "--verify", "-q", branch).returncode == 0
    remote_branch = _run_git(clone, "rev-parse", "--verify", "-q", f"origin/{branch}").returncode == 0

    # §15.5: default-ветка ушла вперед и КОНФЛИКТУЕТ с PR-веткой. Контент ветки
    # детерминирован парой (main, lock), поэтому вместо rebase - recreate от
    # свежего main; push дальше только с force-with-lease на наш прежний sha.
    force_lease = None
    if remote_branch and _branch_conflicts_base(clone, base, f"origin/{branch}"):
        remote_sha = _run_git(clone, "rev-parse", f"origin/{branch}").stdout.strip()
        if cur.get("pr_head_sha") != remote_sha:
            return {"project": name, "klass": "held-foreign-commits",
                    "detail": f"конфликт с {base} + чужие коммиты в origin/{branch}"}
        if os.path.isdir(wt):
            _run_git(clone, "worktree", "remove", "--force", wt)
        _run_git(clone, "worktree", "prune")
        _run_git(clone, "branch", "-D", branch)
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        r = _run_git(clone, "worktree", "add", wt, "-B", branch, base)
        if r.returncode != 0:
            return {"project": name, "klass": "held-worktree", "detail": r.stderr.strip()[:200]}
        branch_existed = True
        force_lease = remote_sha

    if not os.path.isdir(wt):
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        _run_git(clone, "worktree", "prune")  # сироты от снесенных каталогов
        if branch_existed:
            r = _run_git(clone, "worktree", "add", wt, branch)
        elif remote_branch:
            # локальная ветка потеряна, remote жива. CAS по cursor (§15.5):
            # продолжаем ТОЛЬКО если origin/<branch> == наш последний push;
            # иначе в ветке чужие коммиты -> held, не строим поверх молча.
            remote_sha = _run_git(clone, "rev-parse", f"origin/{branch}").stdout.strip()
            cur = load_project_cursor(name)
            if cur.get("pr_head_sha") != remote_sha:
                return {"project": name, "klass": "held-foreign-commits",
                        "detail": f"origin/{branch}={remote_sha[:12]} != cursor"}
            r = _run_git(clone, "worktree", "add", wt, "-b", branch, f"origin/{branch}")
            branch_existed = True  # наша remote-история = ветка существовала
        else:
            base = f"origin/{_default_branch(clone)}"
            r = _run_git(clone, "worktree", "add", wt, "-b", branch, base)
        if r.returncode != 0:
            return {"project": name, "klass": "held-worktree", "detail": r.stderr.strip()[:200]}

    res = delta_call(["--root", wt, "sync", "--lock", lock_file,
                      "--mirror", mirror, "--target", commit])
    if res["klass"] != "ok":
        # конфликт/incompat/...: worktree убрать; свежесозданную ветку не
        # оставлять; пересозданную recreate-ветку тоже (ее база - main без
        # канона, промежуточный артефакт вводит в заблуждение)
        _run_git(clone, "worktree", "remove", "--force", wt)
        if not branch_existed or force_lease:
            _run_git(clone, "branch", "-D", branch)
        if res["klass"] == "conflicts":
            klass = "held-rebase-conflict" if force_lease else "held-conflicts"
        else:
            klass = res["klass"]
        return {"project": name, "klass": klass, "detail": res.get("stderr", "")[:200]}

    # закоммитить материализованный канон (включая .claude/canon.state.json);
    # рантайм-артефакты delta (замок/журнал/стейдж/бэкап) в PR НЕ едут;
    # нет изменений (повторный проход) - no-op, коммиты не плодятся
    _run_git(wt, "add", "-A", "--",
             ":!.claude/.canon-lock", ":!.claude/.canon-journal.json",
             ":!.claude/.canon-stage", ":!.claude/.canon-bak")
    if _run_git(wt, "diff", "--cached", "--quiet").returncode != 0:
        r = _run_git(wt, "-c", "user.name=canon-maintainer",
                     "-c", "user.email=canon-maintainer@local",
                     "commit", "-q", "-m", f"canon: sync {ref}")
        if r.returncode != 0:
            return {"project": name, "klass": "held-commit", "detail": r.stderr.strip()[:200]}
    # нечего предлагать: ветка не отличается от базы (канон уже в main) -> без PR
    ahead = _run_git(wt, "rev-list", "--count", f"{base}..{branch}")
    if ahead.returncode == 0 and ahead.stdout.strip() == "0":
        _run_git(clone, "worktree", "remove", "--force", wt)
        if not branch_existed:
            _run_git(clone, "branch", "-D", branch)
        return {"project": name, "klass": "up-to-date-no-pr"}

    return _push_and_pr(name, spec, wt, clone, branch, ref, force_lease)


def _push_and_pr(name: str, spec: dict, wt: str, clone: str, branch: str, ref: str,
                 force_lease: str | None = None) -> dict:
    """T11 (§15.3): push ветки (fast-forward = встроенный CAS: дивергенция с чужими
    коммитами -> отказ, held-foreign-commits, НЕ затираем) + gh pr create, если
    открытого PR по этой ветке еще нет. pr_number/head_sha -> durable cursor-зачаток
    (T15 расширит CAS-полями). force_lease (recreate-путь §15.5): переписать
    remote-ветку разрешено ТОЛЬКО поверх нашего прежнего sha."""
    push_args = ["push"]
    if force_lease:
        push_args.append(f"--force-with-lease={branch}:{force_lease}")
    r = _run_git(wt, *push_args, "origin", branch)
    if r.returncode != 0:
        err = r.stderr.lower()
        if ("non-fast-forward" in err or "fetch first" in err
                or "stale info" in err or "rejected" in err):
            return {"project": name, "klass": "held-foreign-commits",
                    "detail": r.stderr.strip()[:200]}
        return {"project": name, "klass": "transient", "detail": r.stderr.strip()[:200]}

    head_sha = _run_git(wt, "rev-parse", "HEAD").stdout.strip()
    pr_number = None
    lr = gh_call(["pr", "list", "--head", branch, "--state", "open",
                  "--json", "number,headRefOid"], cwd=wt)
    if lr.returncode == 0:
        try:
            prs = json.loads(lr.stdout or "[]")
            if prs:
                pr_number = prs[0].get("number")
        except json.JSONDecodeError:
            pass
    if pr_number is None:
        # открытого PR нет, но по cursor мы его уже создавали для ЭТОГО релиза:
        # сверить судьбу (§15.5). CLOSED - человек отклонил, новый PR не плодим
        # (held до ack); OPEN - list не нашел (гонка/форк-нюанс) - используем
        # номер; MERGED/неизвестно - транзиентно, следующий проход снимет T3
        cur = load_project_cursor(name)
        if cur.get("release") == ref and cur.get("pr_number") is not None:
            state = _pr_state(clone, cur["pr_number"])
            if state == "CLOSED":
                return {"project": name, "klass": "held-pr-closed",
                        "detail": f"PR #{cur['pr_number']} закрыт без мерджа"}
            if state == "OPEN":
                pr_number = cur["pr_number"]
            elif state == "MERGED":
                return {"project": name, "klass": "transient",
                        "detail": "PR смерджен посреди прохода; T3 решит следующим"}
            else:
                return {"project": name, "klass": "transient",
                        "detail": "судьба PR неизвестна (gh pr view не ответил)"}
    if pr_number is None:
        cr = gh_call(["pr", "create", "--head", branch,
                      "--title", f"canon: sync {ref}",
                      "--body", f"Автоматический PR canon-sync (release {ref}). "
                                f"Applied фиксируется по post-merge main-tree (T3)."],
                     cwd=wt)
        if cr.returncode != 0:
            return {"project": name, "klass": "held-pr-create",
                    "detail": cr.stderr.strip()[:200]}
        tail = cr.stdout.strip().rsplit("/", 1)
        pr_number = int(tail[1]) if len(tail) == 2 and tail[1].isdigit() else None

    save_project_cursor(name, {
        "release": ref, "branch": branch,
        "pr_number": pr_number, "pr_head_sha": head_sha,
    })
    return {"project": name, "klass": "candidate-pr-open",
            "branch": branch, "pr_number": pr_number}


def write_digest(pass_id: str, target_ref: str, verdicts: list[dict]) -> str:
    """Минимальный digest-файл прохода (T23 расширит до полного формата §9)."""
    lines = [f"# canon-pass {pass_id}", "", f"target: {target_ref}", ""]
    for v in verdicts:
        extra = ""
        if "counts" in v:
            extra = " " + json.dumps(v["counts"], ensure_ascii=True, sort_keys=True)
        lines.append(f"- {v['project']}: {v['klass']}{extra}")
    path = os.path.join(canon_dir(), "digest", f"{pass_id}.md")
    durable_write(path, ("\n".join(lines) + "\n").encode("utf-8"), 0o644)
    return path


def cmd_once(argv: list[str]) -> int:
    with SingletonLock(cfg_path("CLAUDE_CANON_LOCK", ".lock")):
        pass_id = new_pass_id()
        mode = effective_mode()
        log("pass-start", armed=is_armed(), mode=mode)
        if mode == "observe-first":
            consume_observe_pass()
        projects = load_fleet()
        if not projects:
            log("pass-end", projects=0)
            return EXIT_OK

        # зеркало + target-ревизия (раз на проход, §5)
        try:
            mirror = mirror_update()
            release = mirror_latest_release(mirror)
            if release is None:
                log("pass-end", projects=len(projects), note="no-canon-release")
                return EXIT_OK
            ref, commit = release
            lock_text = mirror_lock(mirror, commit)
            if lock_text is None:
                raise MirrorError(f"ревизия {ref} без canon.lock.json (издание сломано?)")
        except MirrorError as e:
            die(str(e), EXIT_TRANSIENT)
        lock_file = os.path.join(canon_dir(), "cache", f"lock-{commit}.json")
        durable_write(lock_file, lock_text.encode("utf-8"), 0o644)
        log("release", ref=ref, commit_sha=commit)

        # per-project: observe -> read-only plan; armed + repo_url + мутирующая
        # policy -> candidate-поток (PR-механика §15). path-проекты (Mac-чекауты)
        # НЕ мутируются никогда (F2) - только observe-вердикт.
        verdicts = []
        for name in sorted(projects):
            spec = projects[name]
            if (mode == "armed" and spec.get("repo_url")
                    and spec["policy"] in ("branch", "auto-merge")):
                try:
                    clone = clone_update(name, spec["repo_url"])
                    v = candidate_flow(name, spec, clone, ref, commit, lock_file, mirror)
                except CloneHeld as e:
                    v = {"project": name, "klass": f"held-{e.reason}"}
                except MirrorError as e:
                    v = {"project": name, "klass": "transient", "detail": str(e)[:200]}
            else:
                v = observe_project(name, spec, lock_file)
            log("project-verdict", **v)
            verdicts.append(v)
        digest = write_digest(pass_id, ref, verdicts)
        log("pass-end", projects=len(projects), digest=digest)
    return EXIT_OK


def cmd_status(argv: list[str]) -> int:
    projects = {
        name: {"policy": spec["policy"], "ring": spec["ring"]}
        for name, spec in load_fleet().items()
    }  # T15 добавит cursor/latch/budget
    st = armed_state()
    out = {
        "armed": bool(st.get("armed")),
        "mode": effective_mode(),
        "observe_passes_left": int(st.get("observe_passes_left") or 0),
        "projects": projects,
    }
    print(json.dumps(out, ensure_ascii=True, sort_keys=True, indent=2))
    return EXIT_OK


def cmd_arm(argv: list[str]) -> int:
    set_armed(True)
    log("armed", value=True)
    return EXIT_OK


def cmd_disarm(argv: list[str]) -> int:
    set_armed(False)
    log("armed", value=False)
    return EXIT_OK


def cmd_ack(argv: list[str]) -> int:
    if len(argv) != 2:
        die("usage: ack <release> <ring>", EXIT_VALIDATION)
    release, ring = argv
    # T19 введет latch-хранилище; пока latch'ей нет - no-op с явным сообщением
    log("ack", release=release, ring=ring, result="no-latch")
    return EXIT_OK


def cmd_mirror(argv: list[str]) -> int:
    """mirror <tag>: обновить зеркало, отрезолвить тег, проверить lock. JSON в stdout."""
    if len(argv) != 1:
        die("usage: mirror <canon-vN>", EXIT_VALIDATION)
    try:
        mirror = mirror_update()
        commit = mirror_resolve(mirror, argv[0])
        lock_text = mirror_lock(mirror, commit)
    except MirrorError as e:
        die(str(e), EXIT_TRANSIENT)
    print(json.dumps({
        "mirror": mirror, "ref": argv[0], "commit_sha": commit,
        "lock_found": lock_text is not None,
    }, ensure_ascii=True, sort_keys=True, indent=2))
    return EXIT_OK


def cmd_recover(argv: list[str]) -> int:
    with SingletonLock(cfg_path("CLAUDE_CANON_LOCK", ".lock")):
        new_pass_id()
        # T05/T15: per-project delta recover; пустой инвентарь = no-op
        log("recover", projects=0)
    return EXIT_OK


COMMANDS = {
    "once": cmd_once,
    "status": cmd_status,
    "arm": cmd_arm,
    "disarm": cmd_disarm,
    "ack": cmd_ack,
    "mirror": cmd_mirror,
    "recover": cmd_recover,
}


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        sys.stderr.write(__doc__ or "")
        return EXIT_OK if args else EXIT_VALIDATION
    cmd = args[0].lstrip("-")  # допускаем и `once`, и `--once` (systemd ExecStart)
    fn = COMMANDS.get(cmd)
    if fn is None:
        die(f"неизвестная субкоманда: {args[0]}", EXIT_VALIDATION)
    try:
        return fn(args[1:])
    except OSError as e:
        die(f"disk/IO: {e}", EXIT_DISK)


if __name__ == "__main__":
    sys.exit(main())
