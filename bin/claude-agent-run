def _env_int(name, default):
    """Числовой env с fallback на дефолт при мусоре (аудит v2.2 minor 7) -
    без этого битое значение роняло бы модуль на импорте (в т.ч. для
    spool-put/intake/inbox-status, которым тред не нужен)."""
    try:
        return int(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


def _env_enabled(name, default=True):
    v = os.environ.get(name)
    if v is None:
        return default
    return v.strip().lower() not in ("0", "false", "no", "")


