#!/usr/bin/env python3
"""claude-agent-tgbot: Telegram dashboard for the agent layer (stage 3).

Modes:
  claude-agent-tgbot poll                     long-poll daemon (systemd unit)
  claude-agent-tgbot send <agent> <reason> [detail]
                                              push one alert (reconciler hook:
                                              CLAUDE_AGENT_ALERT_CMD)
  claude-agent-tgbot notify [--pre] [text|-]  push raw text to whitelist ids
                                              (- or no arg = read stdin;
                                              --pre = monospace block)
  claude-agent-tgbot selftest                 offline tests of auth/validation

Env (~/.config/claude-control/env, via unit EnvironmentFile):
  CLAUDE_AGENT_TG_TOKEN      bot token (secrets live in env, not in repo)
  CLAUDE_AGENT_TG_WHITELIST  comma-separated numeric from.id allowlist
  CLAUDE_AGENT_TG_PROXY      http proxy for api.telegram.org (mihomo);
                             default http://127.0.0.1:7890, "" = direct

Security (design "Дашборд"): private chats only + from.id whitelist (group
chat_id is NOT a credential); agent names validated before any FS/CLI use;
all agent-produced text (status_line etc.) is untrusted -> html-escaped,
sent as <pre> blocks.
"""

import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$")
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
MENU_BTN = "☰ Меню"  # "☰ Меню" - постоянная reply-кнопка
OFFSET_FILE = os.path.expanduser("~/.claude-control/tgbot.offset")
LOG_FILE = os.path.expanduser("~/.claude-control/tgbot.log")


def log(msg):
    line = "%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(line)
    except OSError:
        pass
    sys.stderr.write(line)


def cfg():
    token = os.environ.get("CLAUDE_AGENT_TG_TOKEN", "")
    wl = {int(x) for x in
          os.environ.get("CLAUDE_AGENT_TG_WHITELIST", "").split(",")
          if x.strip().isdigit()}
    proxy = os.environ.get("CLAUDE_AGENT_TG_PROXY", "http://127.0.0.1:7890")
    return token, wl, proxy


def api(token, proxy, method, http_timeout, **params):
    url = "https://api.telegram.org/bot%s/%s" % (token, method)
    data = urllib.parse.urlencode(params).encode()
    handlers = []
    if proxy:
        handlers.append(urllib.request.ProxyHandler(
            {"http": proxy, "https": proxy}))
    opener = urllib.request.build_opener(*handlers)
    with opener.open(urllib.request.Request(url, data=data),
                     timeout=http_timeout) as r:
        return json.loads(r.read().decode())


def _chunk_for_html(text, limit=3800):
    """Чанки по СЫРОМУ тексту так, чтобы escape-длина каждого <= limit:
    разрез не попадает внутрь HTML-entity (stage9 гейт п.12)."""
    chunks, cur, cur_len = [], [], 0
    for ch in text:
        e = len(html.escape(ch))
        if cur and cur_len + e > limit:
            chunks.append("".join(cur))
            cur, cur_len = [], 0
        cur.append(ch)
        cur_len += e
    chunks.append("".join(cur))
    return chunks


def send_message(token, proxy, chat_id, text, pre=False):
    # эскейпим ВСЕ (вывод агентов - недоверенные данные), <pre> для таблиц;
    # телеграмный лимит 4096 - режем с запасом ДО escape (entity-safe).
    # Возвращает message_id всех чанков - для map reply-роутинга (stage9).
    ids = []
    for chunk in _chunk_for_html(text):
        body = html.escape(chunk)
        r = api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text=("<pre>%s</pre>" % body) if pre else body,
                parse_mode="HTML")
        mid = ((r or {}).get("result") or {}).get("message_id") \
            if isinstance(r, dict) else None
        ids.append(mid)
    return ids


# ------------------------------------------------- stage9: redaction + map

SECRET_RE = re.compile(
    r"(?i)((?:api[_-]?key|token|secret|password|authorization)\s*[=:]\s*)\S+"
    r"|\b(?:sk|xox[a-z]|ghp|gho|github_pat)-[A-Za-z0-9_-]{8,}"
    r"|\b[A-Za-z0-9+/_-]{40,}\b")


def redact(s):
    """Маскирование секрет-паттернов на экспорте в TG (stage9 гейт п.12).
    Лучше пере-, чем недомаскировать: события пишутся сырыми by design."""
    return SECRET_RE.sub(lambda m: (m.group(1) or "") + "***", s)


SENT_MAP_TTL_S = 14 * 86400


def _sent_map_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_SENT_MAP",
        os.path.expanduser("~/.claude-control/tgbot.sent.json"))


def _sent_map_load():
    try:
        with open(_sent_map_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def sent_map_register(chat_id, message_ids, agent, gen, now=None):
    """(chat_id, message_id) -> {agent, gen} для reply-роутинга: каждый чанк
    регистрируется (stage9 гейт п.8); TTL-prune при записи; atomic rename."""
    now = now or time.time()
    m = {k: v for k, v in _sent_map_load().items()
         if now - (v.get("at") or 0) < SENT_MAP_TTL_S}
    for mid in message_ids or []:
        if mid is None:
            continue
        m["%s:%s" % (chat_id, mid)] = {"agent": agent, "gen": gen, "at": now}
    path = _sent_map_path()
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(m, f, ensure_ascii=False)
        os.replace(tmp, path)
    except OSError as e:
        log("sent-map write error: %s" % e)


def sent_map_lookup(chat_id, message_id):
    return _sent_map_load().get("%s:%s" % (chat_id, message_id))


# ------------------------------------------------------------------- auth

def authorized(update, whitelist):
    """private chat + from.id in whitelist. Группа правом не является."""
    msg = update.get("message") or {}
    chat = msg.get("chat") or {}
    frm = msg.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


def parse_command(text):
    """-> (cmd, arg) или (None, None). Имя агента валидируется здесь."""
    if not isinstance(text, str) or not text.startswith("/"):
        return None, None
    parts = text.split()
    cmd = parts[0].split("@")[0].lower()
    if cmd in ("/agents", "/start", "/help", "/limits"):
        return cmd, None
    if cmd == "/menu":
        return cmd, None
    if cmd == "/agent" and len(parts) == 2 and NAME_RE.match(parts[1]):
        return cmd, parts[1]
    if cmd == "/agent":
        return "/agent-bad", None
    if cmd == "/task":
        # /task <agent> <текст...> - событие в spool агента (этап 4, Д1)
        p3 = text.split(None, 2)
        if len(p3) == 3 and NAME_RE.match(p3[1]):
            return cmd, (p3[1], p3[2])
        return "/task-bad", None
    return None, None


# ---------------------------------------------------------------- commands

def run_cli(args):
    """claude-rc agent ... без shell; вывод - недоверенный текст."""
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-rc"), "agent"]
                           + args, capture_output=True, text=True, timeout=30)
        return (r.stdout + r.stderr).strip() or "(пусто)"
    except Exception as e:  # noqa: BLE001 - боту нельзя падать от CLI
        return "ошибка CLI: %s" % e


def tail_lines(path, n, max_bytes=65536):
    """Хвост файла ограниченным чтением, не readlines() целиком (stage9)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    lines = data.splitlines()
    if size > max_bytes and lines:
        lines = lines[1:]  # первая строка окна могла быть разрезана
    return lines[-n:]


def events_tail(name, n=5):
    path = os.path.expanduser(
        "~/.claude-control/agents/%s/events.jsonl" % name)
    out = []
    for ln in tail_lines(path, n):
        try:
            d = json.loads(ln)
            out.append("%s %s %s" % (d.get("at", "")[11:19],
                                     d.get("event", ""),
                                     redact(str(d.get("detail") or ""))))
        except ValueError:
            continue
    return "\n".join(out)


def agent_names():
    """Имена агентов из реестра (папки со spec.yaml), сортированные."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        names = [n for n in os.listdir(d)
                 if os.path.isfile(os.path.join(d, n, "spec.yaml"))]
    except OSError:
        return []
    return sorted(names)


def menu_trigger(text):
    """Текст reply-кнопки, открывающий меню (не /-команда)."""
    return isinstance(text, str) and text.strip() == MENU_BTN


def _reply_kbd():
    """Постоянная reply-клавиатура с кнопкой меню - всегда под полем ввода."""
    return json.dumps({"keyboard": [[MENU_BTN]], "resize_keyboard": True,
                       "is_persistent": True}, ensure_ascii=False)


def _inline(rows):
    """rows: список рядов [(label, callback_data), ...] -> JSON inline-клавы."""
    kb = [[{"text": lbl, "callback_data": data} for lbl, data in row]
          for row in rows]
    return {"inline_keyboard": kb}


def _limits_text():
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
            capture_output=True, text=True, timeout=30)
        out = (r.stdout if r.returncode == 0 else "").strip()
    except Exception:  # noqa: BLE001
        out = ""
    return out or "лимиты недоступны (см. лог limits-digest)"


def menu_view(level):
    """level -> (html_text, inline_markup_dict). Неизвестный -> root."""
    if level == "agents":
        names = agent_names()
        rows = [[(n, "m:ag:%s" % n)] for n in names]
        rows.append([("◀ Назад", "m:root")])
        body = ("\U0001f916 <b>Агенты</b> (%d)" % len(names)) if names \
            else "нет зарегистрированных агентов"
        return body, _inline(rows)
    if level == "limits":
        body = "<b>Лимиты LLM</b>\n<pre>%s</pre>" % html.escape(_limits_text())
        return body, _inline([[("\U0001f504 Обновить", "m:limits")],
                              [("◀ Назад", "m:root")]])
    if level.startswith("ag:"):
        name = level[3:]
        if not NAME_RE.match(name):
            return menu_view("root")
        text = run_cli(["status", name])
        tail = events_tail(name)
        if tail:
            text += "\n--- события ---\n" + tail
        body = "<pre>%s</pre>" % html.escape(text)
        for h in agent_hints(name):
            body += "\n<code>%s</code>" % html.escape(h)
        return body, _inline([[("\U0001f4cb Сводка", "m:sum:%s" % name)],
                              [("\U0001f504 Обновить", "m:ag:%s" % name)],
                              [("◀ Агенты", "m:agents")]])
    # root
    return ("\U0001f916 <b>claude-control</b>\nВыбери раздел:",
            _inline([[("\U0001f4cb Агенты", "m:agents")],
                     [("\U0001f4ca Лимиты", "m:limits")]]))


def send_menu(token, proxy, chat_id, level="root", arm=False):
    """Новое меню-сообщение. arm=True - заодно ставит reply-клавиатуру."""
    if arm:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="Клавиатура меню включена.", reply_markup=_reply_kbd())
        except Exception as e:  # noqa: BLE001
            log("arm keyboard error: %s" % e)
    body, kb = menu_view(level)
    api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
        text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def edit_menu(token, proxy, chat_id, message_id, level):
    """Перерисовать меню на месте (навигация по уровням)."""
    body, kb = menu_view(level)
    api(token, proxy, "editMessageText", http_timeout=30, chat_id=chat_id,
        message_id=message_id, text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def authorized_cb(update, whitelist):
    """callback_query из private + from.id в whitelist."""
    cq = update.get("callback_query") or {}
    chat = ((cq.get("message") or {}).get("chat") or {})
    frm = cq.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


class TransientSpoolError(Exception):
    """Временный отказ spool-put (диск, lock): offset НЕ двигаем, retry
    следующим getUpdates (ревью-2 этапа 4, атака 5)."""


def spool_task(arg, update_id, from_id):
    """Продюсер #1 (Д1): spool-put c producer-идемпотентностью по update_id.
    Redelivery того же update дает тот же seq, дубль не создается."""
    name, text = arg
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "spool-put", name,
             "--json", json.dumps({"text": text, "from": from_id},
                                  ensure_ascii=False),
             "--producer", "telegram", "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return "принято #%s -> %s" % (r.stdout.strip(), name), False
    if r.returncode in (2, 3, 6):
        # ИЗВЕСТНЫЙ постоянный отказ (валидация, нет агента, кап):
        # ответ пользователю + offset дальше
        return "отказ: %s" % (r.stderr.strip() or "spool-put failed"), False
    # все прочее (lock busy 5, диск 7, неизвестные коды) - fail-closed:
    # событие НЕЛЬЗЯ терять, offset стоит (ревью-3, п.7)
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def _agents_dir():
    return (os.environ.get("CLAUDE_AGENTS_DIR")
            or os.path.expanduser("~/.claude-control/agents"))


def _control_read(name):
    """control.json ОДНИМ чтением (stage9 гейт п.11) ->
    (doc|None, None|"missing"|"error")."""
    d = os.path.join(_agents_dir(), name)
    if not os.path.isdir(d):
        return None, "missing"
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-io"),
                            "control-read", d],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            return json.loads(r.stdout), None
    except Exception:  # noqa: BLE001
        pass
    return None, "error"


def summary_text(name):
    """Механическая сводка mission-агента (stage9 фича 1) -> (text, gen).
    control одним чтением, state строго его поколения, события с redaction,
    mission-очередь."""
    control, err = _control_read(name)
    if control is None:
        return "агент %s: control.json недоступен (%s)" % (name, err), None
    gen = control.get("generation")
    parts = ["агент: %s (gen %s)" % (name, gen),
             "desired: %s" % control.get("desired"),
             "hold: %s" % control.get("hold")]
    att = control.get("attention") or {}
    parts.append("attention: %s" % (att.get("reason") or "-"))
    acc = control.get("acceptance")
    if acc:
        parts.append("acceptance: %s"
                     % json.dumps(acc, ensure_ascii=False)[:200])
    sp = os.path.join(_agents_dir(), name, "state.%s.json" % gen)
    try:
        with open(sp) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = None
    if isinstance(st, dict) and st.get("generation") == gen:
        for k in ("phase", "iterations", "status_line", "agent_claim"):
            if st.get(k) not in (None, ""):
                parts.append("%s: %s" % (k, st.get(k)))
    else:
        parts.append("state: нет валидного отчета поколения %s" % gen)
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-run"),
                            "mission-status", name],
                           capture_output=True, text=True, timeout=15)
        ms = json.loads(r.stdout) if r.returncode == 0 else {}
    except Exception:  # noqa: BLE001
        ms = {}
    if ms:
        q = "очередь: %s" % ms.get("depth")
        if ms.get("depth"):
            q += ", старейшему %sс" % ms.get("oldest_age_s")
        if ms.get("fail_streak"):
            q += ", неудач подряд %s" % ms.get("fail_streak")
        if ms.get("stalled"):
            q += " [DELIVERY STALLED]"
        parts.append(q)
    ev = events_tail(name, 8)
    text = "\n".join(parts)
    if ev:
        text += "\n--- события ---\n" + ev
    return redact(text), gen


def mission_put_task(name, text, update_id, from_id):
    """Продюсер mission-очереди (stage9): идемпотентность по update_id;
    транзиентные отказы (lock 5, диск 7) -> offset стоит, как spool_task."""
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "mission-put", name,
             "--text", text, "--from", str(from_id),
             "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return ("принято #%s -> %s (доставка на idle-промпте сессии)"
                % (r.stdout.strip(), name))
    if r.returncode == 6:
        return "очередь %s полна - подожди доставки (backpressure)" % name
    if r.returncode in (2, 3):
        return "отказ: %s" % (r.stderr.strip() or "mission-put failed")
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def mission_comment(msg, rep, text, update_id):
    """Reply на сообщение бота -> комментарий в mission-очередь (stage9
    фича 2). Роутинг по map (chat_id, message_id) со сверкой generation;
    вызывается ДО командного парсинга (гейт п.9)."""
    chat_id = (msg.get("chat") or {}).get("id")
    ent = sent_map_lookup(chat_id, rep.get("message_id"))
    if not ent:
        return ("сопоставить reply с агентом не могу - "
                "ответь на свежую сводку (кнопка Сводка в меню)")
    name = ent.get("agent") or ""
    if not NAME_RE.match(name):
        return "битая запись роутинга - ответь на свежую сводку"
    control, err = _control_read(name)
    if err == "missing":
        return "агент %s удален - комментарий не доставить" % name
    if control is None:
        # transient: control нечитаем при живом каталоге - не терять update
        raise TransientSpoolError("control-read failed for %s" % name)
    gen = control.get("generation")
    if ent.get("gen") != gen:
        return ("это сообщение прежней инкарнации %s (gen %s, сейчас %s) - "
                "ответь на свежую сводку" % (name, ent.get("gen"), gen))
    return mission_put_task(name, text, update_id,
                            (msg.get("from") or {}).get("id", 0))


def handle(cmd, arg, update_id=0, from_id=0):
    if cmd in ("/start", "/help"):
        return ("Дашборд агентов claude-control.\n"
                "/agents - парк\n/agent <name> - детали и события\n"
                "/task <name> <текст> - событие агенту\n"
                "/limits - остатки лимитов LLM"), False
    if cmd == "/agents":
        return run_cli(["list"]), True
    if cmd == "/limits":
        # панель из последнего кэшированного снапшота (limits-digest render)
        try:
            r = subprocess.run(
                [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
                capture_output=True, text=True, timeout=30)
            out = (r.stdout if r.returncode == 0 else "").strip()
        except Exception:  # noqa: BLE001
            out = ""
        return (out or "лимиты недоступны (см. лог limits-digest)"), True
    if cmd == "/agent-bad":
        return "имя агента: [a-z0-9-], например /agent faq-updater", False
    if cmd == "/task-bad":
        return "формат: /task <agent> <текст задачи>", False
    if cmd == "/agent":
        text = run_cli(["status", arg])
        tail = events_tail(arg)
        if tail:
            text += "\n--- события ---\n" + tail
        hints = agent_hints(arg)
        if not hints:
            return text, True
        # статус - <pre>-таблица, команды - отдельные <code> (копируются
        # построчно), все одним HTML-сообщением - см. mode "html" в send
        body = "<pre>%s</pre>\n--- вход в сессию ---" % html.escape(text)
        for h in hints:
            body += "\n<code>%s</code>" % html.escape(h)
        return body, "html"
    if cmd == "/task":
        return spool_task(arg, update_id, from_id)
    return None, False


# ------------------------------------------------------------------- modes

def mode_poll():
    token, wl, proxy = cfg()
    if not token or not wl:
        log("не настроено: нужны CLAUDE_AGENT_TG_TOKEN и "
            "CLAUDE_AGENT_TG_WHITELIST в ~/.config/claude-control/env")
        sys.exit(0)  # not-configured = чистый выход, не рестарт-шторм
    offset = 0
    try:
        offset = int(open(OFFSET_FILE).read().strip())
    except (OSError, ValueError):
        pass
    log("poll started (whitelist: %d id, proxy: %s)" % (len(wl), proxy or "-"))
    try:  # список команд в UI "/" (идемпотентно, не критично при отказе)
        api(token, proxy, "setMyCommands", http_timeout=30,
            commands=json.dumps([
                {"command": "menu", "description": "меню (кнопки)"},
                {"command": "agents", "description": "парк агентов"},
                {"command": "limits", "description": "остатки лимитов LLM"},
            ], ensure_ascii=False))
    except Exception as e:  # noqa: BLE001
        log("setMyCommands error: %s" % e)
    backoff = 1
    while True:
        try:
            # long-poll 30с: замерено, что прокси/edge рвет идл-коннект на
            # ~50с ("Remote end closed connection"), 45 - последний рабочий.
            # http_timeout с запасом на возврат данных.
            resp = api(token, proxy, "getUpdates", http_timeout=50,
                       offset=offset, timeout=30)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log("getUpdates error: %s (backoff %ss)" % (e, backoff))
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 1
        for upd in resp.get("result", []):
            # обработка ДО коммита offset (Д1: /task at-least-once; crash
            # между -> redelivery, дубль гасит producer-идемпотентность);
            # try/except - poison-update не клинит бота, offset уходит дальше
            try:
                if "callback_query" in upd and authorized_cb(upd, wl):
                    cq = upd["callback_query"]
                    data = cq.get("data", "")
                    cqmsg = cq.get("message") or {}
                    chat_id = (cqmsg.get("chat") or {}).get("id")
                    # спиннер на клиенте гасим всегда, даже при ошибке ниже
                    try:
                        api(token, proxy, "answerCallbackQuery",
                            http_timeout=30, callback_query_id=cq.get("id", ""))
                    except Exception:  # noqa: BLE001
                        pass
                    if data.startswith("m:sum:") and chat_id is not None:
                        # сводка - НОВЫМ сообщением, не edit: неизменяемый
                        # reply-якорь для map (stage9, гейт minor)
                        nm = data[len("m:sum:"):]
                        if NAME_RE.match(nm):
                            try:
                                stext, sgen = summary_text(nm)
                                ids = send_message(token, proxy, chat_id,
                                                  stext, pre=True)
                                sent_map_register(chat_id, ids, nm, sgen)
                            except Exception as e:  # noqa: BLE001
                                log("summary error: %s" % e)
                    elif data.startswith("m:") and chat_id is not None:
                        try:
                            edit_menu(token, proxy, chat_id,
                                      cqmsg.get("message_id"), data[2:])
                        except Exception as e:  # noqa: BLE001
                            log("edit_menu error: %s" % e)
                elif authorized(upd, wl):
                    msg = upd.get("message") or {}
                    mtext = msg.get("text", "")
                    rep = msg.get("reply_to_message") or {}
                    if (rep.get("message_id") is not None
                            and isinstance(mtext, str) and mtext.strip()):
                        # reply = комментарий агенту, ДО парсинга команд
                        # (stage9 гейт п.9); TransientSpoolError уходит
                        # наверх - offset не двигается, update не теряется
                        out = mission_comment(msg, rep, mtext,
                                              upd.get("update_id", 0))
                        if out:
                            try:
                                send_message(token, proxy,
                                             msg["chat"]["id"], out)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
                        offset = upd["update_id"] + 1
                        try:
                            open(OFFSET_FILE, "w").write(str(offset))
                        except OSError:
                            pass
                        continue
                    cmd, arg = parse_command(mtext)
                    if menu_trigger(mtext) or cmd == "/menu":
                        send_menu(token, proxy, msg["chat"]["id"], arm=True)
                        cmd = None  # меню отрисовано, обычный handle не нужен
                    if cmd == "/start":
                        # /start заодно ставит постоянную reply-клавиатуру
                        try:
                            api(token, proxy, "sendMessage", http_timeout=30,
                                chat_id=msg["chat"]["id"],
                                text="Клавиатура меню включена. /menu - открыть.",
                                reply_markup=_reply_kbd())
                        except Exception as e:  # noqa: BLE001
                            log("arm keyboard error: %s" % e)
                    if cmd:
                        text, pre = handle(
                            cmd, arg, update_id=upd.get("update_id", 0),
                            from_id=(msg.get("from") or {}).get("id", 0))
                        if text:
                            try:
                                if pre == "html":
                                    # уже готовый HTML (<pre>+<code>), не
                                    # эскейпить и не заворачивать повторно
                                    api(token, proxy, "sendMessage",
                                        http_timeout=30,
                                        chat_id=msg["chat"]["id"],
                                        text=text, parse_mode="HTML")
                                else:
                                    send_message(token, proxy,
                                                 msg["chat"]["id"],
                                                 text, pre=pre)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
            except TransientSpoolError as e:
                # событие нельзя терять: offset стоит, retry следующим
                # getUpdates (идемпотентность --id гасит дубль ответа)
                log("transient spool error at %s: %s (retry)"
                    % (upd.get("update_id"), e))
                time.sleep(2)
                break
            except Exception as e:  # noqa: BLE001
                log("update %s error: %s" % (upd.get("update_id"), e))
            offset = upd["update_id"] + 1
            try:
                open(OFFSET_FILE, "w").write(str(offset))
            except OSError:
                pass


def _agent_project(agent):
    """project из spec.yaml агента в реестре; "" если нет."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        for line in open(os.path.join(d, agent, "spec.yaml")):
            m = re.match(r"^project:\s*(\S+)", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def agent_hints(agent):
    """Копируемые команды входа в сессию агента (терминал / Cursor).
    Пустой список, если ssh-алиас этой машины не задан (фича выключена)
    или имя агента не похоже на имя агента (служебные пуши)."""
    host = os.environ.get("CLAUDE_AGENT_SSH_HOST", "")
    if not host or not re.match(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$", agent or ""):
        return []
    hints = ["ssh %s -t '~/.local/bin/claude-rc agent attach %s'"
             % (host, agent)]
    project = _agent_project(agent)
    if project:
        hints.append("cursor --remote ssh-remote+%s %s" % (host, project))
    return hints


def mode_send(argv):
    token, wl, proxy = cfg()
    if not token or not wl:
        sys.exit(0)  # хук должен быть безвредным без конфигурации
    agent = argv[0] if argv else "?"
    reason = argv[1] if len(argv) > 1 else "?"
    detail = argv[2] if len(argv) > 2 else ""
    text = "агент %s: %s%s" % (agent, reason,
                               (" - " + detail) if detail else "")
    # команды входа - отдельными <code>, чтобы копировались одним тапом
    body = html.escape(text)
    for h in agent_hints(agent):
        body += "\n<code>%s</code>" % html.escape(h)
    for uid in wl:
        try:
            if len(body) <= 3800:
                api(token, proxy, "sendMessage", http_timeout=30,
                    chat_id=uid, text=body, parse_mode="HTML")
            else:  # аномально длинный detail - чанками, без хинтов
                send_message(token, proxy, uid, text)
        except Exception as e:  # noqa: BLE001
            log("push error to %s: %s" % (uid, e))


def mode_notify(argv):
    """Отправка произвольного текста во все whitelist-id (дайджесты и т.п.).
    В отличие от send-хука падает громко: вызывающему нужен честный exit."""
    pre = False
    args = list(argv)
    if args and args[0] == "--pre":
        pre = True
        args = args[1:]
    text = (" ".join(args) if args and args != ["-"] else sys.stdin.read())
    text = text.rstrip("\n")
    if not text:
        log("notify: пустой текст")
        sys.exit(2)
    token, wl, proxy = cfg()
    if not token or not wl:
        log("notify: нужны CLAUDE_AGENT_TG_TOKEN и CLAUDE_AGENT_TG_WHITELIST")
        sys.exit(2)
    failures = 0
    for uid in sorted(wl):
        try:
            send_message(token, proxy, uid, text, pre=pre)
        except Exception as e:  # noqa: BLE001
            log("notify error to %s: %s" % (uid, e))
            failures += 1
    sys.exit(1 if failures == len(wl) else 0)


def mode_selftest():
    ok = [0]

    def t(name, cond):
        print("  %s: %s" % ("ok" if cond else "FAIL", name))
        ok[0] += 0 if cond else 1

    wl = {111}
    t("private+whitelisted проходит", authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 111}}}, wl))
    t("чужой from.id отбит", not authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 222}}}, wl))
    t("групповой чат отбит даже с верным from.id", not authorized(
        {"message": {"chat": {"type": "group"}, "from": {"id": 111}}}, wl))
    t("пустой update отбит", not authorized({}, wl))
    t("/agents парсится", parse_command("/agents") == ("/agents", None))
    t("/agent name парсится",
      parse_command("/agent faq-updater") == ("/agent", "faq-updater"))
    t("path traversal отбит",
      parse_command("/agent ../x") == ("/agent-bad", None))
    t("абсолютный путь отбит",
      parse_command("/agent /etc/passwd") == ("/agent-bad", None))
    t("не-команда игнорируется", parse_command("привет") == (None, None))
    t("инъекция в имя отбита",
      parse_command("/agent a;rm") == ("/agent-bad", None))
    t("html эскейпится", "<b>" not in html.escape("<b>x</b>"))
    t("/task парсится",
      parse_command("/task faq-updater проверь ссылки")
      == ("/task", ("faq-updater", "проверь ссылки")))
    t("/task без текста отбит",
      parse_command("/task faq-updater") == ("/task-bad", None))
    t("/task с плохим именем отбит",
      parse_command("/task ../x текст") == ("/task-bad", None))
    t("/limits парсится", parse_command("/limits") == ("/limits", None))
    t("/limits@bot парсится", parse_command("/limits@x_bot") == ("/limits", None))
    t("/task инъекция в имя отбита",
      parse_command("/task a;rm -rf текст") == ("/task-bad", None))
    # agent_hints: команды входа в сессию в push-уведомлении
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    t("hints пусты без CLAUDE_AGENT_SSH_HOST", agent_hints("faq-updater") == [])
    os.environ["CLAUDE_AGENT_SSH_HOST"] = "llm"
    t("hint attach содержит host и имя агента",
      any("ssh llm" in h and "agent attach faq-updater" in h
          for h in agent_hints("faq-updater")))
    t("hints пусты для кривого имени агента", agent_hints("../x") == [])
    t("hint cursor отсутствует без spec.yaml",
      not any(h.startswith("cursor") for h in agent_hints("faq-updater")))
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "faq-updater"))
        with open(os.path.join(td, "faq-updater", "spec.yaml"), "w") as f:
            f.write("schema: 1\nname: faq-updater\nproject: /data/Work/faq\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("hint cursor берет project из spec.yaml",
          "cursor --remote ssh-remote+llm /data/Work/faq"
          in agent_hints("faq-updater"))
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    # menu: одной командой /menu, кнопка ☰ Меню = та же команда
    t("/menu парсится", parse_command("/menu") == ("/menu", None))
    t("/menu@bot парсится", parse_command("/menu@x_bot") == ("/menu", None))
    t("текст кнопки ☰ Меню распознается",
      menu_trigger(MENU_BTN) and not menu_trigger("привет"))
    with tempfile.TemporaryDirectory() as td:
        for nm in ("beta", "alfa"):
            os.makedirs(os.path.join(td, nm))
            open(os.path.join(td, nm, "spec.yaml"), "w").write("name: %s\n" % nm)
        open(os.path.join(td, "not-agent.txt"), "w").write("x")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("agent_names сортированы и только с spec.yaml",
          agent_names() == ["alfa", "beta"])
        txt, kb = menu_view("agents")
        datas = [b["callback_data"] for row in kb["inline_keyboard"] for b in row]
        t("уровень agents дает кнопку на каждого агента",
          "m:ag:alfa" in datas and "m:ag:beta" in datas)
        t("уровень agents имеет назад в root", "m:root" in datas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    rtxt, rkb = menu_view("root")
    rdatas = [b["callback_data"] for row in rkb["inline_keyboard"] for b in row]
    t("root ведет в agents и limits",
      "m:agents" in rdatas and "m:limits" in rdatas)
    t("callback_data агента влезает в лимит 64 байта",
      all(len(("m:ag:" + "a" * 32).encode()) <= 64 for _ in [0]))
    t("неизвестный уровень безопасно падает в root",
      menu_view("m:garbage")[0] == menu_view("root")[0])
    # --- stage9: сводка + reply-комментарий (map, redaction, chunking) ---
    t("чанкер не рвет HTML-entity",
      (lambda cs: "".join(cs) == "&" * 4000
       and all(len(html.escape(c)) <= 3800 for c in cs)
       and len(cs) >= 2)(_chunk_for_html("&" * 4000)))
    t("чанкер: пустой текст -> один пустой чанк", _chunk_for_html("") == [""])
    t("redact маскирует token=",
      "supersecretvalue" not in redact("token=supersecretvalue1234"))
    t("redact маскирует длинный base64-хвост",
      "A" * 48 not in redact("payload " + "A" * 48))
    t("redact не трогает обычный текст",
      redact("обычная строка событий") == "обычная строка событий")
    with tempfile.TemporaryDirectory() as td:
        os.environ["CLAUDE_AGENT_TG_SENT_MAP"] = os.path.join(td, "map.json")
        sent_map_register(1, [10, 11], "alfa", 3)
        t("map: lookup по (chat,msg)",
          (sent_map_lookup(1, 10) or {}).get("agent") == "alfa")
        t("map: generation сохранен",
          (sent_map_lookup(1, 11) or {}).get("gen") == 3)
        t("map: чужой message_id пуст", sent_map_lookup(1, 99) is None)
        t("map: chat_id входит в ключ", sent_map_lookup(2, 10) is None)
        t("map: None-id не регистрируется",
          (sent_map_register(1, [None], "alfa", 3) or
           sent_map_lookup(1, None)) is None)
        sent_map_register(1, [12], "beta", 1,
                          now=time.time() + SENT_MAP_TTL_S + 60)
        t("map: TTL-prune при записи", sent_map_lookup(1, 10) is None)
        t("map: свежая запись жива",
          (sent_map_lookup(1, 12) or {}).get("agent") == "beta")
        t("reply без map-записи получает подсказку",
          "свежую сводку" in mission_comment(
              {"chat": {"id": 5}, "from": {"id": 1}},
              {"message_id": 404}, "текст", 1))
        os.environ.pop("CLAUDE_AGENT_TG_SENT_MAP", None)
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "alfa"))
        open(os.path.join(td, "alfa", "spec.yaml"), "w").write("name: alfa\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        _, akb = menu_view("ag:alfa")
        adatas = [b["callback_data"]
                  for row in akb["inline_keyboard"] for b in row]
        t("меню агента имеет кнопку Сводка", "m:sum:alfa" in adatas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    sys.exit(1 if ok[0] else 0)


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "poll":
        mode_poll()
    elif mode == "send":
        mode_send(sys.argv[2:])
    elif mode == "notify":
        mode_notify(sys.argv[2:])
    elif mode == "selftest":
        mode_selftest()
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)
