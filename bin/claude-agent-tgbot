#!/usr/bin/env python3
"""claude-agent-tgbot: Telegram dashboard for the agent layer (stage 3).

Modes:
  claude-agent-tgbot poll                     long-poll daemon (systemd unit)
  claude-agent-tgbot send <agent> <reason> [detail]
                                              push one alert (reconciler hook:
                                              CLAUDE_AGENT_ALERT_CMD)
  claude-agent-tgbot notify [--pre] [text|-]  push raw text to whitelist ids
                                              (- or no arg = read stdin;
                                              --pre = monospace block)
  claude-agent-tgbot voice [--caption C] [--agent NAME] [text|-]
                                              speak it and push as a voice
                                              message; falls back to plain text
                                              if synthesis is unavailable.
                                              --agent binds the message so a
                                              reply lands in that session
  claude-agent-tgbot selftest                 offline tests of auth/validation

Env (~/.config/claude-control/env, via unit EnvironmentFile):
  CLAUDE_AGENT_TG_TOKEN      bot token (secrets live in env, not in repo)
  CLAUDE_AGENT_TG_WHITELIST  comma-separated numeric from.id allowlist
  CLAUDE_AGENT_TG_PROXY      http proxy for api.telegram.org (mihomo);
                             default http://127.0.0.1:7890, "" = direct

Security (design "Дашборд"): private chats only + from.id whitelist (group
chat_id is NOT a credential); agent names validated before any FS/CLI use;
all agent-produced text (status_line etc.) is untrusted -> html-escaped,
sent as <pre> blocks.
"""

import datetime
import fcntl
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$")
QID_RE = re.compile(r"^[0-9a-f-]{36}$")
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
# Разделы живут прямо в reply-клавиатуре под полем ввода. Инлайн-уровня "меню"
# из тех же трех кнопок больше нет: он стоял между рукой и делом, не неся ничего.
BTN_SESSIONS = "\U0001f4bb Сессии"
BTN_AGENTS = "\U0001f4cb Агенты"
BTN_LIMITS = "\U0001f4ca Лимиты"
# Клавиатура живет на телефоне, пока ее не заменят новым сообщением. После
# переезда разделов у человека на экране осталась кнопка старого меню, и тап по
# ней перестал что-либо делать. Узнаем ее и заодно ставим новую клавиатуру.
LEGACY_MENU_BTN = "\u2630 Меню"
# Тумблер голосовых итогов. Состояние стоит ПРЯМО В ПОДПИСИ, а не прячется за
# нажатием: режим переключают в дороге, и человек должен видеть, говорит бот
# сейчас или молчит, не тапая наугад. Отсюда две подписи на одну кнопку - обе
# ведут в один раздел.
BTN_VOICE_ON = "\U0001f50a Голос: вкл"
BTN_VOICE_OFF = "\U0001f507 Голос: выкл"
MENU_BTNS = {BTN_SESSIONS: "sessions", BTN_AGENTS: "agents",
             BTN_LIMITS: "limits", LEGACY_MENU_BTN: "sessions",
             BTN_VOICE_ON: "voice", BTN_VOICE_OFF: "voice"}
VOICE_ON_TEXT = ("\U0001f50a Итоги буду присылать голосом. "
                 "Ответить можно голосом или текстом - реплаем на сообщение.")
VOICE_OFF_TEXT = "\U0001f507 Итоги снова текстом."
OFFSET_FILE = os.path.expanduser("~/.claude-control/tgbot.offset")
LOG_FILE = os.path.expanduser("~/.claude-control/tgbot.log")


def log(msg):
    line = "%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(line)
    except OSError:
        pass
    sys.stderr.write(line)


def cfg():
    token = os.environ.get("CLAUDE_AGENT_TG_TOKEN", "")
    wl = {int(x) for x in
          os.environ.get("CLAUDE_AGENT_TG_WHITELIST", "").split(",")
          if x.strip().isdigit()}
    proxy = os.environ.get("CLAUDE_AGENT_TG_PROXY", "http://127.0.0.1:7890")
    return token, wl, proxy


def api(token, proxy, method, http_timeout, **params):
    url = "https://api.telegram.org/bot%s/%s" % (token, method)
    data = urllib.parse.urlencode(params).encode()
    handlers = []
    if proxy:
        handlers.append(urllib.request.ProxyHandler(
            {"http": proxy, "https": proxy}))
    opener = urllib.request.build_opener(*handlers)
    with opener.open(urllib.request.Request(url, data=data),
                     timeout=http_timeout) as r:
        return json.loads(r.read().decode())


def _chunk_for_html(text, limit=3800):
    """Чанки по СЫРОМУ тексту так, чтобы escape-длина каждого <= limit:
    разрез не попадает внутрь HTML-entity (stage9 гейт п.12)."""
    chunks, cur, cur_len = [], [], 0
    for ch in text:
        e = len(html.escape(ch))
        if cur and cur_len + e > limit:
            chunks.append("".join(cur))
            cur, cur_len = [], 0
        cur.append(ch)
        cur_len += e
    chunks.append("".join(cur))
    return chunks


def send_message(token, proxy, chat_id, text, pre=False, reply_markup=None):
    # эскейпим ВСЕ (вывод агентов - недоверенные данные), <pre> для таблиц;
    # телеграмный лимит 4096 - режем с запасом ДО escape (entity-safe).
    # Возвращает message_id всех чанков - для map reply-роутинга (stage9).
    # reply_markup (V2.5 §4, аудит major 4) - JSON-строка клавиатуры,
    # прикрепляется к ПОСЛЕДНЕМУ чанку (единственному в подавляющем
    # большинстве случаев): длинный текст режется, клавиатура не теряется.
    ids = []
    chunks = _chunk_for_html(text)
    for i, chunk in enumerate(chunks):
        body = html.escape(chunk)
        kwargs = {}
        if reply_markup is not None and i == len(chunks) - 1:
            kwargs["reply_markup"] = reply_markup
        r = api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text=("<pre>%s</pre>" % body) if pre else body,
                parse_mode="HTML", **kwargs)
        mid = ((r or {}).get("result") or {}).get("message_id") \
            if isinstance(r, dict) else None
        ids.append(mid)
    return ids


# ------------------------------------------------- stage9: redaction + map

SECRET_RE = re.compile(
    r'(?i)((?:api[_-]?key|token|secret|password|authorization)"?\s*[=:]\s*"?'
    r'(?:bearer\s+)?)[^\s&"]+'
    r'|(\bbearer\s+)\S+'
    r'|\b(?:sk|xox[a-z]|ghp|gho|github_pat)-[A-Za-z0-9_-]{8,}'
    r'|\b[A-Za-z0-9+/_-]{40,}\b')


def redact(s):
    """Маскирование секрет-паттернов на экспорте в TG (stage9 гейт п.12;
    V2.5 §4 аудит major 3: покрытие выровнено с claude-agent-permit -
    самостоятельный "Bearer <token>" без слова Authorization и JSON-форма
    {"password":"hunter2"} тоже маскируются). Лучше пере-, чем
    недомаскировать: события пишутся сырыми by design."""
    return SECRET_RE.sub(lambda m: (m.group(1) or m.group(2) or "") + "***", s)


SENT_MAP_TTL_S = 14 * 86400


def _sent_map_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_SENT_MAP",
        os.path.expanduser("~/.claude-control/tgbot.sent.json"))


def _sent_map_load():
    """§5, аудит V2.5 minor: форма валидируется на загрузке - не-словарь
    ([], null, скаляр) трактуется как пустая карта, записи с
    не-объектными значениями пропускаются (а не роняют .items()/.get()
    вызывающего AttributeError на каждом апдейте)."""
    try:
        with open(_sent_map_path()) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(d, dict):
        return {}
    return {k: v for k, v in d.items() if isinstance(v, dict)}


def _question_read(agent, qid):
    """Безопасное чтение файла вопроса agent/questions/qid.json - тот же
    containment-протокол, что qid_safe_path в run/answer; agent и qid здесь
    недоверенный ввод (из sent_map/callback), поэтому оба валидируются.
    None, если агент/qid некорректны либо файл нечитаем."""
    if not agent or not NAME_RE.match(agent) or not qid or not QID_RE.match(qid):
        return None
    qdir = os.path.realpath(os.path.join(_agents_dir(), agent, "questions"))
    path = os.path.realpath(os.path.join(qdir, qid + ".json"))
    if path != os.path.join(qdir, qid + ".json"):
        return None
    try:
        with open(path) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def _question_is_open(agent, qid):
    """qid все еще открыт - запись в sent_map с таким qid не прунится по
    TTL (§5): вопрос ждет ответа столько, сколько нужно."""
    d = _question_read(agent, qid)
    return bool(d) and d.get("status") == "open"


def _sent_map_prune(m, now):
    """TTL-фильтр (§5): свежие записи проходят всегда; просроченная запись
    с открытым qid переживает TTL, просроченная без qid или с закрытым
    qid - прунится обычным порядком."""
    kept = {}
    for k, v in m.items():
        if now - (v.get("at") or 0) < SENT_MAP_TTL_S:
            kept[k] = v
        elif v.get("kind") == "question" \
                and _question_is_open(v.get("agent"), v.get("qid")):
            kept[k] = v
    return kept


def sent_map_register(chat_id, message_ids, agent, gen, now=None,
                      kind=None, qid=None):
    """(chat_id, message_id) -> {agent, gen, kind?, qid?} для reply-роутинга
    и роутинга кнопок (§5-6): каждый чанк регистрируется (stage9 гейт п.8);
    TTL-prune при записи (§5, qid открыт -> запись не прунится). RMW под
    flock + запись через mkstemp (§5: конкурентные регистрации раньше
    теряли записи - общий load-modify-save без лока)."""
    now = now or time.time()
    path = _sent_map_path()
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    lk = os.open(path + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lk, fcntl.LOCK_EX)
        m = _sent_map_prune(_sent_map_load(), now)
        for mid in message_ids or []:
            if mid is None:
                continue
            entry = {"agent": agent, "gen": gen, "at": now}
            if kind is not None:
                entry["kind"] = kind
            if qid is not None:
                entry["qid"] = qid
            m["%s:%s" % (chat_id, mid)] = entry
        tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".tgbot.sent.")
        try:
            with os.fdopen(tmp_fd, "w") as f:
                json.dump(m, f, ensure_ascii=False)
            os.replace(tmp_path, path)
        except OSError:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            raise
    except OSError as e:
        log("sent-map write error: %s" % e)
    finally:
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)


def sent_map_lookup(chat_id, message_id):
    return _sent_map_load().get("%s:%s" % (chat_id, message_id))


# ---------------------------------------------- счетчик карточек (Р11, план §12)
# Митигация риска "рост числа карточек > 5-10/день": durable-счетчик
# ФАКТИЧЕСКИ ДОСТАВЛЕННЫХ карточек (кнопки вопроса/готовности), не
# запрошенных - единственная точка учета здесь, в mode_send, на успешной
# доставке (несколько мест зовут алерт, но считать надо доставленное).
# Сутки - UTC, отваливаются сами (day != сегодня -> счетчик обнуляется при
# следующей записи, чистка руками не нужна). claude-agent-limits-digest
# читает этот же файл тем же env-override.

def _cards_count_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_CARDS_COUNT",
        os.path.expanduser("~/.claude-control/tgbot.cards.json"))


def cards_count_bump(now=None):
    """Инкремент на ФАКТИЧЕСКИ доставленной карточке (mode_send, delivered).
    RMW под flock + mkstemp - тот же прием, что sent_map_register."""
    now = now if now is not None else time.time()
    day = time.strftime("%Y-%m-%d", time.gmtime(now))
    path = _cards_count_path()
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    lk = os.open(path + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            with open(path) as f:
                cur = json.load(f)
        except (OSError, ValueError):
            cur = {}
        if not isinstance(cur, dict) or cur.get("day") != day:
            cur = {"day": day, "count": 0}
        cur["count"] = cur.get("count", 0) + 1
        tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".tgbot.cards.")
        try:
            with os.fdopen(tmp_fd, "w") as f:
                json.dump(cur, f, ensure_ascii=False)
            os.replace(tmp_path, path)
        except OSError:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            raise
    except OSError as e:
        log("cards-count write error: %s" % e)
    finally:
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)


BTN_LABEL_LIMIT = 64


def _clip_label(s, limit=BTN_LABEL_LIMIT):
    """Подпись кнопки Telegram <= limit байт (§4, аудит V2.5 major 4).
    Обрезка по границе utf-8 - посимвольно (не по сырым байтам вслепую),
    поэтому многобайтовый символ никогда не режется пополам."""
    if len(s.encode("utf-8")) <= limit:
        return s
    ell = "…"
    budget = limit - len(ell.encode("utf-8"))
    out = s
    while out and len(out.encode("utf-8")) > budget:
        out = out[:-1]
    return out + ell


# ------------------------------------------------- V2.5: чистые функции §9

CID8_RE = re.compile(r"^[0-9a-f]{8}$")

# кап карточки готовности учитывал только поля кандидатов (LESSON_CANDIDATE_
# MAX_BYTES в claude-agent-run), summary заявки не был ограничен вовсе
# (контрольный аудит серьезная 6): summary ~3000 символов + три допустимых
# кандидата режут карточку на несколько сообщений (_chunk_for_html, лимит
# 3800 escaped-символов), клавиатура (принять/отклонить) прикрепляется
# ТОЛЬКО к последнему чанку - обрыв после первого оставляет карточку без
# кнопок, повтор дублирует уже доставленное. Копия та же, что у
# claude-agent-done (единственный писатель summary) - защита в глубину: там
# обрезка на источнике, здесь - на случай значения, попавшего в done.json
# иначе (старый файл до фикса, ручная правка).
DONE_SUMMARY_MAX_BYTES = 1500


def _cap_escaped(text, limit):
    """Обрезает text по HTML-ESCAPED длине (не по сырым символам - см.
    LESSON_CANDIDATE_MAX_BYTES в claude-agent-run: escape-длина - то, что
    реально уходит в send_message/_chunk_for_html, а не сырая)."""
    s = str(text or "")
    esc_len, kept = 0, []
    for ch in s:
        e = len(html.escape(ch))
        if esc_len + e > limit:
            return "".join(kept) + " [обрезано]"
        kept.append(ch)
        esc_len += e
    return s


def _done_card(detail):
    """kind=="done" (V2.7b §3 п.1) - карточка заявки о готовности: те же две
    кнопки принять/отклонить, callback-data несет sha8 (первые 8 символов
    commit_sha, "-" для direct/none) - не украшение, а проверка на
    устаревание, если агент передекларировал готовность новым коммитом.

    detail["lessons"] (V2.9 §5) - хвост до трех кандидатов в урок, у каждой
    пара кнопок принять/отклонить (callback "l:<agent>:<cid8>:y/n").
    Отдельной карточки нет - хвост той же карточки. Ключ отсутствует/пуст ->
    хвоста нет, карточка байт-в-байт как в V2.7b (регресс-инвариант).

    Карточка несет ПОЛНЫЙ текст урока - essence, why и how_to_apply (аудит
    блокер 2), не одну суть: показ только essence позволял бы essence
    выглядеть безобидно, пока в how_to_apply (записываемом при accept)
    уезжает произвольная скрытая инструкция - подтверждение человека
    бессмысленно, если он не видит то, что подтверждает.

    essence/why/how_to_apply НЕ проходят через redact() здесь (аудит блокер
    3): это уже прошедшие _lessons_mask() значения, записанные ТЕМ ЖЕ
    контуром (claude-agent-run), который их же дописывает в журнал/зеркало
    при accept - показанное и записанное обязаны быть побайтно одним и тем
    же текстом. Вторая, ДРУГАЯ функция маскировки поверх уже замаскированных
    полей давала ровно обратный эффект: карточка показывает "***" там, где
    redact() поймал что-то шире, а в журнал и в git при этом уезжают
    исходные (не пойманные _lessons_mask) байты - человек видит маску,
    подтверждает вслепую, секрет утекает."""
    agent = detail.get("agent") or "?"
    project = detail.get("project")
    summary = _cap_escaped(redact(str(detail.get("summary") or "")),
                           DONE_SUMMARY_MAX_BYTES)
    commit_sha = detail.get("commit_sha")
    branch = detail.get("branch")
    changes = detail.get("changes") or []
    # поколение заявки: для worktree это commit_sha[:8], для direct/none -
    # хеш от envelope_key (V2.10, аудит r3 блокер 3). Прежний литерал "-"
    # делал сверку тапа вырожденной: любая старая карточка совпадала с
    # текущей заявкой, даже после перехода владения к новому конверту.
    # Фолбэк на старую форму - для карточек, собранных до обновления.
    sha8 = detail.get("gen8") or (commit_sha[:8] if commit_sha else "-")
    header = "агент %s [%s]: задача готова\n%s" % (agent, project or "-",
                                                   summary)
    if commit_sha:
        header += "\n\ncommit %s (%s)" % (sha8, branch or "?")
    elif changes:
        shown = [redact(str(c)) for c in changes[:5]]
        more = "" if len(changes) <= 5 else " и еще %d" % (len(changes) - 5)
        header += "\n\nизменено: %s%s" % (", ".join(shown), more)
    if detail.get("empty"):
        header += "\n\n(без изменений)"
    # V2.7b §3 п.5: reply текстом на эту карточку = отклонение с
    # комментарием. Без подсказки это неочевидно (live 2026-07-29:
    # оператор отвечал текстом, не имея в виду отклонить).
    header += "\n\nreply текстом = отклонить с комментарием"
    rows = [[("принять", "d:%s:%s:a" % (agent, sha8))],
           [("отклонить", "d:%s:%s:r" % (agent, sha8))]]
    for lesson in (detail.get("lessons") or [])[:3]:
        if not isinstance(lesson, dict):
            continue
        lcid8 = lesson.get("cid8")
        if not isinstance(lcid8, str) or not CID8_RE.match(lcid8):
            continue
        # НЕ redact() - см. docstring выше (аудит блокер 3): показанное
        # обязано побайтно совпадать с тем, что уйдет в журнал/зеркало.
        essence = str(lesson.get("essence") or "")
        why = str(lesson.get("why") or "")
        how = str(lesson.get("how_to_apply") or "")
        header += "\n\nурок: %s" % essence
        if why:
            header += "\nпочему: %s" % why
        header += "\nкак применять: %s" % how
        rows.append([("принять урок", "l:%s:%s:y" % (agent, lcid8)),
                    ("отклонить урок", "l:%s:%s:n" % (agent, lcid8))])
    header += ("\n\nдля отказа с объяснением - ответь (reply) на это "
               "сообщение, кнопка \"отклонить\" - без комментария")
    return header, _inline(rows)


def question_card(detail):
    """detail (§3, JSON-detail mode_send) -> (text, reply_markup). None /
    не-dict / kind не question/done -> (None, None) - вызывающий (mode_send)
    шлет обычный алерт (регресс-инвариант T1/T2). Текст всегда прогоняется
    через redact() (§3, второй рубеж маскировки перед выходом наружу).
    kind=="done" (V2.7b §3) - карточка заявки о готовности, см. _done_card."""
    if not isinstance(detail, dict):
        return None, None
    if detail.get("kind") == "done":
        return _done_card(detail)
    if detail.get("kind") != "question":
        return None, None
    agent = detail.get("agent") or "?"
    qid = detail.get("qid") or ""
    qkind = detail.get("qkind")
    text = redact(str(detail.get("text") or ""))
    # v2.6 §5: снуз есть на любой карточке вопроса. Кнопка живет ЗДЕСЬ, а не
    # постобработкой в mode_send: чистая функция обязана возвращать то, что
    # реально уйдет наружу, иначе ее тесты дают ложную уверенность о карточке.
    snooze = [("напомнить позже", "r:%s" % qid)]
    if qkind == "permission":
        header = "агент %s: запрос подтверждения\n%s" % (agent, text)
        rows = [[("разрешить", "p:%s:a" % qid)],
               [("отклонить", "p:%s:r" % qid)],
               snooze]
        return header, _inline(rows)
    # info (§4): подсказка про reply всегда, кнопки по options - при наличии
    header = ("агент %s: вопрос\n%s\n\nответь reply-ем на это сообщение "
              "для свободного текста" % (agent, text))
    options = detail.get("options") or []
    # §4 аудит V2.5 major 3/4: подпись - тоже строка, уходящая наружу,
    # редактируется так же, как текст вопроса, и обрезается до лимита кнопки.
    rows = [[(_clip_label(redact(str(opt))), "q:%s:%d" % (qid, i))]
            for i, opt in enumerate(options)]
    return header, _inline(rows + [snooze])


def route_callback(data):
    """callback_data -> (kind, qid, arg) (§9). "q:<qid>:<idx>" ->
    ("answer_option", qid, idx); "p:<qid>:a/r" -> ("approve"/"reject", qid,
    None); "r:<qid>" -> ("snooze", qid, None) (v2.6 §5); "d:<agent>:<sha8>:a/r"
    -> ("accept_done"/"reject_done", agent, sha8) (V2.7b §3 п.1 - слот "qid"
    здесь несет имя агента, "arg" - sha8, идентификатор заявки не qid-формы);
    "l:<agent>:<cid8>:y/n" -> ("accept_lesson"/"reject_lesson", agent, cid8)
    (V2.9 §5 - хвост карточки готовности, префикс "l:" свободен от q:/p:/r:/
    m:/d: выше); "m:..." -> ("menu", None, data) - неизменный regression-путь
    (§8); мусор -> ("none", None, None)."""
    if isinstance(data, str):
        m = re.match(r"^q:([0-9a-f-]{36}):(\d+)$", data)
        if m:
            return "answer_option", m.group(1), m.group(2)
        m = re.match(r"^p:([0-9a-f-]{36}):a$", data)
        if m:
            return "approve", m.group(1), None
        m = re.match(r"^p:([0-9a-f-]{36}):r$", data)
        if m:
            return "reject", m.group(1), None
        m = re.match(r"^r:([0-9a-f-]{36})$", data)
        if m:
            return "snooze", m.group(1), None
        m = re.match(r"^d:([a-z][a-z0-9-]{0,30}[a-z0-9]):([0-9a-f]{8}|-):"
                    r"([ar])$", data)
        if m:
            return (("accept_done" if m.group(3) == "a" else "reject_done"),
                   m.group(1), m.group(2))
        m = re.match(r"^l:([a-z][a-z0-9-]{0,30}[a-z0-9]):([0-9a-f]{8}):"
                    r"([yn])$", data)
        if m:
            return (("accept_lesson" if m.group(3) == "y" else "reject_lesson"),
                   m.group(1), m.group(2))
        # V3.0: экран сессий. Имя проекта уходит в argv claude-rc, короткий id -
        # в резолв uuid, поэтому оба поля отбиваются по строгой форме прямо здесь:
        # это вход из сети, а не наши данные.
        if data == "s":
            return "sessions_root", None, None
        m = re.match(r"^s:p:([a-zA-Z0-9_-]{1,32})$", data)
        if m:
            return "sessions_project", m.group(1), None
        # Та же кнопка с номером страницы. Номер - только цифры и не длиннее
        # трех: это вход из сети, а дальше он идет в арифметику смещения.
        m = re.match(r"^s:p:([a-zA-Z0-9_-]{1,32}):(\d{1,3})$", data)
        if m:
            return "sessions_project", m.group(1), m.group(2)
        m = re.match(r"^s:n:([a-zA-Z0-9_-]{1,32})$", data)
        if m:
            return "session_new", m.group(1), None
        m = re.match(r"^s:([sudxyczwhg]):([a-zA-Z0-9_-]{1,32}):([0-9a-f]{8})$", data)
        if m:
            kind = {"s": "session_card", "u": "session_up", "d": "session_down",
                    "x": "session_rm_ask", "y": "session_rm_do",
                    "c": "session_compact_ask", "z": "session_compact_do",
                    "w": "session_compact_up",
                    "h": "session_handoff_ask", "g": "session_handoff_do"}
            return kind[m.group(1)], m.group(2), m.group(3)
        if data.startswith("m:"):
            return "menu", None, data
    return "none", None, None


# ---------------------------------------------------------- V3.0: экран сессий

def run_rc(args, timeout=60):
    """claude-rc <args> (без подкоманды agent). Вывод - недоверенные данные."""
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-rc")] + args,
                           capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or ""), (r.stderr or "")
    except Exception as e:  # noqa: BLE001 - боту нельзя падать от CLI
        return 1, "", "ошибка CLI: %s" % e


def parse_porcelain(text):
    """TSV из `claude-rc sessions <p> --porcelain` -> список словарей.

    Битые строки молча пропускаются: список рисует меню, и одна кривая запись не
    имеет права лишить человека доступа ко всем остальным сессиям.
    """
    rows = []
    for line in (text or "").splitlines():
        parts = line.split("\t")
        if len(parts) != 7:
            continue
        sid, mtime, origin, cwd, title, live, ctx = parts
        if not re.match(r"^[0-9a-f]{8}-", sid):
            continue
        # Процент контекста: пусто -> None. Ноль сюда подставлять нельзя, "не
        # смогли посчитать" и "контекст пуст" в подписи читаются по-разному.
        rows.append({"sid": sid, "short": sid[:8], "mtime": mtime,
                     "origin": origin, "cwd": cwd, "title": title,
                     "live": live == "1",
                     "ctx": int(ctx) if ctx.isdigit() else None})
    return rows


SESSIONS_TZ = os.environ.get("CLAUDE_AGENT_SESSIONS_TZ", "Europe/Moscow")


def session_when(mtime, now=None, tz=None):
    """Когда в сессии было последнее сообщение, с укрупнением по мере старения:
    сейчас / N min / N hour / вчера / N day / N week / N mon. Для свежей сессии важна свежесть, а
    для старой - порядок величины, поэтому точность намеренно падает с возрастом.

    Считается в отображаемой зоне, а не в зоне сервера: у этой машины системная
    TZ - UTC, и без явной зоны вечерние сессии уезжали бы на день назад.
    Пустая строка на кривом mtime: подпись кнопки не имеет права упасть из-за
    одной битой строки транскрипта.
    """
    try:
        ts = int(mtime)
        now_ts = int(now if now is not None else time.time())
    except (TypeError, ValueError):
        return ""
    try:
        from zoneinfo import ZoneInfo
        zone = ZoneInfo(tz or SESSIONS_TZ)
    except Exception:  # noqa: BLE001 - нет tzdata: показываем в зоне сервера
        zone = None
    # Внутри суток шкала мелкая - минуты и часы. Дальше идет календарный счет:
    # "вчера" должно оставаться "вчера" и в 00:30, когда по дельте прошло 2 часа.
    delta = now_ts - ts
    if delta < 60:
        return "сейчас"
    if delta < 3600:
        return "%d min" % (delta // 60)
    if delta < 86400:
        return "%d hour" % (delta // 3600)
    when = datetime.datetime.fromtimestamp(ts, zone)
    today = datetime.datetime.fromtimestamp(now_ts, zone).date()
    days = (today - when.date()).days
    if days <= 0:
        return "сегодня"
    if days == 1:
        return "вчера"
    if days < 7:
        return "%d day" % days
    if days < 30:
        return "%d week" % (days // 7)
    return "%d mon" % (days // 30)


# Состояние сессии одной иконкой - одинаково в списке, на корневом экране и в
# шапке карточки. У опущенной метка тоже есть: пустое место меткой не читается,
# и состояние приходилось вычитывать из подписей кнопок.
# Различаем ФОРМОЙ, а не цветом. Цветные эмодзи-кружки крупнее строки и в списке
# лезут в глаза сильнее самих имен, а зеленый с желтым на телефоне еще и почти
# неразличимы. Текстовые знаки идут вровень со шрифтом и читаются однозначно:
# залитый - работает, пустой - опущена, восклицательный - поднята, но молчит.
ICON_RUNNING = "\u25cf"       # работает
ICON_STOPPED = "\u25cb"       # опущена
ICON_STALE = "\u26a0"         # поднята, но молчит


def session_icon(row):
    if not row.get("live"):
        return ICON_STOPPED
    return ICON_STALE if row.get("health") == "stale" else ICON_RUNNING


def _ctx_note(pct):
    """Занятость окна для подписи. None (не посчитали) - молчим: выдуманный ноль
    хуже отсутствия числа."""
    return "%d%%" % pct if isinstance(pct, int) else ""


def session_label(row, now=None, tz=None):
    """Подпись кнопки: кружок живой сессии, имя (или короткий id) и возраст
    последнего сообщения - то же, что показывает Cursor. Без возраста одинаково
    названные сессии в списке неразличимы, а выбирают обычно по свежести."""
    name = (row.get("title") or "").strip() or row.get("short", "?")
    label = _clip_label(redact("%s %s" % (session_icon(row), name)))
    tail = [x for x in (session_when(row.get("mtime"), now=now, tz=tz),
                        _ctx_note(row.get("ctx"))) if x]
    return " · ".join([label] + tail)


def sessions_list_kb(project, rows, page=0, has_more=False):
    """Клавиатура списка сессий проекта: новая сессия, строка на сессию, возврат.

    Страница глубже первой листается кнопками: без них все, что не влезло в
    первый экран, недостижимо вовсе - имени сессии негде набрать. "Новую сессию"
    показываем только на первой странице: вглубь списка уходят за старым, а не
    за чистым листом.
    """
    kbrows = [[("➕ новая сессия", "s:n:%s" % project)]] if page == 0 else []
    kbrows += [[(session_label(r), "s:s:%s:%s" % (project, r["short"]))]
               for r in rows]
    nav = []
    if page > 0:
        nav.append(("‹ назад", "s:p:%s:%d" % (project, page - 1)))
    if has_more:
        nav.append(("дальше ›", "s:p:%s:%d" % (project, page + 1)))
    if nav:
        kbrows.append(nav)
    kbrows.append([("‹ проекты", "s")])
    return _inline(kbrows)


def sessions_projects_kb(projects):
    """Клавиатура выбора проекта - по два в ряд, чтобы список не рос вниз."""
    btns = [(p, "s:p:%s" % p) for p in projects]
    rows = [btns[i:i + 2] for i in range(0, len(btns), 2)]
    return _inline(rows or [[("(нет проектов)", "s")]])


def rc_projects():
    """Проекты из реестра claude-rc. Пустой список - если CLI недоступен."""
    rc, out, _err = run_rc(["list"], timeout=15)
    if rc != 0:
        return []
    return [p for p in (out or "").split()
            if re.match(r"^[a-zA-Z0-9_-]{1,32}$", p)]


def parse_live(text):
    """TSV из `claude-rc live --porcelain` -> список запущенных сессий."""
    out = []
    for line in (text or "").splitlines():
        parts = line.split("\t")
        if len(parts) != 6 or not re.match(r"^[0-9a-f]{8}-", parts[0]):
            continue
        sid, project, title, health, mtime, ctx = parts
        out.append({"sid": sid, "short": sid[:8], "project": project,
                    "title": title, "health": health, "live": True,
                    "mtime": mtime,
                    "ctx": int(ctx) if ctx.isdigit() else None})
    return out


def live_label(row, now=None, tz=None):
    """Подпись активной сессии: состояние, имя, проект, возраст, объем контекста.

    Молчащая помечена иначе, чем рабочая: залипшая на setup-экране сессия
    снаружи неотличима от живой, и именно это однажды стоило часа диагностики.
    Время и объем - те же, что в списке проекта: корневой экран не должен быть
    беднее, иначе про сжатие вспоминают, только когда сессия уже уперлась."""
    name = (row.get("title") or "").strip() or row.get("short", "?")
    head = _clip_label(redact("%s %s · %s"
                              % (session_icon(row), name, row.get("project", ""))))
    tail = [x for x in (session_when(row.get("mtime"), now=now, tz=tz),
                        _ctx_note(row.get("ctx"))) if x]
    return " · ".join([head] + tail)


def sessions_root_kb(projects, live_rows):
    """Корневой экран: сверху что запущено, снизу проекты."""
    rows = [[(live_label(r), "s:s:%s:%s" % (r["project"], r["short"]))]
            for r in live_rows]
    btns = [(p, "s:p:%s" % p) for p in projects]
    rows += [btns[i:i + 2] for i in range(0, len(btns), 2)]
    if not rows:
        rows = [[("(нет проектов)", "s")]]
    return _inline(rows)


def rc_live():
    rc, out, _err = run_rc(["live", "--porcelain"], timeout=45)
    return parse_live(out) if rc == 0 else []


SESSIONS_PAGE = 8   # строк-сессий на экране


def rc_sessions(project, page=0):
    """Страница сессий проекта -> (строки, есть_ли_еще).

    Просим на одну строку больше, чем показываем: лишняя и есть ответ на
    вопрос "рисовать ли кнопку дальше". Считать общее число сессий ради этого
    - лишний проход по всем транскриптам проекта.
    """
    rc, out, _err = run_rc(
        ["sessions", project, "--porcelain",
         "--offset", str(page * SESSIONS_PAGE),
         "--limit", str(SESSIONS_PAGE + 1)], timeout=30)
    rows = parse_porcelain(out) if rc == 0 else []
    return rows[:SESSIONS_PAGE], len(rows) > SESSIONS_PAGE


def resolve_short(project, short):
    """Короткий id из callback -> строка сессии. None, если не нашлась или
    неоднозначна.

    Точечный поиск по id, а не обход списка: тап приходит и с глубоких страниц,
    а какая открыта - бот не помнит. Обход всего списка ради одной строки стоил
    10,5 с на сотне сессий (замер 2026-08-03) - и это на КАЖДЫЙ тап по сессии,
    подъем, гашение и удаление. Точечный поиск - 0,13 с."""
    rc, out, _err = run_rc(
        ["sessions", project, "--porcelain", "--only", short], timeout=30)
    rows = parse_porcelain(out) if rc == 0 else []
    return rows[0] if len(rows) == 1 else None


def send_sessions_root(token, proxy, chat_id, message_id=None):
    """Экран 1: что запущено прямо сейчас + проекты."""
    projects = rc_projects()
    live_rows = rc_live()
    if not projects:
        text = "Реестр проектов пуст или CLI недоступен."
    elif live_rows:
        stale = sum(1 for r in live_rows if r.get("health") == "stale")
        text = "<b>Сессии</b>\nЗапущено: %d%s" % (
            len(live_rows), " (◌ %d молчит)" % stale if stale else "")
    else:
        text = "<b>Сессии</b>\nСейчас ничего не запущено."
    _send_or_edit(token, proxy, chat_id, message_id, text,
                  sessions_root_kb(projects, live_rows))


def send_sessions_list(token, proxy, chat_id, message_id, project, note="",
                       page=0):
    """Экран 2: сессии проекта. Имена - те же, что в Cursor."""
    rows, has_more = rc_sessions(project, page)
    if not rows and page > 0:
        # Страница опустела, пока человек листал (сессию удалили или подняли
        # новую, сдвинув окно) - откатываем на первую, а не показываем пустоту
        # без единой кнопки назад.
        rows, has_more = rc_sessions(project, 0)
        page = 0
    if rows:
        head = "\u25cf работает · \u25cb опущена · \u26a0 молчит"
        if page:
            head += " Стр. %d." % (page + 1)
        text = "<b>%s</b>\n%s" % (html.escape(project), head)
    else:
        text = "<b>%s</b>\nПрошлых сессий нет." % html.escape(project)
    if note:
        text += "\n\n%s" % html.escape(note)
    _send_or_edit(token, proxy, chat_id, message_id, text,
                  sessions_list_kb(project, rows, page, has_more))


def session_card_view(project, row, note=""):
    """Строка списка -> (текст карточки, клавиатура). Чистая функция: карточка
    рисуется из готовой строки и НЕ ищет сессию заново - иначе только что
    созданную показать нельзя (ее транскрипт еще пуст, а `--porcelain` пропускает
    файлы без реплики человека, так что в списке ее нет)."""
    short = row["short"]
    name = (row.get("title") or "").strip() or short
    state = "поднята" if row.get("live") else "опущена"
    text = "%s <b>%s</b>\n%s · %s" % (session_icon(row), html.escape(name),
                                      html.escape(project), state)
    pct = _ctx_note(row.get("ctx"))
    if pct:
        text += " · контекст %s" % pct
    if note:
        text += "\n\n%s" % html.escape(note)
    if row.get("live"):
        act = [("⏹ опустить", "s:d:%s:%s" % (project, short))]
    else:
        # Сжатие предлагаем только опущенной: транскрипт поднятой держит ее
        # процесс, и второй claude --resume по тому же файлу - задвоение.
        act = [("▶ поднять", "s:u:%s:%s" % (project, short)),
               ("🗜 сжать", "s:c:%s:%s" % (project, short))]
    rows = [act]
    if not row.get("live"):
        # Передача работы: ранбук из этой сессии + свежая с ним. Как и сжатие,
        # только у опущенной - ранбук пишется по ее же транскрипту.
        rows.append([("📄 передать", "s:h:%s:%s" % (project, short)),
                     ("🗑 удалить", "s:x:%s:%s" % (project, short))])
    else:
        act.append(("🗑 удалить", "s:x:%s:%s" % (project, short)))
    # Два выхода, а не один: в карточку проваливаются и из списка проекта, и с
    # корневого экрана активных. Во втором случае "‹ сессии" уводит в список
    # проекта, который человек не выбирал, и наверх выбраться нечем.
    rows.append([("‹ сессии", "s:p:%s" % project), ("‹ проекты", "s")])
    return text, _inline(rows)


# Кэш промпта живет на стороне провайдера около часа и привязан к СОДЕРЖИМОМУ,
# а не к процессу: новый прогон по тому же транскрипту попадает в тот же кэш,
# пока он не протух. Пока теплый - вся переписка читается по цене чтения; после
# - переписывается по цене записи, примерно на порядок дороже (замер 2026-08-04
# на одной сессии: 754 827 из кэша против 723 291 в запись). Поднята сессия или
# опущена - неважно, важна свежесть работы.
CACHE_WARM_S = 3600


def _cache_note(mtime, now=None):
    """Строка про цену прогона по всей переписке. Пусто - пока кэш теплый."""
    try:
        age = int(now if now is not None else time.time()) - int(float(mtime))
    except (TypeError, ValueError):
        return ""
    if age <= CACHE_WARM_S:
        return ""
    return ("\n\nКэш остыл (последняя работа %s назад) - вся переписка пойдет "
            "заново, это примерно на порядок дороже. Дешевле делать сразу после "
            "работы." % session_when(mtime, now=now).strip())


def session_handoff_view(project, row, new_name, now=None):
    """Экран подтверждения передачи работы в свежую сессию.

    Отдельным шагом: это полный запрос по всей переписке (минуты, деньги) плюс
    подъем еще одной сессии. Показываем будущее имя - человек видит, что
    получится, и может передумать до траты."""
    short = row["short"]
    name = (row.get("title") or "").strip() or short
    pct = _ctx_note(row.get("ctx"))
    text = "Передать работу из <b>%s</b> в новую сессию?" % html.escape(name)
    if pct:
        text += "\nСейчас занято %s." % pct
    text += ("\n\nСессия выпишет ранбук - где мы, что сделано, что дальше - и он "
             "уйдет первой репликой в <b>%s</b>. Чистый старт весит втрое меньше "
             "сжатия, но сохранится только записанное.\n\nЭта сессия останется "
             "замороженной: не удаляем, удалить можно отдельно."
             % html.escape(new_name))
    text += _cache_note(row.get("mtime"), now=now)
    kb = _inline([[("✓ передать", "s:g:%s:%s" % (project, short))],
                  [("отмена", "s:s:%s:%s" % (project, short))]])
    return text, kb


def session_compact_view(project, row, now=None):
    """Экран подтверждения сжатия. Отдельным шагом намеренно: это полноценный
    запрос к модели по ВСЕЙ переписке - на большой сессии минуты и заметные
    деньги, случайный тап пальцем тут дорог."""
    short = row["short"]
    name = (row.get("title") or "").strip() or short
    pct = _ctx_note(row.get("ctx"))
    text = "Сжать контекст <b>%s</b>?" % html.escape(name)
    if pct:
        text += "\nСейчас занято %s." % pct
    text += ("\n\nПереписку модель пересказывает сама - это полный запрос по "
             "всей истории, минуты на большой сессии. Процент обновится не сразу, "
             "а после первого ответа: сам вызов сжатия читает еще старый контекст.")
    text += _cache_note(row.get("mtime"), now=now)
    kb = _inline([[("✓ сжать", "s:z:%s:%s" % (project, short)),
                   ("✓ сжать и поднять", "s:w:%s:%s" % (project, short))],
                  [("отмена", "s:s:%s:%s" % (project, short))]])
    return text, kb


def session_confirm_view(project, row):
    """Экран подтверждения удаления. Отдельный шаг намеренно: тап по корзине в
    списке кнопок делается одним пальцем на ходу, а переписку не воссоздать."""
    short = row["short"]
    name = (row.get("title") or "").strip() or short
    text = ("Удалить <b>%s</b>?\n%s\n\nПереписка исчезнет из списка. "
            "Вернуть можно 30 дней." % (html.escape(name), html.escape(project)))
    kb = _inline([[("✓ да, удалить", "s:y:%s:%s" % (project, short)),
                   ("отмена", "s:s:%s:%s" % (project, short))]])
    return text, kb


def send_session_card(token, proxy, chat_id, message_id, project, short,
                      note="", row=None):
    """Экран 3: одна сессия - поднять/опустить. row передают, когда сессии еще
    нет в списке (только что созданная)."""
    if row is None:
        row = resolve_short(project, short)
    if row is None:
        send_sessions_list(token, proxy, chat_id, message_id, project)
        return
    text, kb = session_card_view(project, row, note)
    _send_or_edit(token, proxy, chat_id, message_id, text, kb)


def _is_not_modified(exc):
    """Telegram отвечает 400 на правку сообщения тем же содержимым. Это не сбой:
    так выглядит повторный тап по уже открытому экрану. Логировать это как ошибку
    вредно - в логе копится шум, и настоящие 400 в нем тонут.

    Проверка узкая, по тексту "not modified": раньше под нее подпадал ЛЮБОЙ
    "Bad Request", из-за чего глохли реальные ошибки правки (сообщение удалено,
    сообщение старше 48 ч) - ровно то, что докстринг обещал не делать."""
    return "not modified" in str(exc).lower()


# Типы, которые цикл опроса отдает в _handle_sessions_callback. Держим их ОДНИМ
# списком рядом с обработчиком: раньше перечень был вписан прямо в цикл и отстал
# от обработчика - роутинг и сам обработчик знали про сжатие, а цикл нет, и тап
# по "сжать" молча не делал ничего (найдено 2026-08-04).
SESSION_CALLBACK_KINDS = frozenset((
    "sessions_root", "sessions_project", "session_card", "session_up",
    "session_down", "session_new", "session_rm_ask", "session_rm_do",
    "session_compact_ask", "session_compact_do", "session_compact_up",
    "session_handoff_ask", "session_handoff_do",
))


def _handle_sessions_callback(token, proxy, chat_id, message_id, kind, project, short):
    """Тап по экрану сессий. Действия идут через claude-rc: бот сам ничего не
    запускает и не гасит, его дело - меню и пересказ результата."""
    if kind == "sessions_root":
        send_sessions_root(token, proxy, chat_id, message_id)
        return
    if kind == "sessions_project":
        page = int(short) if (short or "").isdigit() else 0
        send_sessions_list(token, proxy, chat_id, message_id, project,
                           page=page)
        return
    if kind == "session_card":
        send_session_card(token, proxy, chat_id, message_id, project, short)
        return
    if kind == "session_new":
        rc, out, err = run_rc(["new", project], timeout=120)
        m = re.search(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
                      out or "")
        if rc == 0 and m:
            # Карточку рисуем по возвращенному uuid, а не через список: пустая
            # сессия в него не попадает, и человек увидел бы откат к списку
            # вместо только что поднятой сессии.
            sid = m.group(0)
            send_session_card(token, proxy, chat_id, message_id, project,
                              sid[:8], note="поднята новая сессия",
                              row={"sid": sid, "short": sid[:8], "title": "",
                                   "live": True, "origin": "project",
                                   "cwd": "", "mtime": "0"})
        else:
            tail = (err or out or "не удалось поднять").strip().splitlines()
            send_sessions_list(token, proxy, chat_id, message_id, project)
            log("session new failed: %s" % (tail[-1] if tail else "?"))
        return

    row = resolve_short(project, short)
    if row is None:
        # Список мог измениться между показом и тапом - показываем актуальный.
        send_sessions_list(token, proxy, chat_id, message_id, project)
        return
    if kind == "session_handoff_ask":
        rc, out, _err = run_rc(["handoff-name", project, row["sid"]], timeout=45)
        new_name = (out or "").strip().splitlines()
        new_name = new_name[0] if (rc == 0 and new_name) else "новая сессия"
        text, kb = session_handoff_view(project, row, new_name)
        _send_or_edit(token, proxy, chat_id, message_id, text, kb)
        return
    if kind == "session_handoff_do":
        rc, out, err = run_rc(["handoff", project, row["sid"]], timeout=60)
        if rc == 0:
            note = ("ранбук пишется, продолжение поднимется следом. "
                    "Эта сессия останется замороженной")
        else:
            tail = (err or out or "не удалось").strip().splitlines()
            note = tail[-1] if tail else "не удалось запустить передачу"
        send_session_card(token, proxy, chat_id, message_id, project, short,
                          note=note)
        return
    if kind == "session_compact_ask":
        text, kb = session_compact_view(project, row)
        _send_or_edit(token, proxy, chat_id, message_id, text, kb)
        return
    if kind in ("session_compact_do", "session_compact_up"):
        args = ["compact", project, row["sid"]]
        if kind == "session_compact_up":
            args.append("--up")
        # Ответ приходит сразу: сама работа идет в своем юните, а бот не имеет
        # права стоять минуту - он в это время не обрабатывает вообще ничего.
        rc, out, err = run_rc(args, timeout=60)
        if rc == 0:
            note = ("сжатие пошло, поднимем после него"
                    if kind == "session_compact_up" else "сжатие пошло")
            note += ". Процент обновится после первого ответа"
        else:
            tail = (err or out or "не удалось").strip().splitlines()
            note = tail[-1] if tail else "не удалось запустить сжатие"
        send_session_card(token, proxy, chat_id, message_id, project, short,
                          note=note)
        return
    if kind == "session_rm_ask":
        text, kb = session_confirm_view(project, row)
        _send_or_edit(token, proxy, chat_id, message_id, text, kb)
        return
    if kind == "session_rm_do":
        rc, out, err = run_rc(["rm", project, row["sid"]], timeout=60)
        tail = (out or err or "").strip().splitlines()
        note = tail[-1] if tail else ("не удалось удалить" if rc else "удалено")
        # Возвращаемся в список: карточки удаленной сессии больше нет.
        send_sessions_list(token, proxy, chat_id, message_id, project,
                           note=note if rc else "")
        return
    if kind == "session_up":
        rc, out, err = run_rc(["up", project, row["sid"]], timeout=120)
    else:
        rc, out, err = run_rc(["down", row["sid"]], timeout=60)
    note = (out or err or "").strip().splitlines()
    note = note[-1] if note else ("ошибка" if rc else "готово")
    send_session_card(token, proxy, chat_id, message_id, project, short, note=note)


def _send_or_edit(token, proxy, chat_id, message_id, text, kb):
    """Меню живет одним сообщением: экраны сменяют друг друга правкой на месте.
    Правка не прошла (сообщение старое или удалено) - шлем новое, чтобы тап не
    остался без ответа."""
    # Текст уже собран как HTML (<b> вокруг имени), поэтому идет напрямую в api:
    # send_message эскейпит все подряд - это верно для вывода агентов, но здесь
    # превратило бы разметку в литерал.
    markup = json.dumps(kb, ensure_ascii=False)
    if message_id is not None:
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id, text=text,
                parse_mode="HTML", reply_markup=markup)
            return
        except Exception as e:  # noqa: BLE001
            if _is_not_modified(e):
                # Экран уже показывает ровно это содержимое: повторный тап или
                # повторная доставка того же callback. Новое сообщение здесь -
                # дубль экрана с кнопками (случай 2026-08-03: тап "Проекты"
                # после подъема сессии рисовал второе такое же меню).
                return
            log("menu edit failed (%s), sending new message" % e)
    api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
        text=text, parse_mode="HTML", reply_markup=markup)


def answer_action(qkind, status, answered_at, published_at, source):
    """Best-effort UI-дедуп (§6.3, §7 рубеж 1) -> "apply"|"stale"|
    "wrong_kind". wrong_kind - ровно один случай: permission-карточка,
    ответ пришел reply-ем (§4: у permission только кнопки). stale - только
    при ЗАВЕРШЕННОЙ паре (answered_at И published_at непусты) либо при
    закрытом/отсутствующем вопросе; ответ без публикации (spool-put упал,
    бот уже закоммитил offset) - "apply": повтор обязан дожать публикацию,
    иначе вопрос завис бы навсегда (аудит V2.5 major)."""
    if qkind == "permission" and source == "reply":
        return "wrong_kind"
    if status != "open":
        return "stale"
    if answered_at is not None and published_at is not None:
        return "stale"
    return "apply"


def reply_target(entry):
    """Запись sent_map (или None) -> (kind, qid) (§6 reply). kind=="done"
    (V2.7b §3 п.5) -> ("done", sha8) - reply на карточку готовности несет
    комментарий к отказу; с qid -> ("question", qid); без qid (в т.ч.
    запись отсутствует) -> ("mission", None) - неизменный regression-путь
    mission_comment (§8)."""
    if isinstance(entry, dict) and entry.get("kind") == "done":
        return "done", entry.get("qid")
    if isinstance(entry, dict) and entry.get("qid"):
        return "question", entry["qid"]
    return "mission", None


# ------------------------------------------------------------------- auth

def authorized(update, whitelist):
    """private chat + from.id in whitelist. Группа правом не является."""
    msg = update.get("message") or {}
    chat = msg.get("chat") or {}
    frm = msg.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


def parse_command(text):
    """-> (cmd, arg) или (None, None). Имя агента валидируется здесь."""
    if not isinstance(text, str) or not text.startswith("/"):
        return None, None
    parts = text.split()
    cmd = parts[0].split("@")[0].lower()
    if cmd in ("/agents", "/start", "/help", "/limits", "/sessions"):
        return cmd, None
    if cmd == "/menu":
        return cmd, None
    if cmd == "/agent" and len(parts) == 2 and NAME_RE.match(parts[1]):
        return cmd, parts[1]
    if cmd == "/agent":
        return "/agent-bad", None
    if cmd == "/task":
        # /task <agent> <текст...> - событие в spool агента (этап 4, Д1)
        p3 = text.split(None, 2)
        if len(p3) == 3 and NAME_RE.match(p3[1]):
            return cmd, (p3[1], p3[2])
        return "/task-bad", None
    if cmd == "/new":
        # /new <проект> <текст...> - рождение задачи с телефона (V2.7a §1,
        # аудит blocker 1). Имя задачи выводится из update_id в new_task(),
        # не здесь - проект известен только по имени из projects.yaml.
        p3 = text.split(None, 2)
        if len(p3) == 3:
            return cmd, (p3[1], p3[2])
        return "/new-bad", None
    return None, None


# ---------------------------------------------------------------- commands

def run_cli(args):
    """claude-rc agent ... без shell; вывод - недоверенный текст."""
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-rc"), "agent"]
                           + args, capture_output=True, text=True, timeout=30)
        return (r.stdout + r.stderr).strip() or "(пусто)"
    except Exception as e:  # noqa: BLE001 - боту нельзя падать от CLI
        return "ошибка CLI: %s" % e


def tail_lines(path, n, max_bytes=65536):
    """Хвост файла ограниченным чтением, не readlines() целиком (stage9)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    lines = data.splitlines()
    if size > max_bytes and lines:
        lines = lines[1:]  # первая строка окна могла быть разрезана
    return lines[-n:]


def events_tail(name, n=5):
    path = os.path.expanduser(
        "~/.claude-control/agents/%s/events.jsonl" % name)
    out = []
    for ln in tail_lines(path, n):
        try:
            d = json.loads(ln)
            out.append("%s %s %s" % (d.get("at", "")[11:19],
                                     d.get("event", ""),
                                     redact(str(d.get("detail") or ""))))
        except ValueError:
            continue
    return "\n".join(out)


def agent_names():
    """Имена агентов из реестра (папки со spec.yaml), сортированные."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        names = [n for n in os.listdir(d)
                 if os.path.isfile(os.path.join(d, n, "spec.yaml"))]
    except OSError:
        return []
    return sorted(names)


def menu_trigger(text):
    """Текст reply-кнопки -> раздел ("sessions"/"agents"/"limits"), иначе None."""
    if not isinstance(text, str):
        return None
    return MENU_BTNS.get(text.strip())


def _reply_kbd():
    """Постоянная reply-клавиатура с кнопкой меню - всегда под полем ввода."""
    # Голос во втором ряду: он переключается заметно реже, чем открываются
    # разделы, и не должен смещать привычные три кнопки под пальцем.
    return json.dumps({"keyboard": [[BTN_SESSIONS, BTN_AGENTS, BTN_LIMITS],
                                    [voice_btn(voice_enabled())]],
                       "resize_keyboard": True, "is_persistent": True},
                      ensure_ascii=False)


def keyboard_recovery_text(mtext, cmd, section):
    """Подсказка, которой возвращаем reply-клавиатуру. None - если не надо.

    Клавиатура живет на КЛИЕНТЕ, а бот ставил ее только на /start, /menu и
    кнопку старого меню. Пропала на телефоне (переустановка, чистка чата,
    скрыли рукой) - вернуть нечем: человек видит бота без кнопок и должен
    вспомнить команду. Поэтому любой неопознанный текст в личке ставит
    клавиатуру заново: не помнить волшебное слово - нормально.
    """
    if cmd or section:
        return None
    if not isinstance(mtext, str) or not mtext.strip():
        return None
    return "Не понял. Разделы - на клавиатуре под полем ввода."


def _inline(rows):
    """rows: список рядов [(label, callback_data), ...] -> JSON inline-клавы."""
    kb = [[{"text": lbl, "callback_data": data} for lbl, data in row]
          for row in rows]
    return {"inline_keyboard": kb}


def _limits_text():
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
            capture_output=True, text=True, timeout=30)
        out = (r.stdout if r.returncode == 0 else "").strip()
    except Exception:  # noqa: BLE001
        out = ""
    return out or "лимиты недоступны (см. лог limits-digest)"


def menu_view(level):
    """level -> (html_text, inline_markup_dict). Неизвестный -> root."""
    if level == "agents":
        names = agent_names()
        rows = [[(n, "m:ag:%s" % n)] for n in names]
        body = ("\U0001f916 <b>Агенты</b> (%d)" % len(names)) if names \
            else "нет зарегистрированных агентов"
        return body, _inline(rows)
    if level == "limits":
        body = "<b>Лимиты LLM</b>\n<pre>%s</pre>" % html.escape(_limits_text())
        return body, _inline([[("\U0001f504 Обновить", "m:limits")]])
    if level.startswith("ag:"):
        name = level[3:]
        if not NAME_RE.match(name):
            return menu_view("root")
        text = run_cli(["status", name])
        tail = events_tail(name)
        if tail:
            text += "\n--- события ---\n" + tail
        body = "<pre>%s</pre>" % html.escape(text)
        for h in agent_hints(name):
            body += "\n<code>%s</code>" % html.escape(h)
        return body, _inline([[("\U0001f4cb Сводка", "m:sum:%s" % name)],
                              [("\U0001f504 Обновить", "m:ag:%s" % name)],
                              [("◀ Агенты", "m:agents")]])
    # Неизвестный уровень: раздел агентов - ближайшее к хабу, что осталось
    # после удаления root. Молча падать нельзя, кнопка приходит от Telegram.
    return menu_view("agents")


def send_menu(token, proxy, chat_id, level="agents", arm=False):
    """Новое меню-сообщение. arm=True - заодно ставит reply-клавиатуру."""
    if arm:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="Клавиатура меню включена.", reply_markup=_reply_kbd())
        except Exception as e:  # noqa: BLE001
            log("arm keyboard error: %s" % e)
    body, kb = menu_view(level)
    api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
        text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def edit_menu(token, proxy, chat_id, message_id, level):
    """Перерисовать меню на месте (навигация по уровням)."""
    body, kb = menu_view(level)
    api(token, proxy, "editMessageText", http_timeout=30, chat_id=chat_id,
        message_id=message_id, text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def authorized_cb(update, whitelist):
    """callback_query из private + from.id в whitelist."""
    cq = update.get("callback_query") or {}
    chat = ((cq.get("message") or {}).get("chat") or {})
    frm = cq.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


class TransientSpoolError(Exception):
    """Временный отказ spool-put (диск, lock): offset НЕ двигаем, retry
    следующим getUpdates (ревью-2 этапа 4, атака 5)."""


def spool_task(arg, update_id, from_id):
    """Продюсер #1 (Д1): spool-put c producer-идемпотентностью по update_id.
    Redelivery того же update дает тот же seq, дубль не создается."""
    name, text = arg
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "spool-put", name,
             "--json", json.dumps({"text": text, "from": from_id},
                                  ensure_ascii=False),
             "--producer", "telegram", "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return "принято #%s -> %s" % (r.stdout.strip(), name), False
    if r.returncode in (2, 3, 6):
        # ИЗВЕСТНЫЙ постоянный отказ (валидация, нет агента, кап):
        # ответ пользователю + offset дальше
        return "отказ: %s" % (r.stderr.strip() or "spool-put failed"), False
    # все прочее (lock busy 5, диск 7, неизвестные коды) - fail-closed:
    # событие НЕЛЬЗЯ терять, offset стоит (ревью-3, п.7)
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def new_task(project, text, update_id):
    """Продюсер /new (V2.7a §1, аудит blocker 1): claude-rc agent new-task,
    вся цепочка (create/spool-put/start) идемпотентна по update_id - имя
    задачи выводится из него (task-tg<update_id>), redelivery того же
    апдейта дает ту же строку вывода, вторая задача не заводится."""
    name = "task-tg%s" % update_id
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-rc"), "agent", "new-task",
             "--name", name, "--project", project, "--text", text],
            capture_output=True, text=True, timeout=60)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return r.stdout.strip(), False
    return "отказ: %s" % (r.stderr.strip() or "new-task failed"), False


def _agents_dir():
    return (os.environ.get("CLAUDE_AGENTS_DIR")
            or os.path.expanduser("~/.claude-control/agents"))


def _agent_type(name):
    """type из spec.yaml агента ('mission' - дефолт)."""
    try:
        with open(os.path.join(_agents_dir(), name, "spec.yaml")) as f:
            for ln in f:
                if ln.startswith("type:"):
                    return ln.split(":", 1)[1].strip() or "mission"
    except OSError:
        pass
    return "mission"


def _control_read(name):
    """control.json ОДНИМ чтением (stage9 гейт п.11) ->
    (doc|None, None|"missing"|"error")."""
    d = os.path.join(_agents_dir(), name)
    if not os.path.isdir(d):
        return None, "missing"
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-io"),
                            "control-read", d],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            return json.loads(r.stdout), None
    except Exception:  # noqa: BLE001
        pass
    return None, "error"


def summary_text(name):
    """Механическая сводка mission-агента (stage9 фича 1) -> (text, gen).
    control одним чтением, state строго его поколения, события с redaction,
    mission-очередь."""
    control, err = _control_read(name)
    if control is None:
        return "агент %s: control.json недоступен (%s)" % (name, err), None
    gen = control.get("generation")
    parts = ["агент: %s (gen %s)" % (name, gen),
             "desired: %s" % control.get("desired"),
             "hold: %s" % control.get("hold")]
    att = control.get("attention") or {}
    parts.append("attention: %s" % (att.get("reason") or "-"))
    acc = control.get("acceptance")
    if acc:
        parts.append("acceptance: %s"
                     % json.dumps(acc, ensure_ascii=False)[:200])
    sp = os.path.join(_agents_dir(), name, "state.%s.json" % gen)
    try:
        with open(sp) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = None
    if isinstance(st, dict) and st.get("generation") == gen:
        for k in ("phase", "iterations", "status_line", "agent_claim"):
            if st.get(k) not in (None, ""):
                parts.append("%s: %s" % (k, st.get(k)))
    else:
        parts.append("state: нет валидного отчета поколения %s" % gen)
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-run"),
                            "mission-status", name],
                           capture_output=True, text=True, timeout=15)
        ms = json.loads(r.stdout) if r.returncode == 0 else {}
    except Exception:  # noqa: BLE001
        ms = {}
    if ms:
        q = "очередь: %s" % ms.get("depth")
        if ms.get("depth"):
            q += ", старейшему %sс" % ms.get("oldest_age_s")
        if ms.get("fail_streak"):
            q += ", неудач подряд %s" % ms.get("fail_streak")
        if ms.get("stalled"):
            q += " [DELIVERY STALLED]"
        parts.append(q)
    ev = events_tail(name, 8)
    text = "\n".join(parts)
    if ev:
        text += "\n--- события ---\n" + ev
    return redact(text), gen


def mission_put_task(name, text, update_id, from_id):
    """Продюсер mission-очереди (stage9): идемпотентность по update_id;
    транзиентные отказы (lock 5, диск 7) -> offset стоит, как spool_task."""
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "mission-put", name,
             "--text", text, "--from", str(from_id),
             "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return ("принято #%s -> %s (доставка на idle-промпте сессии)"
                % (r.stdout.strip(), name))
    if r.returncode == 6:
        return "очередь %s полна - подожди доставки (backpressure)" % name
    if r.returncode in (2, 3):
        return "отказ: %s" % (r.stderr.strip() or "mission-put failed")
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def mission_comment(msg, rep, text, update_id):
    """Reply на сообщение бота -> комментарий в mission-очередь (stage9
    фича 2). Роутинг по map (chat_id, message_id) со сверкой generation;
    вызывается ДО командного парсинга (гейт п.9)."""
    chat_id = (msg.get("chat") or {}).get("id")
    ent = sent_map_lookup(chat_id, rep.get("message_id"))
    if not ent:
        return ("сопоставить reply с агентом не могу - ответь на карточку "
                "задачи/вопроса или на свежую сводку (кнопка Сводка в "
                "меню); продолжение event-задачи: /task <имя> <текст>")
    if ent.get("kind") == "session":
        # Осознанная граница, а не поломка: голос из сессии - канал в одну
        # сторону. Говорим это прямо и называем, куда идти, вместо совета про
        # карточку задачи, которой тут нет.
        return ("это голосовой итог сессии \"%s\" - ответить в нее отсюда "
                "нельзя: у сессий нет обратного канала, промпт пишется внутри "
                "самой сессии. Голос тут работает в одну сторону."
                % (ent.get("agent") or "?"))
    name = ent.get("agent") or ""
    if not NAME_RE.match(name):
        return "битая запись роутинга - ответь на свежую сводку"
    if _agent_type(name) == "event":
        # живой сессии нет - комментарию некуда доставляться (spec stage9)
        return ("агент %s - event-типа, живой сессии нет; отправь как "
                "задачу: /task %s <текст>" % (name, name))
    control, err = _control_read(name)
    if err == "missing":
        return "агент %s удален - комментарий не доставить" % name
    if control is None:
        # transient: control нечитаем при живом каталоге - не терять update
        raise TransientSpoolError("control-read failed for %s" % name)
    gen = control.get("generation")
    if ent.get("gen") != gen:
        return ("это сообщение прежней инкарнации %s (gen %s, сейчас %s) - "
                "ответь на свежую сводку" % (name, ent.get("gen"), gen))
    return mission_put_task(name, text, update_id,
                            (msg.get("from") or {}).get("id", 0))


def _call_answer(agent_dir, qid, mode, value, by):
    """Доверенный писатель claude-agent-answer (§1: бот сам ничего не
    решает и не пишет в questions/) -> (returncode, stderr)."""
    args = [os.path.join(BIN_DIR, "claude-agent-answer"), agent_dir,
           "--qid", qid]
    if mode == "text":
        args += ["--text", value]
    elif mode == "approve":
        args += ["--approve"]
    else:
        args += ["--reject"]
    args += ["--by", by]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    return r.returncode, r.stderr.strip()


def _handle_question_callback(token, proxy, chat_id, message_id, kind,
                              qid, arg, from_id):
    """Тап по q:/p: (§6): агент вопроса берется из sent_map по
    (chat_id, message_id) - карточка была зарегистрирована при отправке
    (mode_send). Best-effort UI-дедуп (answer_action, §6.3) ДО вызова
    claude-agent-answer; настоящая гарантия "ровно один раз" - в самом
    claude-agent-answer (§7.2) и в runner-side stale-гейте (V2.3 §3.5)."""
    ent = sent_map_lookup(chat_id, message_id) or {}
    agent = ent.get("agent")
    if not ent.get("qid") or ent.get("qid") != qid:
        # §6, аудит V2.5 major 2(a) + V2.6 major 5: агент берется из
        # sent_map, но запись обязана нести qid и он обязан совпасть с
        # qid из callback_data - иначе тап по одной карточке мог бы
        # применить решение к чужому вопросу (например --approve на
        # info-вопросе через подмену qid в data), а старая запись БЕЗ
        # qid вовсе (legacy/mission) позволяла бы это без всякой подмены.
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id,
                text="вопрос уже закрыт или отвечен ранее (устарело)")
        except Exception as e:  # noqa: BLE001
            log("edit stale card error (qid mismatch): %s" % e)
        return
    doc = _question_read(agent, qid)
    decision = answer_action(
        doc.get("kind") if doc else None,
        doc.get("status") if doc else None,
        doc.get("answered_at") if doc else None,
        doc.get("event_published_at") if doc else None,
        "button")
    if decision != "apply":
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id,
                text="вопрос уже закрыт или отвечен ранее (устарело)")
        except Exception as e:  # noqa: BLE001
            log("edit stale card error: %s" % e)
        return
    agent_dir = os.path.join(_agents_dir(), agent)
    by = "tg:%s" % from_id
    if kind == "answer_option":
        try:
            value = (doc.get("options") or [])[int(arg)]
        except (TypeError, ValueError, IndexError):
            log("question callback: индекс опции вне диапазона (%r)" % arg)
            return
        mode = "text"
    else:
        value, mode = None, kind  # "approve" | "reject"
    rc, err = _call_answer(agent_dir, qid, mode, value, by)
    if rc != 0:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="не удалось применить ответ: %s"
                     % (err or ("exit %s" % rc)))
        except Exception as e:  # noqa: BLE001
            log("sendMessage after failed answer error: %s" % e)
        return
    try:
        api(token, proxy, "editMessageText", http_timeout=30,
            chat_id=chat_id, message_id=message_id, text="ответ принят")
    except Exception as e:  # noqa: BLE001
        log("edit applied card error: %s" % e)


def _handle_question_snooze(token, proxy, chat_id, message_id, qid):
    """Тап "напомнить позже" (r:<qid>, v2.6 §5): агент вопроса берется из
    sent_map по (chat_id, message_id), qid сверяется с карточкой - тот же
    рубеж, что в _handle_question_callback (§6). Запись - только через
    claude-agent-run question-snooze под questions/.lock; бот сам в файл
    вопроса не пишет (§5)."""
    ent = sent_map_lookup(chat_id, message_id) or {}
    agent = ent.get("agent")
    # аудит V2.6 major 5: запись обязана нести qid и он обязан совпасть -
    # без этого старая запись sent_map без qid (легаси/mission) позволяла
    # бы подставить произвольный r:<qid> и снузить чужой вопрос агента.
    if not agent or not ent.get("qid") or ent.get("qid") != qid:
        text = "вопрос уже закрыт или отвечен ранее (устарело)"
    else:
        agent_dir = os.path.join(_agents_dir(), agent)
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "question-snooze",
             agent_dir, "--qid", qid],
            capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            text = "напомню позже"
        else:
            text = "не удалось отложить: %s" \
                % (r.stderr.strip() or ("exit %s" % r.returncode))
    try:
        api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
            text=text)
    except Exception as e:  # noqa: BLE001
        log("sendMessage after snooze error: %s" % e)


# --------------------------------------------------- V2.7b: карточка "готово"

def _short_sha(commit_sha):
    return commit_sha[:8] if commit_sha else "-"


def _handle_done_callback(token, proxy, chat_id, message_id, kind, agent,
                          sha8, from_id):
    """Тап "принять"/"отклонить" на карточке готовности (d:<agent>:<sha8>:a/
    r, V2.7b §3). Доверие - право писать, не поле в payload (как в V2.5/
    §3 п.3): бот done.json не читает и не пишет вообще - классификацию
    applied/already/stale целиком отдает claude-agent-run done-verdict, у
    которого один monopoly на done.lock (§2): код возврата 3 - устарело,
    0 + stdout "already" - повторный тап (no-op), 0 + "applied" - первый
    успешный."""
    if not agent or not NAME_RE.match(agent):
        return
    want = "accepted" if kind == "accept_done" else "rejected"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "done-verdict",
           agent_dir, "--accept" if want == "accepted" else "--reject",
           "--expect-sha", sha8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        # причина из done-verdict (stderr) - иначе "устарело" неотличимо:
        # уже принято и ушло по FSM / передекларировано / агент архивирован
        reason = (r.stderr.strip().splitlines() or [""])[-1]
        text = "устарело - задача передекларирована или вердикт уже другой"
        if reason:
            text += "\n(%s)" % reason
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id, text=text)
        except Exception as e:  # noqa: BLE001
            log("edit stale done card error: %s" % e)
        return
    if r.returncode != 0:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="не удалось применить вердикт: %s"
                     % (r.stderr.strip() or ("exit %s" % r.returncode)))
        except Exception as e:  # noqa: BLE001
            log("sendMessage after failed done-verdict error: %s" % e)
        return
    already = r.stdout.strip() == "already"
    if want == "accepted":
        label = "уже принято" if already else "принято"
    else:
        label = "уже отклонено" if already else "отклонено"
    try:
        api(token, proxy, "editMessageText", http_timeout=30, chat_id=chat_id,
            message_id=message_id, text=label)
    except Exception as e:  # noqa: BLE001
        log("edit done card error: %s" % e)


# ------------------------------------------------ V2.9: хвост "уроки"

def _handle_lesson_callback(token, proxy, chat_id, agent, kind, cid8):
    """Тап "принять урок"/"отклонить урок" на хвосте карточки готовности
    (l:<agent>:<cid8>:y/n, V2.9 §5). Как и у done: бот agents/<name>/
    lessons.json и файл уроков проекта сам не открывает - вся классификация
    applied/already/stale в claude-agent-run lesson-verdict под его локом.
    Ответ - НОВЫМ сообщением (не editMessageText самой карточки готовности):
    решение по уроку не зависит от решения по самой заявке, редактирование
    карточки затронуло бы и ту, независимую пару кнопок."""
    if not agent or not NAME_RE.match(agent):
        return
    accept = kind == "accept_lesson"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "lesson-verdict",
           agent_dir, "--accept" if accept else "--reject", "--id", cid8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        text = "устарело - урок не найден или изменился"
    elif r.returncode != 0:
        text = "не удалось применить: %s" \
            % (r.stderr.strip() or ("exit %s" % r.returncode))
    else:
        already = r.stdout.strip() == "already"
        if accept:
            text = "урок уже подтвержден" if already else "урок принят"
        else:
            text = "урок уже отклонен" if already else "урок отклонен"
    try:
        api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
            text=text)
    except Exception as e:  # noqa: BLE001
        log("lesson verdict reply error: %s" % e)


def _handle_done_reply(agent, sha8, text, from_id):
    """Reply на карточку готовности -> отклонение с комментарием (§3 п.5:
    "комментарий к отказу берется reply-ответом"). Комментарий на принятие
    не предусмотрен - reply на карточку "готово" всегда несет намерение
    отклонить с пояснением, симметрично тому, как reply на info-вопрос -
    альтернативный ввод к кнопкам (V2.5 §4). Как и в _handle_done_callback,
    бот done.json не открывает - устарело/уже-отклонено различает по коду
    возврата и stdout claude-agent-run done-verdict."""
    if not agent or not NAME_RE.match(agent):
        return "битая запись роутинга - ответь на актуальную карточку"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "done-verdict",
           agent_dir, "--reject", "--comment", text, "--expect-sha", sha8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        reason = (r.stderr.strip().splitlines() or [""])[-1]
        return ("устарело - задача передекларирована или вердикт уже другой"
                + ("\n(%s)" % reason if reason else ""))
    if r.returncode != 0:
        return "не удалось применить: %s" \
            % (r.stderr.strip() or ("exit %s" % r.returncode))
    # вердикт неизменяем (§3 п.5): на повторе комментарий НЕ переписывается,
    # даже если пришел из более позднего reply на ту же карточку
    return ("уже отклонено ранее - комментарий не сохранен (вердикт "
            "неизменяем)" if r.stdout.strip() == "already"
            else "отклонено с комментарием")


def _question_reply_text(agent, qid, text, from_id):
    """Reply на карточку вопроса -> claude-agent-answer --text (§6 reply,
    §4: permission-карточка reply не принимает - wrong_kind). Возвращает
    сообщение пользователю."""
    doc = _question_read(agent, qid)
    decision = answer_action(
        doc.get("kind") if doc else None,
        doc.get("status") if doc else None,
        doc.get("answered_at") if doc else None,
        doc.get("event_published_at") if doc else None,
        "reply")
    if decision == "wrong_kind":
        return "у этой карточки только кнопки - жми разрешить/отклонить"
    if decision != "apply":
        return "вопрос уже закрыт или отвечен ранее (устарело)"
    agent_dir = os.path.join(_agents_dir(), agent)
    rc, err = _call_answer(agent_dir, qid, "text", text, "tg:%s" % from_id)
    if rc != 0:
        return "не удалось применить ответ: %s" % (err or ("exit %s" % rc))
    return "ответ принят"


def handle(cmd, arg, update_id=0, from_id=0):
    if cmd in ("/start", "/help"):
        return ("Дашборд агентов claude-control.\n"
                "/sessions - проекты и сессии: поднять, опустить\n"
                "/agents - парк\n/agent <name> - детали и события\n"
                "/task <name> <текст> - событие агенту\n"
                "/limits - остатки лимитов LLM"), False
    if cmd == "/agents":
        return run_cli(["list"]), True
    if cmd == "/limits":
        # панель из последнего кэшированного снапшота (limits-digest render)
        try:
            r = subprocess.run(
                [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
                capture_output=True, text=True, timeout=30)
            out = (r.stdout if r.returncode == 0 else "").strip()
        except Exception:  # noqa: BLE001
            out = ""
        return (out or "лимиты недоступны (см. лог limits-digest)"), True
    if cmd == "/agent-bad":
        return "имя агента: [a-z0-9-], например /agent faq-updater", False
    if cmd == "/task-bad":
        return "формат: /task <agent> <текст задачи>", False
    if cmd == "/new-bad":
        return "формат: /new <проект> <текст задачи>", False
    if cmd == "/agent":
        text = run_cli(["status", arg])
        tail = events_tail(arg)
        if tail:
            text += "\n--- события ---\n" + tail
        hints = agent_hints(arg)
        if not hints:
            return text, True
        # статус - <pre>-таблица, команды - отдельные <code> (копируются
        # построчно), все одним HTML-сообщением - см. mode "html" в send
        body = "<pre>%s</pre>\n--- вход в сессию ---" % html.escape(text)
        for h in hints:
            body += "\n<code>%s</code>" % html.escape(h)
        return body, "html"
    if cmd == "/task":
        return spool_task(arg, update_id, from_id)
    if cmd == "/new":
        project, text = arg
        return new_task(project, text, update_id)
    return None, False


# ------------------------------------------------------------------- modes

def mode_poll():
    token, wl, proxy = cfg()
    if not token or not wl:
        log("не настроено: нужны CLAUDE_AGENT_TG_TOKEN и "
            "CLAUDE_AGENT_TG_WHITELIST в ~/.config/claude-control/env")
        sys.exit(0)  # not-configured = чистый выход, не рестарт-шторм
    offset = 0
    try:
        offset = int(open(OFFSET_FILE).read().strip())
    except (OSError, ValueError):
        pass
    log("poll started (whitelist: %d id, proxy: %s)" % (len(wl), proxy or "-"))
    # В подсказке команд UI "/" держим РОВНО ОДНУ команду - /menu. Полный список
    # тут не нужен: работа идет кнопками (☰ Меню -> Сессии / Агенты / Лимиты), и
    # выпадающий список дублировал бы их третьим способом сделать то же самое.
    # Но и пустой список неверен: reply-клавиатура живет на КЛИЕНТЕ, сервер ее не
    # видит и сам не вернет, а пропадает она регулярно - после чистки чата, на
    # новом устройстве, иногда сама. Без единственной видимой команды человеку
    # остается вспоминать слово и набирать его руками (замечание dwl 23.08.2026).
    # Остальные команды продолжают работать набором (в т.ч. /new и /task).
    try:
        api(token, proxy, "setMyCommands", http_timeout=30,
            commands=json.dumps([{"command": "menu", "description": "Открыть меню"}],
                                ensure_ascii=False))
    except Exception as e:  # noqa: BLE001
        log("setMyCommands error: %s" % e)
    backoff = 1
    while True:
        try:
            # long-poll 30с: замерено, что прокси/edge рвет идл-коннект на
            # ~50с ("Remote end closed connection"), 45 - последний рабочий.
            # http_timeout с запасом на возврат данных.
            resp = api(token, proxy, "getUpdates", http_timeout=50,
                       offset=offset, timeout=30)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log("getUpdates error: %s (backoff %ss)" % (e, backoff))
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 1
        for upd in resp.get("result", []):
            # обработка ДО коммита offset (Д1: /task at-least-once; crash
            # между -> redelivery, дубль гасит producer-идемпотентность);
            # try/except - poison-update не клинит бота, offset уходит дальше
            try:
                if "callback_query" in upd and authorized_cb(upd, wl):
                    cq = upd["callback_query"]
                    data = cq.get("data", "")
                    cqmsg = cq.get("message") or {}
                    chat_id = (cqmsg.get("chat") or {}).get("id")
                    # спиннер на клиенте гасим всегда, даже при ошибке ниже
                    try:
                        api(token, proxy, "answerCallbackQuery",
                            http_timeout=30, callback_query_id=cq.get("id", ""))
                    except Exception:  # noqa: BLE001
                        pass
                    kind_cb, qid_cb, arg_cb = route_callback(data)
                    if kind_cb in ("answer_option", "approve", "reject") \
                            and chat_id is not None:
                        try:
                            _handle_question_callback(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), kind_cb, qid_cb,
                                arg_cb, (cq.get("from") or {}).get("id", 0))
                        except Exception as e:  # noqa: BLE001
                            log("question callback error: %s" % e)
                    elif kind_cb == "snooze" and chat_id is not None:
                        try:
                            _handle_question_snooze(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), qid_cb)
                        except Exception as e:  # noqa: BLE001
                            log("question snooze error: %s" % e)
                    elif kind_cb in SESSION_CALLBACK_KINDS \
                            and chat_id is not None:
                        try:
                            _handle_sessions_callback(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), kind_cb, qid_cb, arg_cb)
                        except Exception as e:  # noqa: BLE001
                            log("sessions callback error: %s" % e)
                    elif kind_cb in ("accept_done", "reject_done") \
                            and chat_id is not None:
                        try:
                            _handle_done_callback(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), kind_cb, qid_cb,
                                arg_cb, (cq.get("from") or {}).get("id", 0))
                        except Exception as e:  # noqa: BLE001
                            log("done callback error: %s" % e)
                    elif kind_cb in ("accept_lesson", "reject_lesson") \
                            and chat_id is not None:
                        # личность отправителя уже проверена authorized_cb
                        # выше (§5 - тем же гейтом chat_id, что у /new)
                        try:
                            _handle_lesson_callback(
                                token, proxy, chat_id, qid_cb, kind_cb, arg_cb)
                        except Exception as e:  # noqa: BLE001
                            log("lesson callback error: %s" % e)
                    elif data.startswith("m:sum:") and chat_id is not None:
                        # сводка - НОВЫМ сообщением, не edit: неизменяемый
                        # reply-якорь для map (stage9, гейт minor)
                        nm = data[len("m:sum:"):]
                        if NAME_RE.match(nm):
                            try:
                                stext, sgen = summary_text(nm)
                                ids = send_message(token, proxy, chat_id,
                                                  stext, pre=True)
                                sent_map_register(chat_id, ids, nm, sgen)
                            except Exception as e:  # noqa: BLE001
                                log("summary error: %s" % e)
                    elif data.startswith("m:") and chat_id is not None:
                        try:
                            edit_menu(token, proxy, chat_id,
                                      cqmsg.get("message_id"), data[2:])
                        except Exception as e:  # noqa: BLE001
                            if not _is_not_modified(e):
                                log("edit_menu error: %s" % e)
                elif authorized(upd, wl):
                    msg = upd.get("message") or {}
                    mtext = msg.get("text", "")
                    # Голосовое превращаем в текст ДО всей остальной логики:
                    # дальше оно идет теми же путями, что печатная реплика, -
                    # и reply на карточку агента попадает в ту же сессию, и
                    # команды разбираются как обычно. Ветку "а если голосом"
                    # заводить не надо ни в одном месте ниже.
                    if not (isinstance(mtext, str) and mtext.strip()) \
                            and (msg.get("voice") or msg.get("audio")):
                        mtext = voice_to_text(token, proxy, msg)
                        if mtext:
                            # Показываем, что услышали: без этого человек не
                            # знает, что именно получил агент, а расшифровка
                            # ошибается.
                            try:
                                send_message(token, proxy, msg["chat"]["id"],
                                             "🎙 " + mtext)
                            except Exception as e:  # noqa: BLE001
                                log("voice-in echo error: %s" % e)
                        else:
                            try:
                                send_message(token, proxy, msg["chat"]["id"],
                                             "Голосовое не расшифровалось - "
                                             "напиши текстом.")
                            except Exception as e:  # noqa: BLE001
                                log("voice-in notice error: %s" % e)
                    rep = msg.get("reply_to_message") or {}
                    if (rep.get("message_id") is not None
                            and isinstance(mtext, str) and mtext.strip()):
                        # reply = комментарий агенту, ДО парсинга команд
                        # (stage9 гейт п.9); TransientSpoolError уходит
                        # наверх - offset не двигается, update не теряется.
                        # §6: reply на карточку вопроса (запись с qid) идет
                        # в claude-agent-answer, без qid - прежний
                        # mission_comment (регресс-инвариант §8). reply на
                        # карточку готовности (kind=="done", V2.7b §3 п.5) -
                        # комментарий к отказу через done-verdict.
                        reply_chat_id = (msg.get("chat") or {}).get("id")
                        rt_kind, rt_qid = reply_target(sent_map_lookup(
                            reply_chat_id, rep.get("message_id")))
                        if rt_kind == "question":
                            ent = sent_map_lookup(reply_chat_id,
                                                  rep.get("message_id")) or {}
                            out = _question_reply_text(
                                ent.get("agent"), rt_qid, mtext,
                                (msg.get("from") or {}).get("id", 0))
                        elif rt_kind == "done":
                            ent = sent_map_lookup(reply_chat_id,
                                                  rep.get("message_id")) or {}
                            out = _handle_done_reply(
                                ent.get("agent"), rt_qid, mtext,
                                (msg.get("from") or {}).get("id", 0))
                        else:
                            out = mission_comment(msg, rep, mtext,
                                                  upd.get("update_id", 0))
                        # Разговор продолжится в этой же сессии: следующее
                        # сообщение можно писать без реплая.
                        ent_sticky = sent_map_lookup(reply_chat_id,
                                                     rep.get("message_id")) or {}
                        if ent_sticky.get("agent"):
                            sticky_set(reply_chat_id, ent_sticky.get("agent"),
                                       ent_sticky.get("gen"))
                        if out:
                            try:
                                send_message(token, proxy,
                                             msg["chat"]["id"], out)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
                        offset = upd["update_id"] + 1
                        try:
                            open(OFFSET_FILE, "w").write(str(offset))
                        except OSError:
                            pass
                        continue
                    cmd, arg = parse_command(mtext)
                    section = menu_trigger(mtext)
                    legacy = isinstance(mtext, str) \
                        and mtext.strip() == LEGACY_MENU_BTN
                    if cmd == "/menu":
                        # Меню-уровня больше нет; /menu оставлен как способ
                        # вернуть клавиатуру, если она потерялась.
                        section = section or "sessions"
                    if section:
                        try:
                            if section == "voice":
                                # Переключаем и тут же ПЕРЕСТАВЛЯЕМ клавиатуру:
                                # подпись несет состояние, а клавиатура живет на
                                # телефоне и сама не обновится. Без этого кнопка
                                # осталась бы врать до следующего /menu.
                                on = voice_toggle()
                                api(token, proxy, "sendMessage",
                                    http_timeout=30,
                                    chat_id=msg["chat"]["id"],
                                    text=(VOICE_ON_TEXT if on
                                          else VOICE_OFF_TEXT),
                                    reply_markup=_reply_kbd())
                            elif section == "sessions":
                                if cmd == "/menu" or legacy:
                                    api(token, proxy, "sendMessage",
                                        http_timeout=30,
                                        chat_id=msg["chat"]["id"],
                                        text="Разделы теперь под полем ввода.",
                                        reply_markup=_reply_kbd())
                                send_sessions_root(token, proxy,
                                                   msg["chat"]["id"])
                            else:
                                send_menu(token, proxy, msg["chat"]["id"],
                                          level=section,
                                          arm=(cmd == "/menu" or legacy))
                        except Exception as e:  # noqa: BLE001
                            log("menu section error: %s" % e)
                        cmd = None  # раздел отрисован, обычный handle не нужен
                    if cmd == "/sessions":
                        # V3.0: экран сессий - своя клавиатура, поэтому мимо handle
                        try:
                            send_sessions_root(token, proxy, msg["chat"]["id"])
                        except Exception as e:  # noqa: BLE001
                            log("sessions screen error: %s" % e)
                        cmd = None
                    hint = keyboard_recovery_text(mtext, cmd, section)
                    if hint:
                        try:
                            api(token, proxy, "sendMessage", http_timeout=30,
                                chat_id=msg["chat"]["id"], text=hint,
                                reply_markup=_reply_kbd())
                        except Exception as e:  # noqa: BLE001
                            log("keyboard recovery error: %s" % e)
                    if cmd == "/start":
                        # /start заодно ставит постоянную reply-клавиатуру
                        try:
                            api(token, proxy, "sendMessage", http_timeout=30,
                                chat_id=msg["chat"]["id"],
                                text="Клавиатура включена: разделы под полем ввода.",
                                reply_markup=_reply_kbd())
                        except Exception as e:  # noqa: BLE001
                            log("arm keyboard error: %s" % e)
                    if not cmd and not section and not legacy \
                            and isinstance(mtext, str) and mtext.strip():
                        try:
                            cont = sticky_route(msg, mtext,
                                                upd.get("update_id", 0))
                        except TransientSpoolError:
                            raise
                        except Exception as e:  # noqa: BLE001
                            log("sticky route error: %s" % e)
                            cont = None
                        if cont:
                            try:
                                send_message(token, proxy, msg["chat"]["id"],
                                             cont)
                            except Exception as e:  # noqa: BLE001
                                log("sticky reply error: %s" % e)
                    if cmd:
                        text, pre = handle(
                            cmd, arg, update_id=upd.get("update_id", 0),
                            from_id=(msg.get("from") or {}).get("id", 0))
                        if text:
                            try:
                                if pre == "html":
                                    # уже готовый HTML (<pre>+<code>), не
                                    # эскейпить и не заворачивать повторно
                                    api(token, proxy, "sendMessage",
                                        http_timeout=30,
                                        chat_id=msg["chat"]["id"],
                                        text=text, parse_mode="HTML")
                                else:
                                    send_message(token, proxy,
                                                 msg["chat"]["id"],
                                                 text, pre=pre)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
            except TransientSpoolError as e:
                # событие нельзя терять: offset стоит, retry следующим
                # getUpdates (идемпотентность --id гасит дубль ответа)
                log("transient spool error at %s: %s (retry)"
                    % (upd.get("update_id"), e))
                time.sleep(2)
                break
            except Exception as e:  # noqa: BLE001
                log("update %s error: %s" % (upd.get("update_id"), e))
            offset = upd["update_id"] + 1
            try:
                open(OFFSET_FILE, "w").write(str(offset))
            except OSError:
                pass


def _agent_project(agent):
    """project из spec.yaml агента в реестре; "" если нет."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        for line in open(os.path.join(d, agent, "spec.yaml")):
            m = re.match(r"^project:\s*(\S+)", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def agent_hints(agent):
    """Копируемые команды входа в сессию агента (терминал / Cursor).
    Пустой список, если ssh-алиас этой машины не задан (фича выключена)
    или имя агента не похоже на имя агента (служебные пуши)."""
    host = os.environ.get("CLAUDE_AGENT_SSH_HOST", "")
    if not host or not re.match(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$", agent or ""):
        return []
    hints = ["ssh %s -t '~/.local/bin/claude-rc agent attach %s'"
             % (host, agent)]
    project = _agent_project(agent)
    if project:
        hints.append("cursor --remote ssh-remote+%s %s" % (host, project))
    return hints


def mode_send(argv):
    # v2.6 §2/§4 (аудит V2.6, blocker+major 2): аргументы разбираются ДО
    # проверки конфигурации - has_json (4-й позиционный аргумент реально
    # присутствует) определяет question-путь ДЛЯ КОДА ВОЗВРАТА, независимо
    # от того, распарсится ли он в валидную карточку. json-detail - argv[3]
    # (4-й аргумент), НЕ argv[2] - alert_question (bin/claude-agent-run)
    # кладет туда qid, а json-detail четвертым; старая путаница здесь
    # вырождала question-путь в обычный алерт без кнопок и без sent_map,
    # честный код возврата не проверялся ни разу (сквозной стык V2.5/V2.6).
    agent = argv[0] if argv else "?"
    reason = argv[1] if len(argv) > 1 else "?"
    detail = argv[2] if len(argv) > 2 else ""
    has_json = len(argv) > 3
    token, wl, proxy = cfg()
    if not token or not wl:
        # v2.6 §4 (аудит V2.6, major): отсутствие конфигурации - НЕ
        # доставка. На question-пути это ложный успех (ступень продвинулась
        # бы в никуда) - код честный; обычный алерт остается 0 (регресс).
        return 1 if has_json else 0
    detail_json = None
    if has_json and argv[3]:
        try:
            detail_json = json.loads(argv[3])
        except ValueError:
            detail_json = None
    card_text, card_kb = question_card(detail_json)
    if card_text is not None:
        # V2.5 §3-4: карточка вопроса вместо обычного алерта. Текст уходит
        # существующим entity-safe отправителем (send_message), не прямым
        # api() - аудит V2.5 major 4: прямой вызов на длинном вопросе
        # получает отказ Telegram, исключение гасится, и mode_send
        # рапортует успех, хотя карточки не было вовсе.
        card_kind = detail_json.get("kind") \
            if isinstance(detail_json, dict) else None
        if card_kind == "done":
            # V2.7b §3 п.1: sha8 играет роль qid для роутинга кнопок/reply -
            # sent_map не заводит отдельного поля ради одного нового kind.
            # V2.10 r5 (live-блокер): идентификатор обязан быть ТЕМ ЖЕ, что
            # в callback_data кнопок, - поколением заявки (gen8), иначе
            # reply текстом уходит в done-verdict со старой формой
            # (commit_sha[:8]) и вечно получает "устарело". Фолбэк - для
            # detail от рантайма старой версии, где gen8 еще нет.
            qid = detail_json.get("gen8") \
                or _short_sha(detail_json.get("commit_sha"))
        else:
            qid = detail_json.get("qid") \
                if isinstance(detail_json, dict) else None
        # клавиатура целиком приходит из question_card (включая снуз, v2.6 §5)
        kb = json.dumps(card_kb, ensure_ascii=False) if card_kb else None
        delivered = False
        for uid in wl:
            try:
                ids = send_message(token, proxy, uid, card_text,
                                   reply_markup=kb)
                if any(mid is not None for mid in ids):
                    sent_map_register(uid, ids, agent, None,
                                      kind=card_kind or "question", qid=qid)
                    delivered = True
            except Exception as e:  # noqa: BLE001
                log("push error to %s: %s" % (uid, e))
        if delivered:
            # Р11 (план §12): считаем ДОСТАВЛЕННУЮ карточку ровно один раз,
            # не по числу получателей whitelist - метрика "карточек ушло",
            # не "пушей отправлено".
            cards_count_bump()
        # v2.6 §4: честный код возврата - только на question-пути. Успех =
        # карточку принял хотя бы один получатель из whitelist; ни одного -
        # ненулевой код (иначе "продвигать ступень только после доставки"
        # невыполнимо - недоставленная карточка выглядела бы отправленной).
        return 0 if delivered else 1
    # обычный текст-алерт - байт-в-байт как в V2.4 (регресс-инвариант T1/T2)
    # при отсутствии 4-го аргумента. Если 4-й аргумент присутствовал, но не
    # распознан как карточка вопроса (мусор/не question) - текст все равно
    # рендерится как обычный алерт, но код возврата остается честным
    # (has_json, аудит V2.6 blocker): "question-вызов" определяется числом
    # аргументов, а не успехом парсинга.
    text = "агент %s: %s%s" % (agent, reason,
                               (" - " + detail) if detail else "")
    # команды входа - отдельными <code>, чтобы копировались одним тапом
    body = html.escape(text)
    for h in agent_hints(agent):
        body += "\n<code>%s</code>" % html.escape(h)
    delivered = False
    for uid in wl:
        try:
            if len(body) <= 3800:
                api(token, proxy, "sendMessage", http_timeout=30,
                    chat_id=uid, text=body, parse_mode="HTML")
            else:  # аномально длинный detail - чанками, без хинтов
                send_message(token, proxy, uid, text)
            delivered = True
        except Exception as e:  # noqa: BLE001
            log("push error to %s: %s" % (uid, e))
    if has_json:
        return 0 if delivered else 1
    return 0


def mode_notify(argv):
    """Отправка произвольного текста во все whitelist-id (дайджесты и т.п.).
    В отличие от send-хука падает громко: вызывающему нужен честный exit."""
    pre = False
    agent = ""
    args = list(argv)
    while args and args[0] in ("--pre", "--agent"):
        if args[0] == "--pre":
            pre = True
            args = args[1:]
            continue
        agent = args[1] if len(args) > 1 else ""
        args = args[2:]
    text = (" ".join(args) if args and args != ["-"] else sys.stdin.read())
    text = text.rstrip("\n")
    if not text:
        log("notify: пустой текст")
        sys.exit(2)
    token, wl, proxy = cfg()
    if not token or not wl:
        log("notify: нужны CLAUDE_AGENT_TG_TOKEN и CLAUDE_AGENT_TG_WHITELIST")
        sys.exit(2)
    failures = 0
    for uid in sorted(wl):
        try:
            bind_to_agent(uid, send_message(token, proxy, uid, text, pre=pre), agent)
        except Exception as e:  # noqa: BLE001
            log("notify error to %s: %s" % (uid, e))
            failures += 1
    sys.exit(1 if failures == len(wl) else 0)


def voice_synth_path():
    """Чем синтезировать речь.

    Синтез намеренно НЕ вшит сюда: модель, зависимости и разбивка текста -
    отдельная история со своей ценой, и держать ее в двух местах значит
    однажды чинить только одно. Контур управления владеет ДОСТАВКОЙ (у него
    токен, whitelist и прокси), а синтез вызывает как внешний инструмент.

    Синтезатор живет в этом же репозитории, рядом с этим файлом (bin/voice-report):
    переменная окружения дает переопределить путь, дефолт резолвится от BIN_DIR,
    а не от cwd, - бот исполняется из ~/.local/bin, куда его кладет install.sh.
    """
    override = os.environ.get("CLAUDE_AGENT_VOICE_SYNTH", "")
    if override and os.path.isfile(override):
        return override
    path = os.path.join(BIN_DIR, "voice-report")
    if os.path.isfile(path):
        return path
    return None


def _multipart(fields, file_field, filename, payload):
    """Тело multipart/form-data: sendVoice принимает файл только так, а
    urlencode из api() умеет лишь плоские поля."""
    boundary = "----claudecontrol%s" % uuid.uuid4().hex
    out = []
    for name, value in fields.items():
        out.append(("--%s\r\n" % boundary).encode())
        out.append(('Content-Disposition: form-data; name="%s"\r\n\r\n' % name).encode())
        out.append(("%s\r\n" % value).encode())
    out.append(("--%s\r\n" % boundary).encode())
    out.append(('Content-Disposition: form-data; name="%s"; filename="%s"\r\n'
                % (file_field, filename)).encode())
    out.append(b"Content-Type: audio/ogg\r\n\r\n")
    out.append(payload)
    out.append(("\r\n--%s--\r\n" % boundary).encode())
    return b"".join(out), "multipart/form-data; boundary=%s" % boundary


def _post_audio(token, proxy, method, field, chat_id, ogg_path, fields):
    body, content_type = _multipart(
        fields, field, os.path.basename(ogg_path), open(ogg_path, "rb").read())
    req = urllib.request.Request(
        "https://api.telegram.org/bot%s/%s" % (token, method), data=body,
        headers={"Content-Type": content_type})
    handlers = []
    if proxy:
        handlers.append(urllib.request.ProxyHandler({"http": proxy, "https": proxy}))
    with urllib.request.build_opener(*handlers).open(req, timeout=120) as r:
        return json.loads(r.read().decode())


def _http_detail(e):
    """Описание ошибки от Telegram: без него код 400 не диагностируется."""
    try:
        return e.read().decode()[:300]
    except Exception:  # noqa: BLE001
        return ""


def _to_m4a(ogg_path):
    """Перекодировать ogg/opus в m4a.

    sendAudio принимает только mp3 и m4a - ogg он отвергает так же глухо,
    кодом 400. Нужен только для запасного пути, поэтому отсутствие ffmpeg не
    ошибка: тогда уйдет документом.
    """
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        return None
    out = ogg_path[:-4] + ".m4a" if ogg_path.endswith(".ogg") else ogg_path + ".m4a"
    try:
        proc = subprocess.run(
            [ffmpeg, "-y", "-loglevel", "error", "-i", ogg_path, "-c:a", "aac", "-b:a", "64k", out],
            capture_output=True, text=True, timeout=300)
    except Exception as e:  # noqa: BLE001
        log("voice: ffmpeg упал: %s" % e)
        return None
    if proc.returncode != 0 or not os.path.isfile(out):
        log("voice: ffmpeg не собрал m4a: %s" % (proc.stderr or "").strip()[:200])
        return None
    return out


def send_voice(token, proxy, chat_id, ogg_path, caption=""):
    """Голосовое сообщение, а если получатель их запретил - аудиофайл.

    `VOICE_MESSAGES_FORBIDDEN` - это НЕ наша ошибка и не повод потерять
    сообщение: у получателя в настройках приватности Telegram закрыты
    голосовые от посторонних, и бот попадает в эту категорию (личный аккаунт,
    пишущий в свое Избранное, - нет, поэтому у скрипта из toolkit такой
    проблемы не возникало). Тогда то же самое аудио уходит файлом: пузырь
    выглядит иначе, слушается так же.
    """
    fields = {"chat_id": str(chat_id), "caption": caption[:1024]}
    try:
        return _post_audio(token, proxy, "sendVoice", "voice", chat_id, ogg_path, fields)
    except urllib.error.HTTPError as e:
        detail = _http_detail(e)
        if not (e.code == 400 and "VOICE_MESSAGES_FORBIDDEN" in detail):
            raise RuntimeError("sendVoice %s %s" % (e.code, detail)) from e

    log("voice: получатель запретил голосовые от ботов, отправляю аудиофайлом")
    m4a = _to_m4a(ogg_path)

    try:
        if m4a:
            return _post_audio(token, proxy, "sendAudio", "audio", chat_id, m4a,
                               dict(fields, title=(caption[:64] or "Итог работы"),
                                    performer="claude-control"))
        return _post_audio(token, proxy, "sendDocument", "document", chat_id, ogg_path, fields)
    except urllib.error.HTTPError as e:
        raise RuntimeError("отправка аудио %s %s" % (e.code, _http_detail(e))) from e
    finally:
        if m4a:
            try:
                os.unlink(m4a)
            except OSError:
                pass


VOICE_ASR = os.environ.get("CLAUDE_AGENT_VOICE_ASR", "transcribe-meeting")


def _download(token, proxy, file_path, dest):
    url = "https://api.telegram.org/file/bot%s/%s" % (token, file_path)
    handlers = []
    if proxy:
        handlers.append(urllib.request.ProxyHandler({"http": proxy, "https": proxy}))
    with urllib.request.build_opener(*handlers).open(url, timeout=120) as r:
        payload = r.read()
    with open(dest, "wb") as fh:
        fh.write(payload)
    return dest


def asr_text_from_md(raw):
    """Текст из markdown, который печатает transcribe-meeting.

    Нужен именно разбор, а не чтение файла целиком: заголовок и служебные
    строки, приехавшие в реплику пользователя, агент прочтет как часть его
    слов.

    Тонкость, на которой этот разбор уже один раз ошибся: сам транскрипт тоже
    начинается с полужирного - `**[00:00]** текст`. Отличаем по скобке:
    метка времени остается меткой, а `**Файл:**` и прочая шапка выбрасывается.
    """
    lines = []
    for line in (raw or "").splitlines():
        line = line.strip()
        if not line or line.startswith(("#", "---", "|")):
            continue
        stamped = re.match(r"^\*\*\[[0-9:]+\]\*\*\s*(.*)$", line)
        if stamped:
            body = stamped.group(1).strip()
            if body:
                lines.append(body)
            continue
        if line.startswith("**"):
            continue
        lines.append(line)
    return " ".join(lines).strip()


def voice_to_text(token, proxy, msg):
    """Голосовое от владельца - в текст, локально.

    Расшифровка идет на своей машине (GigaAM): ни голос, ни его текст наружу
    не уходят. Пустая строка означает "не смогли" - вызывающий тогда ведет
    себя так, будто голосового не было, а не додумывает содержание.
    """
    media = msg.get("voice") or msg.get("audio") or {}
    file_id = media.get("file_id")
    if not file_id:
        return ""

    try:
        r = api(token, proxy, "getFile", http_timeout=30, file_id=file_id)
        file_path = ((r or {}).get("result") or {}).get("file_path")
        if not file_path:
            log("voice-in: getFile без file_path")
            return ""

        work = tempfile.mkdtemp(prefix="cc-voice-in-")
        audio = os.path.join(work, "reply" + (os.path.splitext(file_path)[1] or ".oga"))
        _download(token, proxy, file_path, audio)

        out_md = os.path.join(work, "reply.md")
        proc = subprocess.run(
            [VOICE_ASR, audio, "--no-diar", "--no-wait", "-o", out_md],
            capture_output=True, text=True, timeout=900)

        if proc.returncode != 0 or not os.path.isfile(out_md):
            log("voice-in: расшифровка не удалась (%s): %s"
                % (proc.returncode, (proc.stderr or "").strip()[:200]))
            return ""

        text = asr_text_from_md(open(out_md, encoding="utf-8").read())
        log("voice-in: расшифровано %d символов" % len(text))
        return text
    except FileNotFoundError:
        log("voice-in: не найден распознаватель %s" % VOICE_ASR)
        return ""
    except Exception as e:  # noqa: BLE001
        log("voice-in: %s" % e)
        return ""
    finally:
        try:
            shutil.rmtree(work)
        except Exception:  # noqa: BLE001
            pass


STICKY_TTL = 1800


def _voice_pref_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_VOICE_PREF",
        os.path.expanduser("~/.claude-control/tgbot.voice.json"))


def voice_enabled():
    """Озвучивать ли итоги сейчас. Не знаем - НЕ озвучиваем.

    Fail-closed выбран осознанно: пропущенный голосовой итог человек все равно
    прочитает текстом (текст доходит всегда), а неожиданное аудио в тишине
    хуже - его слышат окружающие, и отменить это нельзя. Поэтому отсутствующий,
    битый или нечитаемый файл состояния означает "молчим".
    """
    try:
        with open(_voice_pref_path(), encoding="utf-8") as fh:
            d = json.load(fh)
        return bool(d.get("enabled")) if isinstance(d, dict) else False
    except (OSError, ValueError):
        return False


def voice_set(on):
    """Запомнить режим. Запись атомарная - файл читает поллер на каждом апдейте."""
    path = _voice_pref_path()
    os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump({"enabled": bool(on), "at": time.time()}, fh,
                      ensure_ascii=False)
        os.replace(tmp, path)
    except Exception:  # noqa: BLE001
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return bool(on)


def voice_toggle():
    """Переключить и вернуть НОВОЕ состояние - им подписывается кнопка в ответе."""
    return voice_set(not voice_enabled())


def voice_btn(on):
    return BTN_VOICE_ON if on else BTN_VOICE_OFF


def _sticky_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_STICKY",
        os.path.expanduser("~/.claude-control/tgbot.sticky.json"))


def _sticky_load():
    try:
        with open(_sticky_path(), encoding="utf-8") as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def sticky_set(chat_id, agent, gen, now=None):
    """Запомнить, с кем человек сейчас разговаривает.

    Ответив реплаем один раз, дальше пишут просто в чат - это нормальный ход
    разговора, а не ошибка пользователя. Без такой памяти каждое следующее
    сообщение требует снова целиться в нужный пузырь, и на телефоне это
    промахивается чаще, чем попадает.
    """
    if not agent or not NAME_RE.match(agent or ""):
        return
    now = now if now is not None else time.time()
    d = _sticky_load()
    d[str(chat_id)] = {"agent": agent, "gen": gen, "at": now}
    path = _sticky_path()
    os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(d, fh, ensure_ascii=False)
        os.replace(tmp, path)
    except Exception:  # noqa: BLE001
        try:
            os.unlink(tmp)
        except OSError:
            pass


def sticky_get(chat_id, now=None):
    """Кому уходит продолжение разговора, если оно свежее TTL."""
    now = now if now is not None else time.time()
    ent = _sticky_load().get(str(chat_id))
    if not isinstance(ent, dict):
        return None
    if now - float(ent.get("at") or 0) > STICKY_TTL:
        return None
    return ent


def sticky_route(msg, text, update_id, now=None):
    """Продолжение разговора без реплая - в ту же сессию.

    Возвращает текст ответа или None, если продолжать нечего: тогда сообщение
    обрабатывается как раньше. Молчание тут важнее удобства - подхватывать
    ЛЮБОЙ текст в последнюю сессию нельзя, иначе случайная реплика в чате
    станет задачей агенту.
    """
    chat_id = (msg.get("chat") or {}).get("id")
    ent = sticky_get(chat_id, now)
    if not ent:
        return None
    name = ent.get("agent") or ""
    if not NAME_RE.match(name):
        return None
    control, err = _control_read(name)
    if err == "missing":
        return "агент %s удален - продолжать нечего" % name
    if control is None:
        raise TransientSpoolError("control-read failed for %s" % name)
    if ent.get("gen") != control.get("generation"):
        # Инкарнация сменилась: молча дописывать в новую нельзя, человек
        # продолжает разговор с прежней.
        return ("сессия %s перезапустилась - ответь на свежее сообщение "
                "агента, чтобы продолжить" % name)
    out = mission_put_task(name, text, update_id,
                           (msg.get("from") or {}).get("id", 0))
    sticky_set(chat_id, name, control.get("generation"), now)
    return "-> %s: %s" % (name, out) if out else None


SESSION_LABEL_MAX = 60


def bind_to_session(chat_id, message_ids, label):
    """Пометить сообщение как итог СЕССИИ, а не агента.

    Ответить отсюда в живую сессию нечем: у сессий нет канала ввода (юнит
    поднимается голым script, stdin - /dev/null, pty держит сам script). Раз
    доставки нет, задача записи одна - дать боту сказать это ВНЯТНО. Без нее
    reply попадает в общий путь и получает совет про карточку задачи, к делу
    не относящийся: человек идет искать несуществующую кнопку.

    Имя сессии под NAME_RE не подходит и не должно: у сессий имена вида
    "control-v2 2", "cv Коренева" - с пробелами и кириллицей. Поэтому метка
    тут произвольная, только режется по длине и очищается от управляющих
    символов, а роутингом не является.
    """
    if not label:
        return
    label = "".join(ch for ch in str(label) if ch.isprintable())[:SESSION_LABEL_MAX]
    if not label.strip():
        return
    for mid in [m for m in (message_ids or []) if m]:
        sent_map_register(chat_id, [mid], label, None, kind="session")


def bind_to_agent(chat_id, message_ids, agent):
    """Записать отправленное сообщение в карту роутинга.

    Без этой записи reply на голосовое (и на любую ручную отправку) не с чем
    сопоставить: бот честно отвечает "сопоставить reply с агентом не могу", и
    голосовой ответ повисает в воздухе. Поколение берем текущее у агента -
    ответ на сообщение прошлой инкарнации не должен попасть в новую.
    """
    if not agent:
        return
    if not NAME_RE.match(agent):
        log("bind: имя агента не годится: %s" % agent)
        return
    control, err = _control_read(agent)
    if control is None:
        log("bind: не читается control агента %s (%s) - отправлено без привязки"
            % (agent, err))
        return
    ids = [mid for mid in (message_ids or []) if mid]
    if not ids:
        log("bind: нечего привязывать (нет message_id)")
        return
    try:
        sent_map_register(chat_id, ids, agent, control.get("generation"))
    except Exception as e:  # noqa: BLE001
        log("bind error: %s" % e)


# Латиницу русский Silero не произносит вовсе - на ее месте пауза. Имя сессии
# подставляется автоматически и почти всегда латиницей ("happ sub", "toolkit
# 4"), поэтому вводная фраза звучала как "ответ из сессии ... " с дыркой.
# Транслитерация фонетическая, не побуквенная: диграфы дают "тулкит" вместо
# "тоолкит". Точности тут не нужно - нужно, чтобы имя было слышно и узнавалось.
_SPEAK_DIGRAPHS = (("sch", "ш"), ("tch", "ч"), ("ch", "ч"), ("sh", "ш"),
                   ("th", "з"), ("ph", "ф"), ("ck", "к"), ("oo", "у"),
                   ("ee", "и"), ("ea", "и"), ("ou", "ау"), ("qu", "кв"),
                   ("ya", "я"), ("yu", "ю"))
_SPEAK_LETTERS = {
    "a": "а", "b": "б", "c": "к", "d": "д", "e": "е", "f": "ф", "g": "г",
    "h": "х", "i": "и", "j": "дж", "k": "к", "l": "л", "m": "м", "n": "н",
    "o": "о", "p": "п", "q": "к", "r": "р", "s": "с", "t": "т", "u": "у",
    "v": "в", "w": "в", "x": "кс", "y": "й", "z": "з",
}
# Короткая аббревиатура заглавными читается по буквам, а не слитно: "HR" это
# "эйч эр", а не "хр".
_SPEAK_ABBR = {
    "a": "эй", "b": "би", "c": "си", "d": "ди", "e": "и", "f": "эф",
    "g": "джи", "h": "эйч", "i": "ай", "j": "джей", "k": "кей", "l": "эл",
    "m": "эм", "n": "эн", "o": "оу", "p": "пи", "q": "кью", "r": "эр",
    "s": "эс", "t": "ти", "u": "ю", "v": "ви", "w": "дабл ю", "x": "икс",
    "y": "уай", "z": "зед",
}


def speakable(name):
    """Имя сессии так, чтобы русский синтезатор его произнес.

    Меняет ТОЛЬКО озвучку: подпись карточки и роутинг reply работают с
    исходным именем. Кириллица и цифры проходят как есть - их модель читает.
    """
    out = []
    for word in re.split(r"(\s+)", name or ""):
        if not word.strip():
            out.append(word)
            continue
        # Двухбуквенное латинское слово - почти всегда аббревиатура ("cv", "HR",
        # "vd"), и читать его слитно бессмысленно: "кв" вместо "си ви".
        if word.isalpha() and word.isascii() and (
                len(word) == 2 or (len(word) == 3 and word.isupper())):
            out.append(" ".join(_SPEAK_ABBR[c] for c in word.lower()))
            continue
        # Трогаем ТОЛЬКО латинские куски: кириллица и цифры и так читаются, а
        # понижать им регистр незачем - имя может быть смешанным ("cv Коренева").
        def _lat(m):
            w = m.group(0).lower()
            # Немая e на конце удлиняет предыдущую гласную: "home" это
            # "хоум", а не "хоме" и не "хом".
            if len(w) > 3 and w.endswith("e") and w[-2] not in "aeiou" \
                    and w[-3] in "aeiou":
                long_v = {"a": "эй", "e": "и", "i": "ай", "o": "оу", "u": "ю"}
                w = w[:-3] + long_v[w[-3]] + w[-2]
            elif len(w) > 3 and w.endswith("e") and w[-2] not in "aeiou":
                w = w[:-1]
            for src, dst in _SPEAK_DIGRAPHS:
                w = w.replace(src, dst)
            return "".join(_SPEAK_LETTERS.get(c, c) for c in w)
        out.append(re.sub(r"[A-Za-z]+", _lat, word))
    return "".join(out)


# Маркер начала нового куска. Telegram проигрывает голосовые подряд, и без
# явной отбивки два итога от разных сессий сливаются в один поток речи. Имя
# сессии эту роль не тянет: оно почти всегда латиницей и на слух распознается
# плохо даже после транслитерации. Отдельная короткая фраза с точкой дает паузу
# и однозначный сигнал "начался следующий".
VOICE_MARK = "Новое сообщение."


def voice_intro(text, session):
    """Назвать сессию ПЕРВОЙ фразой озвучки.

    Telegram проигрывает голосовые подряд автоматически, и карточку с именем в
    этот момент никто не видит - телефон в кармане. Без вводной фразы два итога
    от разных сессий сливаются в один поток речи, и понять, где сменился
    источник, нельзя. Имя идет и в текстовую ветку тоже: при отправке текстом
    подписи нет вовсе, а вопрос "кто это сказал" остается тот же.
    """
    if not session:
        return text
    return "%s Сессия %s. %s" % (VOICE_MARK, speakable(session), text)


def voice_caption_for(caption, session):
    """Подпись карточки. Пусто плюс сессия -> имя сессии.

    Без нее Telegram рисует все итоги одинаковой карточкой "Итог работы": три
    сообщения подряд от разных сессий неразличимы, и человек не знает, что
    слушает. Явную подпись не перебиваем, агентский путь (сессии нет) не
    трогаем вовсе.
    """
    return caption or (session or "")


def synth_for_send():
    """Чем синтезировать ЭТУ отправку, с учетом тумблера. None - отправлять текстом.

    Тумблер спрашиваем здесь, а не у зовущего агента: агенты о режиме не знают и
    знать не должны - они шлют итог, а говорить его или молчать, решает тот, у
    кого есть состояние. Выключено - идем ровно той же дорогой, что и при
    отсутствующем синтезаторе, вместе с привязкой ответа к агенту.
    """
    if not voice_enabled():
        log("voice: голосовые выключены тумблером, отправляю текстом")
        return None
    return voice_synth_path()


def mode_voice(argv):
    """Итог работы голосом: синтез внешним инструментом, отправка своим ботом.

    Правило одно и оно важнее удобства: текст доходит ВСЕГДА. Не нашли синтез,
    упал синтез, отбилась отправка файла - уходит обычное сообщение. Голос
    дополняет письменный итог, а не заменяет его, и потерять итог из-за
    отсутствующей модели недопустимо.
    """
    caption = ""
    agent = ""
    session = ""
    args = list(argv)
    while args and args[0] in ("--caption", "--agent", "--session"):
        flag, args = args[0], args[1:]
        value = args[0] if args else ""
        args = args[1:]
        if flag == "--caption":
            caption = value
        elif flag == "--session":
            session = value
        else:
            agent = value
    # Без подписи все итоги приходят одинаковыми карточками "Итог работы",
    # и из трех подряд не понять, какая сессия говорит (поймано на живом
    # экране 24.08). Имя сессии у нас уже есть - оно и идет подписью.
    caption = voice_caption_for(caption, session)
    text = (" ".join(args) if args and args != ["-"] else sys.stdin.read())
    text = text.rstrip("\n")
    if not text:
        log("voice: пустой текст")
        sys.exit(2)
    text = voice_intro(text, session)
    token, wl, proxy = cfg()
    if not token or not wl:
        log("voice: нужны CLAUDE_AGENT_TG_TOKEN и CLAUDE_AGENT_TG_WHITELIST")
        sys.exit(2)

    # Тумблер спрашиваем ЗДЕСЬ, а не у зовущего агента: агенты о режиме не знают
    # и знать не должны - они шлют итог, а говорить ему или молчать, решает тот,
    # у кого есть состояние. Выключено - идем той же дорогой, что и при
    # отсутствующем синтезаторе: текстом, с сохранением привязки к агенту.
    synth = synth_for_send()
    ogg = None
    if synth:
        ogg = os.path.join(tempfile.gettempdir(), "cc-voice-%s.ogg" % uuid.uuid4().hex)
        try:
            proc = subprocess.run(
                [sys.executable, synth, "--text", text, "--out", ogg],
                capture_output=True, text=True, timeout=900)
            if proc.returncode != 0 or not os.path.isfile(ogg):
                log("voice: синтез не удался (%s), отправляю текстом: %s"
                    % (proc.returncode, (proc.stderr or "").strip()[:200]))
                ogg = None
        except Exception as e:  # noqa: BLE001
            log("voice: синтез упал, отправляю текстом: %s" % e)
            ogg = None
    else:
        log("voice: синтезатор не найден, отправляю текстом")

    failures = 0
    for uid in sorted(wl):
        try:
            if ogg:
                r = send_voice(token, proxy, uid, ogg, caption or "")
                mids = [((r or {}).get("result") or {}).get("message_id")]
            else:
                mids = send_message(token, proxy, uid, text)
            if session:
                bind_to_session(uid, mids, session)
            else:
                bind_to_agent(uid, mids, agent)
        except Exception as e:  # noqa: BLE001
            log("voice error to %s: %s" % (uid, e))
            failures += 1
    if ogg:
        try:
            os.unlink(ogg)
        except OSError:
            pass
    sys.exit(1 if failures == len(wl) else 0)


def mode_selftest():
    ok = [0]

    def t(name, cond):
        print("  %s: %s" % ("ok" if cond else "FAIL", name))
        ok[0] += 0 if cond else 1

    import tempfile as _tf
    _sticky_file = os.path.join(_tf.mkdtemp(), "sticky.json")
    os.environ["CLAUDE_AGENT_TG_STICKY"] = _sticky_file
    sticky_set(77, "helper", 3, now=1000)
    t("липкость: свежая запись возвращается",
      (sticky_get(77, now=1100) or {}).get("agent") == "helper")
    t("липкость: протухшая не возвращается",
      sticky_get(77, now=1000 + STICKY_TTL + 1) is None)
    t("липкость: чужой чат не подхватывается",
      sticky_get(78, now=1100) is None)
    sticky_set(79, "../etc", 1, now=1000)
    t("липкость: кривое имя не сохраняется",
      sticky_get(79, now=1100) is None)

    _voice_file = os.path.join(_tf.mkdtemp(), "voice.json")
    os.environ["CLAUDE_AGENT_TG_VOICE_PREF"] = _voice_file
    t("голос: по умолчанию выключен (файла еще нет)",
      voice_enabled() is False)
    voice_set(True)
    t("голос: включенный читается как включенный", voice_enabled() is True)
    voice_set(False)
    t("голос: выключенный читается как выключенный", voice_enabled() is False)
    with open(_voice_file, "w", encoding="utf-8") as _fh:
        _fh.write("{битый жсон")
    t("голос: битый файл состояния - молчим, а не падаем",
      voice_enabled() is False)
    t("голос: подпись кнопки показывает состояние без нажатия",
      voice_btn(True) == BTN_VOICE_ON and voice_btn(False) == BTN_VOICE_OFF)
    t("голос: обе подписи узнаются как один раздел",
      menu_trigger(BTN_VOICE_ON) == "voice"
      and menu_trigger(BTN_VOICE_OFF) == "voice")
    voice_set(True)
    t("голос: кнопка в клавиатуре отражает включенное состояние",
      BTN_VOICE_ON in _reply_kbd() and BTN_VOICE_OFF not in _reply_kbd())
    voice_set(False)
    t("голос: и выключенное тоже",
      BTN_VOICE_OFF in _reply_kbd() and BTN_VOICE_ON not in _reply_kbd())
    t("маркер: озвучка открывается отбивкой, а не сразу текстом",
      voice_intro("текст", "HR 9").startswith(VOICE_MARK))
    t("произношение: двухбуквенное слово читается по буквам",
      speakable("cv") == "си ви")
    t("произношение: немая e на конце не звучит",
      speakable("Home") == "хоум")

    t("произношение: латиница переводится в кириллицу",
      speakable("happ sub") == "хапп суб")
    t("произношение: диграфы, а не побуквенно", speakable("toolkit") == "тулкит")
    t("произношение: аббревиатура читается по буквам",
      speakable("HR") == "эйч эр")
    t("произношение: кириллица и цифры проходят как есть",
      speakable("Коренева 2") == "Коренева 2")
    t("произношение: смешанное имя не теряет русскую часть",
      "Коренева" in speakable("cv Коренева"))

    t("интро: озвучка начинается с названия сессии - в произносимом виде",
      voice_intro("текст итога", "HR 9").startswith(
          "Новое сообщение. Сессия эйч эр 9."))
    t("интро: сам текст никуда не девается",
      voice_intro("текст итога", "HR 9").endswith("текст итога"))
    t("интро: без сессии текст не трогаем (агентский путь)",
      voice_intro("текст итога", "") == "текст итога")

    t("подпись: имя сессии становится заголовком карточки",
      voice_caption_for("", "HR 9") == "HR 9")
    t("подпись: явная не перебивается именем сессии",
      voice_caption_for("свое", "HR 9") == "свое")
    t("подпись: без сессии остается пустой (агентский путь не трогаем)",
      voice_caption_for("", "") == "")

    _sent_file = os.path.join(_tf.mkdtemp(), "sent.json")
    os.environ["CLAUDE_AGENT_TG_SENT_MAP"] = _sent_file
    bind_to_session(5, [4242], "control-v2 2")
    _ent = sent_map_lookup(5, 4242)
    t("сессия: имя с пробелом регистрируется (агентская маска тут не указ)",
      (_ent or {}).get("agent") == "control-v2 2"
      and (_ent or {}).get("kind") == "session")
    _answer = mission_comment({"chat": {"id": 5}}, {"message_id": 4242},
                              "поправь заголовок", 1)
    t("сессия: ответ называет ГРАНИЦУ, а не советует карточку задачи",
      isinstance(_answer, str) and "control-v2 2" in _answer
      and "карточк" not in _answer)
    bind_to_session(5, [4243], "   ")
    t("сессия: пустая метка не регистрируется",
      sent_map_lookup(5, 4243) is None)
    os.environ.pop("CLAUDE_AGENT_TG_SENT_MAP", None)

    _synth_stub = os.path.join(_tf.mkdtemp(), "voice-report")
    open(_synth_stub, "w").close()
    os.environ["CLAUDE_AGENT_VOICE_SYNTH"] = _synth_stub
    voice_set(False)
    t("голос: выключенный тумблер не пускает к синтезу, даже когда он есть",
      synth_for_send() is None)
    voice_set(True)
    t("голос: включенный тумблер синтез пропускает",
      synth_for_send() == _synth_stub)
    os.environ.pop("CLAUDE_AGENT_VOICE_SYNTH", None)
    voice_set(False)
    t("голос: переключение возвращает НОВОЕ состояние, а не прежнее",
      voice_toggle() is True and voice_enabled() is True
      and voice_toggle() is False)

    t("bind: без имени агента ничего не пишется",
      bind_to_agent(1, [1], "") is None)
    t("bind: кривое имя агента отбито",
      bind_to_agent(1, [1], "../etc") is None)

    t("asr: заголовок и шапка не попадают в реплику",
      asr_text_from_md("# Встреча\n\n**Дата:** сегодня\n\nда, поехали дальше\n")
      == "да, поехали дальше")
    t("asr: строки транскрипта с таймкодом сохраняются без метки",
      asr_text_from_md("# t\n\n**Файл:** a.ogg\n\n## Транскрипт\n\n"
                       "**[00:00]** первая фраза\n**[00:04]** вторая фраза\n")
      == "первая фраза вторая фраза")
    t("asr: пустой разбор дает пустую строку, а не мусор",
      asr_text_from_md("# только заголовок\n") == "")

    body, ctype = _multipart({"chat_id": "42", "caption": "итог"}, "voice", "a.ogg", b"OGGDATA")
    t("multipart: граница объявлена в заголовке и стоит в теле",
      ctype.startswith("multipart/form-data; boundary=")
      and ("--" + ctype.split("boundary=")[1]).encode() in body)
    t("multipart: поля и файл на месте",
      b'name="chat_id"' in body and b"42" in body
      and b'name="voice"; filename="a.ogg"' in body and b"OGGDATA" in body)
    t("multipart: тело закрыто финальной границей",
      body.rstrip().endswith(("--" + ctype.split("boundary=")[1] + "--").encode()))
    _voice_override_prev = os.environ.pop("CLAUDE_AGENT_VOICE_SYNTH", None)
    try:
        t("voice: без переопределения путь резолвится рядом с этим бинарем",
          voice_synth_path() == os.path.join(BIN_DIR, "voice-report"))
        _voice_tmp = os.path.join(_tf.mkdtemp(), "custom-voice-synth")
        open(_voice_tmp, "w").close()
        os.environ["CLAUDE_AGENT_VOICE_SYNTH"] = _voice_tmp
        t("voice: переменная окружения переопределяет путь к синтезатору",
          voice_synth_path() == _voice_tmp)
    finally:
        os.environ.pop("CLAUDE_AGENT_VOICE_SYNTH", None)
        if _voice_override_prev is not None:
            os.environ["CLAUDE_AGENT_VOICE_SYNTH"] = _voice_override_prev

    wl = {111}
    t("private+whitelisted проходит", authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 111}}}, wl))
    t("чужой from.id отбит", not authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 222}}}, wl))
    t("групповой чат отбит даже с верным from.id", not authorized(
        {"message": {"chat": {"type": "group"}, "from": {"id": 111}}}, wl))
    t("пустой update отбит", not authorized({}, wl))
    t("/agents парсится", parse_command("/agents") == ("/agents", None))
    t("/agent name парсится",
      parse_command("/agent faq-updater") == ("/agent", "faq-updater"))
    t("path traversal отбит",
      parse_command("/agent ../x") == ("/agent-bad", None))
    t("абсолютный путь отбит",
      parse_command("/agent /etc/passwd") == ("/agent-bad", None))
    t("не-команда игнорируется", parse_command("привет") == (None, None))
    t("инъекция в имя отбита",
      parse_command("/agent a;rm") == ("/agent-bad", None))
    t("html эскейпится", "<b>" not in html.escape("<b>x</b>"))
    t("/task парсится",
      parse_command("/task faq-updater проверь ссылки")
      == ("/task", ("faq-updater", "проверь ссылки")))
    t("/task без текста отбит",
      parse_command("/task faq-updater") == ("/task-bad", None))
    t("/task с плохим именем отбит",
      parse_command("/task ../x текст") == ("/task-bad", None))
    t("/limits парсится", parse_command("/limits") == ("/limits", None))
    t("/limits@bot парсится", parse_command("/limits@x_bot") == ("/limits", None))
    t("/task инъекция в имя отбита",
      parse_command("/task a;rm -rf текст") == ("/task-bad", None))
    t("/new парсится",
      parse_command("/new demoproj текст задачи")
      == ("/new", ("demoproj", "текст задачи")))
    t("/new без текста отбит",
      parse_command("/new demoproj") == ("/new-bad", None))
    # agent_hints: команды входа в сессию в push-уведомлении
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    t("hints пусты без CLAUDE_AGENT_SSH_HOST", agent_hints("faq-updater") == [])
    os.environ["CLAUDE_AGENT_SSH_HOST"] = "llm"
    t("hint attach содержит host и имя агента",
      any("ssh llm" in h and "agent attach faq-updater" in h
          for h in agent_hints("faq-updater")))
    t("hints пусты для кривого имени агента", agent_hints("../x") == [])
    t("hint cursor отсутствует без spec.yaml",
      not any(h.startswith("cursor") for h in agent_hints("faq-updater")))
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "faq-updater"))
        with open(os.path.join(td, "faq-updater", "spec.yaml"), "w") as f:
            f.write("schema: 1\nname: faq-updater\nproject: /data/Work/faq\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("hint cursor берет project из spec.yaml",
          "cursor --remote ssh-remote+llm /data/Work/faq"
          in agent_hints("faq-updater"))
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    # Меню-уровня из трех кнопок больше нет: разделы вынесены прямо в
    # reply-клавиатуру под полем ввода, чтобы не жать "меню" перед каждым делом.
    t("/menu парсится", parse_command("/menu") == ("/menu", None))
    t("/menu@bot парсится", parse_command("/menu@x_bot") == ("/menu", None))
    t("кнопки разделов распознаются",
      menu_trigger(BTN_SESSIONS) == "sessions"
      and menu_trigger(BTN_AGENTS) == "agents"
      and menu_trigger(BTN_LIMITS) == "limits")
    t("посторонний текст не открывает раздел", menu_trigger("привет") is None)
    # Клавиатура живет на телефоне, пока ее не заменят новым сообщением. После
    # переезда разделов у человека осталась старая кнопка "☰ Меню", и тап по ней
    # перестал что-либо делать. Кнопку узнаем и заодно ставим новую клавиатуру.
    t("старая кнопка меню еще узнается", menu_trigger(LEGACY_MENU_BTN) == "sessions")
    # Клавиатура - состояние КЛИЕНТА, а ставил ее бот только на /start, /menu и
    # старую кнопку. Пропала на телефоне (переустановка, чистка чата, скрыли
    # рукой) - вернуть нечем, человек видит бота без кнопок и не знает слова.
    # Поэтому любой неопознанный текст в личке возвращает клавиатуру.
    t("неопознанный текст возвращает клавиатуру",
      keyboard_recovery_text("ау", None, None))
    t("команда клавиатуру не переставляет",
      keyboard_recovery_text("/limits", "/limits", None) is None)
    t("кнопка раздела клавиатуру не переставляет",
      keyboard_recovery_text(BTN_LIMITS, None, "limits") is None)
    t("пустой текст молчит", keyboard_recovery_text("   ", None, None) is None)
    _kbd = json.loads(_reply_kbd())["keyboard"]
    _labels = [b for row in _kbd for b in row]
    t("клавиатура несет все три раздела и тумблер голоса",
      set(_labels) == {BTN_SESSIONS, BTN_AGENTS, BTN_LIMITS,
                       voice_btn(voice_enabled())})
    t("разделы остались в первом ряду - палец их ищет там",
      _kbd[0] == [BTN_SESSIONS, BTN_AGENTS, BTN_LIMITS])
    # Дубль экрана меню (2026-08-03): правка тем же содержимым отвечает 400
    # "not modified", и раньше на нее слался НОВЫЙ экран с кнопками.
    t("not modified распознается",
      _is_not_modified(RuntimeError("Bad Request: message is not modified")))
    t("прочий 400 - не 'not modified'",
      not _is_not_modified(RuntimeError("Bad Request: message to edit not found")))
    _calls = []
    _orig_api = globals()["api"]

    def _fake_api(err):
        def inner(token, proxy, method, **kw):
            _calls.append(method)
            if method == "editMessageText" and err:
                raise RuntimeError(err)
            return {}
        return inner

    try:
        globals()["api"] = _fake_api("Bad Request: message is not modified")
        _send_or_edit("t", None, 1, 42, "текст", {"inline_keyboard": []})
        t("правка тем же содержимым не рисует второй экран",
          _calls == ["editMessageText"])
        _calls.clear()
        globals()["api"] = _fake_api("Bad Request: message to edit not found")
        _send_or_edit("t", None, 1, 42, "текст", {"inline_keyboard": []})
        t("удаленное сообщение - тап не остается без ответа",
          _calls == ["editMessageText", "sendMessage"])
        _calls.clear()
        globals()["api"] = _fake_api(None)
        _send_or_edit("t", None, 1, None, "текст", {"inline_keyboard": []})
        t("без message_id шлем новое сообщение", _calls == ["sendMessage"])
    finally:
        globals()["api"] = _orig_api
    with tempfile.TemporaryDirectory() as td:
        for nm in ("beta", "alfa"):
            os.makedirs(os.path.join(td, nm))
            open(os.path.join(td, nm, "spec.yaml"), "w").write("name: %s\n" % nm)
        open(os.path.join(td, "not-agent.txt"), "w").write("x")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("agent_names сортированы и только с spec.yaml",
          agent_names() == ["alfa", "beta"])
        txt, kb = menu_view("agents")
        datas = [b["callback_data"] for row in kb["inline_keyboard"] for b in row]
        t("уровень agents дает кнопку на каждого агента",
          "m:ag:alfa" in datas and "m:ag:beta" in datas)
        # Назад в несуществующий root вести некуда - выход теперь в клавиатуре.
        t("уровень agents не ссылается на удаленный root", "m:root" not in datas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    _lt, _lkb = menu_view("limits")
    _ldatas = [b["callback_data"] for row in _lkb["inline_keyboard"] for b in row]
    t("уровень limits не ссылается на удаленный root", "m:root" not in _ldatas)
    t("callback_data агента влезает в лимит 64 байта",
      all(len(("m:ag:" + "a" * 32).encode()) <= 64 for _ in [0]))
    t("неизвестный уровень не роняет бота",
      isinstance(menu_view("m:garbage")[0], str))
    # --- stage9: сводка + reply-комментарий (map, redaction, chunking) ---
    t("чанкер не рвет HTML-entity",
      (lambda cs: "".join(cs) == "&" * 4000
       and all(len(html.escape(c)) <= 3800 for c in cs)
       and len(cs) >= 2)(_chunk_for_html("&" * 4000)))
    t("чанкер: пустой текст -> один пустой чанк", _chunk_for_html("") == [""])
    t("redact маскирует token=",
      "supersecretvalue" not in redact("token=supersecretvalue1234"))
    t("redact маскирует длинный base64-хвост",
      "A" * 48 not in redact("payload " + "A" * 48))
    t("redact не трогает обычный текст",
      redact("обычная строка событий") == "обычная строка событий")
    with tempfile.TemporaryDirectory() as td:
        os.environ["CLAUDE_AGENT_TG_SENT_MAP"] = os.path.join(td, "map.json")
        sent_map_register(1, [10, 11], "alfa", 3)
        t("map: lookup по (chat,msg)",
          (sent_map_lookup(1, 10) or {}).get("agent") == "alfa")
        t("map: generation сохранен",
          (sent_map_lookup(1, 11) or {}).get("gen") == 3)
        t("map: чужой message_id пуст", sent_map_lookup(1, 99) is None)
        t("map: chat_id входит в ключ", sent_map_lookup(2, 10) is None)
        t("map: None-id не регистрируется",
          (sent_map_register(1, [None], "alfa", 3) or
           sent_map_lookup(1, None)) is None)
        sent_map_register(1, [12], "beta", 1,
                          now=time.time() + SENT_MAP_TTL_S + 60)
        t("map: TTL-prune при записи", sent_map_lookup(1, 10) is None)
        t("map: свежая запись жива",
          (sent_map_lookup(1, 12) or {}).get("agent") == "beta")
        t("reply без map-записи получает подсказку",
          "свежую сводку" in mission_comment(
              {"chat": {"id": 5}, "from": {"id": 1}},
              {"message_id": 404}, "текст", 1))
        os.makedirs(os.path.join(td, "evtag"))
        open(os.path.join(td, "evtag", "spec.yaml"), "w").write(
            "schema: 1\nname: evtag\ntype: event\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        sent_map_register(7, [70], "evtag", 1)
        t("reply на event-агента получает подсказку /task",
          "/task evtag" in mission_comment(
              {"chat": {"id": 7}, "from": {"id": 1}},
              {"message_id": 70}, "текст", 1))
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
        os.environ.pop("CLAUDE_AGENT_TG_SENT_MAP", None)
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "alfa"))
        open(os.path.join(td, "alfa", "spec.yaml"), "w").write("name: alfa\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        _, akb = menu_view("ag:alfa")
        adatas = [b["callback_data"]
                  for row in akb["inline_keyboard"] for b in row]
        t("меню агента имеет кнопку Сводка", "m:sum:alfa" in adatas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    with tempfile.TemporaryDirectory() as td:
        # Р11 (план §12): durable-счетчик карточек - растет на bump, сутки
        # (UTC) отваливаются сами, повторный bump в те же сутки суммируется.
        os.environ["CLAUDE_AGENT_TG_CARDS_COUNT"] = os.path.join(
            td, "cards.json")
        t("cards: файла нет до первого bump",
          not os.path.exists(_cards_count_path()))
        cards_count_bump(now=1753000000)  # 2025-07-20T05:33:20Z
        with open(_cards_count_path()) as f:
            d1 = json.load(f)
        t("cards: первый bump - count=1", d1 == {"day": "2025-07-20", "count": 1})
        cards_count_bump(now=1753000100)  # тот же UTC-день
        with open(_cards_count_path()) as f:
            d2 = json.load(f)
        t("cards: второй bump в те же сутки - count=2", d2["count"] == 2)
        cards_count_bump(now=1753000000 + 86400)  # следующие сутки
        with open(_cards_count_path()) as f:
            d3 = json.load(f)
        t("cards: новые сутки сбрасывают счетчик", d3 == {
            "day": "2025-07-21", "count": 1})
        os.environ.pop("CLAUDE_AGENT_TG_CARDS_COUNT", None)

    # ---- V3.0: экран сессий (проекты -> сессии по именам -> поднять/опустить)
    t("s: корень разбирается", route_callback("s") == ("sessions_root", None, None))
    t("s:p: проект разбирается",
      route_callback("s:p:projectone") == ("sessions_project", "projectone", None))
    t("s:s: сессия разбирается",
      route_callback("s:s:projectone:5d99c2f0") == ("session_card", "projectone", "5d99c2f0"))
    t("s:u: подъем разбирается",
      route_callback("s:u:projectone:5d99c2f0") == ("session_up", "projectone", "5d99c2f0"))
    t("s:d: гашение разбирается",
      route_callback("s:d:projectone:5d99c2f0") == ("session_down", "projectone", "5d99c2f0"))
    # Мусор в callback_data - это вход из сети: имя проекта уходит в argv CLI,
    # короткий id резолвится в uuid, поэтому оба поля обязаны быть отбиты здесь.
    t("s: кривой проект отбит", route_callback("s:p:../etc") == ("none", None, None))
    t("s: кривой id отбит",
      route_callback("s:u:projectone:zzz") == ("none", None, None))
    t("s: id не-hex отбит",
      route_callback("s:d:projectone:5D99C2F0") == ("none", None, None))
    t("s: callback_data влезает в 64 байта",
      all(len(("s:u:%s:%s" % ("a" * 32, "5d99c2f0")).encode()) <= 64
          for _ in (0,)))

    # Разбор porcelain-строк в модель меню.
    rows = parse_porcelain(
        "aaaaaaaa-1111-4111-8111-111111111111\t1700000000\tproject\t/p\tsupport\t1\t12\n"
        "bbbbbbbb-2222-4222-8222-222222222222\t1600000000\tproject\t/p\t\t0\t\n")
    t("porcelain: две строки", len(rows) == 2)
    t("porcelain: title и live разобраны",
      rows[0]["title"] == "support" and rows[0]["live"] is True
      and rows[1]["live"] is False)
    t("porcelain: пустое имя заменяется коротким id",
      "bbbbbbbb" in session_label(rows[1]))
    # Возраст последнего сообщения - то же, что показывает Cursor: без него
    # одинаково названные сессии в списке не различить, а именно по свежести
    # человек и выбирает, куда возвращаться.
    # Метка времени укрупняется по мере старения: сегодня/вчера словом, дальше
    # дни, недели, месяцы. Смысл в том, что для свежей сессии важна свежесть, а
    # для старой - порядок величины, а не точная дата.
    MSK = "Europe/Moscow"
    import datetime as _dt
    from zoneinfo import ZoneInfo as _ZI
    base = _dt.datetime(2026, 8, 1, 20, 0, tzinfo=_ZI(MSK))
    now_ts = base.timestamp()
    def _ago(days, hour=12):
        return (base - _dt.timedelta(days=days)).replace(hour=hour).timestamp()
    # Внутри суток - минуты и часы: сессия, закрытая минуту назад, и та, что была
    # утром, - разные вещи, а "сегодня" их уравнивало.
    fresh = [(30, "сейчас"), (60, "1 min"), (25 * 60, "25 min"),
             (3600, "1 hour"), (5 * 3600, "5 hour"), (23 * 3600, "23 hour")]
    for secs, want in fresh:
        got = session_when(now_ts - secs, now=now_ts, tz=MSK)
        t("время: %d сек -> %s" % (secs, want), got == want)
    cases = [(1, "вчера"), (3, "3 day"), (4, "4 day"),
             (6, "6 day"), (7, "1 week"), (13, "1 week"), (14, "2 week"),
             (29, "4 week"), (30, "1 mon"), (60, "2 mon"), (400, "13 mon")]
    for days, want in cases:
        got = session_when(_ago(days), now=now_ts, tz=MSK)
        t("время: %d дн -> %s" % (days, want), got == want)
    t("время: битый mtime не роняет", session_when("мусор", now=now_ts, tz=MSK) == "")
    t("метка несет время",
      "3 day" in session_label(dict(rows[0], mtime=_ago(3)), now=now_ts, tz=MSK))
    # Состояние сессии - ИКОНКОЙ в начале строки, и у опущенной она тоже есть:
    # отсутствие метки меткой не читается, приходится вчитываться в кнопки.
    t("метка: работает - залитый знак", session_label(rows[0]).startswith("\u25cf"))
    t("метка: опущена - пустой знак", session_label(rows[1]).startswith("\u25cb"))
    t("карточка: состояние иконкой в шапке",
      session_card_view("projectone", rows[0])[0].startswith("\u25cf")
      and session_card_view("projectone", rows[1])[0].startswith("\u25cb"))
    t("porcelain: битая строка не роняет разбор",
      parse_porcelain("мусор\nтоже\tмусор\n") == [])
    # Занятость контекста: в подписи видно, сколько окна съедено, иначе про
    # сжатие вспоминают, только когда сессия уже упирается.
    _ctx = parse_porcelain(
        "aaaaaaaa-1111-4111-8111-111111111111\t1000\tproject\t/p\tимя\t1\t83\n"
        "bbbbbbbb-2222-4222-8222-222222222222\t1000\tproject\t/p\tбез\t0\t\n")
    t("porcelain: процент контекста разобран", _ctx[0]["ctx"] == 83)
    t("porcelain: пустой процент - None, а не ноль", _ctx[1]["ctx"] is None)
    t("метка несет контекст", "83%" in session_label(_ctx[0], now=now_ts, tz=MSK))
    t("метка без контекста молчит",
      "%" not in session_label(_ctx[1], now=now_ts, tz=MSK))

    # Клавиатура сессий: кнопка на сессию + возврат.
    kb = sessions_list_kb("projectone", rows)
    datas = [b["callback_data"] for row in kb["inline_keyboard"] for b in row]
    t("клава: кнопка на каждую сессию", "s:s:projectone:aaaaaaaa" in datas
      and "s:s:projectone:bbbbbbbb" in datas)
    t("клава: есть возврат к проектам", "s" in datas)
    t("клава: первой идет новая сессия", datas[0] == "s:n:projectone")

    # Постраничность: сессии за первой страницей иначе недостижимы - кнопок на
    # них нет вовсе, а имя вспомнить и набрать негде.
    kb_p0 = sessions_list_kb("projectone", rows, page=0, has_more=True)
    d_p0 = [b["callback_data"] for row in kb_p0["inline_keyboard"] for b in row]
    t("клава: со второй страницей есть кнопка вперед", "s:p:projectone:1" in d_p0)
    t("клава: на первой странице нет кнопки назад",
      "s:p:projectone:0" not in d_p0)
    kb_p2 = sessions_list_kb("projectone", rows, page=2, has_more=False)
    d_p2 = [b["callback_data"] for row in kb_p2["inline_keyboard"] for b in row]
    t("клава: со средней страницы можно назад", "s:p:projectone:1" in d_p2)
    t("клава: на последней странице нет кнопки вперед",
      "s:p:projectone:3" not in d_p2)
    t("клава: на глубокой странице новую сессию не предлагаем",
      "s:n:projectone" not in d_p2)
    t("клава: страница разбирается роутером",
      route_callback("s:p:projectone:7")
      == ("sessions_project", "projectone", "7"))
    t("клава: без номера - по-прежнему первая страница",
      route_callback("s:p:projectone") == ("sessions_project", "projectone", None))
    t("клава: нечисловая страница отбита",
      route_callback("s:p:projectone:ой") == ("none", None, None))
    t("клава: страница влезает в 64 байта",
      len(("s:p:%s:99" % ("a" * 32)).encode()) <= 64)

    # Карточка сессии строится из строки списка, а не ищет ее заново: только так
    # можно показать ТОЛЬКО ЧТО созданную сессию - ее транскрипт еще пуст, и в
    # списке (`--porcelain` пропускает файлы без реплики человека) ее нет.
    txt, kb2 = session_card_view("projectone", rows[0], "")
    d2 = [b["callback_data"] for row in kb2["inline_keyboard"] for b in row]
    t("карточка: у поднятой - опустить", "s:d:projectone:aaaaaaaa" in d2)
    txt3, kb3 = session_card_view("projectone", rows[1], "заметка")
    d3 = [b["callback_data"] for row in kb3["inline_keyboard"] for b in row]
    t("карточка: у лежащей - поднять", "s:u:projectone:bbbbbbbb" in d3)
    # Сжатие контекста: только у опущенной сессии. У поднятой транскрипт держит
    # ее процесс, и второй claude --resume на тот же файл дает задвоение.
    t("карточка: у опущенной есть сжатие", "s:c:projectone:bbbbbbbb" in d3)
    # Передача работы: ранбук + свежая сессия. Как и сжатие - только у опущенной.
    t("карточка: у опущенной есть передача", "s:h:projectone:bbbbbbbb" in d3)
    t("карточка: у поднятой передачи нет", "s:h:projectone:aaaaaaaa" not in d2)
    _ht, _hkb = session_handoff_view("projectone", rows[1], "ShopHack 2")
    _hd = [b["callback_data"] for row in _hkb["inline_keyboard"] for b in row]
    t("подтверждение передачи: запуск", "s:g:projectone:bbbbbbbb" in _hd)
    t("подтверждение передачи: отмена", "s:s:projectone:bbbbbbbb" in _hd)
    t("подтверждение передачи: показано будущее имя", "ShopHack 2" in _ht)
    # Кэш промпта живет на стороне провайдера около часа и привязан к
    # содержимому, а не к процессу. Пока он теплый, вся переписка читается по
    # цене чтения; после протухания - переписывается по цене записи, то есть
    # примерно на порядок дороже (замер 2026-08-04: 754 827 из кэша против
    # 723 291 в запись на той же сессии). Поднята сессия или нет - неважно,
    # важна свежесть работы, поэтому экран говорит именно про время.
    _warm = session_handoff_view("projectone", dict(rows[1], mtime=now_ts - 120),
                                 "X 2", now=now_ts)[0]
    _cold = session_handoff_view("projectone", dict(rows[1], mtime=now_ts - 9000),
                                 "X 2", now=now_ts)[0]
    t("передача: теплый кэш не пугает ценой", "дороже" not in _warm)
    t("передача: остывший кэш назван", "остыл" in _cold and "дороже" in _cold)
    t("сжатие: остывший кэш назван тоже",
      "остыл" in session_compact_view("projectone",
                                      dict(rows[1], mtime=now_ts - 9000),
                                      now=now_ts)[0])
    t("подтверждение передачи: сказано, что старая не удаляется",
      "заморож" in _ht or "не удал" in _ht)
    for _c, _k in (("h", "session_handoff_ask"), ("g", "session_handoff_do")):
        t("s:%s: разбирается" % _c,
          route_callback("s:%s:projectone:bbbbbbbb" % _c)
          == (_k, "projectone", "bbbbbbbb"))
    t("карточка: у поднятой сжатия нет", "s:c:projectone:aaaaaaaa" not in d2)
    # Подтверждение отдельным экраном: ход платный (запрос по всей переписке) и
    # не мгновенный, случайный тап пальцем тут стоит дорого.
    _ctxt, _ckb = session_compact_view("projectone", rows[1])
    _cd = [b["callback_data"] for row in _ckb["inline_keyboard"] for b in row]
    t("подтверждение сжатия: просто сжать", "s:z:projectone:bbbbbbbb" in _cd)
    t("подтверждение сжатия: сжать и поднять", "s:w:projectone:bbbbbbbb" in _cd)
    t("подтверждение сжатия: есть отмена", "s:s:projectone:bbbbbbbb" in _cd)
    t("подтверждение сжатия: показан текущий процент",
      "12%" in session_compact_view("projectone", dict(rows[1], ctx=12))[0])
    for _c, _k in (("c", "session_compact_ask"), ("z", "session_compact_do"),
                   ("w", "session_compact_up")):
        t("s:%s: разбирается" % _c,
          route_callback("s:%s:projectone:bbbbbbbb" % _c)
          == (_k, "projectone", "bbbbbbbb"))
    # Выход к проектам прямо с карточки: в нее проваливаются и из списка
    # проекта, и с корневого экрана активных. Во втором случае "‹ сессии"
    # уводит в список проекта, который человек не выбирал, а выхода наверх нет.
    t("карточка: есть выход к проектам", "s" in d2 and "s" in d3)
    t("карточка: возврат в список проекта остался",
      "s:p:projectone" in d2 and "s:p:projectone" in d3)
    t("карточка: занятость окна видна", "12%" in
      session_card_view("projectone", dict(rows[0], ctx=12))[0])
    t("карточка: без занятости не врет", "%" not in
      session_card_view("projectone", dict(rows[0], ctx=None))[0])
    t("карточка: заметка попадает в текст", "заметка" in txt3)
    t("карточка: безымянная показывается коротким id", "bbbbbbbb" in txt3)
    fresh = {"sid": "ffffffff-6666-4666-8666-666666666666", "short": "ffffffff",
             "title": "", "live": True, "origin": "project", "cwd": "/p", "mtime": "0"}
    txt4, _ = session_card_view("projectone", fresh, "поднята новая сессия")
    # Удаление: в карточке кнопка, но сам тап по ней ничего не трет - он открывает
    # подтверждение. Разнесено намеренно: тап делается одним пальцем на ходу, а
    # переписка невосстановима (файл уезжает в корзину с TTL, но лишний экран
    # дешевле, чем поход в корзину).
    t("s:x: запрос удаления разбирается",
      route_callback("s:x:projectone:5d99c2f0") == ("session_rm_ask", "projectone", "5d99c2f0"))
    t("s:y: подтверждение удаления разбирается",
      route_callback("s:y:projectone:5d99c2f0") == ("session_rm_do", "projectone", "5d99c2f0"))
    d4 = [b["callback_data"] for row in kb2["inline_keyboard"] for b in row]
    t("карточка: есть кнопка удаления", "s:x:projectone:aaaaaaaa" in d4)
    txt5, kb5 = session_confirm_view("projectone", rows[0])
    d5 = [b["callback_data"] for row in kb5["inline_keyboard"] for b in row]
    t("подтверждение: да ведет на s:y", "s:y:projectone:aaaaaaaa" in d5)
    t("подтверждение: отмена возвращает в карточку", "s:s:projectone:aaaaaaaa" in d5)
    t("подтверждение: сказано про обратимость", "30" in txt5)
    # Экран "что запущено": первым делом видно работающее, без обхода проектов.
    live = parse_live(
        "aaaaaaaa-1111-4111-8111-111111111111\tprojectone\tрабочая\tok\t1700000000\t12\n"
        "bbbbbbbb-2222-4222-8222-222222222222\tprojectone\t\tstale\t1700000000\t\n"
        "мусор\n")
    t("live: битая строка отброшена", len(live) == 2)
    t("live: поля разобраны",
      live[0]["project"] == "projectone" and live[0]["health"] == "ok")
    t("live: здоровая - залитый знак", live_label(live[0]).startswith("\u25cf"))
    # Залипшая сессия не должна выглядеть как рабочая - на этом мы уже обожглись.
    t("live: молчащая - не кружком", live_label(live[1]).startswith("\u26a0"))
    t("live: безымянная показывается коротким id", "bbbbbbbb" in live_label(live[1]))
    t("live: в подписи есть проект", "projectone" in live_label(live[0]))
    # Корневой экран должен нести то же, что список проекта: время и объем.
    # Иначе про сжатие вспоминают, только когда сессия уже уперлась.
    _lv = dict(live[0], mtime=now_ts - 30, ctx=41)
    t("live: в подписи есть время", "сейчас" in live_label(_lv, now=now_ts, tz=MSK))
    t("live: в подписи есть объем", "41%" in live_label(_lv, now=now_ts, tz=MSK))
    t("live: без объема подпись не врет",
      "%" not in live_label(dict(_lv, ctx=None), now=now_ts, tz=MSK))
    _pl = parse_live("aaaaaaaa-1111-4111-8111-111111111111\tprojectone\t"
                     "имя\tok\t1700000000\t41\n")
    t("live: разбор несет время и объем",
      _pl and _pl[0]["mtime"] == "1700000000" and _pl[0]["ctx"] == 41)
    t("live: пустой объем - None",
      parse_live("aaaaaaaa-1111-4111-8111-111111111111\tprojectone\t"
                 "имя\tok\t1700000000\t\n")[0]["ctx"] is None)
    kb6 = sessions_root_kb(["projectone", "two"], live)
    d6 = [b["callback_data"] for row in kb6["inline_keyboard"] for b in row]
    t("корень: активные ведут прямо в карточку", "s:s:projectone:aaaaaaaa" in d6)
    t("корень: проекты на месте", "s:p:projectone" in d6 and "s:p:two" in d6)
    t("корень: не ссылается на удаленный root", "m:root" not in d6)
    t("карточка: новая сессия рисуется без похода в список",
      "ffffffff" in txt4 and "поднята новая сессия" in txt4)
    t("s:n: новая сессия разбирается",
      route_callback("s:n:projectone") == ("session_new", "projectone", None))
    # ШОВ: все кнопки экрана сессий должны доходить до обработчика. Роутинг и
    # обработчик проверялись по отдельности и были верны, а в цикле опроса
    # список разрешенных типов остался старым - тап по "сжать" молча не делал
    # ничего (найдено 2026-08-04). Проверяем не список, а сами клавиатуры.
    _all_kb = [sessions_root_kb(["projectone"], live),
               sessions_list_kb("projectone", rows, page=1, has_more=True),
               session_card_view("projectone", rows[0])[1],
               session_card_view("projectone", rows[1])[1],
               session_confirm_view("projectone", rows[0])[1],
               session_compact_view("projectone", rows[1])[1]]
    _undispatched = []
    for _kb in _all_kb:
        for _row in _kb["inline_keyboard"]:
            for _b in _row:
                _k = route_callback(_b["callback_data"])[0]
                if _k.startswith("session") and _k not in SESSION_CALLBACK_KINDS:
                    _undispatched.append((_b["callback_data"], _k))
    t("шов: каждая кнопка сессий доходит до обработчика",
      not _undispatched, )
    t("шов: набор типов не пуст", len(SESSION_CALLBACK_KINDS) >= 8)

    t("s:n: кривой проект отбит",
      route_callback("s:n:../etc") == ("none", None, None))
    t("клава: все callback_data влезают в лимит",
      all(len(d.encode()) <= 64 for d in datas))
    sys.exit(1 if ok[0] else 0)


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "poll":
        mode_poll()
    elif mode == "send":
        sys.exit(mode_send(sys.argv[2:]) or 0)
    elif mode == "notify":
        mode_notify(sys.argv[2:])
    elif mode == "voice":
        mode_voice(sys.argv[2:])
    elif mode == "selftest":
        mode_selftest()
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)
