#!/usr/bin/env python3
"""claude-agent-tgbot: Telegram dashboard for the agent layer (stage 3).

Modes:
  claude-agent-tgbot poll                     long-poll daemon (systemd unit)
  claude-agent-tgbot send <agent> <reason> [detail]
                                              push one alert (reconciler hook:
                                              CLAUDE_AGENT_ALERT_CMD)
  claude-agent-tgbot notify [--pre] [text|-]  push raw text to whitelist ids
                                              (- or no arg = read stdin;
                                              --pre = monospace block)
  claude-agent-tgbot selftest                 offline tests of auth/validation

Env (~/.config/claude-control/env, via unit EnvironmentFile):
  CLAUDE_AGENT_TG_TOKEN      bot token (secrets live in env, not in repo)
  CLAUDE_AGENT_TG_WHITELIST  comma-separated numeric from.id allowlist
  CLAUDE_AGENT_TG_PROXY      http proxy for api.telegram.org (mihomo);
                             default http://127.0.0.1:7890, "" = direct

Security (design "Дашборд"): private chats only + from.id whitelist (group
chat_id is NOT a credential); agent names validated before any FS/CLI use;
all agent-produced text (status_line etc.) is untrusted -> html-escaped,
sent as <pre> blocks.
"""

import fcntl
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$")
QID_RE = re.compile(r"^[0-9a-f-]{36}$")
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
MENU_BTN = "☰ Меню"  # "☰ Меню" - постоянная reply-кнопка
OFFSET_FILE = os.path.expanduser("~/.claude-control/tgbot.offset")
LOG_FILE = os.path.expanduser("~/.claude-control/tgbot.log")


def log(msg):
    line = "%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    try:
        with open(LOG_FILE, "a") as f:
            f.write(line)
    except OSError:
        pass
    sys.stderr.write(line)


def cfg():
    token = os.environ.get("CLAUDE_AGENT_TG_TOKEN", "")
    wl = {int(x) for x in
          os.environ.get("CLAUDE_AGENT_TG_WHITELIST", "").split(",")
          if x.strip().isdigit()}
    proxy = os.environ.get("CLAUDE_AGENT_TG_PROXY", "http://127.0.0.1:7890")
    return token, wl, proxy


def api(token, proxy, method, http_timeout, **params):
    url = "https://api.telegram.org/bot%s/%s" % (token, method)
    data = urllib.parse.urlencode(params).encode()
    handlers = []
    if proxy:
        handlers.append(urllib.request.ProxyHandler(
            {"http": proxy, "https": proxy}))
    opener = urllib.request.build_opener(*handlers)
    with opener.open(urllib.request.Request(url, data=data),
                     timeout=http_timeout) as r:
        return json.loads(r.read().decode())


def _chunk_for_html(text, limit=3800):
    """Чанки по СЫРОМУ тексту так, чтобы escape-длина каждого <= limit:
    разрез не попадает внутрь HTML-entity (stage9 гейт п.12)."""
    chunks, cur, cur_len = [], [], 0
    for ch in text:
        e = len(html.escape(ch))
        if cur and cur_len + e > limit:
            chunks.append("".join(cur))
            cur, cur_len = [], 0
        cur.append(ch)
        cur_len += e
    chunks.append("".join(cur))
    return chunks


def send_message(token, proxy, chat_id, text, pre=False, reply_markup=None):
    # эскейпим ВСЕ (вывод агентов - недоверенные данные), <pre> для таблиц;
    # телеграмный лимит 4096 - режем с запасом ДО escape (entity-safe).
    # Возвращает message_id всех чанков - для map reply-роутинга (stage9).
    # reply_markup (V2.5 §4, аудит major 4) - JSON-строка клавиатуры,
    # прикрепляется к ПОСЛЕДНЕМУ чанку (единственному в подавляющем
    # большинстве случаев): длинный текст режется, клавиатура не теряется.
    ids = []
    chunks = _chunk_for_html(text)
    for i, chunk in enumerate(chunks):
        body = html.escape(chunk)
        kwargs = {}
        if reply_markup is not None and i == len(chunks) - 1:
            kwargs["reply_markup"] = reply_markup
        r = api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text=("<pre>%s</pre>" % body) if pre else body,
                parse_mode="HTML", **kwargs)
        mid = ((r or {}).get("result") or {}).get("message_id") \
            if isinstance(r, dict) else None
        ids.append(mid)
    return ids


# ------------------------------------------------- stage9: redaction + map

SECRET_RE = re.compile(
    r'(?i)((?:api[_-]?key|token|secret|password|authorization)"?\s*[=:]\s*"?'
    r'(?:bearer\s+)?)[^\s&"]+'
    r'|(\bbearer\s+)\S+'
    r'|\b(?:sk|xox[a-z]|ghp|gho|github_pat)-[A-Za-z0-9_-]{8,}'
    r'|\b[A-Za-z0-9+/_-]{40,}\b')


def redact(s):
    """Маскирование секрет-паттернов на экспорте в TG (stage9 гейт п.12;
    V2.5 §4 аудит major 3: покрытие выровнено с claude-agent-permit -
    самостоятельный "Bearer <token>" без слова Authorization и JSON-форма
    {"password":"hunter2"} тоже маскируются). Лучше пере-, чем
    недомаскировать: события пишутся сырыми by design."""
    return SECRET_RE.sub(lambda m: (m.group(1) or m.group(2) or "") + "***", s)


SENT_MAP_TTL_S = 14 * 86400


def _sent_map_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_SENT_MAP",
        os.path.expanduser("~/.claude-control/tgbot.sent.json"))


def _sent_map_load():
    """§5, аудит V2.5 minor: форма валидируется на загрузке - не-словарь
    ([], null, скаляр) трактуется как пустая карта, записи с
    не-объектными значениями пропускаются (а не роняют .items()/.get()
    вызывающего AttributeError на каждом апдейте)."""
    try:
        with open(_sent_map_path()) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(d, dict):
        return {}
    return {k: v for k, v in d.items() if isinstance(v, dict)}


def _question_read(agent, qid):
    """Безопасное чтение файла вопроса agent/questions/qid.json - тот же
    containment-протокол, что qid_safe_path в run/answer; agent и qid здесь
    недоверенный ввод (из sent_map/callback), поэтому оба валидируются.
    None, если агент/qid некорректны либо файл нечитаем."""
    if not agent or not NAME_RE.match(agent) or not qid or not QID_RE.match(qid):
        return None
    qdir = os.path.realpath(os.path.join(_agents_dir(), agent, "questions"))
    path = os.path.realpath(os.path.join(qdir, qid + ".json"))
    if path != os.path.join(qdir, qid + ".json"):
        return None
    try:
        with open(path) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def _question_is_open(agent, qid):
    """qid все еще открыт - запись в sent_map с таким qid не прунится по
    TTL (§5): вопрос ждет ответа столько, сколько нужно."""
    d = _question_read(agent, qid)
    return bool(d) and d.get("status") == "open"


def _sent_map_prune(m, now):
    """TTL-фильтр (§5): свежие записи проходят всегда; просроченная запись
    с открытым qid переживает TTL, просроченная без qid или с закрытым
    qid - прунится обычным порядком."""
    kept = {}
    for k, v in m.items():
        if now - (v.get("at") or 0) < SENT_MAP_TTL_S:
            kept[k] = v
        elif v.get("kind") == "question" \
                and _question_is_open(v.get("agent"), v.get("qid")):
            kept[k] = v
    return kept


def sent_map_register(chat_id, message_ids, agent, gen, now=None,
                      kind=None, qid=None):
    """(chat_id, message_id) -> {agent, gen, kind?, qid?} для reply-роутинга
    и роутинга кнопок (§5-6): каждый чанк регистрируется (stage9 гейт п.8);
    TTL-prune при записи (§5, qid открыт -> запись не прунится). RMW под
    flock + запись через mkstemp (§5: конкурентные регистрации раньше
    теряли записи - общий load-modify-save без лока)."""
    now = now or time.time()
    path = _sent_map_path()
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    lk = os.open(path + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lk, fcntl.LOCK_EX)
        m = _sent_map_prune(_sent_map_load(), now)
        for mid in message_ids or []:
            if mid is None:
                continue
            entry = {"agent": agent, "gen": gen, "at": now}
            if kind is not None:
                entry["kind"] = kind
            if qid is not None:
                entry["qid"] = qid
            m["%s:%s" % (chat_id, mid)] = entry
        tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".tgbot.sent.")
        try:
            with os.fdopen(tmp_fd, "w") as f:
                json.dump(m, f, ensure_ascii=False)
            os.replace(tmp_path, path)
        except OSError:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            raise
    except OSError as e:
        log("sent-map write error: %s" % e)
    finally:
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)


def sent_map_lookup(chat_id, message_id):
    return _sent_map_load().get("%s:%s" % (chat_id, message_id))


# ---------------------------------------------- счетчик карточек (Р11, план §12)
# Митигация риска "рост числа карточек > 5-10/день": durable-счетчик
# ФАКТИЧЕСКИ ДОСТАВЛЕННЫХ карточек (кнопки вопроса/готовности), не
# запрошенных - единственная точка учета здесь, в mode_send, на успешной
# доставке (несколько мест зовут алерт, но считать надо доставленное).
# Сутки - UTC, отваливаются сами (day != сегодня -> счетчик обнуляется при
# следующей записи, чистка руками не нужна). claude-agent-limits-digest
# читает этот же файл тем же env-override.

def _cards_count_path():
    return os.environ.get(
        "CLAUDE_AGENT_TG_CARDS_COUNT",
        os.path.expanduser("~/.claude-control/tgbot.cards.json"))


def cards_count_bump(now=None):
    """Инкремент на ФАКТИЧЕСКИ доставленной карточке (mode_send, delivered).
    RMW под flock + mkstemp - тот же прием, что sent_map_register."""
    now = now if now is not None else time.time()
    day = time.strftime("%Y-%m-%d", time.gmtime(now))
    path = _cards_count_path()
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    lk = os.open(path + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            with open(path) as f:
                cur = json.load(f)
        except (OSError, ValueError):
            cur = {}
        if not isinstance(cur, dict) or cur.get("day") != day:
            cur = {"day": day, "count": 0}
        cur["count"] = cur.get("count", 0) + 1
        tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".tgbot.cards.")
        try:
            with os.fdopen(tmp_fd, "w") as f:
                json.dump(cur, f, ensure_ascii=False)
            os.replace(tmp_path, path)
        except OSError:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            raise
    except OSError as e:
        log("cards-count write error: %s" % e)
    finally:
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)


BTN_LABEL_LIMIT = 64


def _clip_label(s, limit=BTN_LABEL_LIMIT):
    """Подпись кнопки Telegram <= limit байт (§4, аудит V2.5 major 4).
    Обрезка по границе utf-8 - посимвольно (не по сырым байтам вслепую),
    поэтому многобайтовый символ никогда не режется пополам."""
    if len(s.encode("utf-8")) <= limit:
        return s
    ell = "…"
    budget = limit - len(ell.encode("utf-8"))
    out = s
    while out and len(out.encode("utf-8")) > budget:
        out = out[:-1]
    return out + ell


# ------------------------------------------------- V2.5: чистые функции §9

CID8_RE = re.compile(r"^[0-9a-f]{8}$")

# кап карточки готовности учитывал только поля кандидатов (LESSON_CANDIDATE_
# MAX_BYTES в claude-agent-run), summary заявки не был ограничен вовсе
# (контрольный аудит серьезная 6): summary ~3000 символов + три допустимых
# кандидата режут карточку на несколько сообщений (_chunk_for_html, лимит
# 3800 escaped-символов), клавиатура (принять/отклонить) прикрепляется
# ТОЛЬКО к последнему чанку - обрыв после первого оставляет карточку без
# кнопок, повтор дублирует уже доставленное. Копия та же, что у
# claude-agent-done (единственный писатель summary) - защита в глубину: там
# обрезка на источнике, здесь - на случай значения, попавшего в done.json
# иначе (старый файл до фикса, ручная правка).
DONE_SUMMARY_MAX_BYTES = 1500


def _cap_escaped(text, limit):
    """Обрезает text по HTML-ESCAPED длине (не по сырым символам - см.
    LESSON_CANDIDATE_MAX_BYTES в claude-agent-run: escape-длина - то, что
    реально уходит в send_message/_chunk_for_html, а не сырая)."""
    s = str(text or "")
    esc_len, kept = 0, []
    for ch in s:
        e = len(html.escape(ch))
        if esc_len + e > limit:
            return "".join(kept) + " [обрезано]"
        kept.append(ch)
        esc_len += e
    return s


def _done_card(detail):
    """kind=="done" (V2.7b §3 п.1) - карточка заявки о готовности: те же две
    кнопки принять/отклонить, callback-data несет sha8 (первые 8 символов
    commit_sha, "-" для direct/none) - не украшение, а проверка на
    устаревание, если агент передекларировал готовность новым коммитом.

    detail["lessons"] (V2.9 §5) - хвост до трех кандидатов в урок, у каждой
    пара кнопок принять/отклонить (callback "l:<agent>:<cid8>:y/n").
    Отдельной карточки нет - хвост той же карточки. Ключ отсутствует/пуст ->
    хвоста нет, карточка байт-в-байт как в V2.7b (регресс-инвариант).

    Карточка несет ПОЛНЫЙ текст урока - essence, why и how_to_apply (аудит
    блокер 2), не одну суть: показ только essence позволял бы essence
    выглядеть безобидно, пока в how_to_apply (записываемом при accept)
    уезжает произвольная скрытая инструкция - подтверждение человека
    бессмысленно, если он не видит то, что подтверждает.

    essence/why/how_to_apply НЕ проходят через redact() здесь (аудит блокер
    3): это уже прошедшие _lessons_mask() значения, записанные ТЕМ ЖЕ
    контуром (claude-agent-run), который их же дописывает в журнал/зеркало
    при accept - показанное и записанное обязаны быть побайтно одним и тем
    же текстом. Вторая, ДРУГАЯ функция маскировки поверх уже замаскированных
    полей давала ровно обратный эффект: карточка показывает "***" там, где
    redact() поймал что-то шире, а в журнал и в git при этом уезжают
    исходные (не пойманные _lessons_mask) байты - человек видит маску,
    подтверждает вслепую, секрет утекает."""
    agent = detail.get("agent") or "?"
    project = detail.get("project")
    summary = _cap_escaped(redact(str(detail.get("summary") or "")),
                           DONE_SUMMARY_MAX_BYTES)
    commit_sha = detail.get("commit_sha")
    branch = detail.get("branch")
    changes = detail.get("changes") or []
    # поколение заявки: для worktree это commit_sha[:8], для direct/none -
    # хеш от envelope_key (V2.10, аудит r3 блокер 3). Прежний литерал "-"
    # делал сверку тапа вырожденной: любая старая карточка совпадала с
    # текущей заявкой, даже после перехода владения к новому конверту.
    # Фолбэк на старую форму - для карточек, собранных до обновления.
    sha8 = detail.get("gen8") or (commit_sha[:8] if commit_sha else "-")
    header = "агент %s [%s]: задача готова\n%s" % (agent, project or "-",
                                                   summary)
    if commit_sha:
        header += "\n\ncommit %s (%s)" % (sha8, branch or "?")
    elif changes:
        shown = [redact(str(c)) for c in changes[:5]]
        more = "" if len(changes) <= 5 else " и еще %d" % (len(changes) - 5)
        header += "\n\nизменено: %s%s" % (", ".join(shown), more)
    if detail.get("empty"):
        header += "\n\n(без изменений)"
    # V2.7b §3 п.5: reply текстом на эту карточку = отклонение с
    # комментарием. Без подсказки это неочевидно (live 2026-07-29:
    # оператор отвечал текстом, не имея в виду отклонить).
    header += "\n\nreply текстом = отклонить с комментарием"
    rows = [[("принять", "d:%s:%s:a" % (agent, sha8))],
           [("отклонить", "d:%s:%s:r" % (agent, sha8))]]
    for lesson in (detail.get("lessons") or [])[:3]:
        if not isinstance(lesson, dict):
            continue
        lcid8 = lesson.get("cid8")
        if not isinstance(lcid8, str) or not CID8_RE.match(lcid8):
            continue
        # НЕ redact() - см. docstring выше (аудит блокер 3): показанное
        # обязано побайтно совпадать с тем, что уйдет в журнал/зеркало.
        essence = str(lesson.get("essence") or "")
        why = str(lesson.get("why") or "")
        how = str(lesson.get("how_to_apply") or "")
        header += "\n\nурок: %s" % essence
        if why:
            header += "\nпочему: %s" % why
        header += "\nкак применять: %s" % how
        rows.append([("принять урок", "l:%s:%s:y" % (agent, lcid8)),
                    ("отклонить урок", "l:%s:%s:n" % (agent, lcid8))])
    header += ("\n\nдля отказа с объяснением - ответь (reply) на это "
               "сообщение, кнопка \"отклонить\" - без комментария")
    return header, _inline(rows)


def question_card(detail):
    """detail (§3, JSON-detail mode_send) -> (text, reply_markup). None /
    не-dict / kind не question/done -> (None, None) - вызывающий (mode_send)
    шлет обычный алерт (регресс-инвариант T1/T2). Текст всегда прогоняется
    через redact() (§3, второй рубеж маскировки перед выходом наружу).
    kind=="done" (V2.7b §3) - карточка заявки о готовности, см. _done_card."""
    if not isinstance(detail, dict):
        return None, None
    if detail.get("kind") == "done":
        return _done_card(detail)
    if detail.get("kind") != "question":
        return None, None
    agent = detail.get("agent") or "?"
    qid = detail.get("qid") or ""
    qkind = detail.get("qkind")
    text = redact(str(detail.get("text") or ""))
    # v2.6 §5: снуз есть на любой карточке вопроса. Кнопка живет ЗДЕСЬ, а не
    # постобработкой в mode_send: чистая функция обязана возвращать то, что
    # реально уйдет наружу, иначе ее тесты дают ложную уверенность о карточке.
    snooze = [("напомнить позже", "r:%s" % qid)]
    if qkind == "permission":
        header = "агент %s: запрос подтверждения\n%s" % (agent, text)
        rows = [[("разрешить", "p:%s:a" % qid)],
               [("отклонить", "p:%s:r" % qid)],
               snooze]
        return header, _inline(rows)
    # info (§4): подсказка про reply всегда, кнопки по options - при наличии
    header = ("агент %s: вопрос\n%s\n\nответь reply-ем на это сообщение "
              "для свободного текста" % (agent, text))
    options = detail.get("options") or []
    # §4 аудит V2.5 major 3/4: подпись - тоже строка, уходящая наружу,
    # редактируется так же, как текст вопроса, и обрезается до лимита кнопки.
    rows = [[(_clip_label(redact(str(opt))), "q:%s:%d" % (qid, i))]
            for i, opt in enumerate(options)]
    return header, _inline(rows + [snooze])


def route_callback(data):
    """callback_data -> (kind, qid, arg) (§9). "q:<qid>:<idx>" ->
    ("answer_option", qid, idx); "p:<qid>:a/r" -> ("approve"/"reject", qid,
    None); "r:<qid>" -> ("snooze", qid, None) (v2.6 §5); "d:<agent>:<sha8>:a/r"
    -> ("accept_done"/"reject_done", agent, sha8) (V2.7b §3 п.1 - слот "qid"
    здесь несет имя агента, "arg" - sha8, идентификатор заявки не qid-формы);
    "l:<agent>:<cid8>:y/n" -> ("accept_lesson"/"reject_lesson", agent, cid8)
    (V2.9 §5 - хвост карточки готовности, префикс "l:" свободен от q:/p:/r:/
    m:/d: выше); "m:..." -> ("menu", None, data) - неизменный regression-путь
    (§8); мусор -> ("none", None, None)."""
    if isinstance(data, str):
        m = re.match(r"^q:([0-9a-f-]{36}):(\d+)$", data)
        if m:
            return "answer_option", m.group(1), m.group(2)
        m = re.match(r"^p:([0-9a-f-]{36}):a$", data)
        if m:
            return "approve", m.group(1), None
        m = re.match(r"^p:([0-9a-f-]{36}):r$", data)
        if m:
            return "reject", m.group(1), None
        m = re.match(r"^r:([0-9a-f-]{36})$", data)
        if m:
            return "snooze", m.group(1), None
        m = re.match(r"^d:([a-z][a-z0-9-]{0,30}[a-z0-9]):([0-9a-f]{8}|-):"
                    r"([ar])$", data)
        if m:
            return (("accept_done" if m.group(3) == "a" else "reject_done"),
                   m.group(1), m.group(2))
        m = re.match(r"^l:([a-z][a-z0-9-]{0,30}[a-z0-9]):([0-9a-f]{8}):"
                    r"([yn])$", data)
        if m:
            return (("accept_lesson" if m.group(3) == "y" else "reject_lesson"),
                   m.group(1), m.group(2))
        if data.startswith("m:"):
            return "menu", None, data
    return "none", None, None


def answer_action(qkind, status, answered_at, published_at, source):
    """Best-effort UI-дедуп (§6.3, §7 рубеж 1) -> "apply"|"stale"|
    "wrong_kind". wrong_kind - ровно один случай: permission-карточка,
    ответ пришел reply-ем (§4: у permission только кнопки). stale - только
    при ЗАВЕРШЕННОЙ паре (answered_at И published_at непусты) либо при
    закрытом/отсутствующем вопросе; ответ без публикации (spool-put упал,
    бот уже закоммитил offset) - "apply": повтор обязан дожать публикацию,
    иначе вопрос завис бы навсегда (аудит V2.5 major)."""
    if qkind == "permission" and source == "reply":
        return "wrong_kind"
    if status != "open":
        return "stale"
    if answered_at is not None and published_at is not None:
        return "stale"
    return "apply"


def reply_target(entry):
    """Запись sent_map (или None) -> (kind, qid) (§6 reply). kind=="done"
    (V2.7b §3 п.5) -> ("done", sha8) - reply на карточку готовности несет
    комментарий к отказу; с qid -> ("question", qid); без qid (в т.ч.
    запись отсутствует) -> ("mission", None) - неизменный regression-путь
    mission_comment (§8)."""
    if isinstance(entry, dict) and entry.get("kind") == "done":
        return "done", entry.get("qid")
    if isinstance(entry, dict) and entry.get("qid"):
        return "question", entry["qid"]
    return "mission", None


# ------------------------------------------------------------------- auth

def authorized(update, whitelist):
    """private chat + from.id in whitelist. Группа правом не является."""
    msg = update.get("message") or {}
    chat = msg.get("chat") or {}
    frm = msg.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


def parse_command(text):
    """-> (cmd, arg) или (None, None). Имя агента валидируется здесь."""
    if not isinstance(text, str) or not text.startswith("/"):
        return None, None
    parts = text.split()
    cmd = parts[0].split("@")[0].lower()
    if cmd in ("/agents", "/start", "/help", "/limits"):
        return cmd, None
    if cmd == "/menu":
        return cmd, None
    if cmd == "/agent" and len(parts) == 2 and NAME_RE.match(parts[1]):
        return cmd, parts[1]
    if cmd == "/agent":
        return "/agent-bad", None
    if cmd == "/task":
        # /task <agent> <текст...> - событие в spool агента (этап 4, Д1)
        p3 = text.split(None, 2)
        if len(p3) == 3 and NAME_RE.match(p3[1]):
            return cmd, (p3[1], p3[2])
        return "/task-bad", None
    if cmd == "/new":
        # /new <проект> <текст...> - рождение задачи с телефона (V2.7a §1,
        # аудит blocker 1). Имя задачи выводится из update_id в new_task(),
        # не здесь - проект известен только по имени из projects.yaml.
        p3 = text.split(None, 2)
        if len(p3) == 3:
            return cmd, (p3[1], p3[2])
        return "/new-bad", None
    return None, None


# ---------------------------------------------------------------- commands

def run_cli(args):
    """claude-rc agent ... без shell; вывод - недоверенный текст."""
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-rc"), "agent"]
                           + args, capture_output=True, text=True, timeout=30)
        return (r.stdout + r.stderr).strip() or "(пусто)"
    except Exception as e:  # noqa: BLE001 - боту нельзя падать от CLI
        return "ошибка CLI: %s" % e


def tail_lines(path, n, max_bytes=65536):
    """Хвост файла ограниченным чтением, не readlines() целиком (stage9)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    lines = data.splitlines()
    if size > max_bytes and lines:
        lines = lines[1:]  # первая строка окна могла быть разрезана
    return lines[-n:]


def events_tail(name, n=5):
    path = os.path.expanduser(
        "~/.claude-control/agents/%s/events.jsonl" % name)
    out = []
    for ln in tail_lines(path, n):
        try:
            d = json.loads(ln)
            out.append("%s %s %s" % (d.get("at", "")[11:19],
                                     d.get("event", ""),
                                     redact(str(d.get("detail") or ""))))
        except ValueError:
            continue
    return "\n".join(out)


def agent_names():
    """Имена агентов из реестра (папки со spec.yaml), сортированные."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        names = [n for n in os.listdir(d)
                 if os.path.isfile(os.path.join(d, n, "spec.yaml"))]
    except OSError:
        return []
    return sorted(names)


def menu_trigger(text):
    """Текст reply-кнопки, открывающий меню (не /-команда)."""
    return isinstance(text, str) and text.strip() == MENU_BTN


def _reply_kbd():
    """Постоянная reply-клавиатура с кнопкой меню - всегда под полем ввода."""
    return json.dumps({"keyboard": [[MENU_BTN]], "resize_keyboard": True,
                       "is_persistent": True}, ensure_ascii=False)


def _inline(rows):
    """rows: список рядов [(label, callback_data), ...] -> JSON inline-клавы."""
    kb = [[{"text": lbl, "callback_data": data} for lbl, data in row]
          for row in rows]
    return {"inline_keyboard": kb}


def _limits_text():
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
            capture_output=True, text=True, timeout=30)
        out = (r.stdout if r.returncode == 0 else "").strip()
    except Exception:  # noqa: BLE001
        out = ""
    return out or "лимиты недоступны (см. лог limits-digest)"


def menu_view(level):
    """level -> (html_text, inline_markup_dict). Неизвестный -> root."""
    if level == "agents":
        names = agent_names()
        rows = [[(n, "m:ag:%s" % n)] for n in names]
        rows.append([("◀ Назад", "m:root")])
        body = ("\U0001f916 <b>Агенты</b> (%d)" % len(names)) if names \
            else "нет зарегистрированных агентов"
        return body, _inline(rows)
    if level == "limits":
        body = "<b>Лимиты LLM</b>\n<pre>%s</pre>" % html.escape(_limits_text())
        return body, _inline([[("\U0001f504 Обновить", "m:limits")],
                              [("◀ Назад", "m:root")]])
    if level.startswith("ag:"):
        name = level[3:]
        if not NAME_RE.match(name):
            return menu_view("root")
        text = run_cli(["status", name])
        tail = events_tail(name)
        if tail:
            text += "\n--- события ---\n" + tail
        body = "<pre>%s</pre>" % html.escape(text)
        for h in agent_hints(name):
            body += "\n<code>%s</code>" % html.escape(h)
        return body, _inline([[("\U0001f4cb Сводка", "m:sum:%s" % name)],
                              [("\U0001f504 Обновить", "m:ag:%s" % name)],
                              [("◀ Агенты", "m:agents")]])
    # root
    return ("\U0001f916 <b>claude-control</b>\nВыбери раздел:",
            _inline([[("\U0001f4cb Агенты", "m:agents")],
                     [("\U0001f4ca Лимиты", "m:limits")]]))


def send_menu(token, proxy, chat_id, level="root", arm=False):
    """Новое меню-сообщение. arm=True - заодно ставит reply-клавиатуру."""
    if arm:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="Клавиатура меню включена.", reply_markup=_reply_kbd())
        except Exception as e:  # noqa: BLE001
            log("arm keyboard error: %s" % e)
    body, kb = menu_view(level)
    api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
        text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def edit_menu(token, proxy, chat_id, message_id, level):
    """Перерисовать меню на месте (навигация по уровням)."""
    body, kb = menu_view(level)
    api(token, proxy, "editMessageText", http_timeout=30, chat_id=chat_id,
        message_id=message_id, text=body, parse_mode="HTML",
        reply_markup=json.dumps(kb, ensure_ascii=False))


def authorized_cb(update, whitelist):
    """callback_query из private + from.id в whitelist."""
    cq = update.get("callback_query") or {}
    chat = ((cq.get("message") or {}).get("chat") or {})
    frm = cq.get("from") or {}
    return (chat.get("type") == "private"
            and isinstance(frm.get("id"), int)
            and frm["id"] in whitelist)


class TransientSpoolError(Exception):
    """Временный отказ spool-put (диск, lock): offset НЕ двигаем, retry
    следующим getUpdates (ревью-2 этапа 4, атака 5)."""


def spool_task(arg, update_id, from_id):
    """Продюсер #1 (Д1): spool-put c producer-идемпотентностью по update_id.
    Redelivery того же update дает тот же seq, дубль не создается."""
    name, text = arg
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "spool-put", name,
             "--json", json.dumps({"text": text, "from": from_id},
                                  ensure_ascii=False),
             "--producer", "telegram", "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return "принято #%s -> %s" % (r.stdout.strip(), name), False
    if r.returncode in (2, 3, 6):
        # ИЗВЕСТНЫЙ постоянный отказ (валидация, нет агента, кап):
        # ответ пользователю + offset дальше
        return "отказ: %s" % (r.stderr.strip() or "spool-put failed"), False
    # все прочее (lock busy 5, диск 7, неизвестные коды) - fail-closed:
    # событие НЕЛЬЗЯ терять, offset стоит (ревью-3, п.7)
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def new_task(project, text, update_id):
    """Продюсер /new (V2.7a §1, аудит blocker 1): claude-rc agent new-task,
    вся цепочка (create/spool-put/start) идемпотентна по update_id - имя
    задачи выводится из него (task-tg<update_id>), redelivery того же
    апдейта дает ту же строку вывода, вторая задача не заводится."""
    name = "task-tg%s" % update_id
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-rc"), "agent", "new-task",
             "--name", name, "--project", project, "--text", text],
            capture_output=True, text=True, timeout=60)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return r.stdout.strip(), False
    return "отказ: %s" % (r.stderr.strip() or "new-task failed"), False


def _agents_dir():
    return (os.environ.get("CLAUDE_AGENTS_DIR")
            or os.path.expanduser("~/.claude-control/agents"))


def _agent_type(name):
    """type из spec.yaml агента ('mission' - дефолт)."""
    try:
        with open(os.path.join(_agents_dir(), name, "spec.yaml")) as f:
            for ln in f:
                if ln.startswith("type:"):
                    return ln.split(":", 1)[1].strip() or "mission"
    except OSError:
        pass
    return "mission"


def _control_read(name):
    """control.json ОДНИМ чтением (stage9 гейт п.11) ->
    (doc|None, None|"missing"|"error")."""
    d = os.path.join(_agents_dir(), name)
    if not os.path.isdir(d):
        return None, "missing"
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-io"),
                            "control-read", d],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            return json.loads(r.stdout), None
    except Exception:  # noqa: BLE001
        pass
    return None, "error"


def summary_text(name):
    """Механическая сводка mission-агента (stage9 фича 1) -> (text, gen).
    control одним чтением, state строго его поколения, события с redaction,
    mission-очередь."""
    control, err = _control_read(name)
    if control is None:
        return "агент %s: control.json недоступен (%s)" % (name, err), None
    gen = control.get("generation")
    parts = ["агент: %s (gen %s)" % (name, gen),
             "desired: %s" % control.get("desired"),
             "hold: %s" % control.get("hold")]
    att = control.get("attention") or {}
    parts.append("attention: %s" % (att.get("reason") or "-"))
    acc = control.get("acceptance")
    if acc:
        parts.append("acceptance: %s"
                     % json.dumps(acc, ensure_ascii=False)[:200])
    sp = os.path.join(_agents_dir(), name, "state.%s.json" % gen)
    try:
        with open(sp) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = None
    if isinstance(st, dict) and st.get("generation") == gen:
        for k in ("phase", "iterations", "status_line", "agent_claim"):
            if st.get(k) not in (None, ""):
                parts.append("%s: %s" % (k, st.get(k)))
    else:
        parts.append("state: нет валидного отчета поколения %s" % gen)
    try:
        r = subprocess.run([os.path.join(BIN_DIR, "claude-agent-run"),
                            "mission-status", name],
                           capture_output=True, text=True, timeout=15)
        ms = json.loads(r.stdout) if r.returncode == 0 else {}
    except Exception:  # noqa: BLE001
        ms = {}
    if ms:
        q = "очередь: %s" % ms.get("depth")
        if ms.get("depth"):
            q += ", старейшему %sс" % ms.get("oldest_age_s")
        if ms.get("fail_streak"):
            q += ", неудач подряд %s" % ms.get("fail_streak")
        if ms.get("stalled"):
            q += " [DELIVERY STALLED]"
        parts.append(q)
    ev = events_tail(name, 8)
    text = "\n".join(parts)
    if ev:
        text += "\n--- события ---\n" + ev
    return redact(text), gen


def mission_put_task(name, text, update_id, from_id):
    """Продюсер mission-очереди (stage9): идемпотентность по update_id;
    транзиентные отказы (lock 5, диск 7) -> offset стоит, как spool_task."""
    try:
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "mission-put", name,
             "--text", text, "--from", str(from_id),
             "--id", "tg:%s" % update_id],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001
        raise TransientSpoolError(str(e))
    if r.returncode == 0:
        return ("принято #%s -> %s (доставка на idle-промпте сессии)"
                % (r.stdout.strip(), name))
    if r.returncode == 6:
        return "очередь %s полна - подожди доставки (backpressure)" % name
    if r.returncode in (2, 3):
        return "отказ: %s" % (r.stderr.strip() or "mission-put failed")
    raise TransientSpoolError("exit %s: %s"
                              % (r.returncode, r.stderr.strip()[:200]))


def mission_comment(msg, rep, text, update_id):
    """Reply на сообщение бота -> комментарий в mission-очередь (stage9
    фича 2). Роутинг по map (chat_id, message_id) со сверкой generation;
    вызывается ДО командного парсинга (гейт п.9)."""
    chat_id = (msg.get("chat") or {}).get("id")
    ent = sent_map_lookup(chat_id, rep.get("message_id"))
    if not ent:
        return ("сопоставить reply с агентом не могу - ответь на карточку "
                "задачи/вопроса или на свежую сводку (кнопка Сводка в "
                "меню); продолжение event-задачи: /task <имя> <текст>")
    name = ent.get("agent") or ""
    if not NAME_RE.match(name):
        return "битая запись роутинга - ответь на свежую сводку"
    if _agent_type(name) == "event":
        # живой сессии нет - комментарию некуда доставляться (spec stage9)
        return ("агент %s - event-типа, живой сессии нет; отправь как "
                "задачу: /task %s <текст>" % (name, name))
    control, err = _control_read(name)
    if err == "missing":
        return "агент %s удален - комментарий не доставить" % name
    if control is None:
        # transient: control нечитаем при живом каталоге - не терять update
        raise TransientSpoolError("control-read failed for %s" % name)
    gen = control.get("generation")
    if ent.get("gen") != gen:
        return ("это сообщение прежней инкарнации %s (gen %s, сейчас %s) - "
                "ответь на свежую сводку" % (name, ent.get("gen"), gen))
    return mission_put_task(name, text, update_id,
                            (msg.get("from") or {}).get("id", 0))


def _call_answer(agent_dir, qid, mode, value, by):
    """Доверенный писатель claude-agent-answer (§1: бот сам ничего не
    решает и не пишет в questions/) -> (returncode, stderr)."""
    args = [os.path.join(BIN_DIR, "claude-agent-answer"), agent_dir,
           "--qid", qid]
    if mode == "text":
        args += ["--text", value]
    elif mode == "approve":
        args += ["--approve"]
    else:
        args += ["--reject"]
    args += ["--by", by]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    return r.returncode, r.stderr.strip()


def _handle_question_callback(token, proxy, chat_id, message_id, kind,
                              qid, arg, from_id):
    """Тап по q:/p: (§6): агент вопроса берется из sent_map по
    (chat_id, message_id) - карточка была зарегистрирована при отправке
    (mode_send). Best-effort UI-дедуп (answer_action, §6.3) ДО вызова
    claude-agent-answer; настоящая гарантия "ровно один раз" - в самом
    claude-agent-answer (§7.2) и в runner-side stale-гейте (V2.3 §3.5)."""
    ent = sent_map_lookup(chat_id, message_id) or {}
    agent = ent.get("agent")
    if not ent.get("qid") or ent.get("qid") != qid:
        # §6, аудит V2.5 major 2(a) + V2.6 major 5: агент берется из
        # sent_map, но запись обязана нести qid и он обязан совпасть с
        # qid из callback_data - иначе тап по одной карточке мог бы
        # применить решение к чужому вопросу (например --approve на
        # info-вопросе через подмену qid в data), а старая запись БЕЗ
        # qid вовсе (legacy/mission) позволяла бы это без всякой подмены.
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id,
                text="вопрос уже закрыт или отвечен ранее (устарело)")
        except Exception as e:  # noqa: BLE001
            log("edit stale card error (qid mismatch): %s" % e)
        return
    doc = _question_read(agent, qid)
    decision = answer_action(
        doc.get("kind") if doc else None,
        doc.get("status") if doc else None,
        doc.get("answered_at") if doc else None,
        doc.get("event_published_at") if doc else None,
        "button")
    if decision != "apply":
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id,
                text="вопрос уже закрыт или отвечен ранее (устарело)")
        except Exception as e:  # noqa: BLE001
            log("edit stale card error: %s" % e)
        return
    agent_dir = os.path.join(_agents_dir(), agent)
    by = "tg:%s" % from_id
    if kind == "answer_option":
        try:
            value = (doc.get("options") or [])[int(arg)]
        except (TypeError, ValueError, IndexError):
            log("question callback: индекс опции вне диапазона (%r)" % arg)
            return
        mode = "text"
    else:
        value, mode = None, kind  # "approve" | "reject"
    rc, err = _call_answer(agent_dir, qid, mode, value, by)
    if rc != 0:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="не удалось применить ответ: %s"
                     % (err or ("exit %s" % rc)))
        except Exception as e:  # noqa: BLE001
            log("sendMessage after failed answer error: %s" % e)
        return
    try:
        api(token, proxy, "editMessageText", http_timeout=30,
            chat_id=chat_id, message_id=message_id, text="ответ принят")
    except Exception as e:  # noqa: BLE001
        log("edit applied card error: %s" % e)


def _handle_question_snooze(token, proxy, chat_id, message_id, qid):
    """Тап "напомнить позже" (r:<qid>, v2.6 §5): агент вопроса берется из
    sent_map по (chat_id, message_id), qid сверяется с карточкой - тот же
    рубеж, что в _handle_question_callback (§6). Запись - только через
    claude-agent-run question-snooze под questions/.lock; бот сам в файл
    вопроса не пишет (§5)."""
    ent = sent_map_lookup(chat_id, message_id) or {}
    agent = ent.get("agent")
    # аудит V2.6 major 5: запись обязана нести qid и он обязан совпасть -
    # без этого старая запись sent_map без qid (легаси/mission) позволяла
    # бы подставить произвольный r:<qid> и снузить чужой вопрос агента.
    if not agent or not ent.get("qid") or ent.get("qid") != qid:
        text = "вопрос уже закрыт или отвечен ранее (устарело)"
    else:
        agent_dir = os.path.join(_agents_dir(), agent)
        r = subprocess.run(
            [os.path.join(BIN_DIR, "claude-agent-run"), "question-snooze",
             agent_dir, "--qid", qid],
            capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            text = "напомню позже"
        else:
            text = "не удалось отложить: %s" \
                % (r.stderr.strip() or ("exit %s" % r.returncode))
    try:
        api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
            text=text)
    except Exception as e:  # noqa: BLE001
        log("sendMessage after snooze error: %s" % e)


# --------------------------------------------------- V2.7b: карточка "готово"

def _short_sha(commit_sha):
    return commit_sha[:8] if commit_sha else "-"


def _handle_done_callback(token, proxy, chat_id, message_id, kind, agent,
                          sha8, from_id):
    """Тап "принять"/"отклонить" на карточке готовности (d:<agent>:<sha8>:a/
    r, V2.7b §3). Доверие - право писать, не поле в payload (как в V2.5/
    §3 п.3): бот done.json не читает и не пишет вообще - классификацию
    applied/already/stale целиком отдает claude-agent-run done-verdict, у
    которого один monopoly на done.lock (§2): код возврата 3 - устарело,
    0 + stdout "already" - повторный тап (no-op), 0 + "applied" - первый
    успешный."""
    if not agent or not NAME_RE.match(agent):
        return
    want = "accepted" if kind == "accept_done" else "rejected"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "done-verdict",
           agent_dir, "--accept" if want == "accepted" else "--reject",
           "--expect-sha", sha8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        # причина из done-verdict (stderr) - иначе "устарело" неотличимо:
        # уже принято и ушло по FSM / передекларировано / агент архивирован
        reason = (r.stderr.strip().splitlines() or [""])[-1]
        text = "устарело - задача передекларирована или вердикт уже другой"
        if reason:
            text += "\n(%s)" % reason
        try:
            api(token, proxy, "editMessageText", http_timeout=30,
                chat_id=chat_id, message_id=message_id, text=text)
        except Exception as e:  # noqa: BLE001
            log("edit stale done card error: %s" % e)
        return
    if r.returncode != 0:
        try:
            api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
                text="не удалось применить вердикт: %s"
                     % (r.stderr.strip() or ("exit %s" % r.returncode)))
        except Exception as e:  # noqa: BLE001
            log("sendMessage after failed done-verdict error: %s" % e)
        return
    already = r.stdout.strip() == "already"
    if want == "accepted":
        label = "уже принято" if already else "принято"
    else:
        label = "уже отклонено" if already else "отклонено"
    try:
        api(token, proxy, "editMessageText", http_timeout=30, chat_id=chat_id,
            message_id=message_id, text=label)
    except Exception as e:  # noqa: BLE001
        log("edit done card error: %s" % e)


# ------------------------------------------------ V2.9: хвост "уроки"

def _handle_lesson_callback(token, proxy, chat_id, agent, kind, cid8):
    """Тап "принять урок"/"отклонить урок" на хвосте карточки готовности
    (l:<agent>:<cid8>:y/n, V2.9 §5). Как и у done: бот agents/<name>/
    lessons.json и файл уроков проекта сам не открывает - вся классификация
    applied/already/stale в claude-agent-run lesson-verdict под его локом.
    Ответ - НОВЫМ сообщением (не editMessageText самой карточки готовности):
    решение по уроку не зависит от решения по самой заявке, редактирование
    карточки затронуло бы и ту, независимую пару кнопок."""
    if not agent or not NAME_RE.match(agent):
        return
    accept = kind == "accept_lesson"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "lesson-verdict",
           agent_dir, "--accept" if accept else "--reject", "--id", cid8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        text = "устарело - урок не найден или изменился"
    elif r.returncode != 0:
        text = "не удалось применить: %s" \
            % (r.stderr.strip() or ("exit %s" % r.returncode))
    else:
        already = r.stdout.strip() == "already"
        if accept:
            text = "урок уже подтвержден" if already else "урок принят"
        else:
            text = "урок уже отклонен" if already else "урок отклонен"
    try:
        api(token, proxy, "sendMessage", http_timeout=30, chat_id=chat_id,
            text=text)
    except Exception as e:  # noqa: BLE001
        log("lesson verdict reply error: %s" % e)


def _handle_done_reply(agent, sha8, text, from_id):
    """Reply на карточку готовности -> отклонение с комментарием (§3 п.5:
    "комментарий к отказу берется reply-ответом"). Комментарий на принятие
    не предусмотрен - reply на карточку "готово" всегда несет намерение
    отклонить с пояснением, симметрично тому, как reply на info-вопрос -
    альтернативный ввод к кнопкам (V2.5 §4). Как и в _handle_done_callback,
    бот done.json не открывает - устарело/уже-отклонено различает по коду
    возврата и stdout claude-agent-run done-verdict."""
    if not agent or not NAME_RE.match(agent):
        return "битая запись роутинга - ответь на актуальную карточку"
    agent_dir = os.path.join(_agents_dir(), agent)
    args = [os.path.join(BIN_DIR, "claude-agent-run"), "done-verdict",
           agent_dir, "--reject", "--comment", text, "--expect-sha", sha8]
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode == 3:
        reason = (r.stderr.strip().splitlines() or [""])[-1]
        return ("устарело - задача передекларирована или вердикт уже другой"
                + ("\n(%s)" % reason if reason else ""))
    if r.returncode != 0:
        return "не удалось применить: %s" \
            % (r.stderr.strip() or ("exit %s" % r.returncode))
    # вердикт неизменяем (§3 п.5): на повторе комментарий НЕ переписывается,
    # даже если пришел из более позднего reply на ту же карточку
    return ("уже отклонено ранее - комментарий не сохранен (вердикт "
            "неизменяем)" if r.stdout.strip() == "already"
            else "отклонено с комментарием")


def _question_reply_text(agent, qid, text, from_id):
    """Reply на карточку вопроса -> claude-agent-answer --text (§6 reply,
    §4: permission-карточка reply не принимает - wrong_kind). Возвращает
    сообщение пользователю."""
    doc = _question_read(agent, qid)
    decision = answer_action(
        doc.get("kind") if doc else None,
        doc.get("status") if doc else None,
        doc.get("answered_at") if doc else None,
        doc.get("event_published_at") if doc else None,
        "reply")
    if decision == "wrong_kind":
        return "у этой карточки только кнопки - жми разрешить/отклонить"
    if decision != "apply":
        return "вопрос уже закрыт или отвечен ранее (устарело)"
    agent_dir = os.path.join(_agents_dir(), agent)
    rc, err = _call_answer(agent_dir, qid, "text", text, "tg:%s" % from_id)
    if rc != 0:
        return "не удалось применить ответ: %s" % (err or ("exit %s" % rc))
    return "ответ принят"


def handle(cmd, arg, update_id=0, from_id=0):
    if cmd in ("/start", "/help"):
        return ("Дашборд агентов claude-control.\n"
                "/agents - парк\n/agent <name> - детали и события\n"
                "/task <name> <текст> - событие агенту\n"
                "/limits - остатки лимитов LLM"), False
    if cmd == "/agents":
        return run_cli(["list"]), True
    if cmd == "/limits":
        # панель из последнего кэшированного снапшота (limits-digest render)
        try:
            r = subprocess.run(
                [os.path.join(BIN_DIR, "claude-agent-limits-digest"), "render"],
                capture_output=True, text=True, timeout=30)
            out = (r.stdout if r.returncode == 0 else "").strip()
        except Exception:  # noqa: BLE001
            out = ""
        return (out or "лимиты недоступны (см. лог limits-digest)"), True
    if cmd == "/agent-bad":
        return "имя агента: [a-z0-9-], например /agent faq-updater", False
    if cmd == "/task-bad":
        return "формат: /task <agent> <текст задачи>", False
    if cmd == "/new-bad":
        return "формат: /new <проект> <текст задачи>", False
    if cmd == "/agent":
        text = run_cli(["status", arg])
        tail = events_tail(arg)
        if tail:
            text += "\n--- события ---\n" + tail
        hints = agent_hints(arg)
        if not hints:
            return text, True
        # статус - <pre>-таблица, команды - отдельные <code> (копируются
        # построчно), все одним HTML-сообщением - см. mode "html" в send
        body = "<pre>%s</pre>\n--- вход в сессию ---" % html.escape(text)
        for h in hints:
            body += "\n<code>%s</code>" % html.escape(h)
        return body, "html"
    if cmd == "/task":
        return spool_task(arg, update_id, from_id)
    if cmd == "/new":
        project, text = arg
        return new_task(project, text, update_id)
    return None, False


# ------------------------------------------------------------------- modes

def mode_poll():
    token, wl, proxy = cfg()
    if not token or not wl:
        log("не настроено: нужны CLAUDE_AGENT_TG_TOKEN и "
            "CLAUDE_AGENT_TG_WHITELIST в ~/.config/claude-control/env")
        sys.exit(0)  # not-configured = чистый выход, не рестарт-шторм
    offset = 0
    try:
        offset = int(open(OFFSET_FILE).read().strip())
    except (OSError, ValueError):
        pass
    log("poll started (whitelist: %d id, proxy: %s)" % (len(wl), proxy or "-"))
    try:  # список команд в UI "/" (идемпотентно, не критично при отказе)
        api(token, proxy, "setMyCommands", http_timeout=30,
            commands=json.dumps([
                {"command": "menu", "description": "меню (кнопки)"},
                {"command": "agents", "description": "парк агентов"},
                {"command": "limits", "description": "остатки лимитов LLM"},
            ], ensure_ascii=False))
    except Exception as e:  # noqa: BLE001
        log("setMyCommands error: %s" % e)
    backoff = 1
    while True:
        try:
            # long-poll 30с: замерено, что прокси/edge рвет идл-коннект на
            # ~50с ("Remote end closed connection"), 45 - последний рабочий.
            # http_timeout с запасом на возврат данных.
            resp = api(token, proxy, "getUpdates", http_timeout=50,
                       offset=offset, timeout=30)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log("getUpdates error: %s (backoff %ss)" % (e, backoff))
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 1
        for upd in resp.get("result", []):
            # обработка ДО коммита offset (Д1: /task at-least-once; crash
            # между -> redelivery, дубль гасит producer-идемпотентность);
            # try/except - poison-update не клинит бота, offset уходит дальше
            try:
                if "callback_query" in upd and authorized_cb(upd, wl):
                    cq = upd["callback_query"]
                    data = cq.get("data", "")
                    cqmsg = cq.get("message") or {}
                    chat_id = (cqmsg.get("chat") or {}).get("id")
                    # спиннер на клиенте гасим всегда, даже при ошибке ниже
                    try:
                        api(token, proxy, "answerCallbackQuery",
                            http_timeout=30, callback_query_id=cq.get("id", ""))
                    except Exception:  # noqa: BLE001
                        pass
                    kind_cb, qid_cb, arg_cb = route_callback(data)
                    if kind_cb in ("answer_option", "approve", "reject") \
                            and chat_id is not None:
                        try:
                            _handle_question_callback(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), kind_cb, qid_cb,
                                arg_cb, (cq.get("from") or {}).get("id", 0))
                        except Exception as e:  # noqa: BLE001
                            log("question callback error: %s" % e)
                    elif kind_cb == "snooze" and chat_id is not None:
                        try:
                            _handle_question_snooze(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), qid_cb)
                        except Exception as e:  # noqa: BLE001
                            log("question snooze error: %s" % e)
                    elif kind_cb in ("accept_done", "reject_done") \
                            and chat_id is not None:
                        try:
                            _handle_done_callback(
                                token, proxy, chat_id,
                                cqmsg.get("message_id"), kind_cb, qid_cb,
                                arg_cb, (cq.get("from") or {}).get("id", 0))
                        except Exception as e:  # noqa: BLE001
                            log("done callback error: %s" % e)
                    elif kind_cb in ("accept_lesson", "reject_lesson") \
                            and chat_id is not None:
                        # личность отправителя уже проверена authorized_cb
                        # выше (§5 - тем же гейтом chat_id, что у /new)
                        try:
                            _handle_lesson_callback(
                                token, proxy, chat_id, qid_cb, kind_cb, arg_cb)
                        except Exception as e:  # noqa: BLE001
                            log("lesson callback error: %s" % e)
                    elif data.startswith("m:sum:") and chat_id is not None:
                        # сводка - НОВЫМ сообщением, не edit: неизменяемый
                        # reply-якорь для map (stage9, гейт minor)
                        nm = data[len("m:sum:"):]
                        if NAME_RE.match(nm):
                            try:
                                stext, sgen = summary_text(nm)
                                ids = send_message(token, proxy, chat_id,
                                                  stext, pre=True)
                                sent_map_register(chat_id, ids, nm, sgen)
                            except Exception as e:  # noqa: BLE001
                                log("summary error: %s" % e)
                    elif data.startswith("m:") and chat_id is not None:
                        try:
                            edit_menu(token, proxy, chat_id,
                                      cqmsg.get("message_id"), data[2:])
                        except Exception as e:  # noqa: BLE001
                            log("edit_menu error: %s" % e)
                elif authorized(upd, wl):
                    msg = upd.get("message") or {}
                    mtext = msg.get("text", "")
                    rep = msg.get("reply_to_message") or {}
                    if (rep.get("message_id") is not None
                            and isinstance(mtext, str) and mtext.strip()):
                        # reply = комментарий агенту, ДО парсинга команд
                        # (stage9 гейт п.9); TransientSpoolError уходит
                        # наверх - offset не двигается, update не теряется.
                        # §6: reply на карточку вопроса (запись с qid) идет
                        # в claude-agent-answer, без qid - прежний
                        # mission_comment (регресс-инвариант §8). reply на
                        # карточку готовности (kind=="done", V2.7b §3 п.5) -
                        # комментарий к отказу через done-verdict.
                        reply_chat_id = (msg.get("chat") or {}).get("id")
                        rt_kind, rt_qid = reply_target(sent_map_lookup(
                            reply_chat_id, rep.get("message_id")))
                        if rt_kind == "question":
                            ent = sent_map_lookup(reply_chat_id,
                                                  rep.get("message_id")) or {}
                            out = _question_reply_text(
                                ent.get("agent"), rt_qid, mtext,
                                (msg.get("from") or {}).get("id", 0))
                        elif rt_kind == "done":
                            ent = sent_map_lookup(reply_chat_id,
                                                  rep.get("message_id")) or {}
                            out = _handle_done_reply(
                                ent.get("agent"), rt_qid, mtext,
                                (msg.get("from") or {}).get("id", 0))
                        else:
                            out = mission_comment(msg, rep, mtext,
                                                  upd.get("update_id", 0))
                        if out:
                            try:
                                send_message(token, proxy,
                                             msg["chat"]["id"], out)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
                        offset = upd["update_id"] + 1
                        try:
                            open(OFFSET_FILE, "w").write(str(offset))
                        except OSError:
                            pass
                        continue
                    cmd, arg = parse_command(mtext)
                    if menu_trigger(mtext) or cmd == "/menu":
                        send_menu(token, proxy, msg["chat"]["id"], arm=True)
                        cmd = None  # меню отрисовано, обычный handle не нужен
                    if cmd == "/start":
                        # /start заодно ставит постоянную reply-клавиатуру
                        try:
                            api(token, proxy, "sendMessage", http_timeout=30,
                                chat_id=msg["chat"]["id"],
                                text="Клавиатура меню включена. /menu - открыть.",
                                reply_markup=_reply_kbd())
                        except Exception as e:  # noqa: BLE001
                            log("arm keyboard error: %s" % e)
                    if cmd:
                        text, pre = handle(
                            cmd, arg, update_id=upd.get("update_id", 0),
                            from_id=(msg.get("from") or {}).get("id", 0))
                        if text:
                            try:
                                if pre == "html":
                                    # уже готовый HTML (<pre>+<code>), не
                                    # эскейпить и не заворачивать повторно
                                    api(token, proxy, "sendMessage",
                                        http_timeout=30,
                                        chat_id=msg["chat"]["id"],
                                        text=text, parse_mode="HTML")
                                else:
                                    send_message(token, proxy,
                                                 msg["chat"]["id"],
                                                 text, pre=pre)
                            except Exception as e:  # noqa: BLE001
                                log("sendMessage error: %s" % e)
            except TransientSpoolError as e:
                # событие нельзя терять: offset стоит, retry следующим
                # getUpdates (идемпотентность --id гасит дубль ответа)
                log("transient spool error at %s: %s (retry)"
                    % (upd.get("update_id"), e))
                time.sleep(2)
                break
            except Exception as e:  # noqa: BLE001
                log("update %s error: %s" % (upd.get("update_id"), e))
            offset = upd["update_id"] + 1
            try:
                open(OFFSET_FILE, "w").write(str(offset))
            except OSError:
                pass


def _agent_project(agent):
    """project из spec.yaml агента в реестре; "" если нет."""
    d = (os.environ.get("CLAUDE_AGENTS_DIR")
         or os.path.expanduser("~/.claude-control/agents"))
    try:
        for line in open(os.path.join(d, agent, "spec.yaml")):
            m = re.match(r"^project:\s*(\S+)", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def agent_hints(agent):
    """Копируемые команды входа в сессию агента (терминал / Cursor).
    Пустой список, если ssh-алиас этой машины не задан (фича выключена)
    или имя агента не похоже на имя агента (служебные пуши)."""
    host = os.environ.get("CLAUDE_AGENT_SSH_HOST", "")
    if not host or not re.match(r"^[a-z][a-z0-9-]{0,30}[a-z0-9]$", agent or ""):
        return []
    hints = ["ssh %s -t '~/.local/bin/claude-rc agent attach %s'"
             % (host, agent)]
    project = _agent_project(agent)
    if project:
        hints.append("cursor --remote ssh-remote+%s %s" % (host, project))
    return hints


def mode_send(argv):
    # v2.6 §2/§4 (аудит V2.6, blocker+major 2): аргументы разбираются ДО
    # проверки конфигурации - has_json (4-й позиционный аргумент реально
    # присутствует) определяет question-путь ДЛЯ КОДА ВОЗВРАТА, независимо
    # от того, распарсится ли он в валидную карточку. json-detail - argv[3]
    # (4-й аргумент), НЕ argv[2] - alert_question (bin/claude-agent-run)
    # кладет туда qid, а json-detail четвертым; старая путаница здесь
    # вырождала question-путь в обычный алерт без кнопок и без sent_map,
    # честный код возврата не проверялся ни разу (сквозной стык V2.5/V2.6).
    agent = argv[0] if argv else "?"
    reason = argv[1] if len(argv) > 1 else "?"
    detail = argv[2] if len(argv) > 2 else ""
    has_json = len(argv) > 3
    token, wl, proxy = cfg()
    if not token or not wl:
        # v2.6 §4 (аудит V2.6, major): отсутствие конфигурации - НЕ
        # доставка. На question-пути это ложный успех (ступень продвинулась
        # бы в никуда) - код честный; обычный алерт остается 0 (регресс).
        return 1 if has_json else 0
    detail_json = None
    if has_json and argv[3]:
        try:
            detail_json = json.loads(argv[3])
        except ValueError:
            detail_json = None
    card_text, card_kb = question_card(detail_json)
    if card_text is not None:
        # V2.5 §3-4: карточка вопроса вместо обычного алерта. Текст уходит
        # существующим entity-safe отправителем (send_message), не прямым
        # api() - аудит V2.5 major 4: прямой вызов на длинном вопросе
        # получает отказ Telegram, исключение гасится, и mode_send
        # рапортует успех, хотя карточки не было вовсе.
        card_kind = detail_json.get("kind") \
            if isinstance(detail_json, dict) else None
        if card_kind == "done":
            # V2.7b §3 п.1: sha8 играет роль qid для роутинга кнопок/reply -
            # sent_map не заводит отдельного поля ради одного нового kind.
            # V2.10 r5 (live-блокер): идентификатор обязан быть ТЕМ ЖЕ, что
            # в callback_data кнопок, - поколением заявки (gen8), иначе
            # reply текстом уходит в done-verdict со старой формой
            # (commit_sha[:8]) и вечно получает "устарело". Фолбэк - для
            # detail от рантайма старой версии, где gen8 еще нет.
            qid = detail_json.get("gen8") \
                or _short_sha(detail_json.get("commit_sha"))
        else:
            qid = detail_json.get("qid") \
                if isinstance(detail_json, dict) else None
        # клавиатура целиком приходит из question_card (включая снуз, v2.6 §5)
        kb = json.dumps(card_kb, ensure_ascii=False) if card_kb else None
        delivered = False
        for uid in wl:
            try:
                ids = send_message(token, proxy, uid, card_text,
                                   reply_markup=kb)
                if any(mid is not None for mid in ids):
                    sent_map_register(uid, ids, agent, None,
                                      kind=card_kind or "question", qid=qid)
                    delivered = True
            except Exception as e:  # noqa: BLE001
                log("push error to %s: %s" % (uid, e))
        if delivered:
            # Р11 (план §12): считаем ДОСТАВЛЕННУЮ карточку ровно один раз,
            # не по числу получателей whitelist - метрика "карточек ушло",
            # не "пушей отправлено".
            cards_count_bump()
        # v2.6 §4: честный код возврата - только на question-пути. Успех =
        # карточку принял хотя бы один получатель из whitelist; ни одного -
        # ненулевой код (иначе "продвигать ступень только после доставки"
        # невыполнимо - недоставленная карточка выглядела бы отправленной).
        return 0 if delivered else 1
    # обычный текст-алерт - байт-в-байт как в V2.4 (регресс-инвариант T1/T2)
    # при отсутствии 4-го аргумента. Если 4-й аргумент присутствовал, но не
    # распознан как карточка вопроса (мусор/не question) - текст все равно
    # рендерится как обычный алерт, но код возврата остается честным
    # (has_json, аудит V2.6 blocker): "question-вызов" определяется числом
    # аргументов, а не успехом парсинга.
    text = "агент %s: %s%s" % (agent, reason,
                               (" - " + detail) if detail else "")
    # команды входа - отдельными <code>, чтобы копировались одним тапом
    body = html.escape(text)
    for h in agent_hints(agent):
        body += "\n<code>%s</code>" % html.escape(h)
    delivered = False
    for uid in wl:
        try:
            if len(body) <= 3800:
                api(token, proxy, "sendMessage", http_timeout=30,
                    chat_id=uid, text=body, parse_mode="HTML")
            else:  # аномально длинный detail - чанками, без хинтов
                send_message(token, proxy, uid, text)
            delivered = True
        except Exception as e:  # noqa: BLE001
            log("push error to %s: %s" % (uid, e))
    if has_json:
        return 0 if delivered else 1
    return 0


def mode_notify(argv):
    """Отправка произвольного текста во все whitelist-id (дайджесты и т.п.).
    В отличие от send-хука падает громко: вызывающему нужен честный exit."""
    pre = False
    args = list(argv)
    if args and args[0] == "--pre":
        pre = True
        args = args[1:]
    text = (" ".join(args) if args and args != ["-"] else sys.stdin.read())
    text = text.rstrip("\n")
    if not text:
        log("notify: пустой текст")
        sys.exit(2)
    token, wl, proxy = cfg()
    if not token or not wl:
        log("notify: нужны CLAUDE_AGENT_TG_TOKEN и CLAUDE_AGENT_TG_WHITELIST")
        sys.exit(2)
    failures = 0
    for uid in sorted(wl):
        try:
            send_message(token, proxy, uid, text, pre=pre)
        except Exception as e:  # noqa: BLE001
            log("notify error to %s: %s" % (uid, e))
            failures += 1
    sys.exit(1 if failures == len(wl) else 0)


def mode_selftest():
    ok = [0]

    def t(name, cond):
        print("  %s: %s" % ("ok" if cond else "FAIL", name))
        ok[0] += 0 if cond else 1

    wl = {111}
    t("private+whitelisted проходит", authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 111}}}, wl))
    t("чужой from.id отбит", not authorized(
        {"message": {"chat": {"type": "private"}, "from": {"id": 222}}}, wl))
    t("групповой чат отбит даже с верным from.id", not authorized(
        {"message": {"chat": {"type": "group"}, "from": {"id": 111}}}, wl))
    t("пустой update отбит", not authorized({}, wl))
    t("/agents парсится", parse_command("/agents") == ("/agents", None))
    t("/agent name парсится",
      parse_command("/agent faq-updater") == ("/agent", "faq-updater"))
    t("path traversal отбит",
      parse_command("/agent ../x") == ("/agent-bad", None))
    t("абсолютный путь отбит",
      parse_command("/agent /etc/passwd") == ("/agent-bad", None))
    t("не-команда игнорируется", parse_command("привет") == (None, None))
    t("инъекция в имя отбита",
      parse_command("/agent a;rm") == ("/agent-bad", None))
    t("html эскейпится", "<b>" not in html.escape("<b>x</b>"))
    t("/task парсится",
      parse_command("/task faq-updater проверь ссылки")
      == ("/task", ("faq-updater", "проверь ссылки")))
    t("/task без текста отбит",
      parse_command("/task faq-updater") == ("/task-bad", None))
    t("/task с плохим именем отбит",
      parse_command("/task ../x текст") == ("/task-bad", None))
    t("/limits парсится", parse_command("/limits") == ("/limits", None))
    t("/limits@bot парсится", parse_command("/limits@x_bot") == ("/limits", None))
    t("/task инъекция в имя отбита",
      parse_command("/task a;rm -rf текст") == ("/task-bad", None))
    t("/new парсится",
      parse_command("/new demoproj текст задачи")
      == ("/new", ("demoproj", "текст задачи")))
    t("/new без текста отбит",
      parse_command("/new demoproj") == ("/new-bad", None))
    # agent_hints: команды входа в сессию в push-уведомлении
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    t("hints пусты без CLAUDE_AGENT_SSH_HOST", agent_hints("faq-updater") == [])
    os.environ["CLAUDE_AGENT_SSH_HOST"] = "llm"
    t("hint attach содержит host и имя агента",
      any("ssh llm" in h and "agent attach faq-updater" in h
          for h in agent_hints("faq-updater")))
    t("hints пусты для кривого имени агента", agent_hints("../x") == [])
    t("hint cursor отсутствует без spec.yaml",
      not any(h.startswith("cursor") for h in agent_hints("faq-updater")))
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "faq-updater"))
        with open(os.path.join(td, "faq-updater", "spec.yaml"), "w") as f:
            f.write("schema: 1\nname: faq-updater\nproject: /data/Work/faq\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("hint cursor берет project из spec.yaml",
          "cursor --remote ssh-remote+llm /data/Work/faq"
          in agent_hints("faq-updater"))
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    os.environ.pop("CLAUDE_AGENT_SSH_HOST", None)
    # menu: одной командой /menu, кнопка ☰ Меню = та же команда
    t("/menu парсится", parse_command("/menu") == ("/menu", None))
    t("/menu@bot парсится", parse_command("/menu@x_bot") == ("/menu", None))
    t("текст кнопки ☰ Меню распознается",
      menu_trigger(MENU_BTN) and not menu_trigger("привет"))
    with tempfile.TemporaryDirectory() as td:
        for nm in ("beta", "alfa"):
            os.makedirs(os.path.join(td, nm))
            open(os.path.join(td, nm, "spec.yaml"), "w").write("name: %s\n" % nm)
        open(os.path.join(td, "not-agent.txt"), "w").write("x")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        t("agent_names сортированы и только с spec.yaml",
          agent_names() == ["alfa", "beta"])
        txt, kb = menu_view("agents")
        datas = [b["callback_data"] for row in kb["inline_keyboard"] for b in row]
        t("уровень agents дает кнопку на каждого агента",
          "m:ag:alfa" in datas and "m:ag:beta" in datas)
        t("уровень agents имеет назад в root", "m:root" in datas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    rtxt, rkb = menu_view("root")
    rdatas = [b["callback_data"] for row in rkb["inline_keyboard"] for b in row]
    t("root ведет в agents и limits",
      "m:agents" in rdatas and "m:limits" in rdatas)
    t("callback_data агента влезает в лимит 64 байта",
      all(len(("m:ag:" + "a" * 32).encode()) <= 64 for _ in [0]))
    t("неизвестный уровень безопасно падает в root",
      menu_view("m:garbage")[0] == menu_view("root")[0])
    # --- stage9: сводка + reply-комментарий (map, redaction, chunking) ---
    t("чанкер не рвет HTML-entity",
      (lambda cs: "".join(cs) == "&" * 4000
       and all(len(html.escape(c)) <= 3800 for c in cs)
       and len(cs) >= 2)(_chunk_for_html("&" * 4000)))
    t("чанкер: пустой текст -> один пустой чанк", _chunk_for_html("") == [""])
    t("redact маскирует token=",
      "supersecretvalue" not in redact("token=supersecretvalue1234"))
    t("redact маскирует длинный base64-хвост",
      "A" * 48 not in redact("payload " + "A" * 48))
    t("redact не трогает обычный текст",
      redact("обычная строка событий") == "обычная строка событий")
    with tempfile.TemporaryDirectory() as td:
        os.environ["CLAUDE_AGENT_TG_SENT_MAP"] = os.path.join(td, "map.json")
        sent_map_register(1, [10, 11], "alfa", 3)
        t("map: lookup по (chat,msg)",
          (sent_map_lookup(1, 10) or {}).get("agent") == "alfa")
        t("map: generation сохранен",
          (sent_map_lookup(1, 11) or {}).get("gen") == 3)
        t("map: чужой message_id пуст", sent_map_lookup(1, 99) is None)
        t("map: chat_id входит в ключ", sent_map_lookup(2, 10) is None)
        t("map: None-id не регистрируется",
          (sent_map_register(1, [None], "alfa", 3) or
           sent_map_lookup(1, None)) is None)
        sent_map_register(1, [12], "beta", 1,
                          now=time.time() + SENT_MAP_TTL_S + 60)
        t("map: TTL-prune при записи", sent_map_lookup(1, 10) is None)
        t("map: свежая запись жива",
          (sent_map_lookup(1, 12) or {}).get("agent") == "beta")
        t("reply без map-записи получает подсказку",
          "свежую сводку" in mission_comment(
              {"chat": {"id": 5}, "from": {"id": 1}},
              {"message_id": 404}, "текст", 1))
        os.makedirs(os.path.join(td, "evtag"))
        open(os.path.join(td, "evtag", "spec.yaml"), "w").write(
            "schema: 1\nname: evtag\ntype: event\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        sent_map_register(7, [70], "evtag", 1)
        t("reply на event-агента получает подсказку /task",
          "/task evtag" in mission_comment(
              {"chat": {"id": 7}, "from": {"id": 1}},
              {"message_id": 70}, "текст", 1))
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
        os.environ.pop("CLAUDE_AGENT_TG_SENT_MAP", None)
    with tempfile.TemporaryDirectory() as td:
        os.makedirs(os.path.join(td, "alfa"))
        open(os.path.join(td, "alfa", "spec.yaml"), "w").write("name: alfa\n")
        os.environ["CLAUDE_AGENTS_DIR"] = td
        _, akb = menu_view("ag:alfa")
        adatas = [b["callback_data"]
                  for row in akb["inline_keyboard"] for b in row]
        t("меню агента имеет кнопку Сводка", "m:sum:alfa" in adatas)
        os.environ.pop("CLAUDE_AGENTS_DIR", None)
    with tempfile.TemporaryDirectory() as td:
        # Р11 (план §12): durable-счетчик карточек - растет на bump, сутки
        # (UTC) отваливаются сами, повторный bump в те же сутки суммируется.
        os.environ["CLAUDE_AGENT_TG_CARDS_COUNT"] = os.path.join(
            td, "cards.json")
        t("cards: файла нет до первого bump",
          not os.path.exists(_cards_count_path()))
        cards_count_bump(now=1753000000)  # 2025-07-20T05:33:20Z
        with open(_cards_count_path()) as f:
            d1 = json.load(f)
        t("cards: первый bump - count=1", d1 == {"day": "2025-07-20", "count": 1})
        cards_count_bump(now=1753000100)  # тот же UTC-день
        with open(_cards_count_path()) as f:
            d2 = json.load(f)
        t("cards: второй bump в те же сутки - count=2", d2["count"] == 2)
        cards_count_bump(now=1753000000 + 86400)  # следующие сутки
        with open(_cards_count_path()) as f:
            d3 = json.load(f)
        t("cards: новые сутки сбрасывают счетчик", d3 == {
            "day": "2025-07-21", "count": 1})
        os.environ.pop("CLAUDE_AGENT_TG_CARDS_COUNT", None)
    sys.exit(1 if ok[0] else 0)


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "poll":
        mode_poll()
    elif mode == "send":
        sys.exit(mode_send(sys.argv[2:]) or 0)
    elif mode == "notify":
        mode_notify(sys.argv[2:])
    elif mode == "selftest":
        mode_selftest()
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)
