#!/usr/bin/env python3
"""claude-agent-ask: CLI для задачи - задать вопрос оператору (V2.3 §2).

usage: claude-agent-ask --question "..." [--options "a|b|c"] [--context "..."]

Каталог агента и ключ текущего конверта берутся из env, которые runner уже
прокидывает в прогон: CLAUDE_AGENT_DIR, CLAUDE_AGENT_EVENT_KEY.

Singleton (§3.1): не больше одного вопроса со status=open на агента -
проверка и создание атомарны под questions/.lock (общий код с
claude-agent-permit - см. _agent_question_io.create_question, V2.4 §2).
Второй открытый вопрос при уже открытом -> exit 2. Иначе - durable-запись
файла вопроса, stdout=qid, exit 0.

CLI НЕ дергает alert-канал: единственный владелец пушей по вопросам -
reminder-контур reconciler (V2.6). Дублирующий пуш отсюда был бы вторым
источником того же события.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _agent_question_io import create_question, QuestionError  # noqa: E402


def fail(msg, code=2):
    sys.stderr.write("claude-agent-ask: %s\n" % msg)
    sys.exit(code)


def main():
    question, options, context = None, None, None
    args = sys.argv[1:]
    while args:
        a = args.pop(0)
        if a == "--question" and args:
            question = args.pop(0)
        elif a == "--options" and args:
            options = args.pop(0)
        elif a == "--context" and args:
            context = args.pop(0)
        else:
            fail("unknown/incomplete arg %r (usage: --question T "
                 "[--options a|b|c] [--context T])" % a)
    if not question:
        fail("--question is required")

    agent_dir = os.environ.get("CLAUDE_AGENT_DIR", "")
    envelope_key = os.environ.get("CLAUDE_AGENT_EVENT_KEY", "")
    if not agent_dir or not os.path.isdir(agent_dir):
        fail("CLAUDE_AGENT_DIR не задан или не существует")
    if not envelope_key:
        fail("CLAUDE_AGENT_EVENT_KEY не задан (runner должен прокидывать)")
    # Привязка к живому прогону (аудит V2.3, major 6): envelope_key обязан
    # быть ключом конверта, реально лежащего СЕЙЧАС в inflight этого
    # агента - иначе произвольный env создал бы вопрос, не привязанный ни
    # к одному прогону, но безусловно морозящий очередь.
    if not os.path.isfile(os.path.join(agent_dir, "inbox", "inflight",
                                       envelope_key + ".json")):
        fail("CLAUDE_AGENT_EVENT_KEY не соответствует конверту в inflight "
             "этого агента")

    try:
        qid = create_question(
            agent_dir, envelope_key, "info", question,
            options=options.split("|") if options else None,
            context=context)
    except QuestionError as e:
        fail(str(e), e.code)
    print(qid)


if __name__ == "__main__":
    main()
