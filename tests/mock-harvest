#!/usr/bin/env python3
"""Мок claude-agent-harvest для тестов mark-applied-scan (T25).

Env:
  MOCK_HARV_PENDING - JSON-lines для субкоманды pending (дефолт пусто)
  MOCK_HARV_LOG     - файл, куда append'ить argv (фиксация mark-applied)
"""
import os
import sys

args = sys.argv[1:]
log = os.environ.get("MOCK_HARV_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(" ".join(args) + "\n")
if args[:1] == ["pending"]:
    out = os.environ.get("MOCK_HARV_PENDING", "")
    if out:
        print(out)
sys.exit(0)
